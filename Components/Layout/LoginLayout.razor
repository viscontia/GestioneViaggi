@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<!-- Un dialog non si chiude per sbaglio: né cliccando fuori, né con Esc.
     Il valore predefinito di MudBlazor è l'opposto, e bastava un clic a vuoto per
     perdere una scheda compilata a metà senza una sola domanda.
     Si esce dal pulsante, che chiede conferma quando c'è qualcosa da perdere.
     Dove la chiusura rapida ha senso - conferme, anteprime, aiuti, parametri di
     stampa - le singole chiamate riattivano Esc con CloseOnEscapeKey = true. -->
<MudDialogProvider BackdropClick="false" CloseOnEscapeKey="false" />
<MudSnackbarProvider />

<div class="login-container-wrapper">
    @Body
</div>

@code {
    MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#111827",
            Secondary = "#6B7280",
            Success = "#10B981",
            Error = "#EF4444",
            Warning = "#F59E0B",
            Info = "#0EA5E9",
            Background = "#F7F8FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#111827",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280",
        }
    };
}
