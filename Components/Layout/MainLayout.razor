@using MudBlazor
@inherits LayoutComponentBase
@inject IServiceProvider Services
@using GestioneViaggi.Services.Database
@inject IDatabaseService DatabaseService
@inject IJSRuntime JSRuntime

<MudThemeProvider @ref="_mudThemeProvider" Theme="_theme" IsDarkMode="_isDarkMode" />

@* I dialoghi vanno dentro un confine d'errore, e questo e' l'unico posto dove si puo' mettere.
   MudDialogProvider vive qui, nel layout: le finestre che apre NON sono discendenti del confine
   che avvolge il corpo della pagina, quindi un'eccezione dentro un dialogo non veniva fermata da
   nessuno e faceva ricostruire l'intero albero — a video, lo schermo nero con "Caricamento in
   corso". Ed e' nei dialoghi che si inserisce quasi tutto: viaggi, date, blocchi di newsletter. *@
<ConfineErrori @ref="_confineDialoghi" Contesto="dialoghi">
    <ChildContent>
        <MudDialogProvider />
    </ChildContent>
    <ErrorContent Context="ex">
        <div style="position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 3000; max-width: 640px;">
            <PannelloErrore Errore="ex" OnRiprova="RecuperaDialoghi" />
        </div>
    </ErrorContent>
</ConfineErrori>

<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @if (_isMobile)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@((e) => DrawerToggle())"
                           aria-label="Apri/Chiudi menu laterale" />
        }
        <MudText Typo="Typo.h5" Class="ml-3">Gestione Viaggi</MudText>
        <MudSpacer />
        <AppBreadcrumbs />
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.Brightness7 : Icons.Material.Filled.Brightness4)"
                       Color="Color.Inherit"
                       OnClick="@((e) => DarkModeToggle())"
                       aria-label="@(_isDarkMode ? "Passa a tema chiaro" : "Passa a tema scuro")" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Variant="@(_isMobile ? DrawerVariant.Temporary : DrawerVariant.Mini)"
               OpenMiniOnHover="@(!_isMobile)"
               Class="@(_isDarkMode ? "theme-dark" : "theme-light")">
        <NavMenu OnItemClick="@HandleNavItemClick" />
    </MudDrawer>
    <MudMainContent Class="@(_isDarkMode ? "theme-dark" : "theme-light")" Style="padding-left: 0; margin-left: 56px !important;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4 px-0">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<!-- Bottom Status Bar -->
<div
    style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1200; margin-left: var(--mud-drawer-width-mini, 56px);">
    <StatusBar />
</div>

@code {
    private ConfineErrori? _confineDialoghi;

    /// <summary>Rimette in piedi il gestore dei dialoghi dopo un errore: senza, non se ne aprono più.</summary>
    private void RecuperaDialoghi() => _confineDialoghi?.Recover();

    bool _drawerOpen = true;
    bool _isDarkMode = false; // Default Light Mode
    bool _isMobile = false; // Track mobile/tablet (<960px)
    private MudThemeProvider? _mudThemeProvider;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        // Salva la preferenza (funziona anche in Hybrid)
        Preferences.Set("is_dark_mode", _isDarkMode);
    }

    async Task HandleNavItemClick()
    {
        // Close drawer on mobile after navigation
        if (_isMobile && _drawerOpen)
        {
            _drawerOpen = false;
            StateHasChanged();
        }
    }

    MudTheme _theme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#111827",
                Secondary = "#6B7280",
                Success = "#10B981",
                Error = "#EF4444",
                Warning = "#F59E0B",
                Info = "#0EA5E9",
                Background = "#F7F8FA",
                Surface = "#FFFFFF",
                AppbarBackground = "#FFFFFF",
                AppbarText = "#111827",
                TextPrimary = "#111827",
                TextSecondary = "#475569", // Improved contrast: 7.1:1 (WCAG AAA) - was #6B7280
            },
            PaletteDark = new PaletteDark()
            {
                Primary = "#E6E8EB",
                Secondary = "#9CA3AF",
                Success = "#34D399",
                Error = "#F87171",
                Background = "#1A1D23",
                Surface = "#30333B",
                AppbarBackground = "#30333B",
                TextPrimary = "#E6E8EB",
                TextSecondary = "#9AA1AC",
                Divider = "#404752", // FASE 2: Visible borders in dark mode
            },
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cio' che e' andato storto dalla parte JavaScript aspetta in localStorage, anche da
            // prima di un riavvio: e' proprio la coda del giro precedente a raccontare una morte
            // improvvisa. Si preleva qui perche' questo e' il primo momento in cui .NET e' certo
            // che la pagina sia agganciata — chiedere prima e' cio' che impediva l'avvio.
            try
            {
                // Nome per intero: "Services" in questo componente e' l'IServiceProvider iniettato.
                GestioneViaggi.Services.Diagnostics.RegistroJs.Registra(
                    await JSRuntime.InvokeAsync<string>("registroErrori.preleva"));
            }
            catch { /* il registro non deve poter impedire il disegno del layout */ }

            // RESPONSIVE: Detect screen width
            try
            {
                var width = await JSRuntime.InvokeAsync<int>("getWindowWidth");
                _isMobile = width < 960; // MudBlazor Breakpoint.Md
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error detecting window width: {ex.Message}");
                _isMobile = false; // Fallback to desktop
            }

            // Controlla se c'è una preferenza salvata
            if (Preferences.ContainsKey("is_dark_mode"))
            {
                _isDarkMode = Preferences.Get("is_dark_mode", false);
            }
            else
            {
                // Altrimenti usa il default di sistema
                _isDarkMode = await _mudThemeProvider!.GetSystemDarkModeAsync();
            }

            // Forza il refresh per applicare il tema
            StateHasChanged();

#if DEBUG
// Esegue le migrazioni del database (es. correzione dati, creazione trigger)
try
{
using (var scope = Services.CreateScope())
{
var migrationService = scope.ServiceProvider.GetRequiredService<GestioneViaggi.Services.Database.DbMigrationService>();
await migrationService.ApplyMigrationsAsync();
Console.WriteLine("Database migrations applied successfully.");
}
}
catch (Exception ex)
{
Console.WriteLine($"Error applying migrations: {ex.Message}");
}
#endif
        }
    }
}

<style>
    /* Utility per colorare l'helper text di rosso (errore/warning) */
    .helper-text-error .mud-input-helper-text {
        color: var(--mud-palette-error) !important;
        font-weight: 600;
    }
</style>
