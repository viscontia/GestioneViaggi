@inherits LayoutComponentBase
@using MudBlazor
@using GestioneViaggi.Components.Shared
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Navigation
@using GestioneViaggi.Models
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ITabManagerService TabManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<MudThemeProvider @ref="_mudThemeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="1"
               Variant="@DrawerVariant.Persistent"
               ClipMode="@DrawerClipMode.Never"
               Width="280px">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Menu Principale</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudAppBar Elevation="2" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
            Color="Color.Inherit"
            Edge="Edge.Start"
            OnClick="@ToggleDrawer" />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.Brightness7 : Icons.Material.Filled.Brightness4)"
            Color="Color.Inherit"
            OnClick="@DarkModeToggle"
            Class="ml-2" />
        <MudText Typo="Typo.h6" Class="ml-3">Gestione Viaggi</MudText>
        <MudSpacer />
        <AppBreadcrumbs />
    </MudAppBar>

    <MudMainContent Class="@(_isDarkMode ? "theme-dark" : "theme-light")">
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 mb-4" Style="padding: 0 8px;">
            <!-- Custom Tab Strip -->
            <MudPaper Elevation="0" Class="d-flex flex-row align-center gap-2 mb-4 pa-2"
                Style="background-color: var(--mud-palette-background-grey); overflow-x: auto;">
                @foreach (var tab in TabManager.ActiveTabs)
                {
                    var isActive = TabManager.ActiveTabs.ToList().IndexOf(tab) == TabManager.ActiveTabIndex;
                    var color = isActive ? Color.Primary : Color.Default;
                    var variant = isActive ? Variant.Filled : Variant.Text;

                    <MudPaper Elevation="@(isActive ? 2 : 0)" Class="d-flex align-center pa-2 rounded-lg cursor-pointer"
                        Style="@(isActive ? "background-color: var(--mud-palette-primary); color: white;" : "background-color: white;")"
                    @onclick="@(() => OnTabChanged(TabManager.ActiveTabs.ToList().IndexOf(tab)))">

                        @if (!string.IsNullOrEmpty(tab.Icon))
                        {
                            <MudIcon Icon="@GetTabIcon(tab.Icon)" Size="Size.Small" Class="mr-2" />
                        }

                        <MudText Typo="Typo.body2" Style="white-space: nowrap;">@tab.Title</MudText>

                        @if (tab.IsDirty)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Warning" Class="ml-2"
                                Style="font-size: 10px;" />
                        }

                        @if (tab.IsCloseable)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                Color="@(isActive ? Color.Inherit : Color.Default)" OnClick="@((e) => OnCloseTab(tab))"
                                Class="ml-1" />
                        }
                    </MudPaper>
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4" Style="background: transparent;">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            <MudText Typo="Typo.h6">Errore Critico nel Componente</MudText>
                            <MudText>@ex.GetType().Name: @ex.Message</MudText>
                            <MudText Typo="Typo.body2" Class="mt-2">Stack Trace:</MudText>
                            <pre style="white-space: pre-wrap; font-size: 0.75rem;">@ex.StackTrace</pre>
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<!-- Bottom Status Bar -->
<div
    style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1200; margin-left: var(--mud-drawer-width-mini, 56px);">
    <StatusBar />
</div>

@code {
    private bool _isDisposing = false;
    private bool _isDarkMode = false;
    private bool _drawerOpen = true;
    private MudThemeProvider? _mudThemeProvider;
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Controlla se c'è una preferenza salvata
            if (Preferences.ContainsKey("is_dark_mode"))
            {
                _isDarkMode = Preferences.Get("is_dark_mode", false);
            }
            else
            {
                // Altrimenti usa il default di sistema
                // _isDarkMode = await _mudThemeProvider!.GetSystemDarkModeAsync();
            }
            StateHasChanged();
        }
    }

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        // Salva la preferenza (funziona anche in Hybrid)
        Preferences.Set("is_dark_mode", _isDarkMode);
    }

    MudTheme _theme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#111827",
                Secondary = "#6B7280",
                Success = "#10B981",
                Error = "#EF4444",
                Warning = "#F59E0B",
                Info = "#0EA5E9",
                Background = "#F7F8FA",
                Surface = "#FFFFFF",
                AppbarBackground = "#FFFFFF",
                AppbarText = "#111827",
                TextPrimary = "#111827",
                TextSecondary = "#6B7280",
            },
            PaletteDark = new PaletteDark()
            {
                Primary = "#38BDF8",
                Secondary = "#9CA3AF",
                Success = "#10B981",
                Error = "#EF4444",
                Warning = "#F59E0B",
                Info = "#38BDF8",
                Background = "#111827",
                Surface = "#1F2937",
                AppbarBackground = "#1F2937",
                AppbarText = "#F9FAFB",
                TextPrimary = "#F9FAFB",
                TextSecondary = "#D1D5DB",
                DrawerBackground = "#1F2937",
                DrawerText = "#F9FAFB",
            }
        };

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        TabManager.OnTabsChanged += OnTabsChanged;
    }

    private void OnTabsChanged()
    {
        if (!_isDisposing)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnTabChanged(int newIndex)
    {
        TabManager.SwitchToTab(newIndex);
    }

    private async Task OnCloseTab(TabInfo tab)
    {
        if (tab.IsDirty)
        {
            bool? result = await DialogService.ShowMessageBox(
            "Modifiche non salvate",
            $"La tab '{tab.Title}' contiene modifiche non salvate. Chiudere comunque?",
            yesText: "Chiudi", cancelText: "Annulla");

            if (result != true) return;
        }

        TabManager.CloseTab(tab.Id);
    }

    private string GetTabIcon(string iconName)
    {
        return iconName.ToLower() switch
        {
            "home" => Icons.Material.Filled.Home,
            "dashboard" => Icons.Material.Filled.Dashboard,
            "car" => Icons.Material.Filled.DirectionsCar,
            "people" => Icons.Material.Filled.People,
            "table" => Icons.Material.Filled.TableChart,
            "settings" => Icons.Material.Filled.Settings,
            _ => Icons.Material.Filled.Description
        };
    }

    public void Dispose()
    {
        _isDisposing = true;
        TabManager.OnTabsChanged -= OnTabsChanged;
    }
}
