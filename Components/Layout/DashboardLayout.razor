@inherits LayoutComponentBase
@using GestioneViaggi.Services.Authentication
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudText Typo="Typo.h6" Class="ml-3">Gestione Viaggi</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" />
    </MudAppBar>

    <MudDrawer Variant="DrawerVariant.Permanent" Open="true">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Menu Principale</MudText>
        </MudDrawerHeader>

        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#111827",
            Secondary = "#6B7280",
            Success = "#10B981",
            Error = "#EF4444",
            Warning = "#F59E0B",
            Info = "#0EA5E9",
            Background = "#F7F8FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#111827",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
