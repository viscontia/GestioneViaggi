@inherits LayoutComponentBase
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Navigation
@using GestioneViaggi.Models
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ITabManagerService TabManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<MudThemeProvider @ref="_mudThemeProvider" Theme="_theme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudText Typo="Typo.h6" Class="ml-3">Gestione Viaggi</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.Brightness7 : Icons.Material.Filled.Brightness4)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
    </MudAppBar>

    <MudDrawer Variant="DrawerVariant.Persistent" Open="true" Class="@(_isDarkMode ? "theme-dark" : "theme-light")">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Menu Principale</MudText>
        </MudDrawerHeader>

        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="@(_isDarkMode ? "theme-dark" : "theme-light")">
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 mb-4" Style="padding: 0 8px;">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
                     ActivePanelIndex="@TabManager.ActiveTabIndex"
                     ActivePanelIndexChanged="@OnTabChanged"
                     Class="mb-4">
                @foreach (var tab in TabManager.ActiveTabs)
                {
                    <MudTabPanel BadgeData="@(tab.IsDirty ? "●" : null)" BadgeColor="Color.Warning">
                        <TabWrapperContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @if (!string.IsNullOrEmpty(tab.Icon))
                                {
                                    <MudIcon Icon="@GetTabIcon(tab.Icon)" Size="Size.Small" />
                                }
                                <MudText>@tab.Title</MudText>
                                @if (tab.IsCloseable)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OnCloseTab(tab))"
                                                   Style="margin-left: 4px;" />
                                }
                            </MudStack>
                        </TabWrapperContent>
                        <ChildContent>
                            @Body
                        </ChildContent>
                    </MudTabPanel>
                }
            </MudTabs>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<!-- Bottom Status Bar -->
<div style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1200; margin-left: var(--mud-drawer-width-mini, 56px);">
    <StatusBar />
</div>

@code {
    private bool _isDisposing = false;
    private bool _isDarkMode = false;
    private MudThemeProvider? _mudThemeProvider;

    void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#111827",
            Secondary = "#6B7280",
            Success = "#10B981",
            Error = "#EF4444",
            Warning = "#F59E0B",
            Info = "#0EA5E9",
            Background = "#F7F8FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#111827",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#0EA5E9",
            Secondary = "#9CA3AF",
            Success = "#10B981",
            Error = "#EF4444",
            Warning = "#F59E0B",
            Info = "#38BDF8",
            Background = "#1F2937",
            Surface = "#374151",
            AppbarBackground = "#1F2937",
            AppbarText = "#F9FAFB",
            TextPrimary = "#F9FAFB",
            TextSecondary = "#D1D5DB",
            DrawerBackground = "#1F2937",
            DrawerText = "#F9FAFB",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        TabManager.OnTabsChanged += OnTabsChanged;
    }

    private void OnTabsChanged()
    {
        if (!_isDisposing)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnTabChanged(int newIndex)
    {
        TabManager.SwitchToTab(newIndex);
    }

    private async Task OnCloseTab(TabInfo tab)
    {
        if (tab.IsDirty)
        {
            bool? result = await DialogService.ShowMessageBox(
                "Modifiche non salvate",
                $"La tab '{tab.Title}' contiene modifiche non salvate. Chiudere comunque?",
                yesText: "Chiudi", cancelText: "Annulla");

            if (result != true) return;
        }

        TabManager.CloseTab(tab.Id);
    }

    private string GetTabIcon(string iconName)
    {
        return iconName.ToLower() switch
        {
            "home" => Icons.Material.Filled.Home,
            "dashboard" => Icons.Material.Filled.Dashboard,
            "car" => Icons.Material.Filled.DirectionsCar,
            "people" => Icons.Material.Filled.People,
            "table" => Icons.Material.Filled.TableChart,
            "settings" => Icons.Material.Filled.Settings,
            _ => Icons.Material.Filled.Description
        };
    }

    public void Dispose()
    {
        _isDisposing = true;
        TabManager.OnTabsChanged -= OnTabsChanged;
    }
}
