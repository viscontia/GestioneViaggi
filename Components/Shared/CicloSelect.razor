@*
    COMPONENT: CicloSelect
    DESC: Select per la selezione del ciclo contabile (Cash Flow).
          ATTIVO = Entrate (Crediti da Clienti)
          PASSIVO = Uscite (Debiti verso Fornitori)
*@

<MudSelect T="string"
           Label="@Label"
           @bind-Value="@Value"
           Variant="Variant.Outlined"
           Dense="true"
           Margin="Margin.Dense"
           Clearable="@Clearable"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           AnchorOrigin="Origin.BottomCenter"
           Class="@Class">
    <MudSelectItem Value="@("ATTIVO")">Entrate (Crediti da Clienti)</MudSelectItem>
    <MudSelectItem Value="@("PASSIVO")">Uscite (Debiti verso Fornitori)</MudSelectItem>
</MudSelect>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Tipo Cash Flow";
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Campo obbligatorio";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string? Class { get; set; }
}
