@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using System.Threading
@inject CountryIntermediateService CountryIntermediateService

<BaseEntitySelect TItem="CountryIntermediate"
                  Value="_selectedIntermediate"
                  ValueChanged="OnIntermediateChanged"
                  SearchFunc="SearchIntermediates"
                  ToStringFunc="@(i => i?.Name)"
                  Label="@Label"
                  Required="@Required"
                  RequiredError="@RequiredError"
                  Disabled="@Disabled"
                  Class="@Class"
                  HelperText="@HelperText"
                  AutoFocus="@AutoFocus"
                  AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<CountryIntermediate>? _intermediates;
    private CountryIntermediate? _selectedIntermediate;

    [Parameter]
    public int? SelectedIntermediateId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedIntermediateIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Regione Intermedia";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La regione intermedia è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la regione intermedia (es: Caribbean, Eastern Africa)";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadIntermediatesAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedIntermediate();
    }

    private void UpdateSelectedIntermediate()
    {
        if (_intermediates == null) return;

        if (SelectedIntermediateId.HasValue)
        {
            if (_selectedIntermediate?.Id != SelectedIntermediateId.Value)
            {
                _selectedIntermediate = _intermediates.FirstOrDefault(i => i.Id == SelectedIntermediateId.Value);
            }
        }
        else
        {
            _selectedIntermediate = null;
        }
    }

    private async Task LoadIntermediatesAsync()
    {
        try
        {
            _intermediates = await CountryIntermediateService.GetAllOrderedByNameAsync();
            UpdateSelectedIntermediate();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento regioni intermedie: {ex.Message}");
            _intermediates = new List<CountryIntermediate>();
        }
    }

    private async Task OnIntermediateChanged(CountryIntermediate intermediate)
    {
        _selectedIntermediate = intermediate;
        await SelectedIntermediateIdChanged.InvokeAsync(intermediate?.Id);
    }

    private async Task<IEnumerable<CountryIntermediate>> SearchIntermediates(string value, CancellationToken token)
    {
        if (_intermediates == null)
            return Enumerable.Empty<CountryIntermediate>();

        if (string.IsNullOrEmpty(value))
            return _intermediates;

        return _intermediates.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
