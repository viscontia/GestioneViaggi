@using System.Globalization
@using System.Text
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using Blazored.TextEditor
@using MudBlazor
@inject WebTourContenutiService ContenutiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

@* Scheda "Contenuti Web" del viaggio (Blocco 5 estensione web).
   ECCEZIONE UI DOCUMENTATA: i campi editoriali/RichText NON usano il maiuscolo
   forzato (uppercase-input/converter) perché destinati alle pagine del sito
   pubblico — vedi overview.md §3.3 e piano operativo Blocco 5. *@

@if (_loading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" />
    </div>
}
else
{
    <MudGrid Spacing="2">
        <!-- PUBBLICAZIONE -->
        @* Sezione tenuta IN TESTA e non in fondo: lo stato di pubblicazione è l'informazione che si
           consulta e si cambia più spesso, e in coda a una form lunga costringeva a scorrere tutto
           per sapere se un tour è online. Sta subito sotto i chip di stato del selettore edizione,
           che raccontano la stessa cosa. *@
        <MudItem xs="12">
            <MudText Typo="Typo.subtitle1">Pubblicazione</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <div class="d-flex align-center">
                <MudSelect T="string" @bind-Value="_model.StatoPubblicazione" @bind-Value:after="MarkDirty" Label="Stato"
                           Variant="Variant.Outlined" Class="flex-grow-1">
                    <MudSelectItem T="string" Value="@("bozza")">Bozza</MudSelectItem>
                    <MudSelectItem T="string" Value="@("pubblicato")">Pubblicato</MudSelectItem>
                    <MudSelectItem T="string" Value="@("archiviato")">Archiviato</MudSelectItem>
                </MudSelect>
                @* Aiuto esteso: qui non basta dire cosa fa il campo. Il controllo scatta al SALVATAGGIO,
                   non alla scelta, e "archiviato" per il sito è identico a "bozza" — due comportamenti
                   che senza spiegazione sembrano difetti. *@
                <FieldHelp Title="Stato di pubblicazione" MaxWidthPx="440">
                    <MudText Typo="Typo.body2" Class="mt-1">
                        <b>Bozza</b> — Il tour <b>non</b> è visibile sul sito. È lo stato normale mentre lo prepari:
                        puoi modificare tutto senza conseguenze.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <b>Pubblicato</b> — Il tour è online e visibile a chi visita il sito.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <b>Archiviato</b> — Non è visibile sul sito, <b>esattamente come una bozza</b>. Il programma
                        tratta i due stati allo stesso modo: serve a te per distinguere ciò che è finito e non va più
                        toccato da ciò che è ancora in lavorazione.
                    </MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body2">
                        <b>Quando puoi mettere "Pubblicato"</b> — Il controllo avviene al <b>salvataggio</b>, non quando
                        scegli la voce. Se qualcosa manca, il programma riporta lo stato a Bozza e ti dice cosa. Servono
                        due condizioni: tutte le sezioni complete (icone verdi in alto, traduzioni revisionate comprese),
                        e una partenza che <b>deve ancora iniziare</b> e non è segnata come effettuata.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Tornare a Bozza o Archiviato è <b>sempre</b> possibile e toglie subito il tour dal sito.
                    </MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body2">
                        <b>Da sapere</b> — Il giorno in cui la partenza inizia, il tour <b>sparisce dal sito da solo</b>,
                        anche se resta "Pubblicato": nessuno può più prenotare una partenza già cominciata. Lo stato che
                        vedi qui non cambia.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        La scheda si può <b>eliminare</b> solo da Bozza o Archiviato: una scheda pubblicata va prima
                        tolta dal sito.
                    </MudText>
                </FieldHelp>
            </div>
        </MudItem>
        <MudItem xs="6" sm="4">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.subtitle2">Ordine sul sito</MudText>
                <FieldHelp Title="Ordine sul sito"
                           Text="Decide in che ordine appaiono i tour nell'elenco del sito. Numeri più bassi vanno prima. Lascia 0 se non ti interessa; usa 1, 2, 3… per mettere alcuni tour in cima." />
            </div>
            <MudNumericField T="int" @bind-Value="_model.Ordine" @bind-Value:after="MarkDirty" Variant="Variant.Outlined" Min="0" HelperText="Più basso = più in alto nell'elenco." />
        </MudItem>
        <MudItem xs="6" sm="4">
            <div class="d-flex align-center">
                <MudField Label="Prima pubblicazione" Variant="Variant.Text" Class="flex-grow-1"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock">
                    <span class="mud-input-text mud-text-secondary">@(_model.DataPubblicazione?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                </MudField>
                <FieldHelp Title="Prima pubblicazione"
                           Text="Data in cui il tour è stato pubblicato la prima volta. La imposta il sistema automaticamente, non serve toccarla." />
            </div>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        <!-- CAMPI EDITORIALI -->
        <MudItem xs="12">
            <MudTextField @bind-Value="_model.Sottotitolo" @bind-Value:after="MarkDirty" Label="Sottotitolo" Variant="Variant.Outlined"
                          MaxLength="255" AutoFocus="true" Immediate="true"
                          HelperText="Descrivi il tour in una frase." />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_model.DurataTesto" @bind-Value:after="MarkDirty" Label="Durata (testo libero, es. 5 giorni / 4 notti)"
                          Variant="Variant.Outlined" MaxLength="100" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_model.LuoghiVisitati" @bind-Value:after="MarkDirty" Label="Luoghi visitati" Variant="Variant.Outlined" Lines="2"
                          HelperText="Principali luoghi visitati, separati da virgola. Es: Barbagia, Supramonte, Gennargentu, Ogliastra." />
        </MudItem>

        <MudItem xs="12" Class="py-0">
            <style>
                /* BlazoredTextEditor (Quill): scroll interno quando il testo supera l'altezza del box */
                .rte-lg .ql-editor { max-height: 150px; overflow-y: auto; }
                .rte-sm .ql-editor { max-height: 90px; overflow-y: auto; }
            </style>
        </MudItem>
        <!-- DESCRIZIONE PRINCIPALE (RichText) -->
        <MudItem xs="12">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.subtitle2">Descrizione</MudText>
                <FieldHelp Title="Descrizione" Text="Descrizione dettagliata del Tour/Viaggio." />
            </div>
            <div @oninput="MarkDirty" class="rte-lg" style="height:200px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                <BlazoredTextEditor @ref="_edDescrizione" Placeholder="Descrizione del tour per il sito...">
                    <ToolbarContent>@ToolbarStandard</ToolbarContent>
                </BlazoredTextEditor>
            </div>
        </MudItem>

        <!-- SEZIONI INFORMATIVE (RichText) -->
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Pernottamento</MudText>
            <div @oninput="MarkDirty" class="rte-sm" style="height:140px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                <BlazoredTextEditor @ref="_edPernottamento" Placeholder="Info pernottamento...">
                    <ToolbarContent>@ToolbarCompatta</ToolbarContent>
                </BlazoredTextEditor>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Pasti</MudText>
            <div @oninput="MarkDirty" class="rte-sm" style="height:140px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                <BlazoredTextEditor @ref="_edPasti" Placeholder="Info pasti...">
                    <ToolbarContent>@ToolbarCompatta</ToolbarContent>
                </BlazoredTextEditor>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Equipaggiamento</MudText>
            <div @oninput="MarkDirty" class="rte-sm" style="height:140px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                <BlazoredTextEditor @ref="_edEquipaggiamento" Placeholder="Info equipaggiamento...">
                    <ToolbarContent>@ToolbarCompatta</ToolbarContent>
                </BlazoredTextEditor>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Altre informazioni</MudText>
            <div @oninput="MarkDirty" class="rte-sm" style="height:140px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                <BlazoredTextEditor @ref="_edAltre" Placeholder="Altre info utili...">
                    <ToolbarContent>@ToolbarCompatta</ToolbarContent>
                </BlazoredTextEditor>
            </div>
        </MudItem>

        <!-- SEO -->
        <MudItem xs="12">
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle1">SEO</MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.subtitle2">Indirizzo web (URL)</MudText>
                <FieldHelp Title="Indirizzo web"
                           Text="È l'indirizzo della pagina sul sito. Tienilo corto e semplice, tutto minuscolo, parole separate da trattini (es. tour-dune-gallura). ⚠️ Dopo la pubblicazione non cambiarlo: il vecchio link smetterebbe di funzionare." />
            </div>
            <MudTextField @bind-Value="_model.Slug" @bind-Value:after="MarkDirty" Variant="Variant.Outlined"
                          MaxLength="160" Required="true" RequiredError="L'indirizzo web è obbligatorio"
                          HelperText="Minuscolo, senza spazi (es. dalle-dune-alla-gallura). Non cambiarlo dopo la pubblicazione."
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Autorenew"
                          OnAdornmentClick="GeneraSlug" AdornmentAriaLabel="Genera l'indirizzo web dal titolo" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.subtitle2">Meta title</MudText>
                <FieldHelp Title="Meta title"
                           Text="Il titolo che Google mostra nei risultati di ricerca e nella scheda del browser. Tienilo entro ~60 caratteri, con le parole più importanti all'inizio. Se lo lasci vuoto verrà usato il titolo del tour." />
            </div>
            <MudTextField @bind-Value="_model.MetaTitle" @bind-Value:after="MarkDirty" Variant="Variant.Outlined" MaxLength="255" HelperText="~60 caratteri."
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.AutoFixHigh"
                          OnAdornmentClick="SuggerisciMetaTitle" AdornmentAriaLabel="Suggerisci meta title" />
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.subtitle2">Meta description</MudText>
                <FieldHelp Title="Meta description"
                           Text="La breve frase che appare sotto il titolo nei risultati di Google: serve a invogliare il clic. Circa 150 caratteri, invitante e chiara." />
            </div>
            <MudTextField @bind-Value="_model.MetaDescription" @bind-Value:after="MarkDirty" Variant="Variant.Outlined"
                          Lines="2" AutoGrow="true" MaxLines="6" MaxLength="320" Counter="320" HelperText="~150 caratteri."
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.AutoFixHigh"
                          OnAdornmentClick="SuggerisciMetaDescription" AdornmentAriaLabel="Suggerisci meta description" />
        </MudItem>

        <!-- AZIONI -->
        <MudItem xs="12" Class="d-flex justify-end">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salva" Disabled="@_saving"
                       StartIcon="@(_saving ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Save)">
                @(_saving ? "Salvataggio..." : "Salva Contenuti Web")
            </MudButton>
        </MudItem>
    </MudGrid>
}

@code {
    /// <summary>Id del contenuto/edizione (web_tour_contenuti). Il contenuto esiste già (creato/clonato dal dialog viaggio).</summary>
    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    /// <summary>Titolo del viaggio (descrizione breve), usato per suggerire lo slug.</summary>
    [Parameter] public string? DescrizioneBreve { get; set; }
    /// <summary>Notifica al parent (WebEdizioniManager) che ci sono modifiche non salvate in questa scheda.</summary>
    [Parameter] public EventCallback<bool> HasUnsavedChangesChanged { get; set; }
    /// <summary>Notifica al parent lo stato di completamento (semaforo), ricalcolato dopo il load e dopo ogni Salva.</summary>
    [Parameter] public EventCallback<WebTabStato> StatoChanged { get; set; }
    /// <summary>Gating pubblicazione (Fase 3): interrogato al Salva per sapere quali ALTRI sub-tab (Itinerario/
    /// Galleria/Mappa/Traduzioni) non sono ancora Completo. Fornito da WebEdizioniManager, che tiene lo stato dei 5 tab.</summary>
    [Parameter] public Func<IReadOnlyList<string>>? GetTabNonCompletiAltri { get; set; }
    /// <summary>Verifiche non bloccanti, ricalcolate dal parent al momento della pubblicazione.</summary>
    [Parameter] public Func<Task<IReadOnlyList<Verifica>>>? GetVerifiche { get; set; }
    /// <summary>
    /// Motivo per cui questa partenza non è pubblicabile (già effettuata, o data ormai arrivata),
    /// oppure null. Lo calcola il parent, che conosce le date dell'edizione (StatoPartenzaRules).
    /// </summary>
    [Parameter] public Func<string?>? GetMotivoNonPubblicabile { get; set; }

    private WebTourContenuto _model = new();
    private bool _loading = true;
    private bool _saving;
    private bool _htmlLoaded;
    private bool _dirty;

    private BlazoredTextEditor _edDescrizione = default!;
    private BlazoredTextEditor _edPernottamento = default!;
    private BlazoredTextEditor _edPasti = default!;
    private BlazoredTextEditor _edEquipaggiamento = default!;
    private BlazoredTextEditor _edAltre = default!;

    // Toolbar Quill riusate dai 5 editor
    private static readonly RenderFragment ToolbarStandard = __builder =>
    {
        <select class="ql-header">
            <option selected=""></option>
            <option value="2"></option>
            <option value="3"></option>
        </select>
        <span class="ql-formats">
            <button class="ql-bold"></button>
            <button class="ql-italic"></button>
            <button class="ql-underline"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-list" value="ordered"></button>
            <button class="ql-list" value="bullet"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-link"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-clean"></button>
        </span>
    };

    private static readonly RenderFragment ToolbarCompatta = __builder =>
    {
        <span class="ql-formats">
            <button class="ql-bold"></button>
            <button class="ql-italic"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-list" value="bullet"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-clean"></button>
        </span>
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await ContenutiService.GetByIdAsync(ContenutoId, AziendaId);
            if (existing != null)
                _model = existing;
            else
                Snackbar.Add("Contenuto non trovato.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento contenuti web: {ex.Message}", Severity.Error);
        }
        finally
        {
            await NotifyStatoAsync();
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Gli editor Quill esistono solo dopo che _loading è false: carica l'HTML
        // esistente una volta sola, con retry breve (Quill si inizializza async).
        if (!_loading && !_htmlLoaded)
        {
            _htmlLoaded = true;
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch { /* Ignore JS errors on init */ }

            for (var attempt = 0; attempt < 3; attempt++)
            {
                try
                {
                    await Task.Delay(150);
                    await LoadHtml(_edDescrizione, _model.DescrizioneHtml);
                    await LoadHtml(_edPernottamento, _model.InfoPernottamentoHtml);
                    await LoadHtml(_edPasti, _model.InfoPastiHtml);
                    await LoadHtml(_edEquipaggiamento, _model.InfoEquipaggiamentoHtml);
                    await LoadHtml(_edAltre, _model.AltreInfoHtml);
                    break;
                }
                catch when (attempt < 2)
                {
                    // Quill non ancora pronto: riprova
                }
            }
        }
    }

    private static async Task LoadHtml(BlazoredTextEditor editor, string? html)
    {
        if (!string.IsNullOrWhiteSpace(html))
        {
            await editor.LoadHTMLContent(html);
        }
    }

    /// <summary>Tab non ancora completi che bloccano la pubblicazione (vuoto = si può pubblicare).</summary>
    private List<string> Blocco()
    {
        var mancanti = new List<string>();
        if (ComputeStato() != WebTabStato.Completo) mancanti.Add("Contenuti");
        mancanti.AddRange(GetTabNonCompletiAltri?.Invoke() ?? Array.Empty<string>());
        return mancanti;
    }

    /// <summary>Stato del tab secondo la regola condivisa (vedi WebTabStatoRules).</summary>
    private WebTabStato ComputeStato() => WebTabStatoRules.Contenuti(
        !string.IsNullOrWhiteSpace(_model.Slug),
        !string.IsNullOrWhiteSpace(_model.Sottotitolo),
        !string.IsNullOrWhiteSpace(_model.DescrizioneHtml));

    private Task NotifyStatoAsync() => StatoChanged.InvokeAsync(ComputeStato());

    /// <summary>Segnala al parent che ci sono modifiche non salvate (una tantum: notifica solo al primo cambiamento).</summary>
    private Task MarkDirty()
    {
        if (_dirty) return Task.CompletedTask;
        _dirty = true;
        return HasUnsavedChangesChanged.InvokeAsync(true);
    }

    private async Task GeneraSlug()
    {
        _model.Slug = Slugify(DescrizioneBreve);
        await MarkDirty();
    }

    private async Task SuggerisciMetaTitle()
    {
        _model.MetaTitle = Troncatura(DescrizioneBreve, 60);
        await MarkDirty();
    }

    private async Task SuggerisciMetaDescription()
    {
        _model.MetaDescription = Troncatura(StripHtml(_model.DescrizioneHtml) ?? _model.Sottotitolo, 155);
        await MarkDirty();
    }

    /// <summary>Rimuove i tag HTML, decodifica le entità e comprime gli spazi multipli.</summary>
    private static string? StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var senzaTag = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        var decodificato = System.Net.WebUtility.HtmlDecode(senzaTag);
        var compresso = System.Text.RegularExpressions.Regex.Replace(decodificato, @"\s+", " ").Trim();
        return compresso.Length == 0 ? null : compresso;
    }

    /// <summary>Taglia il testo a <paramref name="max"/> caratteri sull'ultimo confine di parola.</summary>
    private static string? Troncatura(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var trimmed = text.Trim();
        if (trimmed.Length <= max) return trimmed;

        var tagliato = trimmed[..max];
        var ultimoSpazio = tagliato.LastIndexOf(' ');
        if (ultimoSpazio > 0) tagliato = tagliato[..ultimoSpazio];
        return tagliato.Trim();
    }

    /// <summary>Slug da testo: minuscolo, accenti rimossi, non-alfanumerici → '-'.</summary>
    private static string Slugify(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;

        var normalized = text.Trim().ToLowerInvariant().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);
        foreach (var c in normalized)
        {
            var cat = CharUnicodeInfo.GetUnicodeCategory(c);
            if (cat == UnicodeCategory.NonSpacingMark) continue;
            sb.Append(char.IsLetterOrDigit(c) ? c : '-');
        }
        var slug = System.Text.RegularExpressions.Regex.Replace(sb.ToString(), "-{2,}", "-").Trim('-');
        return slug.Length > 160 ? slug[..160].Trim('-') : slug;
    }

    /// <summary>Quill "vuoto" restituisce &lt;p&gt;&lt;br&gt;&lt;/p&gt;: normalizza a NULL.</summary>
    private static string? NormalizeHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var stripped = html.Replace("<p><br></p>", string.Empty).Replace("<p></p>", string.Empty).Trim();
        return stripped.Length == 0 ? null : html;
    }

    /// <summary>Salva solo se ci sono modifiche non salvate. Usato dal guard "modifiche non salvate" del parent.</summary>
    public async Task<bool> SaveIfDirtyAsync()
    {
        if (!_dirty) return true;
        return await Salva();
    }

    private async Task<bool> Salva()
    {
      try
      {
        // Raccoglie l'HTML dagli editor
        try
        {
            _model.DescrizioneHtml = NormalizeHtml(await _edDescrizione.GetHTML());
            _model.InfoPernottamentoHtml = NormalizeHtml(await _edPernottamento.GetHTML());
            _model.InfoPastiHtml = NormalizeHtml(await _edPasti.GetHTML());
            _model.InfoEquipaggiamentoHtml = NormalizeHtml(await _edEquipaggiamento.GetHTML());
            _model.AltreInfoHtml = NormalizeHtml(await _edAltre.GetHTML());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore lettura editor: {ex.Message}", Severity.Error);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_model.Slug))
        {
            _model.Slug = Slugify(DescrizioneBreve);
        }
        _model.Slug = Slugify(_model.Slug);
        if (string.IsNullOrWhiteSpace(_model.Slug))
        {
            Snackbar.Add("Inserire un indirizzo web valido.", Severity.Warning);
            return false;
        }

        // Gating pubblicazione (Fase 3): non si passa a "pubblicato" finché tutti i sub-tab non sono Completo.
        // Enforcement solo UI in questo pass; un enforcement DB-first (funzione che rifiuta l'UPDATE) è previsto
        // come difesa futura, non obbligatoria ora.
        if (_model.StatoPubblicazione == "pubblicato")
        {
            // Prima di guardare i contenuti: una partenza già passata o già effettuata non è
            // pubblicabile comunque, perché nessuno potrebbe più prenotarla.
            if (GetMotivoNonPubblicabile?.Invoke() is { } motivo)
            {
                _model.StatoPubblicazione = "bozza";
                Snackbar.Add($"Pubblicazione non consentita: {motivo}. Salvato come bozza.", Severity.Warning);
            }
            else if (Blocco() is { Count: > 0 } mancanti)
            {
                _model.StatoPubblicazione = "bozza";
                Snackbar.Add($"Pubblicazione bloccata: completare prima {string.Join(", ", mancanti)}. Salvato come bozza.", Severity.Warning);
            }
            else if (GetVerifiche != null)
            {
                // Verifiche NON bloccanti: il contenuto è pubblicabile, ma qualcosa sembra dimenticato
                // (giornate senza foto o senza mappa, incluso/escluso vuoti...). Non si impedisce nulla:
                // si obbliga solo a vederle prima che finiscano sul sito.
                var verifiche = await GetVerifiche.Invoke();
                if (verifiche.Count > 0)
                {
                    var parameters = new DialogParameters<WebVerificheDialog>
                    {
                        { x => x.Verifiche, verifiche },
                        { x => x.ModoPubblicazione, true }
                    };
                    var dialog = await DialogService.ShowAsync<WebVerificheDialog>("Prima di pubblicare", parameters,
                        new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });

                    // "Torna e correggi": si annulla il salvataggio e si resta nella form senza perdere nulla.
                    if ((await dialog.Result)!.Canceled) return false;
                }
            }
        }

        // Prima pubblicazione: valorizza data_pubblicazione al primo passaggio a 'pubblicato'
        if (_model.StatoPubblicazione == "pubblicato" && _model.DataPubblicazione == null)
        {
            _model.DataPubblicazione = DateTime.UtcNow;
        }

        _saving = true;
        try
        {
            _model = await ContenutiService.UpdateAsync(_model);
            Snackbar.Add("Contenuti web salvati con successo", Severity.Success);
            _dirty = false;
            await HasUnsavedChangesChanged.InvokeAsync(false);
            await NotifyStatoAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante il salvataggio: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _saving = false;
        }
      }
      catch (Exception exOuter)
      {
          _saving = false;
          Snackbar.Add($"Errore imprevisto nel salvataggio: {exOuter.Message}", Severity.Error);
          return false;
      }
    }
}
