@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject TipoPartecipanteService TipoPartecipanteService

<BaseEntitySelect TItem="TipoPartecipante" Value="_selectedItem" ValueChanged="OnValueChanged" SearchFunc="SearchFunc"
    ToStringFunc="@(x => x?.Descrizione)" Label="@Label" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" Class="@Class" HelperText="@HelperText"
    AutoFocus="@AutoFocus" AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<TipoPartecipante>? _items;
    private TipoPartecipante? _selectedItem;

    [Parameter]
    public int? SelectedId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Ruolo";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "Il ruolo è obbligatorio";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona un ruolo";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public List<TipoPartecipante>? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Items != null)
        {
            _items = Items.OrderBy(x => x.Descrizione).ToList();
            UpdateSelection();
        }
        else
        {
            await LoadDataAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (Items != null)
        {
            _items = Items.OrderBy(x => x.Descrizione).ToList();
        }
        UpdateSelection();
    }

    private void UpdateSelection()
    {
        if (_items == null) return;

        if (SelectedId.HasValue)
        {
            if (_selectedItem?.Id != SelectedId.Value)
            {
                _selectedItem = _items.FirstOrDefault(x => x.Id == SelectedId.Value);
            }
        }
        else
        {
            _selectedItem = null;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _items = (await TipoPartecipanteService.GetAllAsync()).OrderBy(x => x.Descrizione).ToList();
            UpdateSelection();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento tipi partecipanti: {ex.Message}");
            _items = new List<TipoPartecipante>();
        }
    }

    private async Task OnValueChanged(TipoPartecipante item)
    {
        _selectedItem = item;
        await SelectedIdChanged.InvokeAsync(item?.Id);
    }

    private async Task<IEnumerable<TipoPartecipante>> SearchFunc(string value, CancellationToken token)
    {
        if (_items == null)
            return Enumerable.Empty<TipoPartecipante>();

        if (string.IsNullOrEmpty(value))
            return _items;

        return _items.Where(x => !string.IsNullOrEmpty(x.Descrizione) && 
            x.Descrizione.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
