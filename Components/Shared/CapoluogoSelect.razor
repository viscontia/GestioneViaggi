@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using System.Threading
@inject CapoluogoService CapoluogoService

<BaseEntitySelect TItem="Capoluogo"
                  Value="_selectedCapoluogo"
                  ValueChanged="OnCapoluogoChanged"
                  SearchFunc="SearchCapoluoghi"
                  ToStringFunc="@(c => c?.Descrizione)"
                  Label="@Label"
                  Required="@Required"
                  RequiredError="@RequiredError"
                  Disabled="@Disabled"
                  Class="@Class"
                  HelperText="@HelperText"
                  AutoFocus="@AutoFocus"
                  AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<Capoluogo>? _capoluoghi;
    private Capoluogo? _selectedCapoluogo;

    [Parameter]
    public int? SelectedCapoluogoId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedCapoluogoIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Capoluogo";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "Il capoluogo è obbligatorio";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona il capoluogo corretto dall'elenco";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadCapoluoghiAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedCapoluogo();
    }

    private void UpdateSelectedCapoluogo()
    {
        if (_capoluoghi == null) return;

        if (SelectedCapoluogoId.HasValue)
        {
            if (_selectedCapoluogo?.Id != SelectedCapoluogoId.Value)
            {
                _selectedCapoluogo = _capoluoghi.FirstOrDefault(c => c.Id == SelectedCapoluogoId.Value);
            }
        }
        else
        {
            _selectedCapoluogo = null;
        }
    }

    private async Task LoadCapoluoghiAsync()
    {
        try
        {
            _capoluoghi = await CapoluogoService.GetAllAsync();
            UpdateSelectedCapoluogo();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento capoluoghi: {ex.Message}");
            _capoluoghi = new List<Capoluogo>();
        }
    }

    private async Task OnCapoluogoChanged(Capoluogo capoluogo)
    {
        _selectedCapoluogo = capoluogo;
        await SelectedCapoluogoIdChanged.InvokeAsync(capoluogo?.Id);
    }

    private async Task<IEnumerable<Capoluogo>> SearchCapoluoghi(string value, CancellationToken token)
    {
        if (_capoluoghi == null)
            return Enumerable.Empty<Capoluogo>();

        if (string.IsNullOrEmpty(value))
            return _capoluoghi;

        return _capoluoghi.Where(x => x.Descrizione.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
