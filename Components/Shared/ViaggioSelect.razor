@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using Microsoft.Extensions.Logging
@inject AnaViaggiService ViaggioService
@inject ILogger<ViaggioSelect> Logger
@inject ISnackbar Snackbar

<MudAutocomplete T="AnaViaggi"
                 Label="@Label"
                 Value="_selectedViaggio"
                 ValueChanged="@OnValueChanged"
                 SearchFunc="@SearchViaggi"
                 ToStringFunc="@(v => v?.DescrizioneBreve ?? string.Empty)"
                 Variant="Variant.Outlined"
                 Clearable="@Clearable"
                 Required="@Required"
                 Disabled="@Disabled"
                 ResetValueOnEmptyText="true"
                 CoerceText="true"
                 AdornmentIcon="@Icons.Material.Filled.Landscape"
                 AdornmentColor="Color.Primary"
                 Class="@Class">
    <ItemTemplate Context="viaggio">
        <MudText Typo="Typo.body2">@viaggio.DescrizioneBreve</MudText>
        @if (!string.IsNullOrWhiteSpace(viaggio.NazioneNome))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@viaggio.NazioneNome - @viaggio.NumeroGiorni giorni</MudText>
        }
    </ItemTemplate>
    @* Un viaggio si crea in Anagrafica Viaggi: dirlo qui evita di cercare il difetto altrove. *@
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-3">
            Nessun viaggio in anagrafica per questa azienda.
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public int? SelectedViaggioId { get; set; }
    [Parameter] public EventCallback<int?> SelectedViaggioIdChanged { get; set; }
    [Parameter] public int? AziendaId { get; set; }
    [Parameter] public string Label { get; set; } = "Viaggio";
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public IEnumerable<AnaViaggi>? CustomItems { get; set; }
    [Parameter] public bool FilterOnlyWithTransactions { get; set; }

    private AnaViaggi? _selectedViaggio;
    private List<AnaViaggi> _allViaggi = new();
    private int? _previousAziendaId;
    // ⚠️ Si confronta il RIFERIMENTO della lista, non il numero di elementi: due filtri
    // diversi possono restituire lo stesso numero di viaggi (gia' effettuati e da
    // effettuare, per dire) e con il solo conteggio la tendina resterebbe ferma sulla
    // lista precedente senza che nulla lo faccia sospettare.
    private IEnumerable<AnaViaggi>? _previousCustomItems;
    private bool _previousFilterOnlyWithTransactions;

    protected override async Task OnInitializedAsync()
    {
        await LoadViaggiAsync();

        // Imposta il viaggio selezionato se presente
        if (SelectedViaggioId.HasValue && SelectedViaggioId.Value > 0)
        {
            _selectedViaggio = _allViaggi.FirstOrDefault(v => v.Id == SelectedViaggioId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        bool customItemsChanged = !ReferenceEquals(CustomItems, _previousCustomItems);
        bool aziendaChanged = AziendaId != _previousAziendaId;
        bool filterChanged = FilterOnlyWithTransactions != _previousFilterOnlyWithTransactions;

        if (customItemsChanged || aziendaChanged || filterChanged)
        {
            _previousAziendaId = AziendaId;
            _previousCustomItems = CustomItems;
            _previousFilterOnlyWithTransactions = FilterOnlyWithTransactions;

            await LoadViaggiAsync();

            // Ricontrolla se il viaggio selezionato è ancora valido
            if (SelectedViaggioId.HasValue && SelectedViaggioId.Value > 0)
            {
                var newSelected = _allViaggi.FirstOrDefault(v => v.Id == SelectedViaggioId.Value);
                if (newSelected != null && newSelected != _selectedViaggio)
                {
                    // Update only if different to prevent redundant updates
                    _selectedViaggio = newSelected;
                }
                else if (newSelected == null && _selectedViaggio != null)
                {
                    // Viaggio non più disponibile, resetta la selezione
                    // But DON'T invoke callback - parent already knows
                    _selectedViaggio = null;
                }
            }
        }
    }

    private async Task LoadViaggiAsync()
    {
        try
        {
            if (CustomItems != null)
            {
                _allViaggi = CustomItems.ToList();
            }
            else if (FilterOnlyWithTransactions)
            {
                if (AziendaId.HasValue && AziendaId.Value > 0)
                    _allViaggi = await ViaggioService.GetViaggiWithTransactionsAsync(AziendaId.Value);
                else
                    _allViaggi = new List<AnaViaggi>();
            }
            else if (AziendaId.HasValue && AziendaId.Value > 0)
            {
                _allViaggi = await ViaggioService.GetAllAsync(aziendaId: AziendaId.Value);
            }
            else
            {
                _allViaggi = new List<AnaViaggi>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ViaggioSelect: Errore nel caricamento viaggi");
            _allViaggi = new List<AnaViaggi>();
        }
    }

    private async Task<IEnumerable<AnaViaggi>> SearchViaggi(string searchText, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return _allViaggi;
        }

        return _allViaggi.Where(v =>
            v.DescrizioneBreve?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true ||
            v.DescrizioneEstesa?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true ||
            v.NazioneNome?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task OnValueChanged(AnaViaggi? viaggio)
    {
        _selectedViaggio = viaggio;
        await SelectedViaggioIdChanged.InvokeAsync(viaggio?.Id);
    }
}
