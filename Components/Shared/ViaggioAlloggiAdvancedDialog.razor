@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Models.DTOs
@using MudBlazor
@inject MovClientiAlloggiService AlloggiService
@inject MovClientiViaggiService MovClientiService
@inject TipoAlloggioService TipoAlloggioService
@inject IClienteService ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Hotel" Class="mr-2" />
            Gestione Avanzata Alloggi - @_viaggioTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-3" Style="height: 88vh; overflow-y: hidden;">
            <!-- MAIN CONTENT: ASSIGNED ROOMS ONLY -->
            <MudPaper Elevation="0" Class="pa-2 h-100">
                <div class="d-flex align-center justify-space-between mb-3">
                    <div class="d-flex align-center gap-4">
                        <MudText Typo="Typo.h6">
                            Camere Assegnate
                            @if (_roomsCount > 0) { <span style="font-size:0.8em; opacity:0.6;">(@_roomsCount)</span> }
                        </MudText>
                        
                        @if (_unassignedParticipants.Any())
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Filled.Person">
                                @_unassignedParticipants.Count partecipanti senza alloggio
                            </MudChip>
                        }
                        else
                        {
                             <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircle">
                                Tutti assegnati
                            </MudChip>
                        }
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNewRoom">
                        Nuova Camera
                    </MudButton>
                </div>

                @if (_isLoadingRooms)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else if (!_rooms.Any())
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        Nessuna camera assegnata. Usa "Nuova Camera" per iniziare.
                    </MudAlert>
                }
                else
                {
                    <div class="rooms-container" style="height: calc(100% - 60px); overflow-y: auto;">
                        @foreach (var group in _rooms
                            .GroupBy(r => r.TipoDescrizione)
                            .OrderBy(g => g.Key))
                        {
                            /* HEADER DEL GRUPPO DI ALLOGGI */
                            var typeStatusColor = group.All(r => r.Occupanti.Count == r.MaxOccupanti) ? Color.Success : Color.Primary;
                            var totalRooms = group.Count();
                            var totalOccupants = group.Sum(r => r.Occupanti.Count);
                            var maxCapacity = group.Sum(r => r.MaxOccupanti);

                            <MudPaper Class="pa-3 mb-3 mt-4 d-flex align-center justify-space-between sticky-group-header" 
                                      Elevation="0" 
                                      Style="background-color: var(--mud-palette-background-grey); border-left: 4px solid var(--mud-palette-primary);">
                                <div>
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Style="font-weight: 600; text-transform: uppercase;">
                                            @group.Key
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.caption" Class="ml-8">
                                        @totalRooms camere • @totalOccupants/@maxCapacity occupanti totali
                                    </MudText>
                                </div>
                                
                                @if(group.Any(r => r.Occupanti.Count < r.MaxOccupanti))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                        ⚠️ Ci sono posti liberi
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                        ✓ Completo
                                    </MudChip>
                                }
                            </MudPaper>

                            /* LISTA CAMERE PER QUESTO TIPO */
                            <div class="pl-2 pr-2">
                                <MudGrid Spacing="2">
                                @foreach (var room in group.OrderBy(r => r.Occupanti.FirstOrDefault()?.Nominativo ?? "ZZZ"))
                                {
                                    var currentRoom = room;
                                    <MudItem xs="12" md="6" lg="4">
                                        <MudCard Class="mb-3 hover-elevation-2 h-100" Outlined="true" Style="border-left: 1px solid var(--mud-palette-table-lines);">
                                            <MudCardHeader Class="pb-2">
                                                <CardHeaderContent>
                                                    <div class="d-flex align-center justify-space-between width-100">
                                                        <!-- STATUS ICON & OCCUPANCY -->
                                                        <div class="d-flex align-center gap-3">
                                                            <MudIcon Icon="@GetRoomStatusIcon(currentRoom)" 
                                                                    Color="@GetRoomStatusColor(currentRoom)" 
                                                                    Size="Size.Small" />
                                                            
                                                            <MudText Typo="Typo.body2" Style="font-weight: 500; opacity: 0.7;">
                                                                #@currentRoom.AlloggioPk
                                                            </MudText>

                                                            <MudChip T="string" Size="Size.Small" 
                                                                     Color="@GetRoomStatusColor(currentRoom)" 
                                                                     Variant="Variant.Text" 
                                                                     Class="mud-chip-dense">
                                                                @currentRoom.Occupanti.Count/@currentRoom.MaxOccupanti
                                                            </MudChip>
                                                        </div>

                                                        <!-- ACTIONS -->
                                                        <div class="action-buttons opacity-fade d-flex align-center">
                                                            <MudTooltip Text="Modifica abbinamenti">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                                               Color="Color.Primary" 
                                                                               Size="Size.Small"
                                                                               OnClick="@(() => EditRoom(currentRoom))" />
                                                            </MudTooltip>
                                                            <MudTooltip Text="Elimina camera">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                                               Color="Color.Error" 
                                                                               Size="Size.Small"
                                                                               OnClick="@(() => DeleteRoom(currentRoom))" />
                                                            </MudTooltip>
                                                        </div>
                                                    </div>
                                                </CardHeaderContent>
                                            </MudCardHeader>
                                            <MudCardContent Class="pt-0 pb-2">
                                                @if (currentRoom.Occupanti.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                                        @foreach (var occupant in currentRoom.Occupanti.OrderBy(o => o.Nominativo))
                                                        {
                                                            <div class="d-flex align-center gap-1 px-2 py-1" style="background-color: var(--mud-palette-background); border-radius: 4px; border: 1px solid var(--mud-palette-table-lines);">
                                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="opacity: 0.5; font-size: 1rem;" />
                                                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                                                    @occupant.Nominativo
                                                                </MudText>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-flex align-center gap-1 mt-1">
                                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                                        Camera vuota
                                                    </MudText>
                                                }
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                }
                                </MudGrid>
                            </div>
                            <MudDivider Class="my-4" Light="true" />
                        }
                    </div>
                }
            </MudPaper>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int DataViaggioId { get; set; }
    [Parameter] public int ViaggioId { get; set; }
    [Parameter] public int AziendaId { get; set; }
    [Parameter] public string ViaggioTitle { get; set; } = "";

    // Room ViewModel
    public class RoomViewModel
    {
        public int AlloggioPk { get; set; }
        public int TipoAlloggioIdFk { get; set; }
        public string TipoDescrizione { get; set; } = "";
        public int MaxOccupanti { get; set; }
        public List<OccupantViewModel> Occupanti { get; set; } = new();
        public bool HasSupplemento { get; set; }
    }

    public class OccupantViewModel
    {
        public int ClienteId { get; set; }
        public string Nominativo { get; set; } = "";
        public string Ruolo { get; set; } = "";
    }

    // State
    private List<RoomViewModel> _rooms = new();
    private List<ParticipantsViewDTO> _allParticipants = new();
    private List<ParticipantsViewDTO> _unassignedParticipants = new();
    private List<TipoAlloggio> _tipoAlloggi = new();

    private bool _isLoadingRooms = true;
    // private bool _isLoadingParticipants = true; // Removed unused field

    private int _roomsCount = 0; // DB: get_rooms_count() - più efficiente di _rooms.Count

    private Dictionary<int, bool> _selectedParticipantIds = new();
    private string _viaggioTitle = "";

    [Parameter] public int? AutoOpenRoomId { get; set; }
    private RoomViewModel? _pendingAutoOpenRoom;
    private bool _autoOpenHandled = false;

    protected override async Task OnInitializedAsync()
    {
        _viaggioTitle = ViaggioTitle;
        await LoadLookupsAsync();
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAutoOpenRoom != null)
        {
            var room = _pendingAutoOpenRoom;
            _pendingAutoOpenRoom = null;
            // Small delay to ensure UI transition is smooth
            await Task.Delay(50); 
            await EditRoom(room);

            // Auto-close parent dialog to return to main list
            MudDialog.Close(DialogResult.Ok(true));
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadLookupsAsync()
    {
        // ⚠️ Solo i tipi ammessi da QUESTA partenza, non il catalogo intero: un viaggio in
        // albergo non deve proporre tende, uno in tenda non deve proporre matrimoniali.
        // Offrire tutto e' cio' che ha prodotto le 17 assegnazioni incoerenti trovate in
        // produzione, e venivano proprio da qui.
        _tipoAlloggi = await TipoAlloggioService.GetAmmessiPerPartenzaAsync(DataViaggioId);
    }

    private async Task LoadDataAsync()
    {
        // Load participants first, then rooms (rooms need participants data)
        await LoadParticipantsAsync();
        await LoadRoomsAsync();
    }

    private async Task LoadRoomsAsync()
    {
        _isLoadingRooms = true;
        try
        {
            var alloggi = await AlloggiService.GetByDateIdAsync(DataViaggioId);
            _rooms.Clear();

            foreach (var alloggio in alloggi)
            {
                var tipoAlloggio = _tipoAlloggi.FirstOrDefault(t => t.Id == alloggio.TipoAlloggioIdFk);
                if (tipoAlloggio == null) continue;

                var room = new RoomViewModel
                {
                    AlloggioPk = alloggio.MovClientiAlloggioPk,
                    TipoAlloggioIdFk = alloggio.TipoAlloggioIdFk,
                    TipoDescrizione = tipoAlloggio.Descrizione,
                    MaxOccupanti = tipoAlloggio.NumeroOccupanti,
                    HasSupplemento = tipoAlloggio.Supplemento
                };

                // Load occupants
                var clientIds = new[] { alloggio.ClienteId1Fk, alloggio.ClienteId2Fk, alloggio.ClienteId3Fk,
                                       alloggio.ClienteId4Fk, alloggio.ClienteId5Fk, alloggio.ClienteId6Fk }
                    .Where(id => id.HasValue && id.Value > 0)
                    .Select(id => id!.Value)
                    .ToList();

                foreach (var clientId in clientIds)
                {
                    var participant = _allParticipants.FirstOrDefault(p => p.ClienteId == clientId);
                    if (participant != null)
                    {
                        room.Occupanti.Add(new OccupantViewModel
                        {
                            ClienteId = participant.ClienteId,
                            Nominativo = participant.Nominativo,
                            Ruolo = participant.Ruolo
                        });
                    }
                }

                _rooms.Add(room);
            }

            // Update unassigned participants after rooms are loaded
            UpdateUnassignedParticipants();

            // DB: get_rooms_count(p_data_viaggio_id)
            // → Returns: Conteggio totale camere (più efficiente di _rooms.Count)
            _roomsCount = await AlloggiService.GetRoomsCountAsync(DataViaggioId);

            if (AutoOpenRoomId.HasValue && !_autoOpenHandled)
            {
                _pendingAutoOpenRoom = _rooms.FirstOrDefault(r => r.AlloggioPk == AutoOpenRoomId.Value);
                if (_pendingAutoOpenRoom != null)
                {
                    _autoOpenHandled = true;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento camere: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingRooms = false;
        }
    }

    private async Task LoadParticipantsAsync()
    {
        // _isLoadingParticipants = true;
        try
        {
            _allParticipants = (await MovClientiService.GetParticipantsViewAsync(DataViaggioId)).ToList();
            // Don't call UpdateUnassignedParticipants here - rooms are not loaded yet
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento partecipanti: {ex.Message}", Severity.Error);
        }
        finally
        {
            // _isLoadingParticipants = false;
        }
    }

    private void UpdateUnassignedParticipants()
    {
        var assignedClientIds = _rooms.SelectMany(r => r.Occupanti.Select(o => o.ClienteId)).ToHashSet();
        _unassignedParticipants = _allParticipants.Where(p => !assignedClientIds.Contains(p.ClienteId)).ToList();

        // Update selection dictionary
        _selectedParticipantIds = _unassignedParticipants.ToDictionary(p => p.ClienteId, p => false);
    }

    private async Task CreateNewRoom()
    {
        var parameters = new DialogParameters
        {
            { "Room", new MovClientiAlloggi { ViaggioIdFk = ViaggioId, DataViaggioIdFk = DataViaggioId, TipoAlloggioIdFk = 0 } },
            { "Occupants", new List<OccupantViewModel>() },
            { "TipoAlloggi", _tipoAlloggi },
            { "AllParticipants", _allParticipants },
            { "ExistingRooms", _rooms }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ViaggioAlloggiEditDialog>("Nuova Camera", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is not null)
        {
            await SaveRoomFromData(result.Data!);
        }
    }

    private async Task EditRoom(RoomViewModel room)
    {
        // Construct logic to map RoomViewModel to MovClientiAlloggi if needed, or pass directly.
        // The dialog expects MovClientiAlloggi. _rooms contains RoomViewModel which has AlloggioPk.
        // We might need to fetch the entity or construct it.
        // Let's create a temp MovClientiAlloggi from ViewModel:
        var entity = new MovClientiAlloggi 
        { 
            MovClientiAlloggioPk = room.AlloggioPk, 
            ViaggioIdFk = ViaggioId, 
            DataViaggioIdFk = DataViaggioId,
            TipoAlloggioIdFk = room.TipoAlloggioIdFk,
            // Note: Occupants are passed separately
        };
        var occupants = room.Occupanti.ToList(); // clone existing

        var parameters = new DialogParameters
        {
            { "Room", entity },
            { "Occupants", occupants },
            { "TipoAlloggi", _tipoAlloggi },
            { "AllParticipants", _allParticipants },
            { "ExistingRooms", _rooms }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ViaggioAlloggiEditDialog>("Modifica Camera", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is not null)
        {
            await SaveRoomFromData(result.Data!);
        }
    }

    private async Task DeleteRoom(RoomViewModel room)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Conferma Eliminazione",
            $"Eliminare questa camera? Gli occupanti verranno liberati e potranno essere riassegnati.",
            yesText: "Elimina", cancelText: "Annulla");

        if (result == true)
        {
            try
            {
                await AlloggiService.RemoveAccommodationAsync(room.AlloggioPk);
                Snackbar.Add("Camera eliminata con successo", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task SaveRoomFromData(dynamic data)
    {
        try
        {
            MovClientiAlloggi room = data.Room;
            List<OccupantViewModel> occupants = data.Occupants;

            // Map occupants to ClienteId fields
            room.ClienteId1Fk = occupants.ElementAtOrDefault(0)?.ClienteId;
            room.ClienteId2Fk = occupants.ElementAtOrDefault(1)?.ClienteId;
            room.ClienteId3Fk = occupants.ElementAtOrDefault(2)?.ClienteId;
            room.ClienteId4Fk = occupants.ElementAtOrDefault(3)?.ClienteId;
            room.ClienteId5Fk = occupants.ElementAtOrDefault(4)?.ClienteId;
            room.ClienteId6Fk = occupants.ElementAtOrDefault(5)?.ClienteId;

            if (room.MovClientiAlloggioPk > 0)
            {
                await AlloggiService.UpdateAccommodationAsync(room);
                Snackbar.Add("Camera aggiornata con successo", Severity.Success);
            }
            else
            {
                await AlloggiService.AddAccommodationAsync(room);
                Snackbar.Add("Camera creata con successo", Severity.Success);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private int SuggestAccommodationType(int participantsCount)
    {
        if (participantsCount == 2)
        {
            var matrimoniale = _tipoAlloggi
                .FirstOrDefault(t => t.Descrizione.Contains("MATRIMONIALE", StringComparison.OrdinalIgnoreCase));
            if (matrimoniale != null) return matrimoniale.Id;
        }

        var suitable = _tipoAlloggi
            .Where(t => t.NumeroOccupanti >= participantsCount)
            .OrderBy(t => t.NumeroOccupanti)
            .ThenBy(t => t.Supplemento ? 1 : 0)
            .FirstOrDefault();

        return suitable?.Id ?? 0;
    }

    private Color GetRoomStatusColor(RoomViewModel room)
    {
        if (room.Occupanti.Count == 0) return Color.Error;
        if (room.Occupanti.Count == room.MaxOccupanti) return Color.Success;
        return Color.Warning;
    }

    private string GetRoomStatusIcon(RoomViewModel room)
    {
        if (room.Occupanti.Count == 0) return "❌";
        if (room.Occupanti.Count == room.MaxOccupanti) return "✓";
        return "⚠️";
    }

    private void Close() => MudDialog.Cancel();
}
