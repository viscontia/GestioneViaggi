@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using MudBlazor
@inject WebTourContenutiService ContenutiService
@inject WebTourItinerarioService ItinerarioService
@inject WebTourItinerarioPassaggiService PassaggiService
@inject WebTourImmaginiService ImmaginiService
@inject WebTourMappaService MappaService
@inject WebTraduzioniService TraduzioniService
@inject GestioneViaggi.Services.Shared.Ai.ClaudeTranslationClient ClaudeClient

@* Anteprima del contenuto web di un'edizione (Blocco 13): rende l'editoriale come apparirà sul sito.
   Di norma in italiano; si può passare a una lingua tradotta per una verifica d'insieme, ma solo se
   quella lingua è completa e approvata — mostrare un'anteprima mezza tradotta ingannerebbe più che
   aiutare. *@

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
        }
        else if (_contenuto == null)
        {
            <MudAlert Severity="Severity.Error">Contenuto non trovato.</MudAlert>
        }
        else
        {
            <div style="max-width:760px;">
                <div class="d-flex align-center gap-2 flex-wrap mb-3">
                    <MudTooltip Text="@TooltipLingua" Disabled="@(_lingueComplete.Count > 0)">
                        <MudSelect T="string" Value="@_lingua" ValueChanged="OnLinguaChanged" Label="Lingua anteprima"
                                   Dense="true" Variant="Variant.Outlined" Style="min-width:200px;"
                                   Disabled="@(_lingueComplete.Count == 0)">
                            <MudSelectItem T="string" Value="@("IT")">Italiano (originale)</MudSelectItem>
                            @foreach (var l in _lingueComplete)
                            {
                                <MudSelectItem T="string" Value="@l">@NomeLingua(l)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTooltip>
                    @if (_lingua != "IT")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Translate">
                            Traduzione approvata
                        </MudChip>
                    }
                </div>

                @* Le date non fanno parte del contenuto (si lavora sul viaggio, non sul calendario),
                   ma vedere che non ci sono partenze in programma evita di curare la scheda di un
                   viaggio che nessuno può prenotare. *@
                <MudAlert Severity="@(_partenze.Count > 0 ? Severity.Normal : Severity.Warning)" Dense="true" Class="mb-3">
                    @if (_partenze.Count == 0)
                    {
                        <span>Nessuna data in calendario per le prossime partenze di questo viaggio.</span>
                    }
                    else
                    {
                        <div>
                            <b>Prossime partenze in programma per questo viaggio:</b>
                            <div class="d-flex gap-2 flex-wrap mt-1">
                                @foreach (var p in _partenze)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(p.EQuestaEdizione ? Color.Primary : Color.Default)"
                                             Icon="@(p.EQuestaEdizione ? Icons.Material.Filled.Star : null)">
                                        @($"{p.DataInizio:dd/MM/yyyy} – {p.DataFine:dd/MM/yyyy}")
                                    </MudChip>
                                }
                            </div>
                        </div>
                    }
                </MudAlert>

                @if (!string.IsNullOrWhiteSpace(Sottotitolo))
                {
                    <MudText Typo="Typo.h6" Class="mb-1">@Sottotitolo</MudText>
                }
                <div class="d-flex gap-2 flex-wrap mb-2">
                    @if (!string.IsNullOrWhiteSpace(DurataTesto))
                    {
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Schedule">@DurataTesto</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="@(_contenuto.StatoPubblicazione == "pubblicato" ? Color.Success : Color.Default)">@_contenuto.StatoPubblicazione</MudChip>
                </div>

                @if (Verifiche.Count > 0)
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-3">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Verifica contenuti</MudText>
                        <WebVerificheList Verifiche="@Verifiche" />
                    </MudPaper>
                }

                @if (_immaginePrincipale != null)
                {
                    <MudImage Src="@_immaginePrincipale.Url" Alt="@_immaginePrincipale.AltText" Fluid="true" Class="rounded mb-3" Style="max-height:280px;" />
                }

                @if (!string.IsNullOrWhiteSpace(DescrizioneHtml))
                {
                    <div class="mb-3">@((MarkupString)DescrizioneHtml!)</div>
                }
                @if (!string.IsNullOrWhiteSpace(LuoghiVisitati))
                {
                    <MudText Typo="Typo.body2" Class="mb-3"><strong>Luoghi:</strong> @LuoghiVisitati</MudText>
                }

                @if (_giornate.Count > 0)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Itinerario</MudText>
                    @foreach (var g in _giornate)
                    {
                        <MudText Typo="Typo.subtitle2">@TitoloGiornata(g)</MudText>
                        @if (_passi.TryGetValue(g.WebTourItinerarioId, out var passi))
                        {
                            foreach (var p in passi)
                            {
                                <div class="ml-3 mb-2">
                                    @{ var testoPasso = TestoPasso(p); }
                                    @if (!string.IsNullOrWhiteSpace(testoPasso)) { <div>@((MarkupString)testoPasso!)</div> }
                                    @if (!string.IsNullOrWhiteSpace(p.ImmagineUrl))
                                    {
                                        <MudImage Src="@p.ImmagineUrl" Alt="@p.ImmagineDidascalia" Fluid="true" Class="rounded mt-1" Style="max-height:180px;" />
                                    }
                                </div>
                            }
                        }
                    }
                }

                @if (_galleria.Count > 0)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Galleria</MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var img in _galleria)
                        {
                            <MudImage Src="@img.Url" Alt="@img.AltText" Width="120" Height="90" ObjectFit="ObjectFit.Cover" Class="rounded" />
                        }
                    </div>
                }

                @* Mappe in ordine (prima l'intero viaggio, poi le giornate) con la loro descrizione.
                   Dove andranno di preciso su sito e flyer si decide quando si faranno: qui si
                   verifica solo che ci siano e che l'abbinamento sia leggibile. *@
                @if (_mappe.Any(m => !string.IsNullOrWhiteSpace(m.ImmagineUrl)))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@(_mappe.Count > 1 ? "Mappe" : "Mappa")</MudText>
                    @foreach (var m in _mappe.Where(m => !string.IsNullOrWhiteSpace(m.ImmagineUrl)))
                    {
                        <div class="mb-3">
                            @{ var descMappa = DescrizioneMappa(m); }
                            @if (!string.IsNullOrWhiteSpace(descMappa))
                            {
                                <MudText Typo="Typo.body2" Class="mb-1"><b>@descMappa</b></MudText>
                            }
                            <MudImage Src="@m.ImmagineUrl" Alt="@(m.Descrizione ?? "Mappa del tour")" Fluid="true" Class="rounded" Style="max-height:320px;" />
                        </div>
                    }
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    /// <summary>Verifiche non bloccanti calcolate dal parent: mentre guardi come verrà, vedi anche cosa manca.</summary>
    [Parameter] public IReadOnlyList<Verifica> Verifiche { get; set; } = Array.Empty<Verifica>();

    private bool _loading = true;
    private WebTourContenuto? _contenuto;
    private List<WebTourItinerario> _giornate = new();
    private readonly Dictionary<long, List<WebTourItinerarioPassaggio>> _passi = new();
    private List<WebTourImmagine> _galleria = new();
    private WebTourImmagine? _immaginePrincipale;
    private List<WebTourMappa> _mappe = new();
    private List<PartenzaProgrammata> _partenze = new();
    private List<TraduzioneCampo> _traduzioni = new();
    private List<string> _lingueComplete = new();
    private string _lingua = "IT";

    /// <summary>Traduzioni approvate della lingua scelta, indicizzate per (entita, id, campo).</summary>
    private Dictionary<(string, long, string), string> _testiLingua = new();

    private static string NomeLingua(string codice)
        => GestioneViaggi.Services.Shared.Ai.ClaudeTranslationClient.LanguageName(codice) is { } nome
           ? char.ToUpperInvariant(nome[0]) + nome[1..]
           : codice;

    private string TooltipLingua => _lingueComplete.Count > 0
        ? "Scegli la lingua in cui vedere l'anteprima."
        : "Nessuna lingua disponibile: completa e conferma le traduzioni per poter vedere l'anteprima in un'altra lingua.";

    // Campi mostrati: in italiano quelli originali, altrimenti la traduzione approvata.
    private string? Sottotitolo => Tradotto("web_tour_contenuti", _contenuto!.WebTourContenutoId, "sottotitolo", _contenuto.Sottotitolo);
    private string? DurataTesto => Tradotto("web_tour_contenuti", _contenuto!.WebTourContenutoId, "durata_testo", _contenuto.DurataTesto);
    private string? LuoghiVisitati => Tradotto("web_tour_contenuti", _contenuto!.WebTourContenutoId, "luoghi_visitati", _contenuto.LuoghiVisitati);
    private string? DescrizioneHtml => Tradotto("web_tour_contenuti", _contenuto!.WebTourContenutoId, "descrizione_html", _contenuto.DescrizioneHtml);

    private string? TitoloGiornata(WebTourItinerario g)
        => Tradotto("web_tour_itinerario", g.WebTourItinerarioId, "titolo_giornata", g.TitoloGiornata);

    private string? TestoPasso(WebTourItinerarioPassaggio p)
        => Tradotto("web_tour_itinerario_passaggi", p.WebTourItinerarioPassaggioId, "testo_html", p.TestoHtml);

    private string? DescrizioneMappa(WebTourMappa m)
        => Tradotto("web_tour_mappa", m.WebTourMappaId, "descrizione", m.Descrizione);

    /// <summary>Testo nella lingua scelta; se manca (o si è in italiano) resta l'originale.</summary>
    private string? Tradotto(string entita, long entitaId, string campo, string? originale)
        => _lingua == "IT" ? originale
         : _testiLingua.TryGetValue((entita, entitaId, campo), out var t) ? t
         : originale;

    private void OnLinguaChanged(string lingua)
    {
        _lingua = lingua;
        _testiLingua = _lingua == "IT"
            ? new()
            : _traduzioni.Where(t => t.Lingua == _lingua && t.Revisionato && !t.Obsoleto)
                         .ToDictionary(t => (t.Entita, t.EntitaId, t.Campo), t => t.Testo);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _contenuto = await ContenutiService.GetByIdAsync(ContenutoId, AziendaId);
            if (_contenuto == null) return;

            _giornate = await ItinerarioService.ListByContenutoAsync(ContenutoId, AziendaId);
            foreach (var g in _giornate)
                _passi[g.WebTourItinerarioId] = await PassaggiService.ListByItinerarioAsync(g.WebTourItinerarioId, AziendaId);

            var immagini = await ImmaginiService.ListByContenutoAsync(ContenutoId, AziendaId);
            _immaginePrincipale = immagini.FirstOrDefault(i => i.Tipo == "principale");
            _galleria = immagini.Where(i => i.Tipo != "principale").ToList();

            _mappe = await MappaService.ListByContenutoAsync(ContenutoId, AziendaId);
            _partenze = await ContenutiService.GetProssimePartenzeAsync(ContenutoId, AziendaId);

            // Una lingua è selezionabile solo se OGNI campo traducibile è tradotto, revisionato e non
            // obsoleto: un'anteprima a metà in lingua straniera confonderebbe invece di aiutare.
            _traduzioni = await TraduzioniService.ListByContenutoAsync(ContenutoId, AziendaId);

            // Il totale atteso viene dai campi TRADUCIBILI, non dalle traduzioni presenti: un campo
            // mai tradotto in nessuna lingua non comparirebbe fra queste ultime e sparirebbe dal
            // denominatore, facendo risultare "completa" una lingua a cui manca proprio quel campo.
            var stato = await ContenutiService.GetStatoSezioniAsync(
                ContenutoId, AziendaId, WebTraduzioneOrchestratorService.Lingue);
            var attesi = stato?.ItemTraducibili ?? 0;
            _lingueComplete = attesi == 0
                ? new()
                : _traduzioni.Where(t => t.Revisionato && !t.Obsoleto)
                             .GroupBy(t => t.Lingua)
                             .Where(g => g.Select(t => (t.Entita, t.EntitaId, t.Campo)).Distinct().Count() >= attesi)
                             .Select(g => g.Key)
                             .OrderBy(l => l)
                             .ToList();
        }
        catch { /* anteprima best-effort */ }
        finally { _loading = false; }
    }
}
