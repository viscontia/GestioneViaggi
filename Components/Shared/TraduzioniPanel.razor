@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using Microsoft.Extensions.Logging
@using MudBlazor
@inject WebTraduzioneOrchestratorService Orchestrator
@inject WebTraduzioniService Traduzioni
@inject ISnackbar Snackbar
@inject ILogger<TraduzioniPanel> Logger
@implements IDisposable

@* Le lingue di un gruppo di testi qualunque (scheda «Sito web» dell'azienda: Home, e poi Chi siamo,
   FAQ, testi legali). Stesso aspetto e stesso comportamento del pannello della newsletter
   (NewsletterTraduzioniPanel), che resta com'è: chi ospita il pannello gli passa i testi da
   tradurre, lo stato per lingua si calcola dalle traduzioni di quei testi, e a tradurre è
   l'orchestratore di sempre (solo ciò che manca o è obsoleto: le traduzioni riviste non si toccano).

   Il ripiego del sito è per CAMPO: dove una traduzione manca o è obsoleta, quel campo è in italiano. *@

<MudPaper Outlined="true" Class="@($"pa-3 {Class}")">
    <div class="d-flex align-center gap-2 mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Translate" Color="Color.Primary" />
        <MudText Typo="Typo.subtitle2">Lingue</MudText>
        <MudSpacer />
        <MudTooltip Text="@PercheSpento" Disabled="@(PercheSpento is null)">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoAwesome"
                       Disabled="@(Disabilitato || _inCorso || (!CeQualcosaDaFare && !InAttesaDiSalvataggio))" OnClick="Traduci">
                Traduci quello che manca
            </MudButton>
        </MudTooltip>
    </div>

    @if (_inCorso)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">@_avanzamento</MudText>
    }

    <div class="d-flex flex-wrap gap-2 mb-1">
        @foreach (var s in _stato)
        {
            <MudTooltip Text="@Spiega(s)">
                <MudChip T="string" Size="Size.Small" Color="@Colore(s)" Icon="@Icona(s)">
                    @s.Lingua @s.Tradotti/@s.Traducibili
                </MudChip>
            </MudTooltip>
        }
    </div>

    @if (_stato.Any(x => x.DaRifare))
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
            Alcuni testi italiani sono cambiati dopo la traduzione: sul sito, per <strong>quei campi</strong>,
            si vede l'italiano. Ritraduci per riallinearli.
        </MudAlert>
    }

    @if (_esito is not null)
    {
        <MudText Typo="Typo.caption" Class="d-block mt-2" Style="font-weight:500;">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mr-1" />@_esito
        </MudText>
    }

    @if (!string.IsNullOrWhiteSpace(Nota))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">@Nota</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public int AziendaId { get; set; }

    /// <summary>
    /// I testi da tradurre, già compilati in italiano (quelli vuoti non si contano: un campo vuoto non
    /// è una traduzione mancante).
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyList<TranslatableItem> Elementi { get; set; } = Array.Empty<TranslatableItem>();

    /// <summary>Cambia quando i testi italiani cambiano (salvataggio): il pannello rilegge lo stato.</summary>
    [Parameter] public int Revisione { get; set; }

    /// <summary>Vero quando ci sono modifiche non salvate: si traduce ciò che è nel database, non la bozza.</summary>
    [Parameter] public bool Disabilitato { get; set; }
    [Parameter] public string? MotivoDisabilitato { get; set; }

    /// <summary>
    /// Facoltativo: eseguito prima di tradurre (per esempio: salvare le modifiche). Restituisce i testi
    /// da tradurre aggiornati, oppure null per non tradurre (il motivo lo ha già detto chi ospita).
    /// </summary>
    [Parameter] public Func<Task<IReadOnlyList<TranslatableItem>?>>? PrimaDiTradurre { get; set; }

    /// <summary>Il suggerimento del bottone quando c'è un passo prima di tradurre (es. «Salva le modifiche e traduce»).</summary>
    [Parameter] public string? SpiegaPrimaDiTradurre { get; set; }

    [Parameter] public string? Nota { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnTradotto { get; set; }

    private List<StatoLinguaTraduzioni> _stato = new();
    private bool _inCorso;
    private string _avanzamento = "";
    private string? _esito;
    private int _revisioneCaricata = -1;
    private int _aziendaCaricata;
    private bool _smontato;

    public void Dispose() => _smontato = true;

    // Dopo «PrimaDiTradurre» (che salva) chi ospita non si è ancora ridisegnato: i suoi Elementi sono quelli di prima
    // del salvataggio — con un testo appena scritto, nessuno: contatori a «0/0» dopo una traduzione riuscita (prova di
    // Adriano, Chi siamo, 2026-10-27). Si usano quelli restituiti, finché non arriva la revisione nuova.
    private IReadOnlyList<TranslatableItem>? _elementiAggiornati;
    private IReadOnlyList<TranslatableItem> ElementiCorrenti => _elementiAggiornati ?? Elementi;

    private bool CeQualcosaDaFare => _stato.Any(s => s.Mancanti > 0 || s.Obsoleti > 0);

    /// <summary>Vero se chi ospita ha modifiche da salvare prima di tradurre (il bottone resta acceso).</summary>
    [Parameter] public bool InAttesaDiSalvataggio { get; set; }

    private string? PercheSpento =>
        Disabilitato ? (MotivoDisabilitato ?? "Salva prima le modifiche: si traduce ciò che è salvato.")
        : _inCorso ? null
        : InAttesaDiSalvataggio ? SpiegaPrimaDiTradurre
        : ElementiCorrenti.Count == 0 ? "Non c'è testo da tradurre: i campi sono vuoti."
        : !CeQualcosaDaFare ? "Tutte le lingue sono a posto: non c'è niente da tradurre."
        : null;

    // Come nel pannello della newsletter: OnParametersSetAsync scatta a ogni ridisegno del genitore,
    // quindi si rilegge solo quando cambiano azienda o revisione dei testi.
    protected override async Task OnParametersSetAsync()
    {
        if (AziendaId == 0) return;
        if (AziendaId == _aziendaCaricata && Revisione == _revisioneCaricata) return;
        if (AziendaId != _aziendaCaricata) _esito = null;
        _aziendaCaricata = AziendaId;
        _revisioneCaricata = Revisione;
        _elementiAggiornati = null;   // chi ospita ha passato i testi nuovi
        await RicaricaAsync();
    }

    private async Task RicaricaAsync()
    {
        try { _stato = await CalcolaStatoAsync(); }
        catch (Exception ex) { Snackbar.Add($"Stato traduzioni non letto: {ex.Message}", Severity.Error); }
    }

    private Task<List<StatoLinguaTraduzioni>> CalcolaStatoAsync() => Traduzioni.StatoAsync(AziendaId, ElementiCorrenti);

    private async Task Traduci()
    {
        _inCorso = true;
        _avanzamento = "Raccolta dei testi…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var elementi = Elementi;
            if (PrimaDiTradurre is not null)
            {
                var aggiornati = await PrimaDiTradurre();
                if (aggiornati is null) return;
                elementi = aggiornati;
                _elementiAggiornati = aggiornati;
                await RicaricaAsync();
            }
            if (elementi.Count == 0)
            {
                Snackbar.Add("Non c'è testo da tradurre: i campi sono vuoti.", Severity.Info);
                return;
            }

            var fatti = 0;
            var progress = new Progress<string>(t =>
            {
                _avanzamento = t;
                var vaiDiStato = (++fatti % 4) == 0;
                _ = InvokeAsync(async () =>
                {
                    if (_smontato) return;
                    if (vaiDiStato) { try { await RicaricaAsync(); } catch { } }
                    StateHasChanged();
                });
            });
            var (ok, errori, markup, saltate) = await Orchestrator.TranslateAsync(
                AziendaId, elementi, WebTraduzioneOrchestratorService.Lingue, progress);

            await RicaricaAsync();
            await OnTradotto.InvokeAsync();

            var msg = $"Tradotti {ok} testi";
            if (saltate > 0) msg += $", {saltate} già a posto";
            if (errori > 0) msg += $", {errori} non riusciti";
            _esito = $"{DateTime.Now:HH:mm} — {msg}.";
            Logger.LogInformation("Traduzione testi del sito (azienda {Az}): {Esito}", AziendaId, msg);
            Snackbar.Add(msg + ".", errori > 0 ? Severity.Warning : Severity.Success);
            if (markup > 0)
                Snackbar.Add($"{markup} testi con formattazione da ricontrollare: la traduzione c'è, ma i tag potrebbero essere cambiati.", Severity.Warning);
        }
        catch (Exception ex)
        {
            _esito = $"{DateTime.Now:HH:mm} — traduzione non riuscita: {ex.Message}";
            Logger.LogError(ex, "Traduzione testi del sito (azienda {Az}) fallita", AziendaId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _inCorso = false;
            _avanzamento = "";
            if (!_smontato) await InvokeAsync(StateHasChanged);
        }
    }

    private static Color Colore(StatoLinguaTraduzioni s) =>
        s.DaRifare ? Color.Warning : s.Traducibili > 0 && s.Completa ? Color.Success : s.Tradotti > 0 ? Color.Info : Color.Default;

    private static string Icona(StatoLinguaTraduzioni s) =>
        s.DaRifare ? Icons.Material.Filled.Update
        : s.Traducibili > 0 && s.Completa ? Icons.Material.Filled.CheckCircle
        : Icons.Material.Filled.RadioButtonUnchecked;

    private static string Spiega(StatoLinguaTraduzioni s)
    {
        if (s.Traducibili == 0) return "Non c'è testo da tradurre.";
        if (s.DaRifare) return $"{s.Obsoleti} testi sono cambiati in italiano dopo la traduzione: sul sito, per quei campi, si vede l'italiano.";
        if (s.Completa) return "Tutti i testi sono tradotti.";
        if (s.Tradotti == 0) return "Nessun testo tradotto: chi visita il sito in questa lingua vedrà l'italiano.";
        return $"{s.Mancanti} testi non tradotti: sul sito quei campi saranno in italiano.";
    }
}
