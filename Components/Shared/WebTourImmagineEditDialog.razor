@using GestioneViaggi.Models.Web
@using MudBlazor

@* Modifica alt/titolo di un'immagine di galleria (Blocco 7). In dialog per non mettere
   campi editabili dentro una card trascinabile (conflitto puntatore col DnD).
   ECCEZIONE UI: alt/titolo NON in maiuscolo forzato (destinati al sito). *@

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_titolo" Label="Titolo (opzionale)" Variant="Variant.Outlined"
                      MaxLength="255" AutoFocus="true" />
        <MudTextField @bind-Value="_alt" Label="Testo alternativo (alt, per accessibilità/SEO)" Variant="Variant.Outlined"
                      MaxLength="255" Lines="2" Class="mt-3"
                      HelperText="Descrive l'immagine per screen reader e motori di ricerca." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salva">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public WebTourImmagine Immagine { get; set; } = default!;

    private string? _titolo;
    private string? _alt;

    protected override void OnInitialized()
    {
        _titolo = Immagine.Titolo;
        _alt = Immagine.AltText;
    }

    private void Salva()
    {
        Immagine.Titolo = string.IsNullOrWhiteSpace(_titolo) ? null : _titolo.Trim();
        Immagine.AltText = string.IsNullOrWhiteSpace(_alt) ? null : _alt.Trim();
        MudDialog.Close(DialogResult.Ok(Immagine));
    }

    private void Cancel() => MudDialog.Cancel();
}
