@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Models
@using MudBlazor
@inject TipoAlloggioService TipoAlloggioService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Risoluzione Conflitto Alloggio</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Attenzione: Eliminando questo partecipante, la camera <strong>@ViolationData.RoomTypeDesc</strong> rimarrà sotto-occupata.
        </MudAlert>
        
        <MudText Typo="Typo.body2" Class="mb-2">
            Capacità richiesta: <strong>@ViolationData.RequiredSeats</strong><br/>
            Occupanti rimanenti: <strong>@ViolationData.RemainingOccupantsCount</strong>
             @if (!string.IsNullOrEmpty(SurvivorNames))
             {
                 <br/><span>(@SurvivorNames)</span>
             }
        </MudText>
        
        <MudText Typo="Typo.body1" Class="mt-4 mb-2" Style="font-weight:bold;">Come vuoi gestire i partecipanti rimasti?</MudText>

        <MudRadioGroup @bind-Value="_selectedOption" Class="d-flex flex-column gap-2">
            <MudRadio Value="@ResolutionOption.MoveToNewRoom" Color="Color.Primary">
                Sposta in una nuova camera
            </MudRadio>
            
            @if (_selectedOption == ResolutionOption.MoveToNewRoom)
            {
                <div class="ml-8 mb-2" style="max-width: 300px;">
                    <MudSelect T="int" Label="Seleziona Tipo Nuova Camera" 
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               @bind-Value="_selectedNewRoomTypeId" Required="true" RequiredError="Seleziona un tipo camera">
                        @foreach (var tipo in _tipoAlloggi)
                        {
                            <MudSelectItem Value="@tipo.Id">@tipo.Descrizione (@tipo.NumeroOccupanti posti)</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            }

            <MudRadio Value="@ResolutionOption.ParkWithoutRoom" Color="Color.Secondary">
                Rimuovi assegnazione camera (Parcheggia)
            </MudRadio>
            <MudText Typo="Typo.caption" Class="ml-8 text-muted">
                I partecipanti rimarranno senza camera assegnata e dovranno essere sistemati successivamente.
            </MudText>
        </MudRadioGroup>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla Eliminazione</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync">Conferma e Risolvi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public MovClientiAlloggiService.RoomConsistencyCheckResult ViolationData { get; set; } = default!;
    [Parameter] public string SurvivorNames { get; set; } = default!;

    private List<TipoAlloggio> _tipoAlloggi = new();
    private ResolutionOption _selectedOption = ResolutionOption.MoveToNewRoom;
    private int _selectedNewRoomTypeId;

    public enum ResolutionOption
    {
        MoveToNewRoom,
        ParkWithoutRoom
    }

    protected override async Task OnInitializedAsync()
    {
        // Carica tipi alloggio per il dropdown
        _tipoAlloggi = (await TipoAlloggioService.GetAllAsync()).OrderBy(x => x.Descrizione).ToList();
        
        // Pre-seleziona un tipo alloggio logico se possibile (es. Singola se rimane 1 persona)
        if (ViolationData.RemainingOccupantsCount == 1)
        {
            var singleRoom = _tipoAlloggi.FirstOrDefault(x => x.NumeroOccupanti == 1);
            if (singleRoom != null) _selectedNewRoomTypeId = singleRoom.Id;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void ConfirmAsync()
    {
        if (_selectedOption == ResolutionOption.MoveToNewRoom && _selectedNewRoomTypeId == 0)
        {
            // Validazione manuale semplice (mostra border red se MudSelect supportasse validazione esterna facile, 
            // ma qui blocchiamo e basta, magari con snackbar o return)
            // Essendo Required=true, speriamo MudSelect lo evidenzi. 
            // Ma per sicurezza non chiudiamo.
            return; 
        }

        MudDialog.Close(DialogResult.Ok(new RoomViolationResolutionResult 
        { 
            ResolutionType = _selectedOption,
            NewRoomTypeId = _selectedNewRoomTypeId
        }));
    }

    public class RoomViolationResolutionResult
    {
        public ResolutionOption ResolutionType { get; set; }
        public int NewRoomTypeId { get; set; }
    }
}
