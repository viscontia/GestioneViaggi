@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inherits BaseCrudDialog<Provincia>
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Provincia" : "Nuova Provincia")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <MudTextField @ref="_firstField"
                          Value="@Entity.Descrizione"
                          ValueChanged="@((string value) => HandleDescrizioneChanged(value))"
                          For="@(() => Entity.Descrizione)"
                          Label="Descrizione Provincia"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="La descrizione è obbligatoria"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          HelperText="Inserisci la denominazione ufficiale della provincia."
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnBlur="@(() => HandleFieldBlur(_firstField))"
                          OnKeyDown="@HandleKeyDown" />

            <MudTextField @ref="_siglaField"
                          Value="@Entity.Sigla"
                          ValueChanged="@((string value) => HandleSiglaChanged(value))"
                          For="@(() => Entity.Sigla)"
                          Label="Sigla Provincia"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="La sigla è obbligatoria"
                          MaxLength="2"
                          Class="mb-3 uppercase-input"
                          HelperText="Indica la sigla a due lettere della provincia (es. MI)."
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnBlur="@(() => HandleFieldBlur(_siglaField))"
                          OnKeyDown="@HandleKeyDown" />

            <RegioneSelect SelectedRegioneId="@Entity.RegioneIdFk"
                           SelectedRegioneIdChanged="@((int? value) => Entity.RegioneIdFk = value ?? 0)"
                           Required="true"
                           RequiredError="La regione è obbligatoria"
                           HelperText="Seleziona la regione amministrativa di riferimento."
                           Class="mb-3" />

            <MudNumericField @bind-Value="Entity.Superficie"
                             For="@(() => Entity.Superficie)"
                             Label="Superficie (kmq) - opzionale"
                             Variant="Variant.Outlined"
                             Min="0"
                             Culture="@(new System.Globalization.CultureInfo("it-IT"))"
                             Format="N2"
                             HelperText="Specifica la superficie totale in chilometri quadrati (opzionale)."
                             Class="mb-3" />

            <MudNumericField @bind-Value="Entity.Residenti"
                             For="@(() => Entity.Residenti)"
                             Label="Residenti - opzionale"
                             Variant="Variant.Outlined"
                             Min="0"
                             Culture="@(new System.Globalization.CultureInfo("it-IT"))"
                             Format="N0"
                             HelperText="Inserisci il numero stimato di residenti (opzionale)."
                             Class="mb-3" />

            <MudNumericField @bind-Value="Entity.NumeroComuni"
                             For="@(() => Entity.NumeroComuni)"
                             Label="Numero Comuni - opzionale"
                             Variant="Variant.Outlined"
                             Min="0"
                             Culture="@(new System.Globalization.CultureInfo("it-IT"))"
                             Format="N0"
                             HelperText="Indica il numero totale di comuni compresi nella provincia (opzionale)."
                             Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelDialog" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;
    private MudTextField<string>? _siglaField;

    [Parameter]
    public Provincia Entity { get; set; } = new Provincia();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation con JavaScript helper
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
                // Fallback: focus manuale
                if (_firstField != null)
                {
                    await Task.Delay(150);
                    await _firstField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        // Cleanup JavaScript handlers quando il dialog viene chiuso
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch
        {
            // Ignora errori su cleanup
        }
    }

    private void HandleDescrizioneChanged(string value)
    {
        Entity.Descrizione = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleSiglaChanged(string value)
    {
        Entity.Sigla = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private async Task HandleFieldBlur(MudTextField<string>? field)
    {
        if (field != null)
        {
            await field.Validate();
            if (field.Error)
            {
                await Task.Delay(150);
                try
                {
                    await field.FocusAsync();
                }
                catch
                {
                    // Ignora errori se il dialog è stato chiuso
                }
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                CloseDialog(DialogResult.Ok(Entity));
            }
            else
            {
                // Focus sul primo campo in errore
                if (_firstField?.Error == true)
                {
                    await _firstField.FocusAsync();
                }
                else if (_siglaField?.Error == true)
                {
                    await _siglaField.FocusAsync();
                }
            }
        }
    }
}
