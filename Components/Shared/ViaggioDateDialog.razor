@using GestioneViaggi.Models
@using MudBlazor

<style>
    /* Force Red Asterisk for Required Fields */
    .mud-input-control.mud-input-required .mud-input-label::after {
        content: " *";
        color: var(--mud-palette-error);
    }
</style>

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity" @bind-IsValid="@_isValid">
            <MudGrid Spacing="2">
                <!-- Date -->
                <MudItem xs="6">
                    <MudDatePicker @ref="_startDatePicker" Label="Data Inizio" Date="Entity.DataInizio" DateChanged="OnStartDateChanged"
                        Required="true" RequiredError="Campo obbligatorio" Editable="true" Variant="Variant.Outlined"
                        Mask="@(new DateMask("dd/MM/yyyy"))"
                        Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="Data Fine" Date="Entity.DataFine" DateChanged="OnEndDateChanged" Required="true"
                        RequiredError="Campo obbligatorio" Editable="true" Variant="Variant.Outlined"
                        Mask="@(new DateMask("dd/MM/yyyy"))"
                        Margin="Margin.Dense" 
                        HelperText="@GetDurationHelperText()"
                        Error="@IsDurationInvalid()"
                        ErrorText="@($"Durata errata: deve essere {DurationDays} gg")" />
                </MudItem>

                <!-- Stato -->
                <MudItem xs="12">
                    <MudCheckBox T="bool" Label="Viaggio Effettuato" Value="@(Entity.EffettuatoSino == "Y")"
                        ValueChanged="@(v => Entity.EffettuatoSino = v ? "Y" : "N")" Color="Color.Success">
                    </MudCheckBox>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" Light="true" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Costi Base</MudText>
                </MudItem>

                <!-- Costi Base -->
                <MudItem xs="6">
                    <MudNumericField @bind-Value="Entity.CostoPilota" Label="Costo Pilota" Required="true"
                        RequiredError="Campo obbligatorio" Variant="Variant.Outlined" Margin="Margin.Dense"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="Entity.CostoPasseggero" Label="Costo Passeggero" Required="true"
                        RequiredError="Campo obbligatorio" Variant="Variant.Outlined" Margin="Margin.Dense"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="Entity.CostoPasseggeroAutoGuida" Label="Costo Pass. Auto Guida"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" Light="true" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Costi Bambini</MudText>
                </MudItem>

                <!-- Costi Bambini -->
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Entity.CostoBambino02" Label="0-2 Anni" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Entity.CostoBambino26" Label="2-6 Anni" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Entity.CostoBambino612" Label="6-12 Anni" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
                </MudItem>

            </MudGrid>
            <MudTextField @bind-Value="Entity.Note" Label="Note" Variant="Variant.Outlined" Lines="2"
                Class="mt-3 uppercase-input" Converter="@_uppercaseConverter" Immediate="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Conferma</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    [Parameter] public AnaDataViaggio Entity { get; set; } = new();

    [Parameter] public int DurationDays { get; set; }

    // Converter to enforce Uppercase
    private Converter<string?> _uppercaseConverter = new Converter<string?>
        {
            SetFunc = value => value?.ToUpperInvariant(),
            GetFunc = text => text?.ToUpperInvariant()
        };

    private MudForm _form = default!;
    private MudDatePicker _startDatePicker = default!;
    private bool _isValid;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Small delay to ensure Dialog transition is complete
                await Task.Delay(150);
                await _startDatePicker.FocusAsync();
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch { /* Ignore JS errors/timing issues */ }
        }
    }

    private void OnStartDateChanged(DateTime? date)
    {
        Entity.DataInizio = date;
        if (date.HasValue && DurationDays > 0)
        {
            // Auto-Calculate End Date based on Duration
            Entity.DataFine = date.Value.AddDays(DurationDays - 1);
        }
    }

    private void OnEndDateChanged(DateTime? date)
    {
        Entity.DataFine = date;
        // Not auto-calculating Start Date to avoid circular or confusing behavior,
        // but the validation in Submit and the Error property will catch inconsistencies.
    }

    private string? GetDurationHelperText()
    {
        if (DurationDays <= 0) return null;
        return $"Durata fissa: {DurationDays} giorni";
    }

    private bool IsDurationInvalid()
    {
        if (DurationDays <= 0) return false;
        if (!Entity.DataInizio.HasValue || !Entity.DataFine.HasValue) return false;
        var duration = (Entity.DataFine.Value - Entity.DataInizio.Value).Days + 1;
        return duration != DurationDays;
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            // Validate Date Logic
            // Validate Date Logic
            if (Entity.DataInizio.HasValue && Entity.DataFine.HasValue)
            {
                if (Entity.DataFine < Entity.DataInizio)
                {
                    Snackbar.Add("La data di fine viaggio non può essere antecedente alla data di inizio.", Severity.Error);
                    return;
                }

                if (DurationDays > 0)
                {
                    // Strict Duration Check
                    var duration = (Entity.DataFine.Value - Entity.DataInizio.Value).Days + 1;
                    if (duration != DurationDays)
                    {
                        Snackbar.Add($"La durata del viaggio deve essere di {DurationDays} giorni (come da anagrafica). Attuale: {duration}",
                        Severity.Error);
                        return;
                    }
                }
            }

            // Validate Costs (must be positive?)
            // User just said "obbligatorio". Let's assume > 0 is expected for a trip cost, or at least >= 0.
            // If they mean "must be filled", and it's logic int/decimal, it's always "filled".
            // Let's assume they want non-zero or just visually flagged.
            // If the user says "edit lets me save but doesn't update", maybe the value IS updating but not saving to DB?
            // "Se li modifico mi lascia salvare, ma poi non fa l'update sul file"
            // This suggests the Update operation fails silently.
            // In ViaggioDatesManager, we use Entity.Clone().
            // If we clone, we break the reference.
            // In UpdateDateAsync (LiveMode), we pass the modified clone.
            // If the Clone doesn't copy the ID, then UpdateDateAsync might fail (ID=0).
            // Let's check Clone mechanism. BaseEntity.Clone uses MemberwiseClone. It SHOULD copy ID (int).

            MudDialog.Close(DialogResult.Ok(Entity));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
