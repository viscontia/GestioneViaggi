@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEditMode ? "Modifica Genere" : "Nuovo Genere")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <MudTextField T="string"
                          @ref="_firstField"
                          Value="@Entity.Descrizione"
                          ValueChanged="@((string val) => HandleDescrizioneChanged(val))"
                          For="@(() => Entity.Descrizione)"
                          Label="Descrizione"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="La descrizione è obbligatoria"
                          MaxLength="60"
                          tabindex="1"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnKeyDown="@HandleKeyDown" />

            <MudTextField T="string"
                          Value="@Entity.Codice"
                          ValueChanged="@((string val) => HandleCodiceChanged(val))"
                          For="@(() => Entity.Codice)"
                          Label="Codice"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il codice è obbligatorio"
                          MaxLength="20"
                          Disabled="@IsEditMode"
                          tabindex="2"
                          Class="mb-1 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnKeyDown="@HandleKeyDown" />

            @*
                Il codice non si modifica dopo la creazione: e' il nome con cui il
                programma riconosce il genere — NESSUNA, per dirne uno, ha un
                comportamento suo. Cambiarlo su una riga gia' usata romperebbe in
                silenzio le regole che ci si appoggiano.
            *@
            <MudText Typo="Typo.caption" Class="mb-3 d-block mud-text-secondary">
                @(IsEditMode
                    ? "Il codice non si può cambiare: è il nome con cui il programma riconosce il genere."
                    : "Il codice identifica il genere per il programma. Scegliere una parola breve, es. BUNGALOW.")
            </MudText>

            @* T esplicito: Ordine e' short, e Min/Max scritti come 1 e 99 sarebbero int. *@
            <MudNumericField T="short"
                             @bind-Value="Entity.Ordine"
                             For="@(() => Entity.Ordine)"
                             Label="Ordine di presentazione"
                             Variant="Variant.Outlined"
                             Min="@((short)1)" Max="@((short)99)"
                             tabindex="3"
                             Class="mb-3" />

            <MudCheckBox @bind-Value="Entity.Attivo"
                         Label="Attivo"
                         Color="Color.Primary"
                         tabindex="4"
                         Class="mb-1" />
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                Un genere disattivato non si può più scegliere, ma resta sui tipi
                di sistemazione che lo usano già.
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Annulla</MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public AlloggioGenere Entity { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); }
        catch (Exception ex) { Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}"); }

        if (_firstField != null)
        {
            await Task.Delay(300);
            try { await _firstField.FocusAsync(); }
            catch (Exception ex) { Console.WriteLine($"Errore focus: {ex.Message}"); }
        }
    }

    public void Dispose()
    {
        try { JS.InvokeVoidAsync("dialogFormHelper.cleanup"); } catch { }
    }

    private void Cancel() => MudDialog?.Cancel();

    private void HandleDescrizioneChanged(string value)
    {
        Entity.Descrizione = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleCodiceChanged(string value)
    {
        // Il codice lo usa il programma: niente spazi, sempre maiuscolo.
        Entity.Codice = (value ?? string.Empty).ToUpper().Replace(" ", "_");
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    private async Task HandleSubmit()
    {
        if (_form is null) return;
        await _form.Validate();
        if (_form.IsValid) MudDialog?.Close(DialogResult.Ok(Entity));
    }
}
