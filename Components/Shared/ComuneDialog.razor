@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Validation.Semantic
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ProvinciaService ProvinciaService
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Comune" : "Nuovo Comune")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <!-- Nome Comune - OBBLIGATORIO con UPPERCASE -->
            <MudTextField @ref="_firstField" Value="@Entity.Nome"
                ValueChanged="@((string val) => HandleNomeChanged(val))" For="@(() => Entity.Nome)" Label="Nome Comune"
                Variant="Variant.Outlined" Immediate="true" Required="true"
                RequiredError="Il nome del comune è obbligatorio" MaxLength="100" tabindex="1"
                Class="mb-3 uppercase-input" Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                OnBlur="@(() => HandleFieldBlur(_firstField))" OnKeyDown="@HandleKeyDown" />

            <!-- Checkbox Comune Estero -->
            <MudCheckBox Value="@Entity.ComuneEstero" ValueChanged="@((bool val) => HandleComuneEsteroChanged(val))"
                For="@(() => Entity.ComuneEstero)" Label="Comune Estero" Color="Color.Primary" tabindex="2"
                Class="mb-3" />

            <!-- Cod. ISTAT - Condizionalmente obbligatorio -->
            <MudTextField @bind-Value="Entity.CodIstat" For="@(() => Entity.CodIstat)" Label="@GetCodIstatLabel()"
                Variant="Variant.Outlined" Required="@(!Entity.ComuneEstero)"
                RequiredError="Il codice ISTAT è obbligatorio per i comuni italiani" Mask="@(new PatternMask("000000"))"
                MaxLength="6" tabindex="3" Class="mb-3" HelperText="Obbligatorio per Italia. 6 cifre (es: 001001)"
                Adornment="@(Entity.ComuneEstero ? Adornment.None : Adornment.End)"
                AdornmentText="@(Entity.ComuneEstero ? "" : "*")" AdornmentColor="Color.Error" />

            <!-- Pref. Telefonico - Condizionalmente obbligatorio -->
            <MudTextField @bind-Value="Entity.PrefTel" For="@(() => Entity.PrefTel)" Label="@GetPrefTelLabel()"
                Variant="Variant.Outlined" Required="@(!Entity.ComuneEstero)"
                RequiredError="Il prefisso è obbligatorio per i comuni italiani" Mask="@GetPrefTelMask()"
                MaxLength="4" tabindex="4" Class="mb-3"
                HelperText="Obbligatorio per Italia. 2-4 cifre (es: 02, 055, 0332)"
                Adornment="@(Entity.ComuneEstero ? Adornment.None : Adornment.End)"
                AdornmentText="@(Entity.ComuneEstero ? "" : "*")" AdornmentColor="Color.Error" Immediate="true" />

            <!-- CAP - Condizionalmente obbligatorio con MASK dinamica -->
            <MudTextField @bind-Value="Entity.Cap" For="@(() => Entity.Cap)" Label="@GetCapLabel()"
                Validation="@(new Func<string, IEnumerable<string>>(ValidateCap))"
                Variant="Variant.Outlined" Required="@(!Entity.ComuneEstero)"
                RequiredError="Il CAP è obbligatorio per i comuni italiani" Mask="@GetCapMask()"
                MaxLength="@GetCapMaxLength()" tabindex="5" Class="mb-3" HelperText="@GetCapHelperText()"
                Adornment="@(Entity.ComuneEstero ? Adornment.None : Adornment.End)"
                AdornmentText="@(Entity.ComuneEstero ? "" : "*")" AdornmentColor="Color.Error" Immediate="true" />

            <!-- Cod. Fiscale / Catastale - Condizionalmente obbligatorio -->
            <MudTextField @bind-Value="Entity.CodFiscale" For="@(() => Entity.CodFiscale)" Label="@GetCodFiscaleLabel()"
                Variant="Variant.Outlined" Required="@(!Entity.ComuneEstero)"
                RequiredError="Il codice è obbligatorio per i comuni italiani" 
                Mask="@(new PatternMask("L000"))" 
                MaxLength="4" tabindex="6"
                Class="mb-3 uppercase-input" HelperText="Obbligatorio per Italia. Es: H501"
                Adornment="@(Entity.ComuneEstero ? Adornment.None : Adornment.End)"
                AdornmentText="@(Entity.ComuneEstero ? "" : "*")" AdornmentColor="Color.Error" />


            <!-- Num. Abitanti - OBBLIGATORIO -->
            <MudNumericField @bind-Value="Entity.NumAbitanti" For="@(() => Entity.NumAbitanti)" Label="Numero Abitanti"
                Format="N0" Variant="Variant.Outlined" Required="true" RequiredError="Il numero di abitanti è obbligatorio"
                Min="10" tabindex="7" Class="mb-3" Adornment="Adornment.End"
                AdornmentText="*" AdornmentColor="Color.Error" HideSpinButtons="true" Immediate="true" />

            <!-- Link - Opzionale -->
            <MudTextField @bind-Value="Entity.Link" For="@(() => Entity.Link)" Label="Link Sito Web (opzionale)"
                Variant="Variant.Outlined" MaxLength="200" tabindex="8" Class="mb-3"
                HelperText="Inserire URL completo (es: https://www.esempio.it)" />

            <!-- Ripartizione Geografica FK - OBBLIGATORIO (auto-impostato se Estero) -->
            <RipGeoSelect SelectedRipGeoId="Entity.RipGeoIdFk" SelectedRipGeoIdChanged="@HandleRipGeoIdChanged" Label="Ripartizione Geografica" Required="true"
                RequiredError="La ripartizione geografica è obbligatoria" Disabled="@Entity.ComuneEstero"
                FilterEsteroOnly="@(Entity.ComuneEstero ? null : false)"
                HelperText="@(Entity.ComuneEstero ? "Se Comune Estero questo campo non è modificabile" : "Seleziona la ripartizione geografica corretta dall'elenco")"
                HelperTextError="@Entity.ComuneEstero" tabindex="@(Entity.ComuneEstero ? -1 : 9)" Class="mb-3" />

            <!-- Provincia FK - OBBLIGATORIO - Disabilitata se RipGeo non selezionata -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <ProvinciaSelect @key="_provinciaSelectKey" @bind-SelectedProvinciaId="Entity.ProvinciaIdFk"
                    Label="Provincia" Required="true" RequiredError="La provincia è obbligatoria"
                    FilterEsteroOnly="@Entity.ComuneEstero" Disabled="@(!Entity.RipGeoIdFk.HasValue)" tabindex="10"
                    Class="flex-grow-1" />
<MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OpenAddProvinciaDialog"
    Variant="Variant.Outlined" Size="Size.Small" title="Crea nuova provincia"
                    Disabled="@(!Entity.RipGeoIdFk.HasValue)" tabindex="-1" />
            </MudStack>

            <!-- Capoluogo FK - OBBLIGATORIO -->
            <CapoluogoSelect @bind-SelectedCapoluogoId="Entity.CapoluogoIdFk" Label="Capoluogo" Required="true"
                RequiredError="Il capoluogo è obbligatorio" tabindex="11" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;
    private int _provinciaSelectKey = 0;

    /// <summary>
    /// Proxy property per gestire input numerico mascherato come stringa.
    /// Risolve il problema del casting con MudTextField e Mask su tipi int?.
    /// </summary>
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public Comune Entity { get; set; } = new Comune();

    [Parameter]
    public bool IsEditMode { get; set; }

    private IEnumerable<string> ValidateCap(string value)
    {
        if (!Entity.ComuneEstero)
        {
            // Validazione ITALIA
            if (string.IsNullOrWhiteSpace(value))
            {
                yield return "Il CAP è obbligatorio per i comuni italiani";
                yield break;
            }

            var result = GeographicValidator.CheckCap(value);
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
        else
        {
            // Validazione ESTERO
            // Lunghezza massima già gestita da MaxLength e Mask
            if (!string.IsNullOrWhiteSpace(value) && value.Length > 12)
            {
                 yield return "Il CAP non può superare i 12 caratteri";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation con JavaScript helper
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }

            // Focus manuale sul primo campo (sempre, per sicurezza)
            // Delay maggiore per permettere rendering completo
            if (_firstField != null)
            {
                await Task.Delay(300);
                try
                {
                    await _firstField.FocusAsync();
                    Console.WriteLine("Focus manuale applicato al primo campo");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Errore focus manuale: {ex.Message}");
                }
            }
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void HandleNomeChanged(string value)
    {
        Entity.Nome = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private async Task HandleComuneEsteroChanged(bool value)
    {
        Entity.ComuneEstero = value;

        // Se è un comune estero, imposta automaticamente RipGeoIdFk = 6 (ESTERO)
        if (value)
        {
            Entity.RipGeoIdFk = 6; // ID di ESTERO nella tabella ana_geo_ita_ripgeo
        }

        // Forza la rivalutazione delle validazioni quando cambia il flag e renderizza l'UI
        StateHasChanged();

        // IMPORTANTE: Ricarica la navigazione TAB perché la lista dei campi attivi è cambiata
        // (RipGeoSelect è stato abilitato/disabilitato)
        try
        {
            await Task.Delay(150); // Attendi che MudBlazor renderizzi i cambiamenti nel DOM
            await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore aggiornamento navigazione TAB: {ex.Message}");
        }
    }

    private async Task HandleRipGeoIdChanged(int? ripGeoId)
    {
        Entity.RipGeoIdFk = ripGeoId;
        StateHasChanged();

        // Aggiorna il setup TAB perché la disponibilità del ProvinciaSelect è cambiata
        try
        {
            await Task.Delay(150);
            await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore aggiornamento navigazione TAB: {ex.Message}");
        }
    }

    private string GetCodIstatLabel()
    {
        return Entity.ComuneEstero ? "Codice ISTAT (opzionale)" : "Codice ISTAT";
    }

    private string GetCapLabel()
    {
        return Entity.ComuneEstero ? "CAP (opzionale)" : "CAP";
    }

    private string GetCodFiscaleLabel()
    {
        return Entity.ComuneEstero ? "Codice Fiscale (opzionale)" : "Codice Fiscale";
    }

    private string GetPrefTelLabel()
    {
        return Entity.ComuneEstero ? "Prefisso Telefonico (opzionale)" : "Prefisso Telefonico";
    }

    private IMask GetCapMask()
    {
        if (Entity.ComuneEstero)
            return new RegexMask(@"^[a-zA-Z0-9\-\s]*$"); // Alfanumerico libero per estero
        
        return new PatternMask("00000"); // 5 cifre fisso per Italia
    }

    private int GetCapMaxLength()
    {
        return Entity.ComuneEstero ? 12 : 5;
    }

    private string GetCapHelperText()
    {
        return Entity.ComuneEstero 
            ? "Opzionale. Max 12 caratteri (Alfanumerico)" 
            : "5 cifre numeriche (es: 00035). Supporta zero iniziale";
    }

    private IMask GetPrefTelMask()
    {
        if (Entity.ComuneEstero)
            return new RegexMask(@"^\d*$"); // Estero: Solo numeri, lunghezza libera
        
        // Italia: Deve iniziare con 0, max 4 cifre totali (0 + 3 cifre)
        // La regex accetta stringa vuota O stringa che inizia con 0 seguita da 0-3 cifre
        return new RegexMask(@"^(0\d{0,3})?$");
    }

    private async Task HandleFieldBlur(MudTextField<string>? field)
    {
        if (field != null)
        {
            // Normalizzazione specifica
            if (Entity.CodFiscale != null) Entity.CodFiscale = Entity.CodFiscale.ToUpper();
            
            await field.Validate();
            if (field.Error)
            {
                await Task.Delay(150);
                try
                {
                    await field.FocusAsync();
                }
                catch
                {
                    // Ignora errori se il dialog è stato chiuso
                }
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                // Validazione manuale per le regole condizionali
                var validationResults = Entity.Validate(new System.ComponentModel.DataAnnotations.ValidationContext(Entity));
                if (!validationResults.Any())
                {
                    MudDialog?.Close(DialogResult.Ok(Entity));
                }
                else
                {
                    // Se ci sono errori di validazione custom, focus sul primo campo
                    if (_firstField != null)
                    {
                        await _firstField.FocusAsync();
                    }
                }
            }
            else
            {
                if (_firstField?.Error == true)
                {
                    await _firstField.FocusAsync();
                }
            }
        }
    }

    private async Task OpenAddProvinciaDialog()
    {
        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false
            };

        // Apre il dialog della provincia in modalità CREAZIONE (Entity vuota)
        var parameters = new DialogParameters<ProvinciaDialog>
{
{ x => x.Entity, new Provincia() },
{ x => x.IsEditMode, false }
};

        var dialog = await DialogService.ShowAsync<ProvinciaDialog>("Nuova Provincia", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is Provincia tempProvincia)
        {
            try
            {
                // 1. Salva la nuova provincia nel database
                // Il dialog ritorna l'oggetto ma spetta al chiamante salvarlo (Pattern CRUD)
                var savedProvincia = await ProvinciaService.CreateAsync(tempProvincia);

                // 2. Forza il refresh del componente ProvinciaSelect incrementando la chiave
                _provinciaSelectKey++;

                // 3. Seleziona automaticamente la nuova provincia usando l'ID generato dal DB
                Entity.ProvinciaIdFk = savedProvincia.Id;

                Snackbar.Add("Provincia creata e selezionata con successo", Severity.Success);

                // 4. Notifica il cambiamento di stato
                StateHasChanged();

                // 5. Aggiorna la navigazione TAB nel caso ci siano cambiamenti nel DOM
                await Task.Delay(150);
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante il salvataggio della provincia: {ex.Message}", Severity.Error);
                Console.WriteLine($"Errore salvataggio provincia: {ex}");
            }
        }
    }

    public void Dispose()
    {
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch { }
    }
}
