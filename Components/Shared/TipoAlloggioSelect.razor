@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject TipoAlloggioService TipoAlloggioService

@*
    La tendina delle sistemazioni. Una sola, per tutto il gestionale.

    ⚠️ Prima erano TRE, disegnate a mano nell'Iscrizione Veloce, nella scheda Partecipanti e
    nella gestione alloggi, ognuna col suo elenco e persino con due nomi diversi per la stessa
    cosa («Tipo Sistemazione» e «Tipo Camera»). Tre copie vogliono dire tre fonti, e alla
    domanda «la tendina e' filtrata sul viaggio?» rispondevano in modo diverso: due si'
    e una no — quella dei Partecipanti, che offriva le camere d'albergo su un viaggio in
    tenda (prova D2, 2026-09-06).

    Qui dentro c'e' tutto quello che quella domanda richiede, in un posto solo:

    1. L'elenco viene da `fn_alloggi_tipi_ammessi`, che sa cosa la PARTENZA ammette. Non e'
       un catalogo fisso: un viaggio in albergo non offre tende, uno in tenda non offre
       matrimoniali.
    2. Cambiando partenza l'elenco si rilegge, e la scelta fatta prima **si azzera** se su
       quella nuova non e' piu' ammessa. Prima questa regola stava in una scheda sola.
    3. Posti e supplemento si vedono sempre allo stesso modo.

    Il nome e' «sistemazione», non «camera»: da quando esistono le tende, «camera» e' falso
    meta' delle volte.
*@

@* ⚠️ Il valore viaggia come int? e non come int: con int, «nessuna scelta» vale 0, e
   MudSelect non trovando nessuna voce con quel valore scriveva nel campo «0». Su una scheda
   appena aperta si leggeva «Tipo Sistemazione: 0», che non vuol dire niente. *@
<MudSelect T="int?"
           Label="@Label"
           Value="@(SelectedId > 0 ? SelectedId : null)"
           ValueChanged="@OnValueChanged"
           Variant="Variant.Outlined"
           Margin="Margin.Dense"
           Required="@Required"
           RequiredError="@(RequiredError ?? "La sistemazione è obbligatoria")"
           Disabled="@(Disabled || _tipi.Count == 0)"
           HelperText="@HelperTextCorrente"
           Class="@Class"
           @attributes="AdditionalAttributes">
    @foreach (var tipo in _tipi)
    {
        <MudSelectItem T="int?" Value="@tipo.Id">
            <div class="d-flex align-center justify-space-between width-100">
                <span>@tipo.Descrizione (@tipo.NumeroOccupanti posti)</span>
                @if (tipo.Supplemento)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                        + Supplemento
                    </MudChip>
                }
            </div>
        </MudSelectItem>
    }
</MudSelect>

@code {
    /// <summary>
    /// La partenza su cui si sta lavorando: è lei a decidere cosa si può assegnare.
    /// ⚠️ Senza (zero), la tendina resta vuota e disabilitata — non si mostra il catalogo
    /// intero: se non si sa su quale partenza si lavora, un elenco completo sarebbe una
    /// risposta inventata, ed è da lì che nascono le assegnazioni incoerenti.
    /// </summary>
    [Parameter, EditorRequired] public int DataViaggioId { get; set; }

    [Parameter] public int SelectedId { get; set; }
    [Parameter] public EventCallback<int> SelectedIdChanged { get; set; }

    /// <summary>
    /// Il tipo scelto per intero, per chi deve mostrarne la capienza o il supplemento.
    /// Arriva anche al caricamento, così chi riapre una scheda già compilata lo ha subito.
    /// </summary>
    [Parameter] public EventCallback<TipoAlloggio?> SelectedItemChanged { get; set; }

    /// <summary>
    /// Quante persone vanno sistemate. Se è nota e nessuno ha ancora scelto, il componente
    /// **propone** il tipo adatto (<see cref="TipoAlloggioService.Suggerisci"/>).
    ///
    /// ⚠️ Una proposta, non una decisione: resta cambiabile, e se l'utente sceglie a mano
    /// il componente non ci torna più sopra. Ma finché il valore è quello proposto da noi,
    /// e il gruppo cresce, la proposta si aggiorna — altrimenti chi aggiunge la seconda
    /// persona resterebbe con la singola scelta per la prima, che la validazione rifiuta.
    /// </summary>
    [Parameter] public int PersoneDaSistemare { get; set; }

    /// <summary>
    /// Se maggiore di zero, l'elenco mostra SOLO le sistemazioni di questa capienza.
    ///
    /// ⚠️ Serve dove il numero di persone è già deciso e la capienza deve corrispondere:
    /// per due persone si sceglie fra matrimoniale e due letti singoli, non fra tutte e
    /// quindici. La scelta resta di chi lavora — «chi ha deciso che deve essere
    /// matrimoniale?» (Adriano, 2026-09-06) — ma solo fra quelle che stanno in piedi.
    /// </summary>
    [Parameter] public int CapienzaEsatta { get; set; }

    [Parameter] public string Label { get; set; } = "Tipo Sistemazione";
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// Tutte le sistemazioni ammesse dalla partenza, prima del filtro di capienza.
    private List<TipoAlloggio> _ammessi = new();
    private List<TipoAlloggio> _tipi = new();
    private int _partenzaCaricata = -1;
    private int _capienzaApplicata = -1;

    /// L'ultimo id che abbiamo proposto noi. Serve a distinguere «lo ha scelto lui» da
    /// «gliel'abbiamo messo noi»: solo il secondo si può sostituire.
    private int _proposto;

    /// L'ultimo id già comunicato a chi ci contiene. Senza, si riparte a ogni render e il
    /// programma si blocca — vedi NotificaSeCambiato.
    private int _idNotificato;

    private string? HelperTextCorrente =>
        DataViaggioId <= 0 ? "Scegli prima la partenza"
        : _tipi.Count == 0 && CapienzaEsatta > 0
            ? $"Questo viaggio non prevede sistemazioni da {CapienzaEsatta} posti"
        : _tipi.Count == 0 ? "Questo viaggio non prevede sistemazioni da comporre"
        : HelperText;

    protected override async Task OnParametersSetAsync()
    {
        // Solo se la partenza è davvero cambiata si rilegge l'elenco: chi ci contiene
        // ridisegna in continuazione, e una lettura per render sarebbe una query per render.
        if (DataViaggioId != _partenzaCaricata)
        {
            _partenzaCaricata = DataViaggioId;

            _ammessi = DataViaggioId > 0
                ? await TipoAlloggioService.GetAmmessiPerPartenzaAsync(DataViaggioId)
                : new List<TipoAlloggio>();
            _capienzaApplicata = -1;   // il filtro va rifatto sull'elenco nuovo

            // La scelta fatta su un'altra partenza può non essere ammessa su questa: si
            // azzera, altrimenti resterebbe un valore che la tendina non mostra nemmeno più.
            if (SelectedId > 0 && _tipi.All(t => t.Id != SelectedId))
            {
                SelectedId = 0;
                await SelectedIdChanged.InvokeAsync(0);
            }
        }

        ApplicaFiltroCapienza();
        await ProponiSeServe();
        await NotificaSeCambiato();
    }

    /// <summary>
    /// Restringe l'elenco alla capienza richiesta, se ne è stata chiesta una. Si rifà solo
    /// quando cambia: gira a ogni render, e rifiltrare per niente costa a ogni disegno.
    /// </summary>
    private void ApplicaFiltroCapienza()
    {
        if (CapienzaEsatta == _capienzaApplicata) return;
        _capienzaApplicata = CapienzaEsatta;

        _tipi = CapienzaEsatta > 0
            ? _ammessi.Where(t => t.NumeroOccupanti == CapienzaEsatta).ToList()
            : _ammessi.ToList();

        // Quello che era scelto può non essere più in elenco.
        if (SelectedId > 0 && _tipi.All(t => t.Id != SelectedId)) SelectedId = 0;
    }

    /// <summary>
    /// Avvisa chi ci contiene SOLO quando la scelta è davvero cambiata.
    ///
    /// ⛔️ Avvisarlo a ogni passaggio di parametri congela il programma, e non è un modo di
    /// dire: chiamare un <c>EventCallback</c> fa ridisegnare il componente padre, che ci
    /// ripassa i parametri, che ci fanno richiamare il callback. Il giro non finisce mai e
    /// la finestra resta ferma. È il difetto che ha bloccato l'apertura dei partecipanti il
    /// 2026-09-06, introdotto insieme a questo componente.
    /// </summary>
    private async Task NotificaSeCambiato()
    {
        if (SelectedId == _idNotificato) return;
        _idNotificato = SelectedId;
        await SelectedItemChanged.InvokeAsync(_tipi.FirstOrDefault(t => t.Id == SelectedId));
    }

    /// <summary>
    /// Mette la proposta se nessuno ha scelto, o se il valore attuale è ancora quello che
    /// avevamo proposto noi e il gruppo nel frattempo è cambiato.
    /// </summary>
    private async Task ProponiSeServe()
    {
        if (PersoneDaSistemare <= 0 || _tipi.Count == 0) return;
        if (SelectedId != 0 && SelectedId != _proposto) return;   // scelto a mano: non si tocca

        var proposta = TipoAlloggioService.Suggerisci(_tipi, PersoneDaSistemare);
        // Niente di adatto: si lascia com'è. Proporre una capienza sbagliata sarebbe peggio
        // che non proporre, perché poi il salvataggio la rifiuta.
        if (proposta == null || proposta.Id == SelectedId) return;

        _proposto = proposta.Id;
        SelectedId = proposta.Id;
        await SelectedIdChanged.InvokeAsync(proposta.Id);
    }

    private async Task OnValueChanged(int? id)
    {
        _proposto = 0;   // da qui in poi il valore è suo, e non si sovrascrive
        SelectedId = id ?? 0;
        await SelectedIdChanged.InvokeAsync(SelectedId);
        await NotificaSeCambiato();
    }
}
