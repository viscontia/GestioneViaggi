@using GestioneViaggi.Models
@using GestioneViaggi.Models.DTOs
@using GestioneViaggi.Models.Web

<div class="travel-tooltip-content">
    <MudText Typo="Typo.subtitle2" Class="mb-1">@Travel.DescrizioneViaggio</MudText>
    <MudDivider Class="my-1" />

    <MudStack Spacing="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small" />
            <MudText Typo="Typo.body2">
                @Travel.DataInizio.ToString("dd/MM") - @Travel.DataFine.ToString("dd/MM/yyyy")
            </MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
            <MudText Typo="Typo.body2">@Travel.TotClienti partecipanti</MudText>
        </MudStack>

        @* Qui siamo gia' dentro un tooltip, quindi la spiegazione si scrive: e' lo stesso testo
           che altrove compare passando il mouse sullo stato, e nel calendario e' proprio cio' che
           mancava per capire i colori delle targhette. *@
        <MudChip T="string" Size="Size.Small" Color="@Colore" Icon="@Icona" Variant="Variant.Filled" Class="mt-1">
            @Stato.Etichetta
        </MudChip>
        <MudText Typo="Typo.caption">@Stato.Tooltip</MudText>

        @if (!string.IsNullOrEmpty(Travel.AziendaNome))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Travel.AziendaNome</MudText>
            </MudStack>
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public CalendarTravelDTO Travel { get; set; } = null!;

    private EsitoStatoPartenza Stato => StatoPartenzaRules.Valuta(Travel.Effettuato, Travel.DataFine, DateTime.Today);

    // Stesse icone e stessi colori di StatoPartenzaChip: la scelta e' li', qui si riusa.
    private string Icona => Stato.Livello switch
    {
        LivelloStatoPartenza.Anomalia => Icons.Material.Filled.ErrorOutline,
        LivelloStatoPartenza.Conclusa => Icons.Material.Filled.EventAvailable,
        _ => Icons.Material.Filled.Schedule
    };

    private Color Colore => Stato.Livello switch
    {
        LivelloStatoPartenza.Anomalia => Color.Warning,
        LivelloStatoPartenza.Conclusa => Color.Info,
        _ => Color.Default
    };
}
