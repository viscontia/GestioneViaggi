@using Blazored.TextEditor
@inject IJSRuntime JS
@using Microsoft.Extensions.Logging
@inject ILogger<EditorHtmlBozza> Log

@* Editor Quill per un testo HTML che vive in una BOZZA tenuta da altri (il dialogo), non nell'editor.
   Si carica da solo quando nasce e avvisa a ogni modifica: così sopravvive alle linguette che MudBlazor ricrea
   (prova di Adriano, 2026-10-23: passando a un'altra linguetta e tornando il testo spariva, perché gli editor
   ricreati non venivano ricaricati da chi li conteneva). Nato per i testi legali della scheda «Sito web».
   Caricamento e incolla passano dal modello di Quill (wwwroot/js/editorHtmlBozza.js): scritti direttamente nella pagina,
   come fa Blazored, alla prima modifica potevano sparire (prova di Adriano sulle FAQ, 2026-10-27). *@

<div @ref="_contenitore" class="editor-html-bozza" style="height:@(Altezza)px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;"
     @oninput="RileggiAsync" @onkeyup="RileggiAsync" @onclick="RileggiAsync" @onfocusout="RileggiAsync">
    <BlazoredTextEditor @ref="_editor" Placeholder="@Placeholder">
        <ToolbarContent>
            <select class="ql-header"><option selected=""></option><option value="2"></option><option value="3"></option></select>
            <span class="ql-formats"><button class="ql-bold"></button><button class="ql-italic"></button></span>
            <span class="ql-formats"><button class="ql-list" value="ordered"></button><button class="ql-list" value="bullet"></button></span>
            <span class="ql-formats"><button class="ql-link"></button></span>
        </ToolbarContent>
    </BlazoredTextEditor>
</div>

@code {
    /// <summary>Il testo della bozza, come HTML (null = nessun testo).</summary>
    [Parameter] public string? Testo { get; set; }

    /// <summary>Chiamata quando il testo cambia, con l'HTML normalizzato (l'HTML vuoto di Quill diventa null).</summary>
    [Parameter] public EventCallback<string?> TestoChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Altezza { get; set; } = 420;

    private BlazoredTextEditor? _editor;
    private ElementReference _contenitore;
    // finché il testo della bozza non è dentro l'editor, l'editor non si rilegge: un editor vuoto «creduto
    // pronto» cancellerebbe la bozza al primo tocco
    private bool _caricato;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _editor is null) return;
        // Quill si inizializza dopo il disegno: lo script lo aspetta (fino a 5 s) e poi ci mette il testo della bozza.
        // Prima si rinunciava dopo 0,75 s: con Quill lento l'editor funzionava a vista ma non copiava più niente
        // nella bozza, e alla prima volta che veniva ricreato il testo spariva (prova di Adriano sulle FAQ, 2026-10-27).
        try
        {
            _caricato = await JS.InvokeAsync<bool>("editorHtmlBozza.carica", _contenitore, Testo);
            if (!_caricato)
                Log.LogWarning("Editor HTML: Quill non è partito in 5 s; l'editor non copia nella bozza ({Lunghezza} caratteri in bozza)",
                    Testo?.Length ?? 0);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Editor HTML: testo della bozza non caricato nell'editor");
        }
    }

    private bool _segnalatoNonCaricato;

    private async Task RileggiAsync()
    {
        if (_editor is null) return;
        if (!_caricato)
        {
            // si scrive nell'editor ma la bozza non lo riceve: lo si dice una volta nel registro (diagnosi)
            if (!_segnalatoNonCaricato)
            {
                _segnalatoNonCaricato = true;
                Log.LogWarning("Editor HTML: modifica ignorata perché l'editor non risulta caricato: la bozza non la riceve");
            }
            return;
        }
        string? html;
        try { html = Normalizza(await _editor.GetHTML()); } catch { return; }
        if (string.Equals(html, Testo, StringComparison.Ordinal)) return;
        Testo = html;
        await TestoChanged.InvokeAsync(html);
    }

    /// <summary>L'HTML che Quill lascia quando si cancella tutto vale «nessun testo» (lo stesso fa il database, 701).</summary>
    public static string? Normalizza(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var resto = System.Text.RegularExpressions.Regex.Replace(html, @"<p>(\s|<br\s*/?>|&nbsp;)*</p>", "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
        return resto.Length == 0 ? null : html;
    }
}
