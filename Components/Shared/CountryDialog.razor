@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inherits BaseCrudDialog<Country>
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Nazione" : "Nuova Nazione")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <MudTextField @ref="_firstField"
                          Value="@Entity.Name"
                          ValueChanged="@((string value) => HandleNameChanged(value))"
                          For="@(() => Entity.Name)"
                          Label="Nome Nazione"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il nome della nazione è obbligatorio"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          HelperText="Inserisci il nome ufficiale della nazione."
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnBlur="@(() => HandleFieldBlur(_firstField))"
                          OnKeyDown="@HandleKeyDown" />

            <MudTextField Value="@Entity.Nationality"
                          ValueChanged="@((string value) => HandleNationalityChanged(value))"
                          For="@(() => Entity.Nationality)"
                          Label="Nazionalità"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="La nazionalità è obbligatoria"
                          MaxLength="50"
                          Class="mb-3 uppercase-input"
                          HelperText="Inserisci la nazionalità (es: Italian, American)."
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnKeyDown="@HandleKeyDown" />

            <MudTextField Value="@Entity.CountryCode"
                          ValueChanged="@((string value) => HandleCountryCodeChanged(value))"
                          For="@(() => Entity.CountryCode)"
                          Label="Codice Paese (3 caratteri)"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il codice paese è obbligatorio"
                          MaxLength="3"
                          Class="mb-3 uppercase-input"
                          HelperText="Codice ISO a 3 caratteri (es: ITA, USA, FRA)."
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnKeyDown="@HandleKeyDown" />

            <MudTextField Value="@Entity.IsoAlpha2"
                          ValueChanged="@((string value) => HandleIsoAlpha2Changed(value))"
                          For="@(() => Entity.IsoAlpha2)"
                          Label="ISO Alpha2 (2 caratteri)"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il codice ISO Alpha2 è obbligatorio"
                          MaxLength="2"
                          Class="mb-3 uppercase-input"
                          HelperText="Codice ISO a 2 caratteri (es: IT, US, FR)."
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnKeyDown="@HandleKeyDown" />

            <MudTextField Value="@Entity.Capital"
                          ValueChanged="@((string value) => HandleCapitalChanged(value))"
                          For="@(() => Entity.Capital)"
                          Label="Capitale - opzionale"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          HelperText="Inserisci la capitale della nazione (opzionale)."
                          OnKeyDown="@HandleKeyDown" />

            <MudNumericField @bind-Value="Entity.Population"
                             For="@(() => Entity.Population)"
                             Label="Popolazione - opzionale"
                             Variant="Variant.Outlined"
                             Min="0"
                             Culture="@(new System.Globalization.CultureInfo("it-IT"))"
                             Format="N0"
                             HelperText="Inserisci la popolazione stimata (opzionale)."
                             Class="mb-3" />

            <MudNumericField @bind-Value="Entity.AreaKm2"
                             For="@(() => Entity.AreaKm2)"
                             Label="Area (kmq) - opzionale"
                             Variant="Variant.Outlined"
                             Min="0"
                             Culture="@(new System.Globalization.CultureInfo("it-IT"))"
                             Format="N2"
                             HelperText="Specifica l'area totale in chilometri quadrati (opzionale)."
                             Class="mb-3" />

            <CountryRegionSelect SelectedRegionId="@Entity.RegionId"
                                 SelectedRegionIdChanged="@((int? value) => Entity.RegionId = value)"
                                 Required="false"
                                 HelperText="Seleziona la regione geografica (es: Africa, Asia, Europe)."
                                 Class="mb-3" />

            <CountrySubRegionSelect SelectedSubRegionId="@Entity.SubRegionId"
                                    SelectedSubRegionIdChanged="@((int? value) => Entity.SubRegionId = value)"
                                    Required="false"
                                    HelperText="Seleziona la sotto-regione (es: Eastern Europe, Central Asia)."
                                    Class="mb-3" />

            <CountryIntermediateSelect SelectedIntermediateId="@Entity.IntermediateRegionId"
                                       SelectedIntermediateIdChanged="@((int? value) => Entity.IntermediateRegionId = value)"
                                       Required="false"
                                       HelperText="Seleziona la regione intermedia (es: Caribbean, Eastern Africa)."
                                       Class="mb-3" />

            <CountryOrganizationSelect SelectedOrganizationId="@Entity.OrganizationRegionId"
                                       SelectedOrganizationIdChanged="@((int? value) => Entity.OrganizationRegionId = value)"
                                       Required="false"
                                       HelperText="Seleziona l'organizzazione (es: EMEA, APAC, NA)."
                                       Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelDialog" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;

    [Parameter]
    public Country Entity { get; set; } = new Country();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation con JavaScript helper
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
                // Fallback: focus manuale
                if (_firstField != null)
                {
                    await Task.Delay(150);
                    await _firstField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        // Cleanup JavaScript handlers quando il dialog viene chiuso
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch
        {
            // Ignora errori su cleanup
        }
    }

    private void HandleNameChanged(string value)
    {
        Entity.Name = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleNationalityChanged(string value)
    {
        Entity.Nationality = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleCountryCodeChanged(string value)
    {
        Entity.CountryCode = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleIsoAlpha2Changed(string value)
    {
        Entity.IsoAlpha2 = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleCapitalChanged(string value)
    {
        Entity.Capital = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private async Task HandleFieldBlur(MudTextField<string>? field)
    {
        if (field != null)
        {
            await field.Validate();
            if (field.Error)
            {
                await Task.Delay(150);
                try
                {
                    await field.FocusAsync();
                }
                catch
                {
                    // Ignora errori se il dialog è stato chiuso
                }
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                CloseDialog(DialogResult.Ok(Entity));
            }
            else
            {
                // Focus sul primo campo in errore
                if (_firstField?.Error == true)
                {
                    await _firstField.FocusAsync();
                }
            }
        }
    }
}
