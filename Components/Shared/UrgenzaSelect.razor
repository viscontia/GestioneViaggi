@*
    COMPONENT: UrgenzaSelect
    DESC: Select per la selezione dell'urgenza delle scadenze.
          - SCADUTO = in ritardo rispetto alla data di scadenza
          - URGENTE = entro 7 giorni
          - IN_SCADENZA = entro 30 giorni
          - NORMALE = oltre 30 giorni
*@

<MudSelect T="string"
           Label="@Label"
           @bind-Value="@Value"
           Variant="Variant.Outlined"
           Dense="true"
           Margin="Margin.Dense"
           Clearable="@Clearable"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           AnchorOrigin="Origin.BottomCenter"
           Class="@Class">
    <MudSelectItem Value="@("SCADUTO")">Scaduto (in ritardo)</MudSelectItem>
    <MudSelectItem Value="@("URGENTE")">Urgente (entro 7 giorni)</MudSelectItem>
    <MudSelectItem Value="@("IN_SCADENZA")">In scadenza (entro 30 giorni)</MudSelectItem>
    <MudSelectItem Value="@("NORMALE")">Normale (oltre 30 giorni)</MudSelectItem>
</MudSelect>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Urgenza";
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Campo obbligatorio";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string? Class { get; set; }
}
