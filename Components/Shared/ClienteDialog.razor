@using GestioneViaggi.Models
@using GestioneViaggi.Validation.Semantic
@using MudBlazor
@using Microsoft.JSInterop
@using GestioneViaggi.Validation.Business
@using GestioneViaggi.Validation.Fiscal
@using GestioneViaggi.Validation.Syntax
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? $"Modifica Cliente: {Entity.Cognome} {Entity.Nome}" : "Nuovo Cliente")
        </MudText>
    </TitleContent>
    <DialogContent>
        <div style="max-height: 80vh; overflow-y: auto;" class="pr-4">
            <MudForm @ref="_form" Model="@Entity">
                <MudGrid Spacing="4">
                    <!-- FOTO CLIENTE (Colonna Sinistra) -->
                    <MudItem xs="12" sm="4" md="3" Class="d-flex flex-column align-center pt-4">
                        <MudPaper Elevation="4" Class="d-flex flex-column align-center justify-center pa-1" Style="border-radius: 50%; width: 150px; height: 150px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(_photoPreviewUrl))
                            {
                                <MudImage Src="@_photoPreviewUrl" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
                            }
                            else
                            {
                                <MudAvatar Style="width: 100%; height: 100%; font-size: 3rem;" Color="Color.Primary" Variant="Variant.Filled">
                                    @((Entity.Nome?.FirstOrDefault() ?? '?').ToString().ToUpper())@((Entity.Cognome?.FirstOrDefault() ?? '?').ToString().ToUpper())
                                </MudAvatar>
                            }
                        </MudPaper>

                        <div class="mt-4 d-flex gap-2 justify-center">
                            @* MostraAttesa disattivato: la foto e' piccola e un velo a schermo intero
                               per un'operazione istantanea sembra un blocco, non un'attesa. *@
                            <FileUploader Accept="image/*" MaxByte="@MaxFileSize" MostraAttesa="false"
                                          RiepilogoAutomatico="false" OnFile="UploadPhoto">
                                <Attivatore>
                                    <MudTooltip Text="Carica Foto">
                                        <MudIconButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Icon="@Icons.Material.Filled.PhotoCamera"
                                                       Size="Size.Small" />
                                    </MudTooltip>
                                </Attivatore>
                            </FileUploader>

                            @if (!string.IsNullOrEmpty(_photoPreviewUrl))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Download" OnClick="DownloadPhoto" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="DeletePhoto" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" />
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-2 text-center" Color="Color.Secondary">Max 5MB<br/>.jpg, .png</MudText>
                    </MudItem>

                <!-- FORM DATI (Colonna Destra - Layout a Schede) -->
                <MudItem xs="12" sm="8" md="9" Style="position:relative; z-index:5;">
                    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
                             KeepPanelsAlive="true"
                             ActivePanelIndexChanged="OnTabChanged">
                        
                        <!-- TAB 1: GENERALE -->
                        <MudTabPanel Text="Generale" Icon="@Icons.Material.Filled.Person" IconColor="@GetTabColor("Generale")">
                            <MudGrid Spacing="3" Class="mt-2">
                                <!-- Azienda - Solo per SuperAdmin -->
                                @if (IsSuperAdmin)
                                {
                                    <MudItem xs="12">
                                        <AziendaSelect @bind-Value="Entity.AziendaFk" Required="true" Label="Azienda *" Items="@_initData.Aziende" />
                                    </MudItem>
                                }

                                <MudItem xs="12" sm="4">
                                    @* Titoli letti da ana_titolo_persone: la vecchia tendina cablata scriveva
                                       valori che il normalizzatore poi rendeva irriconoscibili. *@
                                    <TitoloPersonaSelect @ref="_titoloField" @bind-Value="Entity.TitoloFk"
                                        SelectedChanged="OnTitoloScelto" Label="Titolo" Required="true"
                                        RequiredError="Obbligatorio" />
                                </MudItem>
                                <MudItem xs="12" sm="8">
                                    @* Il sesso non si digita piu': lo porta il titolo. Un campo libero
                                       accanto a un titolo di genere e' solo un modo per contraddirlo. *@
                                    <MudTextField T="string" Value="@SessoDescrizione" Label="Sesso"
                                        Variant="Variant.Outlined" ReadOnly="true"
                                        HelperText="Impostato dal titolo: per cambiarlo scegli un altro titolo." />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @ref="_cognomeField" @bind-Value="Entity.Cognome" For="@(() => Entity.Cognome)" Label="Cognome"
                                        Variant="Variant.Outlined" Immediate="true" Required="true"
                                        RequiredError="Obbligatorio" MaxLength="50" Class="uppercase-input"
                                        Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @ref="_nomeField" @bind-Value="Entity.Nome" For="@(() => Entity.Nome)" Label="Nome"
                                        Variant="Variant.Outlined" Immediate="true" Required="true" 
                                        RequiredError="Obbligatorio" MaxLength="50" Class="uppercase-input" 
                                        Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudDatePicker @ref="_dataNascitaField" @bind-Date="Entity.DataNascita" For="@(() => Entity.DataNascita)"
                                        Label="Data di Nascita" Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Editable="true"
                                        Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                        HelperText="Es: 15/03/1990" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <ComuneSelect @bind-SelectedComuneId="ComuneNascitaIdProxy" 
                                                          @bind-SelectedComune="Entity.ComuneNascita"
                                                          Label="Comune di Nascita" Required="true"
                                                          RequiredError="Obbligatorio" Items="@_initData.Comuni" />
                                        </MudItem>
                                        <!-- Dettagli Geografici Nascita -->
                                        <MudItem xs="2">
                                            <MudTextField Value="@(Entity.ComuneNascita?.Cap)" Label="CAP" ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudTextField Value="@(Entity.ComuneNascita?.RegioneDescrizione)" Label="Regione" ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                        <MudItem xs="2">
                                            <MudTextField Value="@(Entity.ComuneNascita?.ProvinciaSigla)" Label="Prov." ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                        <MudItem xs="2">
                                            <MudTextField Value="@(Entity.ComuneNascita?.ComuneEstero == true ? "ESTERO" : "IT")" Label="Naz." ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <!-- TAB 2: RESIDENZA & CONTATTI -->
                        <MudTabPanel Text="Residenza & Contatti" Icon="@Icons.Material.Filled.HomeWork" IconColor="@GetTabColor("Residenza")">
                            <MudGrid Spacing="3" Class="mt-2">
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-1 fw-bold">Residenza</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <ComuneSelect @bind-SelectedComuneId="ComuneResidenzaIdProxy"
                                            @bind-SelectedComune="Entity.ComuneResidenza" Label="Comune di Residenza" Required="true"
                                                RequiredError="Obbligatorio" Items="@_initData.Comuni" />
                                        </MudItem>
                                        <!-- Dettagli Geografici Residenza -->
                                        <MudItem xs="2">
                                            <MudTextField Value="@(Entity.ComuneResidenza?.Cap)" Label="CAP" ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudTextField Value="@(Entity.ComuneResidenza?.RegioneDescrizione)" Label="Regione" ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                        <MudItem xs="2">
                                            <MudTextField Value="@(Entity.ComuneResidenza?.ProvinciaSigla)" Label="Prov." ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                        <MudItem xs="2">
                                            <MudTextField Value="@(Entity.ComuneResidenza?.ComuneEstero == true ? "ESTERO" : "IT")" Label="Naz." ReadOnly="true"
                                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                          Style="pointer-events: none;" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @ref="_indirizzoField" @bind-Value="Entity.IndirizzoResidenza" For="@(() => Entity.IndirizzoResidenza)"
                                        Label="Indirizzo" Variant="Variant.Outlined" MaxLength="100"
                                        Class="uppercase-input" HelperText="Via e numero civico" />
                                </MudItem>

                                <MudItem xs="12" Class="mt-2">
                                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-1 fw-bold">Contatti</MudText>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @ref="_emailField" @bind-Value="Entity.Email" For="@(() => Entity.Email)" Label="Email"
                                        Variant="Variant.Outlined" InputType="InputType.Email" MaxLength="100"
                                        HelperText="Email principale" Immediate="true" DebounceInterval="800"
                                        Validation="@(async (string e) => await ValidateEmailAsync(e))" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-Value="_lingua" Label="Lingua newsletter" Variant="Variant.Outlined" Clearable="true"
                                               HelperText="Vuoto = deriva dalla nazione di residenza al salvataggio.">
                                        <MudSelectItem T="string" Value="@("IT")">Italiano</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("EN")">Inglese</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("DE")">Tedesco</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("FR")">Francese</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("ES")">Spagnolo</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudCheckBox @bind-Value="_consenso"
                                                 Label="Consenso newsletter/marketing"
                                                 Color="Color.Primary"
                                                 Class="mt-3" />
                                    @if (_consensoData.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary" Style="margin-left:12px;">
                                            @(_consenso ? "Concesso il " : "Revocato il ")@_consensoData.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            @(string.IsNullOrWhiteSpace(_consensoFonte) ? "" : $" ({_consensoFonte})")
                                        </MudText>
                                    }
                                </MudItem>
                                <MudItem xs="4" sm="3">
                                    <MudTextField @ref="_prefTelField" @bind-Value="Entity.PrefTelInt" For="@(() => Entity.PrefTelInt)"
                                        Label="Prefisso" Variant="Variant.Outlined" MaxLength="5" Placeholder="+39"
                                        Immediate="true" Validation="@((string val) => ValidatePrefisso(val))" />
                                </MudItem>
                                <MudItem xs="8" sm="9">
                                    <MudTextField @ref="_telefonoField" @bind-Value="Entity.Telefono" For="@(() => Entity.Telefono)" Label="Telefono"
                                        Variant="Variant.Outlined" MaxLength="15" InputType="InputType.Telephone" Immediate="true"
                                        Validation="@((string val) => ValidateTelefono(val))" />
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <!-- TAB 3: DOCUMENTI -->
                        <MudTabPanel Text="Documenti" Icon="@Icons.Material.Filled.Badge" IconColor="@GetTabColor("Documenti")">
                            <MudGrid Spacing="3" Class="mt-2">
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string" @ref="_tipoDocField" @bind-Value="Entity.TipoDocIdentita" For="@(() => Entity.TipoDocIdentita)"
                                        Label="Tipo Doc." Variant="Variant.Outlined" Required="true"
                                        RequiredError="Obbligatorio">
                                        <MudSelectItem Value="@("CI")">Carta d'Identità</MudSelectItem>
                                        <MudSelectItem Value="@("Passaporto")">Passaporto</MudSelectItem>
                                        <MudSelectItem Value="@("Patente")">Patente</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="8">
                                    <MudTextField @ref="_docNumeroField" @bind-Value="Entity.DocumentoNumero" For="@(() => Entity.DocumentoNumero)"
                                        Label="Numero Documento" Variant="Variant.Outlined" MaxLength="50" Class="uppercase-input" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @ref="_docRilDaField" @bind-Value="Entity.DocumentoRilasciatoDa" For="@(() => Entity.DocumentoRilasciatoDa)"
                                        Label="Rilasciato Da" Variant="Variant.Outlined" MaxLength="100" Class="uppercase-input" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudDatePicker @ref="_docRilDataField" @bind-Date="Entity.DocumentoRilasciatoData" For="@(() => Entity.DocumentoRilasciatoData)"
                                        Label="Data Rilascio" Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Editable="true"
                                        Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                        Validation="@((DateTime? d) => ValidateDataRilascio(d))" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker @ref="_docScadenzaField" @bind-Date="Entity.DocumentoRilasciatoScadenza" For="@(() => Entity.DocumentoRilasciatoScadenza)"
                                        Label="Data Scadenza" Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Editable="true"
                                        Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                        Validation="@((DateTime? d) => ValidateDataScadenza(d))" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6">
                                    <MudTextField @ref="_cfField" @bind-Value="Entity.CodiceFiscale" For="@(() => Entity.CodiceFiscale)"
                                        Label="Codice Fiscale" Variant="Variant.Outlined" MaxLength="16" Class="uppercase-input"
                                        Immediate="true" DebounceInterval="800"
                                        Validation="@(async (string cf) => await ValidateCodiceFiscaleAsync(cf))" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @ref="_ibanField" @bind-Value="Entity.Iban" For="@(() => Entity.Iban)" Label="IBAN"
                                        Variant="Variant.Outlined" MaxLength="34" Class="uppercase-input" />
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <!-- TAB 4: ALTRO -->
                        <MudTabPanel Text="Altro" Icon="@Icons.Material.Filled.Note" IconColor="@GetTabColor("Altro")">
                            <MudGrid Spacing="3" Class="mt-2">
                                <MudItem xs="12">
                                    <MudTextField @ref="_intolleranzaField" @bind-Value="Entity.Intolleranza" For="@(() => Entity.Intolleranza)"
                                        Label="Intolleranze/Allergie" Variant="Variant.Outlined" Lines="3" Class="uppercase-input"
                                        HelperText="Indicare eventuali intolleranze o allergie alimentari" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @ref="_noteField" @bind-Value="Entity.Note" For="@(() => Entity.Note)" Label="Note"
                                        Variant="Variant.Outlined" Lines="5" Class="uppercase-input"
                                        HelperText="Note aggiuntive sul cliente" />
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                    </MudTabs>
                </MudItem>
                </MudGrid>
            </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <span>Salvataggio...</span>
            }
            else
            {
                <span>Salva</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
