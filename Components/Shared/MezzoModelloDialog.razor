@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Modello Veicolo" : "Nuovo Modello Veicolo")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <!-- PRIMO CAMPO OBBLIGATORIO: Descrizione -->
            <MudTextField T="string" @ref="_firstField"
                          Value="@Entity.Descrizione"
                          ValueChanged="@HandleDescrizioneChanged"
                          For="@(() => Entity.Descrizione)"
                          Label="Descrizione Modello"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="La descrizione è obbligatoria"
                          MaxLength="100"
                          tabindex="1"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          OnBlur="@(() => HandleFieldBlur(_firstField))"
                          OnKeyDown="@HandleKeyDown" />

            <!-- SECONDO CAMPO OBBLIGATORIO: Marca -->
            <MarcaVeicoloSelect SelectedId="@(Entity.MarcaIdFk == 0 ? null : Entity.MarcaIdFk)"
                                SelectedIdChanged="@((int? value) => Entity.MarcaIdFk = value ?? 0)"
                                Required="true"
                                RequiredError="La marca è obbligatoria"
                                HelperText="Seleziona la marca del veicolo"
                                tabindex="2" />

            <!-- TERZO CAMPO OBBLIGATORIO: Tipo Mezzo -->
            <TipoMezzoSelect SelectedId="@(Entity.TipoMezzoIdFk == 0 ? null : Entity.TipoMezzoIdFk)"
                             SelectedIdChanged="@((int? value) => Entity.TipoMezzoIdFk = value ?? 0)"
                             Required="true"
                             RequiredError="Il tipo mezzo è obbligatorio"
                             HelperText="Seleziona il tipo di mezzo"
                             tabindex="3" />

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public MezzoModello Entity { get; set; } = new MezzoModello();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation con JavaScript helper
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }

            // ⚠️ OBBLIGATORIO: Focus manuale sul primo campo (sempre eseguito)
            // Delay di 300ms per permettere rendering completo di MudBlazor
            if (_firstField != null)
            {
                await Task.Delay(300);
                try
                {
                    await _firstField.FocusAsync();
                    Console.WriteLine("Focus manuale applicato al primo campo");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Errore focus manuale: {ex.Message}");
                }
            }
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    // ⚠️ OBBLIGATORIO: Handler per uppercase in tempo reale
    private void HandleDescrizioneChanged(string value)
    {
        Entity.Descrizione = value?.ToUpper() ?? string.Empty;
        StateHasChanged(); // Forza re-render per mostrare uppercase
    }

    private async Task HandleFieldBlur(MudTextField<string>? field)
    {
        if (field != null)
        {
            await field.Validate();
            if (field.Error)
            {
                // Delay per permettere al click su "Annulla" di essere processato prima del focus back
                await Task.Delay(150);
                try
                {
                    await field.FocusAsync();
                }
                catch
                {
                    // Ignora errori se il dialog è stato chiuso
                }
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                MudDialog?.Close(DialogResult.Ok(Entity));
            }
            else
            {
                // Se ci sono errori, focus sul primo campo invalido
                if (_firstField?.Error == true)
                {
                    await _firstField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        try { JS.InvokeVoidAsync("dialogFormHelper.cleanup"); } catch { }
    }
}
