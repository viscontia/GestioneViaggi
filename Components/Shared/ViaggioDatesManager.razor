@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Printing
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization

@inject IRoomingListPrintService RoomingListPrintService
@inject IPdfOpenerService PdfOpenerService

<MudDataGrid T="AnaDataViaggio" Items="@Dates" Dense="true" Hover="true" Bordered="true" Striped="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Date in Programma</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
            OnClick="AddDate">Aggiungi Data</MudButton>
    </ToolBarContent>
    <Columns>
        <!-- Azioni: Compact icon group, centered in column -->
        <TemplateColumn Title="AZIONI" Sortable="false" Filterable="false"
            CellStyle="text-align:center; padding:4px;"
            HeaderStyle="text-align:center;" StickyLeft="true">
            <CellTemplate>
                <div style="display: inline-flex; align-items: center; gap: 4px;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning"
                        OnClick="@(() => EditDate(context.Item))" title="Modifica" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                        OnClick="@(() => DeleteDate(context.Item))" title="Elimina" />
                    @if (IsLiveMode)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Info"
                            OnClick="@(() => OpenParticipantsDialog(context.Item))" title="Partecipanti" />
                        <MudIconButton Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Success"
                            OnClick="@(() => OpenEmailDialog(context.Item))" title="Invia Email Partecipanti" />
                        <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Default"
                            OnClick="@(() => OpenPrintDialog(context.Item))" title="Stampa Scheda Data Viaggio" />
                        <MudIconButton Icon="@Icons.Material.Filled.Hotel" Size="Size.Small" Color="Color.Primary"
                            OnClick="@(() => PrintRoomingList(context.Item))" title="Stampa Rooming List" />
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>

        <!-- Inizio: Fixed 95px -->
        <PropertyColumn Property="x => x.DataInizio" Title="INIZIO" Format="dd/MM/yy" Sortable="true" Filterable="false"
            CellStyle="width:95px; min-width:95px; max-width:95px; text-align:center; padding:2px; font-size:0.875rem;" 
            HeaderStyle="width:95px; min-width:95px; max-width:95px; text-align:center;" />

        <!-- Fine: Fixed 95px -->
        <PropertyColumn Property="x => x.DataFine" Title="FINE" Format="dd/MM/yy" Sortable="false" Filterable="false"
            CellStyle="width:95px; min-width:95px; max-width:95px; text-align:center; padding:2px; font-size:0.875rem;" 
            HeaderStyle="width:95px; min-width:95px; max-width:95px; text-align:center;" />

        <!-- Effett.: Fixed 70px -->
        <TemplateColumn Title="EFFETT." Sortable="false" Filterable="false"
            CellStyle="width:70px; min-width:70px; max-width:70px; text-align:center; padding:0;" 
            HeaderStyle="width:70px; min-width:70px; max-width:70px; text-align:center;">
            <CellTemplate>
                @if (context.Item.EffettuatoSino == "Y")
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Error" Size="Size.Small" />
                }
            </CellTemplate>
        </TemplateColumn>
        
        <!-- Costo Pilota: Fixed 135px - Header Centered -->
        <PropertyColumn Property="x => x.CostoPilota" Title="COSTO PILOTA" Format="C0" Sortable="false" Filterable="false"
            CellStyle="width:135px; min-width:135px; max-width:135px; text-align:right; padding:2px; font-size:0.875rem;" 
            HeaderStyle="width:135px; min-width:135px; max-width:135px; text-align:center;" />

        <!-- Costo Passeggero: Fixed 165px - Header Centered -->
        <PropertyColumn Property="x => x.CostoPasseggero" Title="COSTO PASSEGGERO" Format="C0" Sortable="false" Filterable="false"
            CellStyle="width:165px; min-width:165px; max-width:165px; text-align:right; padding:2px; font-size:0.875rem;" 
            HeaderStyle="width:165px; min-width:165px; max-width:165px; text-align:center;" />

        <!-- N. Mezzi: Fixed 80px to fit title -->
        <PropertyColumn Property="x => x.TotMezzi" Title="N.MEZZI" Sortable="false" Filterable="false"
            CellStyle="width:80px; min-width:80px; max-width:80px; text-align:center; padding:2px; font-weight:bold; font-size:0.875rem;" 
            HeaderStyle="width:80px; min-width:80px; max-width:80px; text-align:center;" />

        <!-- N. Clienti: Fixed 90px to fit title -->
        <PropertyColumn Property="x => x.TotClienti" Title="N.CLIENTI" Sortable="false" Filterable="false"
            CellStyle="width:90px; min-width:90px; max-width:90px; text-align:center; padding:2px; font-weight:bold; font-size:0.875rem;" 
            HeaderStyle="width:90px; min-width:90px; max-width:90px; text-align:center;" />
            
        <!-- Spacer: Fill Remaining -->
        <TemplateColumn Title="" Sortable="false" Filterable="false" />
    </Columns>
</MudDataGrid>

@code {
    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] AnaViaggiService ViaggiService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    [Parameter] public List<AnaDataViaggio> Dates { get; set; } = new();

    // Live Mode: when true, actions are executed directly on DB and list is refreshed.
    // when false, actions are on the in-memory list only.
    [Parameter] public bool IsLiveMode { get; set; }
    [Parameter] public int TripId { get; set; }
    [Parameter] public int AziendaId { get; set; }
    [Parameter] public int DurationDays { get; set; } // Duration from Parent Trip
    [Parameter] public AnaViaggi? Trip { get; set; } // Full Trip Object for Context

    [Parameter] public EventCallback DatesChanged { get; set; } // To notify parent of changes (count/content)
    [Parameter] public EventCallback OnTripDeleted { get; set; } // To notify parent that trip was deleted (orphaned)

    public async Task AddDate()
    {
        var newDate = new AnaDataViaggio
            {
                ViaggioIdFk = TripId,
                AziendaId = AziendaId,
                DataInizio = DateTime.Today,
                // Default end date logic: Use DurationDays if available, otherwise +7
                DataFine = DurationDays > 0 ? DateTime.Today.AddDays(DurationDays - 1) : DateTime.Today.AddDays(7)
            };
        await OpenDialog(newDate, true);
    }
    
    private async Task EditDate(AnaDataViaggio date)
    {
        await OpenDialog(date, false);
    }

    private async Task OpenParticipantsDialog(AnaDataViaggio date)
    {
        if (Trip == null || TripId == 0 || date.Id == 0)
        {
            Snackbar.Add("Salva prima il viaggio e le date prima di gestire i partecipanti.", Severity.Warning);
            return;
        }

        var headerTitle = "Gestione Partecipanti";
        if (Trip != null && date.DataInizio.HasValue && date.DataFine.HasValue)
        {
             headerTitle = $"{Trip.DescrizioneBreve} (Dal {date.DataInizio.Value:dd/MM/yyyy} al {date.DataFine.Value:dd/MM/yyyy})";
        }

        var parameters = new DialogParameters 
        { 
            ["DataViaggioId"] = date.Id,
            ["ViaggioId"] = TripId,
            ["AziendaId"] = AziendaId,
            ["HeaderTitle"] = headerTitle
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };

        await DialogService.ShowAsync<ViaggioPartecipantiManagerDialog>("", parameters, options);
    }

    private async Task OpenEmailDialog(AnaDataViaggio date)
    {
        if (Trip == null)
        {
            Snackbar.Add("Dati del viaggio non disponibili.", Severity.Warning);
            return;
        }

        if (!date.DataInizio.HasValue || !date.DataFine.HasValue)
        {
            Snackbar.Add("Date del viaggio non disponibili.", Severity.Warning);
            return;
        }

        var tripName = Trip.DescrizioneBreve;
        var dateRange = $"Dal {date.DataInizio.Value:dd/MM/yyyy} al {date.DataFine.Value:dd/MM/yyyy}";

        var parameters = new DialogParameters
        {
            ["DataViaggioId"] = date.Id,
            ["AziendaId"] = AziendaId,
            ["TripName"] = tripName,
            ["DateRange"] = dateRange,
            ["DefaultSubject"] = $"{tripName} - {dateRange}"
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<SendEmailDialog>("", parameters, options);
    }
    
    private async Task OpenPrintDialog(AnaDataViaggio date)
    {
        var parameters = new DialogParameters
        {
            ["DataViaggioId"] = date.Id,
            ["Trip"] = Trip
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        await DialogService.ShowAsync<StampaSchedaViaggioDialog>("Stampa Scheda Viaggio", parameters, options);
    }

    private async Task DeleteDate(AnaDataViaggio date)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (IsLiveMode && Dates.Count == 1)
        {
            // Orphaned Trip Scenario
            bool confirmOrphan = await DialogService.ShowMessageBox(
                "ATTENZIONE", 
                "Questa è l'ultima data rimasta. Cancellandola verrà eliminato permanentemente anche l'intero Viaggio (Anagrafica). Procedere?", 
                yesText: "Elimina Tutto", 
                cancelText: "Annulla") ?? false;
            
            if (!confirmOrphan) return;

            try
            {
                // 1. Delete the Date first
                await ViaggiService.DeleteDateAsync(date.Id);
                
                // 2. Delete the Trip
                await ViaggiService.DeleteAsync(TripId);
                
                Snackbar.Add("Viaggio e data eliminati correttamente", Severity.Success);
                
                // 3. Notify Parent to Close
                await OnTripDeleted.InvokeAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore eliminazione viaggio: {ex.Message}", Severity.Error);
            }
            return;
        }

        bool confirm = await DialogService.ShowMessageBox("Conferma", "Eliminare questa data?", yesText: "Elimina", cancelText: "Annulla") ?? false;
        if (!confirm) return;

        if (IsLiveMode)
        {
            try
            {
                await ViaggiService.DeleteDateAsync(date.Id);
                Dates.Remove(date); // UI Update
                Snackbar.Add("Data eliminata", Severity.Success);
            }
            catch (InvalidOperationException ex)
            {
                // Business logic error
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            Dates.Remove(date);
        }
        await DatesChanged.InvokeAsync();
    }

    private async Task OpenDialog(AnaDataViaggio date, bool isNew)
    {
        // Clone for edit to avoid dirty state on cancel
        var model = date.Clone<AnaDataViaggio>();

        var parameters = new DialogParameters 
        { 
            ["Entity"] = model,
            ["DurationDays"] = DurationDays
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ViaggioDateDialog>(isNew ? "Nuova Data" : "Modifica Data", parameters,
        options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is AnaDataViaggio modifiedDate)
        {
            if (IsLiveMode)
            {
                try
                {
                    // Ensure links
                    modifiedDate.ViaggioIdFk = TripId;
                    modifiedDate.AziendaId = AziendaId;

                    if (isNew)
                    {
                        await ViaggiService.CreateDateAsync(modifiedDate);
                        // Ideally reload to get ID, or Service returns ID.
                        // CreateDateAsync currently void? Let's assume just refresh logic or we need ID.
                        // For now, let's just add to list, but in LiveMode we should reload or get ID.
                        // Simple approach: Reload list from parent or trust the DB.
                        // Let's create a partial reload if needed.
                        // To be robust: Creating returns nothing now. I should verify Service returns ID or object.
                        // Currently void.
                        // Let's Reload ALL dates for safety in Live Mode.
                        var updatedDates = await ViaggiService.GetDatesByTripIdAsync(TripId);
                        Dates.Clear();
                        Dates.AddRange(updatedDates);
                    }
                    else
                    {
                        await ViaggiService.UpdateDateAsync(modifiedDate);
                        // Reload from DB to ensure sync and confirmation
                        var updatedDates = await ViaggiService.GetDatesByTripIdAsync(TripId);
                        Dates.Clear();
                        Dates.AddRange(updatedDates);
                    }
                    Snackbar.Add("Data salvata", Severity.Success);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Errore salvataggio: {ex.Message}", Severity.Error);
                }
            }
            else
            {
                // Memory Mode
                if (isNew)
                {
                    Dates.Add(modifiedDate);
                }
                else
                {
                    // Replace instance properties or object in list
                    // Since 'date' is the reference in the list (if we passed the original), we can update it or swap.
                    // 'date' passed to this method is reference from list? Yes context.Item.
                    // But we cloned 'model'. So we need to update 'date' with 'model' values OR swap in list.
                    var index = Dates.IndexOf(date);
                    if (index >= 0) Dates[index] = modifiedDate;
                }
            }
            await DatesChanged.InvokeAsync();
        }
    }

    private async Task PrintRoomingList(AnaDataViaggio date)
    {
        try
        {
            var data = await RoomingListPrintService.GetRoomingListDataAsync(date.Id);

            // Save to Downloads
            var targetFolder = PdfOpenerService.GetPdfOutputFolder();

            // Create descriptive filename
            var fileName = GestioneViaggi.Services.Printing.PdfFileNameHelper.GetRoomingListFileName(data.Header);
            var filePath = Path.Combine(targetFolder, fileName);

            // Overwrite check
            if (System.IO.File.Exists(filePath))
            {
                System.IO.File.Delete(filePath);
            }

            await GestioneViaggi.Services.Printing.RoomingListPrinter.GeneratePdfAsync(data, filePath);

            await PdfOpenerService.OpenPdfAsync(filePath, "Stampa Rooming List Completata");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore stampa Rooming List: {ex.Message}", Severity.Error);
        }
    }
}
