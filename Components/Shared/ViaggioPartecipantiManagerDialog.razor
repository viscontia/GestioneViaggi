    private void OnRoleChanged(int newRoleId)
    {
        _currentEntity.TipoPartecipanteIdFk = newRoleId;

        // Auto-suggest accommodation type when role changes
        if (_wantsAccommodation && !_isEditMode)
        {
            var groupSize = GetCurrentGroupSize();
