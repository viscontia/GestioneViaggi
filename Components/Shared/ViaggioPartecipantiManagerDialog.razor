    private int GetCurrentGroupSize()
    {
        // Conta pilota + passeggeri già associati
        if (_isEditMode && _currentEntity.ClienteIdFk > 0)
        {
            // In edit mode: conta il gruppo esistente
            if (IsPilot(_currentEntity.TipoPartecipanteIdFk))
            {
                // Se è un pilota, conta se stesso + i suoi passeggeri
                return 1 + _participants.Count(p => p.GroupingKey == _currentEntity.ClienteIdFk && p.ClienteId != _currentEntity.ClienteIdFk);
            }
            else
            {
                // Se è un passeggero, conta solo se stesso
                return 1;
            }
        }

        // In insert mode: solo il cliente corrente
        return 1;
    }

    private string GetDisplayRole(string role)
    {
        if (string.IsNullOrEmpty(role)) return "";
        if (role.Contains("PASSEGGERO", StringComparison.OrdinalIgnoreCase))
            return "PASSEGGERO";
        return role;
    }

    private string GetRoleDescription(int tipoPartecipanteId)
    {
        return _tipoPartecipanti.FirstOrDefault(t => t.Id == tipoPartecipanteId)?.Descrizione ?? "?";
    }

    private int SuggestAccommodationType(int participantsCount)
    {
        // Caso speciale: 2 persone → Matrimoniale
        if (participantsCount == 2)
        {
            var matrimoniale = _tipoAlloggi
                .FirstOrDefault(t => t.Descrizione.Contains("MATRIMONIALE", StringComparison.OrdinalIgnoreCase));
            if (matrimoniale != null) return matrimoniale.Id;
        }

        // Caso generale: Trova il più piccolo che contiene tutti
        var suitable = _tipoAlloggi
            .Where(t => t.NumeroOccupanti >= participantsCount)
            .OrderBy(t => t.NumeroOccupanti)
            .ThenBy(t => t.Supplemento ? 1 : 0) // Preferisci senza supplemento
            .FirstOrDefault();

        return suitable?.Id ?? 0;
    }

    private async Task LoadRoomsAsync()
    {
        try
        {
            // DB: get_rooms_with_occupants(p_data_viaggio_id)
            // → Returns: Camere con occupanti aggregati (ARRAY_AGG di nomi e IDs)
            // → Elimina necessità di loop su 6 slot + lookup partecipanti in memoria
            var roomsDto = await AlloggiService.GetRoomsWithOccupantsAsync(DataViaggioId);

            _existingRooms.Clear();
            foreach (var dto in roomsDto)
            {
                _existingRooms.Add(new RoomCardViewModel
                {
                    RoomId = dto.AlloggioPk,
                    RoomType = dto.TipoAlloggio,
                    MaxOccupants = dto.MaxOccupants,
                    CurrentOccupants = dto.CurrentOccupants,
                    OccupantNames = dto.OccupantNames.ToList(),
                    OccupantIds = dto.OccupantIds.ToList(),
                    HasSupplement = dto.HasSupplement,
                    RoomEntity = new MovClientiAlloggi() // TODO: Remove when all SaveAsync refactored
                });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento camere: {ex.Message}", Severity.Error);
        }
    }

    // Helper class for room visualization
    public class RoomCardViewModel
    {
        public int RoomId { get; set; }
        public string RoomType { get; set; } = "";
        public int MaxOccupants { get; set; }
        public int CurrentOccupants { get; set; }
        public List<string> OccupantNames { get; set; } = new();
        public List<int> OccupantIds { get; set; } = new();
        public bool HasSupplement { get; set; }
        public MovClientiAlloggi RoomEntity { get; set; } = new();

        public bool IsFull => CurrentOccupants >= MaxOccupants;
        public bool IsEmpty => CurrentOccupants == 0;
        public bool HasSpace => CurrentOccupants < MaxOccupants;

        public Color StatusColor => IsFull ? Color.Success : (IsEmpty ? Color.Default : Color.Warning);
        public string StatusIcon => IsFull ? Icons.Material.Filled.CheckCircle : (IsEmpty ? Icons.Material.Filled.Circle : Icons.Material.Filled.Warning);
        public string StatusText => $"{CurrentOccupants}/{MaxOccupants}";
    }
}
