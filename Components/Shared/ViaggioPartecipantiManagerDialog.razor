
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Models.DTOs
@using MudBlazor
@using System.IO
@inject MovClientiViaggiService MovClientiService
@inject MovClientiAlloggiService AlloggiService
@inject AnaViaggiService ViaggiService
@inject TipoPartecipanteService TipoPartecipanteService
@inject TipoAlloggioService TipoAlloggioService
@inject IClienteService ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@_headerTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-3" Style="height: 88vh; overflow-y: hidden;">
            <MudGrid Style="height: 100%;">

                <!-- LEFT PANEL: TABS (60%) -->
                <MudItem xs="12" md="7" Style="height: 100%; overflow-y: auto;">
                    <MudPaper Elevation="0" Class="pa-2 h-100 d-flex flex-column">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.h6">
                                @if (!string.IsNullOrEmpty(_summaryTitle))
                                {
                                        <span>@_summaryTitle</span>
                                }
                                else
                                {
                                        <span>Gestione Viaggio</span>
                                }
                            </MudText>
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(async () => await ResetForm())">
                                    Nuovo
                                </MudButton>
                            </div>
                        </div>

                        @if (_isLoadingList)
                        {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else
                        {
                                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" Centered="true">

                                    <!-- TAB 1: PARTECIPANTI -->
                                    <MudTabPanel>
                                        <TabContent>
                                            <div class="d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Partecipanti (@_participantsCount)</MudText>
                                            </div>
                                        </TabContent>
                                        <ChildContent>
                                            <MudSimpleTable Dense="true" Hover="true" Striped="true" Bordered="true"
                                                            FixedHeader="true" Style="font-size: 15px;">
                                                <thead>
                                                    <tr>
                                                        <th style="padding: 4px 8px; width: 30px;"></th>
                                                        <th style="padding: 4px 8px; min-width: 180px;">Nominativo</th>
                                                        <th style="padding: 4px 8px; min-width: 150px;">Ruolo</th>
                                                        <th style="padding: 4px 8px; min-width: 200px;">Veicolo</th>
                                                        <th style="padding: 4px 8px; width: 80px; text-align: center;">Info</th>
                                                        <th style="padding: 4px 8px; width: 100px; text-align: center;">Azioni</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var participant in _participants)
                                                {
                                                    var isPilot = participant.ClienteId == participant.GroupingKey;
                                                    // Stile riga: 
                                                    // - Pilota: Sfondo Tinta Primary molto leggero (funziona sia Light che Dark)
                                                    // - Passeggero: Sfondo standard
                                                    var rowStyle = isPilot 
                                                        ? "background-color: rgba(var(--mud-palette-primary-rgb), 0.04); border-top: 2px solid var(--mud-palette-divider); font-weight: 600;" 
                                                        : "background-color: transparent;";

                                                    <tr style="@rowStyle">
                                                        <!-- Icona Tipo -->
                                                        <td style="padding: 4px 8px; text-align: center;">
                                                            @if (isPilot)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.SportsMotorsports" Color="Color.Primary" Size="Size.Small" Style="font-size: 1.1rem;" />
                                                            }
                                                            else
                                                            {
                                                                 // Icona o spazio per passeggero (Gestito nell'indentazione del nome)
                                                            }
                                                        </td>

                                                        <!-- Nominativo -->
                                                        <td style="padding: 4px 8px;">
                                                            @if (isPilot)
                                                            {
                                                                <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight: 700;">
                                                                    @participant.Nominativo
                                                                </MudText>
                                                            }
                                                            else
                                                            {
                                                                // Indentazione visiva per i passeggeri
                                                                <div class="d-flex align-center">
                                                                    <!-- Linea guida visiva -->
                                                                    <div style="
                                                                        width: 20px; 
                                                                        height: 24px; 
                                                                        margin-left: 8px; 
                                                                        border-left: 2px solid var(--mud-palette-divider); 
                                                                        border-bottom: 2px solid var(--mud-palette-divider);
                                                                        border-bottom-left-radius: 8px;
                                                                        margin-right: 8px;
                                                                        opacity: 0.5;">
                                                                    </div>
                                                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-primary);">
                                                                        @participant.Nominativo
                                                                    </MudText>
                                                                </div>
                                                            }
                                                        </td>

                                                        <!-- Ruolo -->
                                                        <td style="padding: 4px 8px;">
                                                            @if (isPilot)
                                                            {
                                                                // Pilota: Evidenziato con Chip Filled per massimo contrasto
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Style="font-weight: 600; border-radius: 4px;">
                                                                    @GetDisplayRole(participant.Ruolo)
                                                                </MudChip>
                                                            }
                                                            else
                                                            {
                                                                // Passeggero: Testo light e ruolo semplificato
                                                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); white-space: nowrap;">
                                                                    @GetDisplayRole(participant.Ruolo)
                                                                </MudText>
                                                            }
                                                        </td>

                                                        <!-- Veicolo -->
                                                        <td style="padding: 4px 8px;">
                                                            @if (isPilot && !string.IsNullOrEmpty(participant.MezzoDettagli))
                                                            {
                                                                <div class="d-flex align-center gap-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.9rem;" />
                                                                    <MudText Typo="Typo.body2" Style="font-size: 0.95rem; font-weight: 500;">@participant.MezzoDettagli</MudText>
                                                                </div>
                                                            }
                                                        </td>

                                                        <!-- Info (Note, Cane, Intolleranze) -->
                                                        <td style="padding: 4px 8px; text-align: center;">
                                                            <div class="d-flex align-center justify-center gap-1">
                                                                @if (!string.IsNullOrEmpty(participant.Note))
                                                                {
                                                                    <MudTooltip Text="@participant.Note">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Note" Size="Size.Small" Color="Color.Info" Style="font-size: 0.9rem;" />
                                                                    </MudTooltip>
                                                                }
                                                                @if (participant.CaneSino == "Y")
                                                                {
                                                                    <MudTooltip Text="Viaggia con Cane">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Small" Color="Color.Warning" Style="font-size: 0.9rem;" />
                                                                    </MudTooltip>
                                                                }
                                                                @if (!string.IsNullOrEmpty(participant.Intolleranze))
                                                                {
                                                                    <MudTooltip Text="@($"Intolleranze: {participant.Intolleranze}")">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" Color="Color.Error" Style="font-size: 0.9rem;" />
                                                                    </MudTooltip>
                                                                }
                                                            </div>
                                                        </td>

                                                        <!-- Azioni -->
                                                        <td style="padding: 4px 8px; text-align: center;">
                                                            <div class="d-flex align-center justify-center gap-1">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => LoadForEdit(participant))" Style="width: 28px; height: 28px;" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteParticipant(participant))" Style="width: 28px; height: 28px;" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            </MudSimpleTable>
                                        </ChildContent>
                                    </MudTabPanel>

                                    <!-- TAB 2: ALLOGGI -->
                                    <MudTabPanel>
                                        <TabContent>
                                            <div class="d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Hotel" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Alloggi (@_roomsCount)</MudText>
                                            </div>
                                        </TabContent>
                                        <ChildContent>
                                            <!-- Warning Partecipanti Senza Camera -->
                                        @if (_participantsWithoutRoom.Any())
                                        {
                                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" Style="padding: 8px;">
                                                        <b>⚠️ @_participantsWithoutRoom.Count senza camera:</b> @string.Join(", ", _participantsWithoutRoom.Select(p => p.Nominativo).Take(3))@(_participantsWithoutRoom.Count > 3 ? $" +{_participantsWithoutRoom.Count - 3} altri" : "")
                                                    </MudAlert>
                                        }

                                            <!-- Sezione Alloggi Assegnati - Raggruppata per Tipo -->
                                        @if (_existingRooms.Any())
                                        {
                                            var roomsByType = _existingRooms
                                                .GroupBy(r => r.RoomType)
                                                .OrderBy(g => g.Key);

                                            @foreach (var roomGroup in roomsByType)
                                            {
                                                var groupRooms = roomGroup.OrderBy(r => string.Join(", ", r.OccupantNames)).ToList();
                                                var hasSupplementInGroup = groupRooms.Any(r => r.HasSupplement);

                                                            <!-- Header Tipologia -->
                                                            <div style="background-color: var(--mud-palette-background); padding: 4px 8px; margin-top: 4px; border-left: 3px solid var(--mud-palette-primary); border-radius: 4px;">
                                                                <MudText Typo="Typo.caption" Style="font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">
                                                        @roomGroup.Key (@groupRooms.Count)
                                                        @if (hasSupplementInGroup)
                                                        {
                                                                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Color="Color.Warning" Style="font-size: 0.75rem; margin-left: 4px;" />
                                                        }
                                                                </MudText>
                                                            </div>

                                                            <!-- Camere del gruppo -->
                                                            <MudSimpleTable Dense="true" Style="font-size: 0.75rem; margin-bottom: 8px;">
                                                                <tbody>
                                                        @foreach (var room in groupRooms)
                                                        {
                                                                            <tr style="border-bottom: 1px solid var(--mud-palette-divider-light);">
                                                                                <td style="padding: 4px 8px; width: 50px; text-align: center;">
                                                                                    <MudIcon Icon="@room.StatusIcon" Size="Size.Small" Color="@room.StatusColor" Style="font-size: 0.9rem;" />
                                                                                </td>
                                                                                <td style="padding: 4px 8px; width: 70px; text-align: center;">
                                                                                    <MudChip T="string" Size="Size.Small" Color="@room.StatusColor" Variant="Variant.Text" Style="font-size: 0.65rem; height: 18px; padding: 0 6px;">
                                                                        @room.StatusText
                                                                                    </MudChip>
                                                                                </td>
                                                                                <td style="padding: 4px 8px;">
                                                                    @if (room.OccupantNames.Any())
                                                                    {
                                                                                            <span>@string.Join(", ", room.OccupantNames)</span>
                                                                    }
                                                                    else
                                                                    {
                                                                                            <span style="opacity: 0.5; font-style: italic;">vuota</span>
                                                                    }
                                                                                </td>
                                                                                <td style="padding: 4px 8px; width: 50px; text-align: center;">
                                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteRoom(room))" Style="width: 28px; height: 28px;" />
                                                                                </td>
                                                                            </tr>
                                                        }
                                                                </tbody>
                                                            </MudSimpleTable>
                                            }
                                        }
                                        else
                                        {
                                                    <MudAlert Severity="Severity.Info" Dense="true">
                                                        Nessuna camera assegnata per questo viaggio
                                                    </MudAlert>
                                        }
                                        </ChildContent>
                                    </MudTabPanel>

                                </MudTabs>
                        }
                    </MudPaper>
                </MudItem>

                <!-- RIGHT PANEL: EDIT/ADD (40%) -->
                <MudItem xs="12" md="5" Style="height: 100%; overflow-y: auto; border-left: 1px solid var(--mud-palette-divider);">
                    <MudPaper Elevation="0" Class="pa-3 h-100">
                         <MudText Typo="Typo.h6" Class="mb-3">@(_isEditMode ? "Modifica Partecipante" : "Nuovo Inserimento")</MudText>

                             <MudForm @ref="_form" Model="@_currentEntity" @bind-IsValid="@_isValid">

                                 <!-- 1. Selection Cliente -->
                                 <ClienteSelect @bind-SelectedCliente="_selectedCliente"
                                                AziendaId="@AziendaId"
                                                Required="true" 
                                                RequiredError="Selezionare un cliente"
                                                Disabled="@_isEditMode" 
                                                Class="mb-3" />

                                 <!-- 2. Trip Config -->
                                 <MudGrid Spacing="2">
                                     <MudItem xs="6">
                                         <TipoPartecipanteSelect SelectedId="@(_currentEntity.TipoPartecipanteIdFk == 0 ? (int?)null : _currentEntity.TipoPartecipanteIdFk)"
                                                                 SelectedIdChanged="@OnRoleChangedAsync"
                                                                 Required="true" />
                                 </MudItem>
                                 <MudItem xs="6" Class="d-flex align-center">
                                     <MudCheckBox @bind-Value="@_hasDog" Label="Con Cane" Color="Color.Warning" Dense="true" />
                                 </MudItem>
                             </MudGrid>

                             <!-- Pilot Selection (Visible only if NOT Pilot) -->
                            @if (_currentEntity.TipoPartecipanteIdFk > 0 && !IsPilot(_currentEntity.TipoPartecipanteIdFk))
                            {
                                     <MudSelect T="int?" Label="Assegnato al Veicolo di" @bind-Value="_currentEntity.ClientePilotaIdFk" 
                                                Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                                                Clearable="true" AdornmentIcon="@Icons.Material.Filled.SportsMotorsports">
                                    @foreach (var p in _participants.Where(x => IsPilot(x.TipoPartecipanteId)))
                                    {
                                                 <MudSelectItem T="int?" Value="@p.ClienteId">@p.Nominativo</MudSelectItem>
                                    }
                                     </MudSelect>
                            }

                             <MudTextField @bind-Value="_currentEntity.MovClienteViaggioNote" Label="Note Viaggio" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mt-3" />

                             <!-- Vehicle Config (Visible only if Pilot) -->
                            @if (IsPilot(_currentEntity.TipoPartecipanteIdFk))
                            {
                                     <MudDivider Class="my-3" />
                                     <div class="d-flex align-center gap-2 mb-2">
                                         <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Color="Color.Primary" Size="Size.Small" />
                                         <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Dettagli Veicolo</b></MudText>
                                     </div>

                                     <MudGrid Spacing="2">
                                         <MudItem xs="6">
                                             <MarcaVeicoloSelect SelectedId="@_currentEntity.AnaMezziIdFk"
                                                                 SelectedIdChanged="@OnMarcaChanged"
                                                                 Label="Marca" Required="false" />
                                         </MudItem>
                                         <MudItem xs="6">
                                             <MezzoModelloSelect @ref="_modelloSelect"
                                                                 SelectedId="@_currentEntity.MezzoModelloIdFk"
                                                                 SelectedIdChanged="@((int? val) => _currentEntity.MezzoModelloIdFk = val)"
                                                                 SelectedItemChanged="OnMezzoModelloChanged"
                                                                 MarcaId="@_currentEntity.AnaMezziIdFk"
                                                                 Label="Modello" Required="false" />
                                         </MudItem>
                                         <MudItem xs="6">
                                             <MudTextField @bind-Value="_currentEntity.MovClienteViaggioTargaMezzo" 
                                                           Label="Targa" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                           Class="uppercase-input" />
                                         </MudItem>
                                         <MudItem xs="6">
                                             <MudNumericField @bind-Value="_currentEntity.MovClienteViaggioScontovalTotale" 
                                                              Label="Sconto Totale (€)" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                              Min="0" HideSpinButtons="true" Format="N2" />
                                         </MudItem>
                                     </MudGrid>
                            }

                            @if (!_isEditMode)
                            {
                                     <MudDivider Class="my-3" />

                                     <!-- 3. Accommodation Config (Solo in INSERT mode) -->
                                     <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Hotel" Color="Color.Primary" Size="Size.Small" />
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Alloggio</b></MudText>
                                        </div>
                                        <MudSwitch @bind-Value="@_wantsAccommodation"
                                                   @bind-Value:after="@OnWantsAccommodationChangedAsync"
                                                   Label="@(_wantsAccommodation ? "Assegna camera" : "No")"
                                                   Color="Color.Success" />
                                     </div>

                                @if (_wantsAccommodation)
                                {
                                         <MudPaper Class="pa-3" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">

                                             <!-- Scelta: Camera Esistente o Nuova -->
                                             <MudRadioGroup @bind-Value="_assignToExistingRoom" @bind-Value:after="@OnAssignToExistingRoomChangedAsync" Class="mb-3">
                                                 <MudRadio T="bool" Value="true" Color="Color.Primary" Dense="true">
                                                     Aggiungi a camera esistente
                                                 </MudRadio>
                                                 <MudRadio T="bool" Value="false" Color="Color.Primary" Dense="true">
                                                     Crea nuova camera
                                                 </MudRadio>
                                             </MudRadioGroup>

                                        @if (_assignToExistingRoom)
                                        {
                                                     <!-- Opzione 1: Seleziona Camera Esistente -->
                                            var availableRooms = _existingRooms.Where(r => r.HasSpace).ToList();

                                            @if (availableRooms.Any())
                                            {
                                                             <MudSelect T="int?" Label="Seleziona Camera"
                                                @bind-Value="_selectedExistingRoomId"
                                                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                       Required="true">
                                                    @foreach (var room in availableRooms)
                                                    {
                                                                         <MudSelectItem T="int?" Value="@room.RoomId">
                                                                             <div class="d-flex align-center justify-space-between width-100">
                                                                                 <span>@room.RoomType - @string.Join(", ", room.OccupantNames)</span>
                                                                                 <MudChip T="string" Size="Size.Small" Color="@room.StatusColor" Variant="Variant.Text">
                                                                    @room.StatusText
                                                                                 </MudChip>
                                                                             </div>
                                                                         </MudSelectItem>
                                                    }
                                                             </MudSelect>

                                                @if (_selectedExistingRoomId.HasValue)
                                                {
                                                    var selectedRoom = _existingRooms.FirstOrDefault(r => r.RoomId == _selectedExistingRoomId.Value);
                                                    @if (selectedRoom != null)
                                                    {
                                                                             <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                                                                 Camera: <b>@selectedRoom.RoomType</b><br/>
                                                                                 Occupanti attuali: @string.Join(", ", selectedRoom.OccupantNames)<br/>
                                                                                 Dopo assegnazione: @(selectedRoom.CurrentOccupants + 1)/@selectedRoom.MaxOccupants
                                                                             </MudAlert>

                                                        @if (selectedRoom.HasSupplement)
                                                        {
                                                                                     <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                                                                         💡 Questa camera prevede un supplemento aggiuntivo
                                                                                     </MudAlert>
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                             <MudAlert Severity="Severity.Warning" Dense="true">
                                                                 Nessuna camera disponibile con posti liberi. Crea una nuova camera.
                                                             </MudAlert>
                                            }
                                        }
                                        else
                                        {
                                                     <!-- Opzione 2: Crea Nuova Camera -->
                                                     <MudSelect T="int" Label="Tipo Camera"
                                            @bind-Value="_currentAlloggio.TipoAlloggioIdFk"
                                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                                               Required="true">
                                                @foreach (var tipo in _tipoAlloggi)
                                                {
                                                                 <MudSelectItem Value="@tipo.Id">
                                                                     <div class="d-flex align-center justify-space-between width-100">
                                                                         <span>@tipo.Descrizione (@tipo.NumeroOccupanti posti)</span>
                                                            @if (tipo.Supplemento)
                                                            {
                                                                                 <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                                                                     + Supplemento
                                                                                 </MudChip>
                                                            }
                                                                     </div>
                                                                 </MudSelectItem>
                                                }
                                                     </MudSelect>

                                            @if (_currentAlloggio.TipoAlloggioIdFk > 0)
                                            {
                                                var selectedTipo = _tipoAlloggi.FirstOrDefault(t => t.Id == _currentAlloggio.TipoAlloggioIdFk);
                                                @if (selectedTipo != null)
                                                {
                                                                     <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                                                         Nuova camera: <b>@selectedTipo.Descrizione</b><br/>
                                                                         Primo occupante: @(_selectedCliente != null ? $"{_selectedCliente.Cognome} {_selectedCliente.Nome}" : "...")<br/>
                                                                         Capacità: 1/@selectedTipo.NumeroOccupanti
                                                                     </MudAlert>

                                                    @if (selectedTipo.Supplemento)
                                                    {
                                                                             <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                                                                 💡 Questa camera prevede un supplemento aggiuntivo
                                                                             </MudAlert>
                                                    }
                                                }
                                            }
                                        }

                                             <MudText Typo="Typo.caption" Class="mt-2" Style="opacity: 0.7;">
                                                 💡 Usa il TAB "Alloggi" per gestire le camere
                                             </MudText>
                                         </MudPaper>
                                }
                            }
                            else
                            {
                                     <!-- In EDIT mode, mostra solo info alloggio corrente -->
                                     <MudDivider Class="my-3" />
                                     <MudAlert Severity="Severity.Info" Dense="true">
                                         <b>Per modificare gli alloggi, usa il TAB "Alloggi"</b>
                                     </MudAlert>
                            }

                             <!-- Actions -->
                             <div class="d-flex justify-end mt-4 gap-2">
                                @if (_isEditMode)
                                {
                                         <MudButton Variant="Variant.Outlined" OnClick="@(async () => await ResetForm())">Annulla Modifica</MudButton>
                                }
                                 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!_isValid)">
                                    @(_isEditMode ? "Aggiorna" : "Salva e Nuovo")
                                 </MudButton>
                             </div>

                         </MudForm>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int DataViaggioId { get; set; }
    [Parameter] public int ViaggioId { get; set; }
    [Parameter] public int AziendaId { get; set; }

    // Models
    private MovClientiViaggi _currentEntity = new();
    private MovClientiAlloggi _currentAlloggio = new();
    private Cliente? _selectedCliente;

    // Lists & Lookups
    private List<ParticipantsViewDTO> _participants = new(); // Mapping from SP result (già ordinati dal DB)
    private List<ParticipantsViewDTO> _participantsWithoutRoom = new(); // NEW DB-CENTRIC: Caricati da get_participants_without_accommodation()
    private List<TipoPartecipante> _tipoPartecipanti = new();
    private List<TipoAlloggio> _tipoAlloggi = new();
    private List<RoomCardViewModel> _existingRooms = new(); // Camere già create per questo viaggio

    // Counters from DB
    private int _participantsCount = 0; // DB: get_participants_count() - più efficiente di _participants.Count
