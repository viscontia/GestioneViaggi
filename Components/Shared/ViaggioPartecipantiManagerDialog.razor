    /// <summary>
    /// Chiede che cosa diventano le sistemazioni che, cancellando questa persona (e i suoi
    /// passeggeri se guida), resterebbero con meno gente dentro. Torna il JSON da passare
    /// alla cancellazione, o <c>null</c> se l'operatore ha annullato.
    ///
    /// ⚠️ Senza risposta il database RIFIUTA la cancellazione: con la capienza rigorosa una
    /// doppia con un occupante non è uno stato ammesso. E il tipo non lo sceglie il software —
    /// «rischi di mettere in matrimoniale due amici che vogliono letti separati».
    /// </summary>
    private async Task<string?> ChiediSistemazioniDiChiRestaAsync(int dataViaggioId, int clienteId)
    {
        var camere = await MovClientiService.GetCamereDaRisistemareAsync(dataViaggioId, clienteId);
        if (camere.Count == 0) return "[]";

        var scelte = new List<object>();

        foreach (var c in camere)
        {
            var parameters = new DialogParameters<SistemazioneResiduaDialog>
            {
                { x => x.DataViaggioId, dataViaggioId },
                { x => x.Descrizione, c.Tipo },
                { x => x.Chi, c.ChiEsce ?? "chi esce" },
                { x => x.Restano, (c.Restano ?? "").Split(", ", StringSplitOptions.RemoveEmptyEntries).ToList() }
            };

            var dialog = await DialogService.ShowAsync<SistemazioneResiduaDialog>(
                "La sistemazione di chi resta", parameters,
                new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });

            var esito = await dialog.Result;
            if (esito!.Canceled || esito.Data is not int tipoId || tipoId <= 0) return null;

            scelte.Add(new { alloggio_pk = c.AlloggioPk, tipo_id = tipoId });
        }

        return System.Text.Json.JsonSerializer.Serialize(scelte);
    }

    /// <summary>
    /// Porta ad assegnare una sistemazione a chi non ce l'ha, senza uscire da questa scheda.
    /// Apre la finestra degli alloggi già puntata su quella persona: lì può avere una
    /// sistemazione sua o stare con qualcuno che ce l'ha già.
    /// </summary>
    private async Task AssegnaSenzaCamera(ParticipantsViewDTO chi)
    {
        var parameters = new DialogParameters<ViaggioAlloggiAdvancedDialog>
        {
            { x => x.ViaggioId, ViaggioId },
            { x => x.DataViaggioId, DataViaggioId },
            { x => x.DaSistemareClienteId, chi.ClienteId }
        };

        var dialog = await DialogService.ShowAsync<ViaggioAlloggiAdvancedDialog>(
            "Gestione Alloggi", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false });

        await dialog.Result;
        await LoadListAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Quante persone vanno sistemate insieme a questa: un pilota porta con sé i suoi
    /// passeggeri, un passeggero sta per conto suo. Serve a <see cref="TipoAlloggioSelect"/>
    /// per proporre il tipo della capienza giusta.
    ///
    /// ⚠️ Chi guida si riconosce dal dato (<c>tipo_partecipante_pilota</c>) tramite
    /// <c>IsPilot</c>, non dalla descrizione: «PILOTA MOTO PROPRIA» e «GUIDA IN SECONDA»
    /// guidano entrambi, e nessuna regola sul testo li tiene insieme.
    /// </summary>
    private int DimensioneGruppo()
    {
        if (!_isEditMode || _currentEntity.ClienteIdFk <= 0) return 1;
        if (!IsPilot(_currentEntity.TipoPartecipanteIdFk)) return 1;

        return 1 + _participants.Count(p => p.GroupingKey == _currentEntity.ClienteIdFk
                                         && p.ClienteId != _currentEntity.ClienteIdFk);
    }

    // Helper class for room visualization
    /// <summary>
    /// La camera del pilota a cui si sta abbinando questo passeggero, se ne ha una piena.
    /// Serve a dire la cosa giusta quando non ci sono posti liberi: il caso normale non è
    /// «servono due camere», è «quella che c'è va cambiata».
    ///
    /// ⚠️ Nasce dal caso portato da Adriano il 2026-09-06: iscritto lui come pilota con una
    /// CAMERA SINGOLA, poi aggiunta la moglie come passeggera. Il programma diceva «crea una
    /// nuova camera» — cioè due singole e due supplementi per una coppia — e il database non
    /// avrebbe avuto niente da obiettare: due singole con un occupante ciascuna sono valide
    /// esattamente quanto una matrimoniale.
    /// </summary>
    private RoomCardViewModel? CameraDelPilotaScelto()
    {
        var pilotaId = _currentEntity.ClientePilotaIdFk;
        if (pilotaId is null or <= 0) return null;

        return _existingRooms.FirstOrDefault(r => r.IsFull && r.OccupantIds.Contains(pilotaId.Value));
    }

    public class RoomCardViewModel
    {
        public int RoomId { get; set; }
        public string RoomType { get; set; } = "";
        public int RoomTypeId { get; set; }
        public int MaxOccupants { get; set; }
        public int CurrentOccupants { get; set; }
        public List<string> OccupantNames { get; set; } = new();
        public List<int> OccupantIds { get; set; } = new();
        public bool HasSupplement { get; set; }
        public string PilotCognome { get; set; } = "ZZZZZ";
        public MovClientiAlloggi RoomEntity { get; set; } = new();

        public bool IsFull => CurrentOccupants >= MaxOccupants;
        public bool IsEmpty => CurrentOccupants == 0;
        public bool HasSpace => CurrentOccupants < MaxOccupants;

        public Color StatusColor => IsFull ? Color.Success : (IsEmpty ? Color.Default : Color.Warning);
        public string StatusIcon => IsFull ? Icons.Material.Filled.CheckCircle : (IsEmpty ? Icons.Material.Filled.Circle : Icons.Material.Filled.Warning);
        public string StatusText => $"{CurrentOccupants}/{MaxOccupants}";
    }
}
