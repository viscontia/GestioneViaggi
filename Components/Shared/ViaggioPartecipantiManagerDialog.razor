    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(HeaderTitle))
            {
                _headerTitle = HeaderTitle;
            }
            else
            {
                // Fallback to async load only if strictly necessary (should be avoided now)
                await LoadHeaderInfoAsync();
            }

            await LoadLookupsAsync();
            await LoadListAsync();
            await LoadRoomsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore inizializzazione: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadHeaderInfoAsync()
    {
        try
        {
            // Fallback: use optimized query if no title passed
            _headerTitle = await MovClientiService.GetTripHeaderStringAsync(ViaggioId, DataViaggioId);
        }
        catch (Exception ex)
        {
            _headerTitle = $"ERR: {ex.Message}";
            // Console.WriteLine($"Error loading header info: {ex.Message}");
        }
    }

    private async Task LoadLookupsAsync()
    {
        _tipoPartecipanti = (await TipoPartecipanteService.GetAllAsync()).ToList();
        _tipoAlloggi = (await TipoAlloggioService.GetAllAsync()).ToList();
    }

    private async Task LoadListAsync()
    {
        _isLoadingList = true;
        try
        {
            // DB: get_participants_sorted(p_data_viaggio_id)
            // → Returns: Partecipanti ordinati per cognome pilota, pilota prima dei passeggeri, cognome passeggeri
            var rawList = await MovClientiService.GetParticipantsSortedAsync(DataViaggioId);
            _participants = rawList.ToList();

            // DB: get_participants_count(p_data_viaggio_id)
            // → Returns: Conteggio totale partecipanti (più efficiente di _participants.Count)
            _participantsCount = await MovClientiService.GetParticipantsCountAsync(DataViaggioId);

            // DB: get_participants_without_accommodation(p_data_viaggio_id)
            // → Returns: Solo partecipanti senza camera assegnata (LEFT JOIN atomico)
            var withoutRoom = await MovClientiService.GetParticipantsWithoutAccommodationAsync(DataViaggioId);
            _participantsWithoutRoom = withoutRoom.ToList();

            // DB: get_viaggio_partecipanti_summary(p_data_viaggio_id)
            // → Returns: String riepilogo (es. "3 Piloti, 5 Passeggeri")
            _summaryTitle = await MovClientiService.GetParticipantsSummaryAsync(DataViaggioId);

            // Reload rooms after participants list changes
            await LoadRoomsAsync();

            // DB: get_rooms_count(p_data_viaggio_id)
            // → Returns: Conteggio totale camere (più efficiente di _existingRooms.Count)
            _roomsCount = await AlloggiService.GetRoomsCountAsync(DataViaggioId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento lista: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingList = false;
        }
    }

    private bool IsPilot(int tipoId)
    {
        // Use the database field tipo_partecipante_pilota instead of description
        var type = _tipoPartecipanti.FirstOrDefault(x => x.Id == tipoId);
        return type?.Pilota ?? false;
    }

