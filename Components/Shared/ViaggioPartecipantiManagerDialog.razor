    private IEnumerable<ParticipantsViewDTO> GetSortedParticipants()
    {
        // Ordina: prima per cognome del pilota, poi per ogni pilota i suoi passeggeri ordinati per cognome-nome
        return _participants
            .OrderBy(p =>
            {
                // Se è un pilota, usa il suo cognome
                if (p.ClienteId == p.GroupingKey)
                    return p.Nominativo;

                // Se è un passeggero, trova il cognome del pilota
                var pilot = _participants.FirstOrDefault(x => x.ClienteId == p.GroupingKey);
                return pilot?.Nominativo ?? "ZZZZZ"; // Partecipanti non assegnati vanno alla fine
            })
            .ThenBy(p => p.ClienteId == p.GroupingKey ? 0 : 1) // Prima il pilota, poi i passeggeri
            .ThenBy(p => p.Nominativo); // Poi ordina i passeggeri per cognome-nome
    }



    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        if (_selectedCliente == null)
        {
            Snackbar.Add("Selezionare un cliente", Severity.Warning);
            return;
        }

        try
        {
            // 1. Save Movimento Viaggio
            _currentEntity.ViaggioIdFk = ViaggioId;
            _currentEntity.DataViaggioIdFk = DataViaggioId;
            _currentEntity.ClienteIdFk = _selectedCliente.ClienteId;
            _currentEntity.MovClienteViaggioCaneSino = _hasDog ? "Y" : "N";

            // If Role is Link Pilot, ensure we haven't accidentally set a Parent Pilot (Circular/Invalid)
            if (IsPilot(_currentEntity.TipoPartecipanteIdFk))
            {
                _currentEntity.ClientePilotaIdFk = null;
            }

            if (_isEditMode)
            {
                await MovClientiService.UpdateParticipantAsync(_currentEntity);
                Snackbar.Add("Partecipante aggiornato", Severity.Success);
            }
            else
            {
                await MovClientiService.AddParticipantAsync(_currentEntity);
                Snackbar.Add("Partecipante aggiunto", Severity.Success);
            }

            // 3. Save Accommodation (Solo in INSERT mode, non in EDIT)
            // In EDIT mode, usa "Gestione Alloggi" per modificare le camere
            if (_wantsAccommodation && !_isEditMode)
            {
                if (_assignToExistingRoom && _selectedExistingRoomId.HasValue)
                {
                    // Opzione 1: Aggiungi a camera esistente
                    var existingRoom = _existingRooms.FirstOrDefault(r => r.RoomId == _selectedExistingRoomId.Value);
                    if (existingRoom != null)
                    {
                        // Trova il primo slot libero e aggiungi il cliente
                        var roomEntity = existingRoom.RoomEntity;

                        if (!roomEntity.ClienteId1Fk.HasValue)
                            roomEntity.ClienteId1Fk = _selectedCliente.ClienteId;
                        else if (!roomEntity.ClienteId2Fk.HasValue)
                            roomEntity.ClienteId2Fk = _selectedCliente.ClienteId;
                        else if (!roomEntity.ClienteId3Fk.HasValue)
                            roomEntity.ClienteId3Fk = _selectedCliente.ClienteId;
                        else if (!roomEntity.ClienteId4Fk.HasValue)
                            roomEntity.ClienteId4Fk = _selectedCliente.ClienteId;
                        else if (!roomEntity.ClienteId5Fk.HasValue)
                            roomEntity.ClienteId5Fk = _selectedCliente.ClienteId;
                        else if (!roomEntity.ClienteId6Fk.HasValue)
                            roomEntity.ClienteId6Fk = _selectedCliente.ClienteId;
                        else
                        {
                            Snackbar.Add("Errore: camera già piena!", Severity.Error);
                            return;
                        }

                        await AlloggiService.UpdateAccommodationAsync(roomEntity);
                        Snackbar.Add($"Partecipante aggiunto alla camera {existingRoom.RoomType}", Severity.Success);
                    }
                }
                else if (!_assignToExistingRoom && _currentAlloggio.TipoAlloggioIdFk > 0)
                {
                    // Opzione 2: Crea nuova camera
                    _currentAlloggio.ViaggioIdFk = ViaggioId;
                    _currentAlloggio.DataViaggioIdFk = DataViaggioId;
                    _currentAlloggio.ClienteId1Fk = _selectedCliente.ClienteId;
                    _currentAlloggio.ClienteId2Fk = null;
                    _currentAlloggio.ClienteId3Fk = null;
                    _currentAlloggio.ClienteId4Fk = null;
                    _currentAlloggio.ClienteId5Fk = null;
                    _currentAlloggio.ClienteId6Fk = null;

                    // Update o Insert in base a se l'alloggio esiste già
                    if (_isEditMode && _currentAlloggio.MovClientiAlloggioPk > 0)
                    {
                        await AlloggiService.UpdateAccommodationAsync(_currentAlloggio);
                    }
                    else
                    {
                        await AlloggiService.AddAccommodationAsync(_currentAlloggio);
                    }

                    var selectedTipo = _tipoAlloggi.FirstOrDefault(t => t.Id == _currentAlloggio.TipoAlloggioIdFk);
                    var msg = selectedTipo?.Supplemento == true
                        ? "Nuova camera creata (con supplemento)"
                        : "Nuova camera creata";
                    Snackbar.Add(msg, Severity.Success);
                }
            }
            else if (_isEditMode && !_wantsAccommodation && _currentAlloggio.MovClientiAlloggioPk > 0)
            {
                // Se in edit mode l'utente ha disattivato l'alloggio, rimuovi quello esistente
                await AlloggiService.RemoveAccommodationAsync(_currentAlloggio.MovClientiAlloggioPk);
                Snackbar.Add("Alloggio rimosso", Severity.Info);
            }

            // 3. Reset for next entry (if not editing)
            if (_isEditMode)
            {
                await ResetForm();
            }
            else
            {
                // Keep some settings like Role? Maybe.
                // Reset Client
                _selectedCliente = null;
                _currentEntity = new MovClientiViaggi
                {
                    TipoPartecipanteIdFk = _currentEntity.TipoPartecipanteIdFk // Keep role
                };
                _currentAlloggio = new MovClientiAlloggi();
                _hasDog = false;
                _assignToExistingRoom = false;
                _selectedExistingRoomId = null;
            }

            await LoadListAsync(); // Refresh Grid
            StateHasChanged(); // Force UI refresh
        }
        catch(Exception ex)
        {
            Snackbar.Add($"Errore salvataggio: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadForEdit(ParticipantsViewDTO item)
    {
        try
        {
            _isEditMode = true;

            // Fetch full entity
            var list = await MovClientiService.GetByDateIdAsync(item.DataId);
            var entity = list.FirstOrDefault(x => x.ClienteIdFk == item.ClienteId);

            if (entity != null)
            {
                _currentEntity = entity;
            }

            // Fetch Client for Autocomplete
            _selectedCliente = await ClienteService.GetByIdAsync(item.ClienteId, AziendaId);

            _hasDog = _currentEntity.MovClienteViaggioCaneSino == "Y";

            // Fetch existing accommodation for this client
            var alloggi = await AlloggiService.GetByDateIdAsync(item.DataId);
            var existingAlloggio = alloggi.FirstOrDefault(a =>
                a.ClienteId1Fk == item.ClienteId ||
                a.ClienteId2Fk == item.ClienteId ||
                a.ClienteId3Fk == item.ClienteId ||
                a.ClienteId4Fk == item.ClienteId ||
                a.ClienteId5Fk == item.ClienteId ||
                a.ClienteId6Fk == item.ClienteId);

            if (existingAlloggio != null)
            {
                _currentAlloggio = existingAlloggio;
                _wantsAccommodation = true; // Cliente ha già un alloggio
            }
            else
            {
                _currentAlloggio = new MovClientiAlloggi();
                _wantsAccommodation = false; // Nessun alloggio assegnato
            }
        }
        catch (Exception ex)
        {
            _isEditMode = false; // Revert state
            Snackbar.Add($"CRITICAL ERROR LoadForEdit: {ex.Message} {ex.StackTrace}", Severity.Error);
        }
    }

