        _selectedCliente = null;
        _hasDog = false;
        _wantsAccommodation = true;
        _assignToExistingRoom = false;
        _selectedExistingRoomId = null;
        _currentAlloggio = new MovClientiAlloggi();

        // Refresh participants list to show newly added pilots
        await LoadListAsync();
    }

    private async Task RefreshTabNavigationAsync()
    {
        try 
        {
            // Small delay to allow Blazor to update DOM
            await Task.Delay(100);
            // Passa skipAutoFocus: true per evitare il salto al primo campo durante i refresh
            await JS.InvokeVoidAsync("window.dialogFormHelper.setupTabNavigation", ".mud-dialog-content", true);
        }
        catch { /* Ignore JS errors */ }
    }

    private async Task SetFocusOnClienteFieldAsync()
    {
        try
        {
            // Delay per permettere a Blazor di aggiornare il DOM dopo StateHasChanged
            await Task.Delay(150);
            // Cerca il primo input del MudAutocomplete (campo Cliente) e setta il focus
            await JS.InvokeVoidAsync("eval", @"
                const clienteInput = document.querySelector('.mud-dialog-content input[type=""text""]');
                if (clienteInput) {
                    clienteInput.focus();
                    clienteInput.select();
                }
            ");
        }
        catch { /* Ignore JS errors */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _needsTabRefresh)
        {
            _needsTabRefresh = false;
            await RefreshTabNavigationAsync();
        }
    }

