    private async Task DeleteParticipant(ParticipantsViewDTO item)
    {
        // 1. Verifica se il partecipante ha un alloggio assegnato
        var room = _existingRooms.FirstOrDefault(r => r.OccupantIds.Contains(item.ClienteId));

        if (room == null)
        {
            // SCENARIO A: Nessun alloggio - elimina direttamente
            await ConfirmAndDeleteParticipant(item);
            // Force refresh dopo la chiusura del dialog
            StateHasChanged();
        }
        else if (room.CurrentOccupants == 1)
        {
            // SCENARIO B: Solo lui nella camera - chiedi conferma per eliminare entrambi
            bool? confirm = await DialogService.ShowMessageBox(
                "Conferma Eliminazione",
                $"⚠️ Eliminando {item.Nominativo} verrà eliminata anche la camera {room.RoomType}.\n\nVuoi procedere?",
                yesText: "Elimina Tutto", cancelText: "Annulla");

            if (confirm == true)
            {
                await DeleteParticipantAndRoom(item, room);
            }
            // Force refresh dopo la chiusura del dialog (anche se annullato)
            StateHasChanged();
        }
        else
        {
            // SCENARIO C: Camera condivisa - BLOCCA l'eliminazione
            var otherOccupants = string.Join("\n• ", room.OccupantNames.Where(n => n != item.Nominativo));

            await DialogService.ShowMessageBox(
                "Impossibile Eliminare",
                $"❌ {item.Nominativo} è assegnato a una camera con altri occupanti:\n\n• {otherOccupants}\n\n" +
                $"Prima devi:\n" +
                $"1. Andare nel TAB 'Alloggi'\n" +
                $"2. Modificare/eliminare la camera\n" +
                $"3. Riassegnare gli altri occupanti se necessario\n" +
                $"4. Poi potrai eliminare il partecipante",
                yesText: "OK");
            // Force refresh dopo la chiusura del dialog informativo
            StateHasChanged();
        }
    }

    private async Task ConfirmAndDeleteParticipant(ParticipantsViewDTO item)
    {
        bool? result = await DialogService.ShowMessageBox(
           "Conferma Eliminazione",
           $"Rimuovere {item.Nominativo} dal viaggio?",
           yesText: "Rimuovi", cancelText: "Annulla");

        if (result != true) return;

        try
        {
            // 2. Controllo Coerenza Alloggio
            var consistency = await AlloggiService.CheckRoomConsistencyOnDeleteAsync(item.DataId, item.ClienteId);

            if (consistency.ViolationDetected)
            {
                // Prepara messaggio con nomi superstiti
                string survivorNames = "";
                if (consistency.SurvivorIds != null && consistency.SurvivorIds.Length > 0)
                {
                   var names = _participants
                       .Where(p => consistency.SurvivorIds.Contains(p.ClienteId))
                       .Select(p => p.Nominativo)
                       .ToList();
                   survivorNames = string.Join(", ", names);
                }

                // Mostra errore: l'utente deve gestire manualmente dal TAB Alloggi
                await DialogService.ShowMessageBox(
                    "Conflitto Alloggio",
                    $"❌ Impossibile eliminare {item.Nominativo}.\n\n" +
                    $"Questa camera ha altri occupanti: {survivorNames}\n\n" +
                    $"Per risolvere:\n" +
                    $"1. Vai al TAB 'Alloggi'\n" +
                    $"2. Modifica/elimina la camera\n" +
                    $"3. Poi riprova a eliminare il partecipante",
                    yesText: "OK");
                return; // Blocca l'eliminazione
            }

            // 3. Eliminazione Finale (DB procedure updated to be safe and clean old rooms)
            await MovClientiService.RemoveParticipantAsync(item.ViaggioId, item.DataId, item.ClienteId);
            
            Snackbar.Add($"{item.Nominativo} rimosso dal viaggio", Severity.Success);
            await LoadListAsync();
            StateHasChanged(); 
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteParticipantAndRoom(ParticipantsViewDTO item, RoomCardViewModel room)
    {
        try
        {
            // Elimina prima la camera, poi il partecipante
            // Se la seconda operazione fallisce, il DB avrà già fatto rollback della prima
            await AlloggiService.RemoveAccommodationAsync(room.RoomId);
            await MovClientiService.RemoveParticipantAsync(item.ViaggioId, item.DataId, item.ClienteId);

            Snackbar.Add($"{item.Nominativo} e camera {room.RoomType} eliminati", Severity.Success);
            await LoadListAsync();
            StateHasChanged(); // Force UI refresh della grid
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante l'eliminazione: {ex.Message}", Severity.Error);
            // Ricarica per mostrare lo stato reale dopo eventuale rollback
            await LoadListAsync();
            StateHasChanged(); // Force UI refresh anche in caso di errore
        }
    }

    private async Task DeleteRoom(RoomCardViewModel room)
    {
        // Prima conferma: elimina solo camera o anche partecipanti?
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            { "ContentText", $"Vuoi eliminare la camera {room.RoomType}?\n\n" +
                            $"Occupanti: {string.Join(", ", room.OccupantNames)}\n\n" +
                            $"Scegli un'opzione:" },
            { "ButtonText", "Annulla" },
            { "Color", Color.Primary }
        };

        // Mostra dialog con 3 opzioni
        bool? result = await DialogService.ShowMessageBox(
            "Elimina Camera",
            (MarkupString)($"⚠️ Vuoi eliminare la camera <b>{room.RoomType}</b>?<br/><br/>" +
                          $"<b>Occupanti:</b> {string.Join(", ", room.OccupantNames)}<br/><br/>" +
                          $"Cosa vuoi fare con i partecipanti?"),
            yesText: "Elimina Solo Camera",
            noText: "Elimina Camera e Partecipanti",
            cancelText: "Annulla");

        if (result == true)
        {
            // Elimina solo la camera, partecipanti restano iscritti
            try
            {
                await AlloggiService.RemoveAccommodationAsync(room.RoomId);
                Snackbar.Add($"Camera {room.RoomType} eliminata. Partecipanti ancora iscritti.", Severity.Success);
                await LoadListAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante l'eliminazione: {ex.Message}", Severity.Error);
            }
        }
        else if (result == false)
        {
            // Elimina camera E partecipanti
            try
            {
                // Prima elimina la camera
                await AlloggiService.RemoveAccommodationAsync(room.RoomId);

                // Poi elimina tutti i partecipanti della camera
                foreach (var occupantId in room.OccupantIds)
                {
                    await MovClientiService.RemoveParticipantAsync(ViaggioId, DataViaggioId, occupantId);
                }

                Snackbar.Add($"Camera {room.RoomType} e {room.OccupantIds.Count} partecipanti eliminati dal viaggio", Severity.Success);
                await LoadListAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante l'eliminazione: {ex.Message}", Severity.Error);
                // Ricarica per mostrare stato reale dopo eventuale rollback
                await LoadListAsync();
            }
        }
        // else: null = Annulla, non fare nulla
    }

