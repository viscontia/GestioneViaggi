@using GestioneViaggi.Helpers

@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Models.DTOs
@using MudBlazor
@using System.IO
@using GestioneViaggi.Services.Printing
@inject MovClientiViaggiService MovClientiService
@inject MovClientiAlloggiService AlloggiService
@inject AnaViaggiService ViaggiService
@inject TipoPartecipanteService TipoPartecipanteService
@inject TipoAlloggioService TipoAlloggioService
@inject IClienteService ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject Services.Printing.IRoomingListPrintService RoomingListPrintService
@inject GestioneViaggi.Services.Printing.RoomingListStampaService RoomingListStampaService
@inject GestioneViaggi.Services.Printing.SchedaViaggioStampaService SchedaViaggioStampaService
@inject GestioneViaggi.Services.CRUD.DocumentiPartecipantiService DocumentiPartecipanti

@* Il titolo NON si disegna qui con <TitleContent>: quel frammento viene reso una volta dal
   contenitore del dialogo e non si aggiorna quando il componente ricarica i dati — per questo
   restava "Caricamento..." anche a elenco caricato. Si usa invece SetTitleAsync, l'API prevista
   da MudBlazor proprio per i titoli che dipendono da un valore interno al dialogo; nella sua
   documentazione è scritto che non ha effetto se TitleContent è impostato. *@
<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-3" Style="height: 88vh; overflow-y: hidden;">
            <MudGrid Style="height: 100%;">

                <!-- LEFT PANEL: TABS (60%) -->
                <MudItem xs="12" md="7" Style="height: 100%; overflow-y: auto;">
                    <MudPaper Elevation="0" Class="pa-2 h-100 d-flex flex-column">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.h6">
                                @if (!string.IsNullOrEmpty(_summaryTitle))
                                {
                                        <span>@_summaryTitle</span>
                                }
                                else
                                {
                                        <span>Gestione Viaggio</span>
                                }
                            </MudText>
                            <div class="d-flex gap-2">
                                <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                                    <MudButton StartIcon="@Icons.Material.Filled.Print" Variant="Variant.Filled" Color="Color.Primary">Stampe</MudButton>
                                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowDropDown" Style="min-width: 32px; padding: 0;" />
                                        </ActivatorContent>
                                        <ChildContent>
                                            <MudMenuItem OnClick="OnStampaSchedaViaggioClick">
                                                <MudText Typo="Typo.body1" Style="font-size: 16px !important;">Stampa Scheda Data Viaggio</MudText>
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="OnStampaDettaglioViaggioClick">
                                                <MudText Typo="Typo.body1" Style="font-size: 16px !important;">Stampa Dettaglio Data Viaggio</MudText>
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="OnStampaRoomingListClick">
                                                <MudText Typo="Typo.body1" Style="font-size: 16px !important;">Stampa Rooming List</MudText>
                                            </MudMenuItem>
                                        </ChildContent>
                                    </MudMenu>
                                </MudButtonGroup>

                                @* Su una partenza conclusa non si iscrive piu' nessuno. Il pulsante non
                                   sparisce, si spegne e dice perche': un comando che scompare lascia
                                   pensare a un guasto. Il rifiuto vero e' a database (SqlScripts/578). *@
                                @* Il motivo lo dice il database: «conclusa», «già iniziata» o
                                   «già effettuata» sono situazioni diverse, e chi legge deve
                                   riconoscere la propria. *@
                                <MudTooltip Text="@(_motivoNonIscrivibile ?? "Aggiungi un partecipante")">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               Disabled="@_partenzaConclusa"
                                               OnClick="@(async () => await ResetForm())">
                                        Nuovo
                                    </MudButton>
                                </MudTooltip>
                            </div>
                        </div>

                        @if (_isLoadingList)
                        {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        }
                        else
                        {
                                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" Centered="true">

                                    <!-- TAB 1: PARTECIPANTI -->
                                    <MudTabPanel>
                                        <TabContent>
                                            <div class="d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Partecipanti (@_participantsCount)</MudText>
                                            </div>
                                        </TabContent>
                                        <ChildContent>
                                            <MudSimpleTable Dense="true" Hover="true" Striped="true" Bordered="true"
                                                            FixedHeader="true" Style="font-size: 15px;">
                                                <thead>
                                                    <tr>
                                                        <th style="padding: 4px 8px; width: 30px;"></th>
                                                        <th style="padding: 4px 8px; min-width: 180px;">Nominativo</th>
                                                        <th style="padding: 4px 8px; min-width: 150px;">Ruolo</th>
                                                        <th style="padding: 4px 8px; min-width: 200px;">Veicolo</th>
                                                        <th style="padding: 4px 8px; width: 80px; text-align: center;">Info</th>
                                                        <th style="padding: 4px 8px; width: 100px; text-align: center;">Azioni</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var participant in _participants)
                                                {
                                                    var isPilot = participant.ClienteId == participant.GroupingKey;
                                                    // Stile riga: 
                                                    // - Pilota: Sfondo Tinta Primary molto leggero (funziona sia Light che Dark)
                                                    // - Passeggero: Sfondo standard
                                                    var rowStyle = isPilot 
                                                        ? "background-color: rgba(var(--mud-palette-primary-rgb), 0.04); border-top: 2px solid var(--mud-palette-divider); font-weight: 600;" 
                                                        : "background-color: transparent;";

                                                    // Il documento non arriva valido alla fine del viaggio. Rosso per chi
                                                    // non puo' partire (mancante o gia' scaduto), giallo per chi scade
                                                    // DURANTE: sono due telefonate diverse, e con un colore solo si
                                                    // perderebbe la differenza. Tinte tenui, perche' la riga si deve
                                                    // ancora leggere: e' un elenco di lavoro, non un allarme.
                                                    var documento = DocumentiDaSistemare.GetValueOrDefault(participant.ClienteId);
                                                    if (documento is not null)
                                                    {
                                                        rowStyle += documento.Impedisce
                                                            ? " background-color: rgba(211, 47, 47, 0.16); border-left: 4px solid #d32f2f;"
                                                            : " background-color: rgba(237, 108, 2, 0.14); border-left: 4px solid #ed6c02;";
                                                    }

                                                    <tr style="@rowStyle">
                                                        <!-- Icona Tipo -->
                                                        <td style="padding: 4px 8px; text-align: center;">
                                                            @if (isPilot)
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.SportsMotorsports" Color="Color.Primary" Size="Size.Small" Style="font-size: 1.1rem;" />
                                                            }
                                                            else
                                                            {
                                                                 // Icona o spazio per passeggero (Gestito nell'indentazione del nome)
                                                            }
                                                        </td>

                                                        <!-- Nominativo -->
                                                        <td style="padding: 4px 8px;">
                                                            @if (documento is not null)
                                                            {
                                                                <MudTooltip Text="@documento.Messaggio">
                                                                    <MudIcon Icon="@Icons.Material.Filled.Badge"
                                                                             Color="@(documento.Impedisce ? Color.Error : Color.Warning)"
                                                                             Size="Size.Small" Class="mr-1"
                                                                             Style="vertical-align: text-bottom;" />
                                                                </MudTooltip>
                                                            }
                                                            @if (isPilot)
                                                            {
                                                                <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight: 700;">
                                                                    @participant.Nominativo
                                                                </MudText>
                                                            }
                                                            else
                                                            {
                                                                // Indentazione visiva per i passeggeri
                                                                <div class="d-flex align-center">
                                                                    <!-- Linea guida visiva -->
                                                                    <div style="
                                                                        width: 20px; 
                                                                        height: 24px; 
                                                                        margin-left: 8px; 
                                                                        border-left: 2px solid var(--mud-palette-divider); 
                                                                        border-bottom: 2px solid var(--mud-palette-divider);
                                                                        border-bottom-left-radius: 8px;
                                                                        margin-right: 8px;
                                                                        opacity: 0.5;">
                                                                    </div>
                                                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-primary);">
                                                                        @participant.Nominativo
                                                                    </MudText>
                                                                </div>
                                                            }
                                                        </td>

                                                        <!-- Ruolo -->
                                                        <td style="padding: 4px 8px;">
                                                            @if (isPilot)
                                                            {
                                                                // Pilota: Evidenziato con Chip Filled per massimo contrasto
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Style="font-weight: 600; border-radius: 4px;">
                                                                    @GetDisplayRole(participant.Ruolo)
                                                                </MudChip>
                                                            }
                                                            else
                                                            {
                                                                // Passeggero: Testo light e ruolo semplificato
                                                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); white-space: nowrap;">
                                                                    @GetDisplayRole(participant.Ruolo)
                                                                </MudText>
                                                            }
                                                        </td>

                                                        <!-- Veicolo -->
                                                        <td style="padding: 4px 8px;">
                                                            @if (isPilot && !string.IsNullOrEmpty(participant.MezzoDettagli))
                                                            {
                                                                <div class="d-flex align-center gap-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.9rem;" />
                                                                    <MudText Typo="Typo.body2" Style="font-size: 0.95rem; font-weight: 500;">@participant.MezzoDettagli</MudText>
                                                                </div>
                                                            }
                                                        </td>

                                                        <!-- Info (Note, Cane, Intolleranze) -->
                                                        <td style="padding: 4px 8px; text-align: center;">
                                                            <div class="d-flex align-center justify-center gap-1">
                                                                @if (!string.IsNullOrEmpty(participant.Note))
                                                                {
                                                                    <MudTooltip Text="@participant.Note">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Note" Size="Size.Small" Color="Color.Info" Style="font-size: 0.9rem;" />
                                                                    </MudTooltip>
                                                                }
                                                                @if (participant.CaneSino == "Y")
                                                                {
                                                                    <MudTooltip Text="Viaggia con Cane">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Small" Color="Color.Warning" Style="font-size: 0.9rem;" />
                                                                    </MudTooltip>
                                                                }
                                                                @if (!string.IsNullOrEmpty(participant.Intolleranze))
                                                                {
                                                                    <MudTooltip Text="@($"Intolleranze: {participant.Intolleranze}")">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" Color="Color.Error" Style="font-size: 0.9rem;" />
                                                                    </MudTooltip>
                                                                }
                                                            </div>
                                                        </td>

                                                        <!-- Azioni -->
                                                        <td style="padding: 4px 8px; text-align: center;">
                                                            <div class="d-flex align-center justify-center gap-1">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => LoadForEdit(participant))" Style="width: 28px; height: 28px;" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteParticipant(participant))" Style="width: 28px; height: 28px;" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            </MudSimpleTable>

                                            @* Perche' quelle righe sono colorate. L'icona con il tooltip dice il
                                               caso singolo, ma va cercata riga per riga: chi apre l'elenco e vede
                                               due colori vuole sapere subito cosa distingue l'uno dall'altro.
                                               Compare solo quando serve, altrimenti spiegherebbe il nulla. *@
                                            @if (DocumentiDaSistemare.Count > 0)
                                            {
                                                <div class="d-flex align-center flex-wrap gap-4 mt-2 px-2">
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary"><b>Colori:</b></MudText>
                                                    @if (DocumentiDaSistemare.Values.Any(d => d.Impedisce))
                                                    {
                                                        <div class="d-flex align-center gap-2">
                                                            <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background-color:rgba(211,47,47,0.16);border-left:4px solid #d32f2f;"></span>
                                                            <MudText Typo="Typo.caption">
                                                                Documento mancante o scaduto: <b>non può partire</b>
                                                            </MudText>
                                                        </div>
                                                    }
                                                    @if (DocumentiDaSistemare.Values.Any(d => !d.Impedisce && !d.SenzaRecapito))
                                                    {
                                                        <div class="d-flex align-center gap-2">
                                                            <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background-color:rgba(237,108,2,0.14);border-left:4px solid #ed6c02;"></span>
                                                            <MudText Typo="Typo.caption">
                                                                Documento in scadenza <b>durante</b> il viaggio: parte, ma va avvisato
                                                            </MudText>
                                                        </div>
                                                    }
                                                    @if (DocumentiDaSistemare.Values.Any(d => d.SenzaRecapito))
                                                    {
                                                        <div class="d-flex align-center gap-2">
                                                            <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background-color:rgba(237,108,2,0.14);border-left:4px solid #ed6c02;"></span>
                                                            <MudText Typo="Typo.caption">
                                                                Guida <b>senza email né telefono</b>: non c'è modo di avvisarlo
                                                            </MudText>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </ChildContent>
                                    </MudTabPanel>

                                    <!-- TAB 2: ALLOGGI -->
                                    <MudTabPanel>
                                        <TabContent>
                                            <div class="d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Hotel" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Alloggi (@_roomsCount)</MudText>
                                            </div>
                                        </TabContent>
                                        <ChildContent>
                                            <!-- Warning Partecipanti Senza Camera -->
                                            @* ⚠️ Senza questo pulsante, la gestione alloggi si apriva SOLO dalla
                                               matita di una camera esistente: con zero camere non ci si arrivava
                                               affatto, e comporre una sistemazione da piu' posti era impossibile
                                               dall'interfaccia. «Questa funzionalita' forse esiste a codice, ma
                                               nella interfaccia non esiste» (Adriano, 2026-09-06). *@
                                            <div class="d-flex justify-end mb-2">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Hotel"
                                                           OnClick="@(() => OpenAdvancedAccommodation())">
                                                    Componi le sistemazioni
                                                </MudButton>
                                            </div>

                                        @if (_participantsWithoutRoom.Any())
                                        {
                                                    @* L'elenco con i pulsanti sta nella linguetta «Partecipanti senza
                                                       camere», che si vede appena si entra. Qui basta il richiamo: due
                                                       posti con lo stesso pulsante sono due posti da tenere allineati. *@
                                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" Style="padding: 8px;">
                                                        <b>⚠️ @_participantsWithoutRoom.Count senza camera:</b> @string.Join(", ", _participantsWithoutRoom.Select(p => p.Nominativo).Take(3))@(_participantsWithoutRoom.Count > 3 ? $" +{_participantsWithoutRoom.Count - 3} altri" : "")
                                                    </MudAlert>
                                        }

                                            <!-- Sezione Alloggi Assegnati - Raggruppata per Tipo -->
                                        @if (_existingRooms.Any())
                                        {
                                            var roomsByType = _existingRooms
                                                .GroupBy(r => r.RoomType)
                                                .OrderBy(g => g.Key);

                                            @foreach (var roomGroup in roomsByType)
                                            {
                                                var groupRooms = roomGroup.OrderBy(r => r.PilotCognome).ToList();
                                                var hasSupplementInGroup = groupRooms.Any(r => r.HasSupplement);

                                                            <!-- Header Tipologia -->
                                                            <div style="background-color: var(--mud-palette-background); padding: 4px 8px; margin-top: 4px; border-left: 3px solid var(--mud-palette-primary); border-radius: 4px;">
                                                                <MudText Typo="Typo.caption" Style="font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">
                                                        @roomGroup.Key (@groupRooms.Count)
                                                        @if (hasSupplementInGroup)
                                                        {
                                                                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Color="Color.Warning" Style="font-size: 0.75rem; margin-left: 4px;" />
                                                        }
                                                                </MudText>
                                                            </div>

                                                            <!-- Camere del gruppo -->
                                                            <MudSimpleTable Dense="true" Style="font-size: 0.75rem; margin-bottom: 8px;">
                                                                <tbody>
                                                        @foreach (var room in groupRooms)
                                                        {
                                                                            <tr style="border-bottom: 1px solid var(--mud-palette-divider-light);">
                                                                                <td style="padding: 4px 8px; width: 50px; text-align: center;">
                                                                                    <MudIcon Icon="@room.StatusIcon" Size="Size.Small" Color="@room.StatusColor" Style="font-size: 0.9rem;" />
                                                                                </td>
                                                                                <td style="padding: 4px 8px; width: 70px; text-align: center;">
                                                                                    <MudChip T="string" Size="Size.Small" Color="@room.StatusColor" Variant="Variant.Text" Style="font-size: 0.65rem; height: 18px; padding: 0 6px;">
                                                                        @room.StatusText
                                                                                    </MudChip>
                                                                                </td>
                                                                                <td style="padding: 4px 8px;">
                                                                    @if (room.OccupantNames.Any())
                                                                    {
                                                                        var hasPilot = room.PilotCognome != "ZZZZZ";
                                                                        for (var i = 0; i < room.OccupantNames.Count; i++)
                                                                        {
                                                                            if (i > 0) { <text>, </text> }
                                                                            if (i == 0 && hasPilot)
                                                                            {
                                                                                <strong>@room.OccupantNames[i]</strong>
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>@room.OccupantNames[i]</text>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                                            <span style="opacity: 0.5; font-style: italic;">vuota</span>
                                                                    }
                                                                                </td>
                                                                                <td style="padding: 4px 8px; width: 80px; text-align: center;">
                                                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditRoom(room))" Style="width: 28px; height: 28px; margin-right: 4px;" />
                                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteRoom(room))" Style="width: 28px; height: 28px;" />
                                                                                </td>
                                                                            </tr>
                                                        }
                                                                </tbody>
                                                            </MudSimpleTable>
                                            }
                                        }
                                        else
                                        {
                                                    <MudAlert Severity="Severity.Info" Dense="true">
                                                        Nessuna camera assegnata per questo viaggio
                                                    </MudAlert>
                                        }
                                        </ChildContent>
                                    </MudTabPanel>

                                    @* ⚠️ TAB 3: chi non ha una sistemazione, e da qui si rimedia.
                                       Compare SOLO se ce n'è qualcuno: una linguetta «(0)» sempre
                                       accesa insegna a non guardarla. Sta accanto agli altri due e
                                       non dentro gli Alloggi perché il problema si deve vedere
                                       ENTRANDO, senza dover aprire il tab giusto — chiesto da
                                       Adriano il 2026-09-06: «così si vede subito immediatamente
                                       che ci sono delle situazioni anomale». *@
                                    @if (_participantsWithoutRoom.Any())
                                    {
                                        <MudTabPanel>
                                            <TabContent>
                                                <div class="d-flex align-center gap-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                                                    <MudText Typo="Typo.body2">
                                                        Partecipanti senza camere (@_participantsWithoutRoom.Count)
                                                    </MudText>
                                                </div>
                                            </TabContent>
                                            <ChildContent>
                                                <MudSimpleTable Dense="true" Hover="true" Striped="true" Bordered="true"
                                                                FixedHeader="true" Style="font-size: 15px;">
                                                    <thead>
                                                        <tr>
                                                            <th style="padding: 4px 8px; min-width: 180px;">Nominativo</th>
                                                            <th style="padding: 4px 8px; min-width: 150px;">Ruolo</th>
                                                            <th style="padding: 4px 8px; min-width: 200px;">Veicolo</th>
                                                            <th style="padding: 4px 8px; width: 130px; text-align: center;">Azioni</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var senza in _participantsWithoutRoom)
                                                        {
                                                            <tr>
                                                                <td style="padding: 4px 8px;"><b>@senza.Nominativo</b></td>
                                                                <td style="padding: 4px 8px;">
                                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@senza.Ruolo</MudChip>
                                                                </td>
                                                                <td style="padding: 4px 8px;">@senza.MezzoDettagli</td>
                                                                <td style="padding: 4px 8px; text-align: center;">
                                                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                                               StartIcon="@Icons.Material.Filled.Hotel"
                                                                               OnClick="@(() => AssegnaSenzaCamera(senza))">
                                                                        Assegna
                                                                    </MudButton>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            </ChildContent>
                                        </MudTabPanel>
                                    }

                                </MudTabs>
                        }
                    </MudPaper>
                </MudItem>

                <!-- RIGHT PANEL: EDIT/ADD (40%) -->
                <MudItem xs="12" md="5" Style="height: 100%; overflow-y: auto; border-left: 1px solid var(--mud-palette-divider);">
                    <MudPaper Elevation="0" Class="pa-3 h-100">
                         <MudText Typo="Typo.h6" Class="mb-3">@(_isEditMode ? "Modifica Partecipante" : "Nuovo Inserimento")</MudText>

                             @* ⚠️ La chiave cambia a ogni svuotata, e Blazor rifà TUTTA la scheda da
                                zero invece di riusarla. Azzerare i valori non basta: i campi di
                                ricerca tengono il testo scritto — dopo «Salva e Nuovo» restavano
                                «VISCONTI ADRIANO» e «GUIDA» con dentro nulla, e chi salvava credeva
                                di aver scelto qualcosa che non era più selezionato.

                                ⚠️ Sta sulla scheda intera e non sui singoli campi perché mettercela
                                uno alla volta è una caccia senza fine: il 2026-09-06 ho corretto il
                                ruolo e si è sporcato il cliente. Dietro ci sono anche marca, modello
                                e pilota, che hanno lo stesso comportamento.

                                ⚠️ Provato prima a svuotare i campi dall'interno (ClearAsync su
                                BaseEntitySelect): peggio — li segnava come toccati, quindi una scheda
                                appena aperta mostrava «Il ruolo è obbligatorio» in rosso, e su tutte
                                e ~35 le tendine del gestionale. Rifare il componente azzera anche lo
                                stato di validazione, che è metà del problema. *@
                             <MudForm @key="_chiaveScheda" @ref="_form" Model="@_currentEntity">

                                 <!-- 1. Selection Cliente -->
                                 <ClienteSelect @bind-SelectedCliente="_selectedCliente"
                                                AziendaId="@AziendaId"
                                                InputId="campo-cliente-iscrizione"
                                                Required="true" 
                                                RequiredError="Selezionare un cliente"
                                                Disabled="@_isEditMode" 
                                                Class="mb-3" />

                                 @if (_selectedCliente != null)
                                 {
                                     <div class="d-flex gap-4 mb-3" style="opacity: 0.75;">
                                         @if (!string.IsNullOrEmpty(_selectedCliente.Email))
                                         {
                                             <div class="d-flex align-center gap-1">
                                                 <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                                                 <MudText Typo="Typo.body2">@_selectedCliente.Email</MudText>
                                             </div>
                                         }
                                         @if (!string.IsNullOrEmpty(_selectedCliente.Telefono))
                                         {
                                             <div class="d-flex align-center gap-1">
                                                 <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                                                 <MudText Typo="Typo.body2">@($"{_selectedCliente.PrefTelInt} {_selectedCliente.Telefono}".Trim())</MudText>
                                             </div>
                                         }
                                     </div>
                                 }

                                 <!-- 2. Trip Config -->
                                 <MudGrid Spacing="2">
                                     <MudItem xs="6">
                                         <TipoPartecipanteSelect
                                                                 SelectedId="@(_currentEntity.TipoPartecipanteIdFk == 0 ? (int?)null : _currentEntity.TipoPartecipanteIdFk)"
                                                                 SelectedIdChanged="@OnRoleChangedAsync"
                                                                 Required="true"
                                                                 Items="@_tipoPartecipanti" />
                                 </MudItem>
                                 <MudItem xs="6" Class="d-flex align-center">
                                     <MudCheckBox @bind-Value="@_hasDog" Label="Con Cane" Color="Color.Warning" Dense="true" />
                                 </MudItem>
                             </MudGrid>

                             <!-- Pilot Selection (Visible only if NOT Pilot) -->
                            @if (_currentEntity.TipoPartecipanteIdFk > 0 && !IsPilot(_currentEntity.TipoPartecipanteIdFk))
                            {
                                     <MudSelect T="int?" Label="Assegnato al Veicolo di" @bind-Value="_currentEntity.ClientePilotaIdFk" 
                                                Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                                                Clearable="true" AdornmentIcon="@Icons.Material.Filled.SportsMotorsports">
                                    @foreach (var p in _participants.Where(x => IsPilot(x.TipoPartecipanteId)))
                                    {
                                                 <MudSelectItem T="int?" Value="@p.ClienteId">@p.Nominativo</MudSelectItem>
                                    }
                                     </MudSelect>
                            }

                             <MudTextField @bind-Value="_currentEntity.MovClienteViaggioNote" Label="Note Viaggio" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mt-3" />

                             <!-- Vehicle Config (Visible only if Pilot) -->
                            @if (IsPilot(_currentEntity.TipoPartecipanteIdFk))
                            {
                                     @* I tre dati del mezzo stanno in un componente condiviso: la stessa
                                        regola vale anche per l'Iscrizione Veloce, e una regola in due
                                        copie prima o poi diverge. *@
                                     <DatiMezzoPartecipante Entity="_currentEntity" />

                                     <MudGrid Spacing="2" Class="mt-1">
                                         <MudItem xs="6">
                                             <MudNumericField @bind-Value="_currentEntity.MovClienteViaggioScontovalTotale" 
                                                              Label="Sconto Totale (€)" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                              Min="0" HideSpinButtons="true" Format="N2" />
                                         </MudItem>
                                     </MudGrid>
                            }

                            @if (!_isEditMode)
                            {
                                     <MudDivider Class="my-3" />

                                     <!-- 3. Accommodation Config (Solo in INSERT mode) -->
                                     <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Hotel" Color="Color.Primary" Size="Size.Small" />
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Alloggio</b></MudText>
                                        </div>
                                        <MudSwitch @bind-Value="@_wantsAccommodation"
                                                   @bind-Value:after="@OnWantsAccommodationChangedAsync"
                                                   Label="@(_wantsAccommodation ? "Assegna camera" : "No")"
                                                   Color="Color.Success" />
                                     </div>

                                @if (_wantsAccommodation)
                                {
                                         <MudPaper Class="pa-3" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">

                                             <!-- Scelta: Camera Esistente o Nuova -->
                                             <MudRadioGroup @bind-Value="_assignToExistingRoom" @bind-Value:after="@OnAssignToExistingRoomChangedAsync" Class="mb-3">
                                                 <MudRadio T="bool" Value="true" Color="Color.Primary" Dense="true">
                                                     Aggiungi a camera esistente
                                                 </MudRadio>
                                                 <MudRadio T="bool" Value="false" Color="Color.Primary" Dense="true">
                                                     Crea nuova camera
                                                 </MudRadio>
                                             </MudRadioGroup>

                                        @if (_assignToExistingRoom)
                                        {
                                                     <!-- Opzione 1: Seleziona Camera Esistente -->
                                            @* ⚠️ Anche le camere PIENE: chi arriva dopo — la moglie che prima
                                               aveva detto di no — deve poter dormire con chi c'è già. Prima
                                               qui comparivano solo quelle con posti liberi, e per una coppia
                                               non ce n'erano mai: l'unica via era registrarla in una singola
                                               finta e poi riabbinarla. Un giro che si dimentica. *@
                                            var availableRooms = _existingRooms.ToList();

                                            @if (availableRooms.Any())
                                            {
                                                             <MudSelect T="int?" Label="Seleziona Camera"
                                                @bind-Value="_selectedExistingRoomId"
                                                @bind-Value:after="ScegliCameraEsistente"
                                                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                       Required="true">
                                                    @foreach (var room in availableRooms)
                                                    {
                                                                         <MudSelectItem T="int?" Value="@room.RoomId">
                                                                             <div class="d-flex align-center justify-space-between width-100">
                                                                                 <span>@room.RoomType - @string.Join(", ", room.OccupantNames)</span>
                                                                                 <MudChip T="string" Size="Size.Small" Color="@room.StatusColor" Variant="Variant.Text">
                                                                    @room.StatusText
                                                                                 </MudChip>
                                                                             </div>
                                                                         </MudSelectItem>
                                                    }
                                                             </MudSelect>

                                                @if (_selectedExistingRoomId.HasValue)
                                                {
                                                    var selectedRoom = _existingRooms.FirstOrDefault(r => r.RoomId == _selectedExistingRoomId.Value);
                                                    @if (selectedRoom != null && selectedRoom.IsFull)
                                                    {
                                                        @* La capienza resta rigorosa: non si aggiunge una persona a una
                                                           camera piena, si CAMBIA la camera con una che li contiene.
                                                           ⚠️ Ma QUALE si sceglie qui: due persone possono volere una
                                                           matrimoniale o due letti singoli, e non è il programma a
                                                           deciderlo — «chi ha deciso che deve essere matrimoniale?»
                                                           (Adriano, 2026-09-06). L'elenco è ristretto alla capienza
                                                           giusta, la scelta dentro è di chi lavora. *@
                                                                             <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                                                                 <b>@selectedRoom.RoomType</b> è al completo
                                                                                 (@selectedRoom.StatusText). Per stare insieme a
                                                                                 @string.Join(", ", selectedRoom.OccupantNames)
                                                                                 la camera va cambiata:
                                                                             </MudAlert>

                                                                             <TipoAlloggioSelect DataViaggioId="@DataViaggioId"
                                                                                                 CapienzaEsatta="@(selectedRoom.CurrentOccupants + 1)"
                                                                                                 PersoneDaSistemare="@(selectedRoom.CurrentOccupants + 1)"
                                                                                                 SelectedId="@_ingrandimentoId"
                                                                                                 SelectedIdChanged="@OnIngrandimentoChanged"
                                                                                                 SelectedItemChanged="@(t => _ingrandimento = t)"
                                                                                                 Label="La camera diventa"
                                                                                                 Required="true"
                                                                                                 Class="mt-2" />
                                                    }
                                                    else if (selectedRoom != null)
                                                    {
                                                                             <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                                                                 Camera: <b>@selectedRoom.RoomType</b><br/>
                                                                                 Occupanti attuali: @string.Join(", ", selectedRoom.OccupantNames)<br/>
                                                                                 Dopo assegnazione: @(selectedRoom.CurrentOccupants + 1)/@selectedRoom.MaxOccupants
                                                                             </MudAlert>

                                                        @if (selectedRoom.HasSupplement)
                                                        {
                                                                                     <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                                                                         💡 Questa camera prevede un supplemento aggiuntivo
                                                                                     </MudAlert>
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                var cameraDelPilota = CameraDelPilotaScelto();
                                                @if (cameraDelPilota != null)
                                                {
                                                                 @* ⚠️ «Crea una nuova camera» qui e' un consiglio che costa: per una
                                                                    coppia produce DUE camere e DUE supplementi, e nessuno lo impedisce —
                                                                    due singole con un occupante ciascuna sono valide quanto una
                                                                    matrimoniale. Se il pilota a cui si sta abbinando ha una camera piena,
                                                                    la strada giusta e' quasi sempre cambiare QUELLA. *@
                                                                 <MudAlert Severity="Severity.Warning" Dense="true">
                                                                     <b>@cameraDelPilota.OccupantNames.FirstOrDefault()</b> ha una
                                                                     <b>@cameraDelPilota.RoomType</b>, già al completo
                                                                     (@cameraDelPilota.StatusText).<br/>
                                                                     Se devono stare <b>insieme</b>, cambia quella camera con la matita
                                                                     qui sopra — creandone una seconda si pagano due sistemazioni.
                                                                 </MudAlert>
                                                }
                                                else
                                                {
                                                                 <MudAlert Severity="Severity.Warning" Dense="true">
                                                                     Nessuna camera con posti liberi: qui puoi solo crearne una nuova,
                                                                     oppure fare spazio in una di quelle che ci sono.
                                                                 </MudAlert>
                                                }
                                            }
                                        }
                                        else
                                        {
                                                     <!-- Opzione 2: Crea Nuova Camera -->
                                                     @* ⚠️ Ristretta alla capienza di CHI SI STA ISCRIVENDO. Senza questo
                                                        filtro si poteva creare una MATRIMONIALE per una persona sola —
                                                        successo davvero il 2026-09-06, camera 4887 — cioe' proprio la
                                                        scappatoia vietata: «le camere vanno assegnate in modo rigoroso sul
                                                        rapporto persone/capienza». Questa strada non passava da nessun
                                                        controllo di capienza: quello vive nella gestione alloggi.
                                                        Per dormire con qualcun altro non si crea una camera piu' grande
                                                        vuota a meta': si sceglie «aggiungi a camera esistente». *@
                                                     @* ⚠️ Nessuna proposta finché non si sa PER CHI: su una scheda appena
                                                        svuotata compariva già CAMERA SINGOLA, con sotto un riquadro verde
                                                        che diceva «Primo occupante: …» perché non c'era nessuno. Una
                                                        proposta prima della persona non è un aiuto: sembra un residuo
                                                        dell'inserimento precedente, ed è indistinguibile da uno. *@
                                                     <TipoAlloggioSelect DataViaggioId="@DataViaggioId"
                                                                         @bind-SelectedId="_currentAlloggio.TipoAlloggioIdFk"
                                                                         SelectedItemChanged="@(t => _tipoScelto = t)"
                                                                         CapienzaEsatta="@DimensioneGruppo()"
                                                                         PersoneDaSistemare="@(_selectedCliente is null ? 0 : DimensioneGruppo())"
                                                                         HelperText="@(_selectedCliente is null
                                                                             ? "Si compila da sé quando scegli la persona"
                                                                             : $"Per {DimensioneGruppo()} persona/e. Per dormire con altri, scegli «aggiungi a camera esistente»")"
                                                                         Required="true" />

                                            @if (_currentAlloggio.TipoAlloggioIdFk > 0)
                                            {
                                                var selectedTipo = _tipoScelto;
                                                @if (selectedTipo != null)
                                                {
                                                                     <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                                                         Nuova camera: <b>@selectedTipo.Descrizione</b><br/>
                                                                         Primo occupante: @(_selectedCliente != null ? $"{_selectedCliente.Cognome} {_selectedCliente.Nome}" : "...")<br/>
                                                                         Capacità: 1/@selectedTipo.NumeroOccupanti
                                                                     </MudAlert>

                                                    @if (selectedTipo.Supplemento)
                                                    {
                                                                             <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                                                                 💡 Questa camera prevede un supplemento aggiuntivo
                                                                             </MudAlert>
                                                    }
                                                }
                                            }
                                        }

                                             <MudText Typo="Typo.caption" Class="mt-2" Style="opacity: 0.7;">
                                                 💡 Usa il TAB "Alloggi" per gestire le camere
                                             </MudText>
                                         </MudPaper>
                                }
                            }
                            else
                            {
                                     <!-- In EDIT mode, mostra solo info alloggio corrente -->
                                     <MudDivider Class="my-3" />
                                     <MudAlert Severity="Severity.Info" Dense="true">
                                         <b>Per modificare gli alloggi, usa il TAB "Alloggi"</b>
                                     </MudAlert>
                            }

                             <!-- Actions -->
                             <div class="d-flex justify-end mt-4 gap-2">
                                @if (_isEditMode)
                                {
                                         <MudButton Variant="Variant.Outlined" OnClick="@(async () => await ResetForm())">Annulla Modifica</MudButton>
                                }
                                 @* Il pulsante non dipende dalla validita' della form.
                                    Legarcelo significava lasciare un comando spento senza dire
                                    perche': in modifica MudForm nasce non valida e ci restava,
                                    quindi «Aggiorna» era spento su dati corretti e cambiare le
                                    sole Note non bastava a riaccenderlo. Ora si preme sempre, e
                                    se manca qualcosa e' il salvataggio a dirlo. *@
                                 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">
                                    @(_isEditMode ? "Aggiorna" : "Salva e Nuovo")
                                 </MudButton>
                             </div>

                         </MudForm>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int DataViaggioId { get; set; }
    [Parameter] public int ViaggioId { get; set; }
    [Parameter] public int AziendaId { get; set; }

    // Models
    private MovClientiViaggi _currentEntity = new();
    private MovClientiAlloggi _currentAlloggio = new();
    private Cliente? _selectedCliente;

    // Lists & Lookups
    private List<ParticipantsViewDTO> _participants = new(); // Mapping from SP result (già ordinati dal DB)

    /// <summary>
    /// Chi, fra questi partecipanti, ha un documento che non arriva valido alla fine del
    /// viaggio — indicizzato per cliente, perche' la lista lo chiede riga per riga.
    /// Si rilegge a ogni caricamento: fra l'iscrizione e la partenza passano mesi, e un
    /// documento valido allora puo' non esserlo piu' adesso.
    /// </summary>
    private Dictionary<int, GestioneViaggi.Models.DocumentoNonValido> DocumentiDaSistemare = new();

    /// <summary>
    /// Se questa partenza e' gia' conclusa. Lo dice il database (<c>fn_partenza_conclusa</c>),
    /// non un confronto di date scritto qui: la stessa definizione blocca l'inserimento, e
    /// due definizioni diverse darebbero un pulsante attivo su cio' che poi viene rifiutato.
    /// </summary>
    private string? _motivoNonIscrivibile;
    private bool _partenzaConclusa => _motivoNonIscrivibile is not null;
    private List<ParticipantsViewDTO> _participantsWithoutRoom = new(); // NEW DB-CENTRIC: Caricati da get_participants_without_accommodation()
    private List<TipoPartecipante> _tipoPartecipanti = new();
    /// <summary>
    /// Il tipo scelto, comunicato da <see cref="TipoAlloggioSelect"/>. ⚠️ Al posto della
    /// lista `_tipoAlloggi` che questa scheda si portava dal blocco iniziale: quella lista
    /// conteneva TUTTO il catalogo, e su un viaggio in tenda offriva le camere d'albergo
    /// (prova D2). Ora l'elenco lo tiene il componente, che lo prende dalla partenza.
    /// </summary>
    private TipoAlloggio? _tipoScelto;

    /// <summary>
    /// Con che tipo diventerebbe la camera piena scelta, per farci stare anche la persona
    /// che si sta iscrivendo. <c>null</c> se per quel numero di persone il viaggio non
    /// prevede nessuna sistemazione.
    /// </summary>
    private TipoAlloggio? _ingrandimento;
    private int _ingrandimentoId;

    private void OnIngrandimentoChanged(int id) => _ingrandimentoId = id;
    private List<RoomCardViewModel> _existingRooms = new(); // Camere già create per questo viaggio
    private GestioneViaggi.Models.DTOs.ViaggioPartecipantiInitData _initData = new();

    // Counters from DB
    private int _participantsCount = 0; // DB: get_participants_count() - più efficiente di _participants.Count
    private int _roomsCount = 0; // DB: get_rooms_count() - più efficiente di _existingRooms.Count

    // UI State
    private MudForm _form = default!;
    private bool _isLoadingList = true;
    private bool _isEditMode = false;
    private bool _hasDog = false;
    private bool _wantsAccommodation = true; // Default true (90% case)
    private bool _assignToExistingRoom = false; // Se true, assegna a camera esistente
    private int? _selectedExistingRoomId = null; // ID camera esistente selezionata
    private bool _needsTabRefresh = false; // Flag per richiedere refresh Tab navigation dopo render


    // DTO for List
    // DTO for List is now in Models.DTOs namespace


    [Parameter] public string? HeaderTitle { get; set; }

    private string _summaryTitle = "";
    private string _headerTitle = "Caricamento...";

    protected override async Task OnInitializedAsync()
    {
        await MudDialog.SetTitleAsync("Caricamento...");
        await LoadListAsync(true);
    }

    private async Task OnStampaSchedaViaggioClick()
    {
        // Il controllo sui documenti lo fa SchedaViaggioStampaService, dopo la scelta del
        // tipo di scheda: cosi' vale anche per gli altri sei punti da cui si stampa.
        var parameters = new DialogParameters { ["DataViaggioId"] = DataViaggioId };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<StampaSchedaViaggioDialog>("Opzioni di Stampa", parameters, options);
    }

    private async Task OnStampaDettaglioViaggioClick()
    {
        // Flusso unico in SchedaViaggioStampaService: controllo documenti, generazione e
        // apertura. Era ripetuto in sette punti, e l'avviso sui documenti compariva da uno solo.
        await SchedaViaggioStampaService.StampaAsync(DataViaggioId, dettagliata: true);
    }

    private async Task OnStampaRoomingListClick()
    {
        if (DataViaggioId <= 0)
        {
            Snackbar.Add("Impossibile stampare: ID Viaggio non valido", Severity.Error);
            return;
        }

        // Flusso unico in RoomingListStampaService: controlli sugli abbinamenti, generazione
        // e apertura. Era ripetuto in cinque schermate, e i controlli sarebbero mancati in
        // quelle dimenticate.
        await RoomingListStampaService.StampaAsync(DataViaggioId);
    }

    private async Task LoadListAsync(bool isFullInit = false)
    {
        _isLoadingList = true;
        try
        {
            // Se è la prima volta o HeaderTitle è vuoto, chiediamo tutto
            _initData = await MovClientiService.GetPartecipantiInitDataAsync(ViaggioId, DataViaggioId);

            if (isFullInit || string.IsNullOrEmpty(_headerTitle) || _headerTitle == "Caricamento...")
            {
                _headerTitle = _initData.HeaderTitle;
                _tipoPartecipanti = _initData.TipoPartecipanti;
            }

            // Il titolo va aggiornato esplicitamente: il contenitore del dialogo non lo rilegge da solo.
            // Se il dato non arriva si lascia il titolo com'è, invece di svuotare l'intestazione.
            if (!string.IsNullOrWhiteSpace(_headerTitle))
                await MudDialog.SetTitleAsync(_headerTitle);

            _summaryTitle = _initData.SummaryTitle;
            _participants = _initData.Participants;

            var daSistemare = await DocumentiPartecipanti.DaSistemareAsync(DataViaggioId);
            DocumentiDaSistemare = daSistemare.ToDictionary(d => d.ClienteId);
            _motivoNonIscrivibile = await MovClientiService.MotivoNonIscrivibileAsync(DataViaggioId);
            _participantsWithoutRoom = _initData.ParticipantsWithoutRoom;
            _participantsCount = _initData.ParticipantsCount;
            _roomsCount = _initData.RoomsCount;
            
            // Mapping DTO -> ViewModel per la visualizzazione delle card camere
            _existingRooms = _initData.Rooms.Select(dto => new RoomCardViewModel
            {
                RoomId = dto.AlloggioPk,
                RoomType = dto.TipoAlloggio,
                RoomTypeId = dto.TipoAlloggioId,
                MaxOccupants = dto.MaxOccupants,
                CurrentOccupants = dto.CurrentOccupants,
                OccupantNames = dto.OccupantNames.ToList(),
                OccupantIds = dto.OccupantIds.ToList(),
                HasSupplement = dto.HasSupplement,
                PilotCognome = dto.PilotCognome,
                RoomEntity = new MovClientiAlloggi()
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento dati: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingList = false;
        }
    }

    private bool IsPilot(int tipoId)
    {
        // Use the database field tipo_partecipante_pilota instead of description
        var type = _tipoPartecipanti.FirstOrDefault(x => x.Id == tipoId);
        return type?.Pilota ?? false;
    }

    // Cache Pilot Type ID for UI highlighting
    private int _idPilota => _tipoPartecipanti.FirstOrDefault(x => x.Pilota)?.Id ?? 0;

    private TableGroupDefinition<ParticipantsViewDTO> _groupDefinition = new()
        {
            GroupName = "Equipaggio",
            Indentation = false,
            Expandable = true,
            IsInitiallyExpanded = true,
            Selector = (e) => e.GroupingKey
        };

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            // Tornare in silenzio lasciava l'utente davanti a un pulsante che non fa niente,
            // senza un modo per sapere quale campo lo rifiuta.
            var mancanti = _form.Errors is { Length: > 0 }
                ? string.Join(" · ", _form.Errors.Distinct())
                : "Controllare i campi obbligatori.";
            Snackbar.Add(mancanti, Severity.Warning);
            return;
        }

        if (_selectedCliente == null)
        {
            Snackbar.Add("Selezionare un cliente", Severity.Warning);
            return;
        }

        if (_currentEntity.TipoPartecipanteIdFk == 0)
        {
            Snackbar.Add("Selezionare il ruolo del partecipante (Pilota/Passeggero)", Severity.Warning);
            return;
        }

        try
        {
            // 1. Save Movimento Viaggio
            _currentEntity.ViaggioIdFk = ViaggioId;
            _currentEntity.DataViaggioIdFk = DataViaggioId;
            _currentEntity.ClienteIdFk = _selectedCliente.ClienteId;
            _currentEntity.MovClienteViaggioCaneSino = _hasDog ? "Y" : "N";

            // If Role is Link Pilot, ensure we haven't accidentally set a Parent Pilot (Circular/Invalid)
            if (IsPilot(_currentEntity.TipoPartecipanteIdFk))
            {
                _currentEntity.ClientePilotaIdFk = null;
            }

            // La validazione del database prima di scrivere: se manca l'email di chi guida
            // la chiede e la salva, invece di limitarsi a rifiutare l'iscrizione.
            if (!await IscrizionePartecipante.PuoProcedereAsync(
                    _currentEntity, _isEditMode, MovClientiService, ClienteService, DialogService, Snackbar))
                return;

            // ⚠️ Si chiede PRIMA di scrivere qualunque cosa: rispondendo «no» non deve restare
            // niente a metà — né l'iscrizione né la camera.
            if (!await CameraIndipendenteConfermataAsync()) return;

            if (_isEditMode)
            {
                await MovClientiService.UpdateParticipantAsync(_currentEntity);
                Snackbar.Add("Partecipante aggiornato", Severity.Success);
            }
            else
            {
                await MovClientiService.AddParticipantAsync(_currentEntity);
                Snackbar.Add("Partecipante aggiunto", Severity.Success);
            }

            // 3. Save Accommodation (Solo in INSERT mode, non in EDIT)
            // In EDIT mode, usa il TAB "Alloggi" per modificare le camere
            if (_wantsAccommodation && !_isEditMode)
            {
                if (_assignToExistingRoom && _selectedExistingRoomId.HasValue)
                {
                    var existingRoom = _existingRooms.FirstOrDefault(r => r.RoomId == _selectedExistingRoomId.Value);
                    if (existingRoom != null)
                    {
                        // ⚠️ Se la camera è piena non ci si infila dentro: la si CAMBIA con una
                        // che contiene tutti. La capienza resta rigorosa — le eccezioni con
                        // l'albergo restano fuori dal sistema (decisione del 2026-09-06).
                        if (existingRoom.IsFull && _ingrandimento == null)
                        {
                            Snackbar.Add($"«{existingRoom.RoomType}» è al completo: scegli con quale " +
                                         $"sistemazione da {existingRoom.CurrentOccupants + 1} posti sostituirla.",
                                         Severity.Error);
                            return;
                        }

                        // Una chiamata sola: cambio di tipo e nuovo occupante insieme, o tutto
                        // o niente. Prima erano due strade diverse — assegna a uno slot libero
                        // oppure aggiorna la camera — e la seconda non esisteva affatto.
                        await AlloggiService.SalvaCameraAsync(
                            new MovClientiAlloggi
                            {
                                MovClientiAlloggioPk = existingRoom.RoomId,
                                ViaggioIdFk = ViaggioId,
                                DataViaggioIdFk = DataViaggioId,
                                TipoAlloggioIdFk = _ingrandimento?.Id ?? existingRoom.RoomTypeId
                            },
                            existingRoom.OccupantIds.Append(_selectedCliente.ClienteId));

                        Snackbar.Add(_ingrandimento != null
                            ? $"Camera cambiata in {_ingrandimento.Descrizione}, con {existingRoom.CurrentOccupants + 1} occupanti"
                            : $"Partecipante aggiunto alla camera {existingRoom.RoomType}",
                            Severity.Success);
                    }
                }
                else if (!_assignToExistingRoom && _currentAlloggio.TipoAlloggioIdFk > 0)
                {
                    // Opzione 2: Crea nuova camera
                    // ⚠️ Passa dalla stessa funzione di tutte le altre scritture. Prima usava
                    // una strada sua (AddAccommodationAsync) che non controllava la capienza:
                    // da lì è nata la MATRIMONIALE con una persona sola del 2026-09-06.
                    _currentAlloggio.ViaggioIdFk = ViaggioId;
                    _currentAlloggio.DataViaggioIdFk = DataViaggioId;

                    await AlloggiService.SalvaCameraAsync(
                        _currentAlloggio, new[] { _selectedCliente.ClienteId });

                    var msg = _tipoScelto?.Supplemento == true
                        ? "Nuova camera creata (con supplemento)"
                        : "Nuova camera creata";
                    Snackbar.Add(msg, Severity.Success);
                }
            }
            else if (_isEditMode && !_wantsAccommodation && _currentAlloggio.MovClientiAlloggioPk > 0)
            {
                // Se in edit mode l'utente ha disattivato l'alloggio, rimuovi quello esistente
                await AlloggiService.RemoveAccommodationAsync(_currentAlloggio.MovClientiAlloggioPk);
                Snackbar.Add("Alloggio rimosso", Severity.Info);
            }

            // ⚠️ UNA sola svuotata, la stessa del pulsante «Nuovo». Qui c'era una SECONDA
            // copia, scritta a mano campo per campo: due copie divergono sempre, e chi ne
            // aggiunge uno nuovo lo mette in una delle due. «Salva e Nuovo» deve lasciare la
            // scheda esattamente come la lascia «Nuovo».
            await ResetForm();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Dettaglio diagnostico: mostra i valori inviati per identificare il campo problematico
            var diagInfo = $"[ViaggioId={_currentEntity.ViaggioIdFk}, DataId={_currentEntity.DataViaggioIdFk}, ClienteId={_currentEntity.ClienteIdFk}, TipoPartId={_currentEntity.TipoPartecipanteIdFk}, MarcaId={_currentEntity.AnaMezziIdFk?.ToString() ?? "null"}, ModelloId={_currentEntity.MezzoModelloIdFk?.ToString() ?? "null"}, PilotaId={_currentEntity.ClientePilotaIdFk?.ToString() ?? "null"}]";
            Snackbar.Add($"Errore salvataggio: {ex.Message} {diagInfo}", Severity.Error);
        }
    }

    private async Task LoadForEdit(ParticipantsViewDTO item)
    {
        try
        {
            _isEditMode = true;

            // Fetch full entity
            var list = await MovClientiService.GetByDateIdAsync(item.DataId);
            var entity = list.FirstOrDefault(x => x.ClienteIdFk == item.ClienteId);

            if (entity != null)
            {
                _currentEntity = entity;
            }

            // Fetch Client for Autocomplete
            _selectedCliente = await ClienteService.GetByIdAsync(item.ClienteId, AziendaId);


            _hasDog = _currentEntity.MovClienteViaggioCaneSino == "Y";

            // Fetch existing accommodation for this client
            var alloggi = await AlloggiService.GetByDateIdAsync(item.DataId);
            var existingAlloggio = alloggi.FirstOrDefault(a =>
                a.ClienteId1Fk == item.ClienteId ||
                a.ClienteId2Fk == item.ClienteId ||
                a.ClienteId3Fk == item.ClienteId ||
                a.ClienteId4Fk == item.ClienteId ||
                a.ClienteId5Fk == item.ClienteId ||
                a.ClienteId6Fk == item.ClienteId);

            if (existingAlloggio != null)
            {
                _currentAlloggio = existingAlloggio;
                _wantsAccommodation = true; // Cliente ha già un alloggio
            }
            else
            {
                _currentAlloggio = new MovClientiAlloggi();
                _wantsAccommodation = false; // Nessun alloggio assegnato
            }
        }
        catch (Exception ex)
        {
            _isEditMode = false; // Revert state
            Snackbar.Add($"CRITICAL ERROR LoadForEdit: {ex.Message} {ex.StackTrace}", Severity.Error);
        }
    }

