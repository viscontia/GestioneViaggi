@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject CountryOrganizationService CountryOrganizationService

<MudSelect T="int?"
           @ref="_selectRef"
           Value="@SelectedOrganizationId"
           ValueChanged="@SelectedOrganizationIdChanged"
           Label="@Label"
           Variant="Variant.Outlined"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           Class="@ComputedClass"
           HelperText="@HelperText"
           Placeholder="Seleziona organizzazione..."
           OpenIcon="@Icons.Material.Filled.ArrowDropDown"
           CloseIcon="@Icons.Material.Filled.ArrowDropDown"
           @attributes="AdditionalAttributes">
    @if (_organizations != null)
    {
        <MudSelectItem T="int?" Value="@((int?)null)">-- Seleziona --</MudSelectItem>
        @foreach (var org in _organizations)
        {
            <MudSelectItem T="int?" Value="@org.Id">@org.Name</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<CountryOrganization>? _organizations;
    private MudSelect<int?>? _selectRef;
    private bool _focusApplied;

    [Parameter]
    public int? SelectedOrganizationId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedOrganizationIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Organizzazione";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "L'organizzazione è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona l'organizzazione (es: EMEA, APAC, NA)";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var baseClass = string.IsNullOrWhiteSpace(Class) ? string.Empty : Class;
            return Required ? string.Join(' ', new[] { baseClass, "required-field" }.Where(x => !string.IsNullOrWhiteSpace(x))) : baseClass;
        }
    }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusApplied && AutoFocus && _selectRef is not null)
        {
            _focusApplied = true;
            await _selectRef.FocusAsync();
        }
    }

    private async Task LoadOrganizationsAsync()
    {
        try
        {
            _organizations = await CountryOrganizationService.GetAllOrderedByNameAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento organizzazioni: {ex.Message}");
            _organizations = new List<CountryOrganization>();
        }
    }
}
