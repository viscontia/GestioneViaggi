@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using System.Threading
@inject CountryOrganizationService CountryOrganizationService

<BaseEntitySelect TItem="CountryOrganization" Value="_selectedOrganization" ValueChanged="OnOrganizationChanged"
    SearchFunc="SearchOrganizations" ToStringFunc="@(o => o?.Name?.ToUpperInvariant())" Label="@Label"
    Required="@Required" RequiredError="@RequiredError" Disabled="@Disabled" Class="@($"{Class} uppercase-input")"
    HelperText="@HelperText" AutoFocus="@AutoFocus" AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<CountryOrganization>? _organizations;
    private CountryOrganization? _selectedOrganization;

    [Parameter]
    public int? SelectedOrganizationId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedOrganizationIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Organizzazione";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "L'organizzazione è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona l'organizzazione (es: EMEA, APAC, NA)";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationsAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedOrganization();
    }

    private void UpdateSelectedOrganization()
    {
        if (_organizations == null) return;

        if (SelectedOrganizationId.HasValue)
        {
            if (_selectedOrganization?.Id != SelectedOrganizationId.Value)
            {
                _selectedOrganization = _organizations.FirstOrDefault(o => o.Id == SelectedOrganizationId.Value);
            }
        }
        else
        {
            _selectedOrganization = null;
        }
    }

    private async Task LoadOrganizationsAsync()
    {
        try
        {
            _organizations = await CountryOrganizationService.GetAllOrderedByNameAsync();
            UpdateSelectedOrganization();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento organizzazioni: {ex.Message}");
            _organizations = new List<CountryOrganization>();
        }
    }

    private async Task OnOrganizationChanged(CountryOrganization organization)
    {
        _selectedOrganization = organization;
        await SelectedOrganizationIdChanged.InvokeAsync(organization?.Id);
    }

    private async Task<IEnumerable<CountryOrganization>> SearchOrganizations(string value, CancellationToken token)
    {
        if (_organizations == null)
            return Enumerable.Empty<CountryOrganization>();

        if (string.IsNullOrEmpty(value))
            return _organizations;

        return _organizations.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
