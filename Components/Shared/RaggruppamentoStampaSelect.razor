@*
    COMPONENT: RaggruppamentoStampaSelect
    DESC: Select per la selezione del criterio di raggruppamento nelle stampe scadenzario.
          - URGENZA = Raggruppa per livello di urgenza (Scaduto/Urgente/Normale)
          - MESE = Raggruppa per mese di scadenza
          - CONTROPARTE = Raggruppa per controparte (Fornitore/Cliente)
*@

<MudSelect T="string"
           Label="@Label"
           @bind-Value="@Value"
           Variant="Variant.Outlined"
           Dense="true"
           Margin="Margin.Dense"
           Clearable="@Clearable"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           AnchorOrigin="Origin.BottomCenter"
           Class="@Class">
    <MudSelectItem Value="@("URGENZA")">Urgenza (Scaduto/Urgente/Normale)</MudSelectItem>
    <MudSelectItem Value="@("MESE")">Mese di Scadenza</MudSelectItem>
    <MudSelectItem Value="@("CONTROPARTE")">Controparte</MudSelectItem>
</MudSelect>

@code {
    [Parameter] public string Value { get; set; } = "URGENZA"; // Default
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Raggruppa per";
    [Parameter] public bool Clearable { get; set; } = false; // Non clearable, deve sempre avere un valore
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Campo obbligatorio";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string? Class { get; set; }
}
