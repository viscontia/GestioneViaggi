@* Dialog per la selezione filtri e stampa movimenti contabili *@
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Services.Printing
@using GestioneViaggi.Components.Shared
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext
@inject ISessionManager SessionManager
@inject MovTransazioniPrintService PrintService
@inject ContropartiService ContropartiService
@inject AnaValuteService ValuteService
@inject AnaTipiCausaliService CausaliService
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IPdfOpenerService PdfOpenerService
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                
                @* RIGA 1: Azienda e Ciclo *@
                @if (_isSuperAdmin)
                {
                    <MudItem xs="12" sm="6">
                        <AziendaSelect @bind-Value="_filtroAziendaIdInt" 
                                       Label="Azienda" 
                                       Clearable="true" />
                    </MudItem>
                }
                <MudItem xs="12" sm="@(_isSuperAdmin ? 6 : 12)">
                      <MudSelect T="string" Label="Ciclo Contabile" @bind-Value="_filtroCausaleCiclo" 
                                   Clearable="true" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("ATTIVO")">Attivo (Entrate/Clienti)</MudSelectItem>
                            <MudSelectItem Value="@("PASSIVO")">Passivo (Uscite/Fornitori)</MudSelectItem>
                        </MudSelect>
                </MudItem>

                @* RIGA 2: Controparte *@
                <MudItem xs="12" sm="12">
                    <ControparteSelect @bind-SelectedControparteId="_filtroControparteIdInt"
                                       AziendaId="@_aziendaIdEffettivo"
                                       CausaleCiclo="@_filtroCausaleCiclo" 
                                       Label="Filtra per Controparte"
                                       Clearable="true" />
                </MudItem>

                @* RIGA 3: Causale e Stati *@
                <MudItem xs="12" sm="6">
                    <CausaleSelect @bind-SelectedCausaleId="_filtroCausaleTipoIdInt"
                                   AziendaId="@_aziendaIdEffettivo"
                                   CycleType="@_filtroCausaleCiclo" 
                                   Label="Filtra per Causale"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Stato" @bind-SelectedValues="_filtroStati" 
                               MultiSelection="true" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("DA_PAGARE")">Da Pagare</MudSelectItem>
                        <MudSelectItem Value="@("PAGATO")">Pagato</MudSelectItem>
                        <MudSelectItem Value="@("PARZIALMENTE_PAGATO")">Parzialmente Pagato</MudSelectItem>
                        <MudSelectItem Value="@("ANNULLATO")">Annullato</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* RIGA 4: Data Transazione Da/A *@
                <MudItem xs="12" sm="6">
                    <MudDatePicker @ref="_firstField" Label="Data Transazione Da" @bind-Date="_dataTransazioneDa" 
                                   Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                   Error="@_errorDataTransazione" ErrorText="Data Da deve essere <= Data A"
                                   Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Transazione A" @bind-Date="_dataTransazioneA" 
                                   Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>

                @* RIGA 5: Data Documento Da/A *@
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Documento Da" @bind-Date="_dataDocumentoDa" 
                                   Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                   Error="@_errorDataDocumento" ErrorText="Data Da deve essere <= Data A"
                                   Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Documento A" @bind-Date="_dataDocumentoA" 
                                   Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>

                @* RIGA 6: Importo Da/A *@
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?" Label="Importo Da" @bind-Value="_importoDa" 
                                     Variant="Variant.Outlined" Format="N2"
                                     Error="@_errorImporto" ErrorText="Importo Da deve essere <= Importo A" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?" Label="Importo A" @bind-Value="_importoA" 
                                     Variant="Variant.Outlined" Format="N2" />
                </MudItem>

                @* RIGA 7: Viaggio e Data Viaggio *@
                <MudItem xs="12" sm="6">
                    <ViaggioSelect @bind-SelectedViaggioId="_filtroViaggioId"
                                   AziendaId="@_aziendaIdEffettivo"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <DataViaggioSelect @bind-SelectedDataViaggioId="_filtroDataViaggioId"
                                       ViaggioId="@_filtroViaggioId"
                                       Clearable="true" />
                </MudItem>

                @* RIGA 8: Valuta e Numero Documento *@
                <MudItem xs="12" sm="6">
                    <ValutaSelect @bind-SelectedValutaId="_filtroValutaIdInt" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Numero Documento" @bind-Value="_filtroNumeroDocumento" 
                                  Variant="Variant.Outlined" />
                </MudItem>

                @* RIGA 9: Checkbox opzioni *@
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="4" Class="flex-wrap">
                        <MudCheckBox @bind-Value="_soloConDocumento" Label="Solo con documento" Dense="true" Color="Color.Primary" />
                        <MudCheckBox @bind-Value="_soloScadute" Label="Solo scadute" Dense="true" Color="Color.Warning" />
                        <MudCheckBox @bind-Value="_soloConFattura" Label="Solo con fattura" Dense="true" Color="Color.Primary" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="4" Class="flex-wrap">
                        <MudCheckBox T="bool" Value="_soloConViaggio" Label="Solo con viaggio" Dense="true" Color="Color.Primary" 
                                     ValueChanged="@OnSoloConViaggioChanged" />
                        <MudCheckBox T="bool" Value="_soloSenzaViaggio" Label="Solo senza viaggio" Dense="true" Color="Color.Primary"
                                     ValueChanged="@OnSoloSenzaViaggioChanged" />
                    </MudStack>
                </MudItem>

                @* RIGA 10: Ordinamento *@
                <MudItem xs="12" sm="6">
                    <OrdinamentoStampaSelect @bind-SelectedOrdinamento="_ordinamento" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterListOff" OnClick="ResetFiltri">
            Reset
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" OnClick="EseguiStampa">
            Stampa
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private MudDatePicker? _firstField;

    // Sessione e tenant
    private bool _isSuperAdmin;
    private int? _currentAziendaId;
    private int _aziendaIdEffettivo => _isSuperAdmin ? (_filtroAziendaId ?? 0) : (_currentAziendaId ?? 0);

    // Filtri
    private int _filtroAziendaIdInt;
    private int? _filtroAziendaId => _filtroAziendaIdInt > 0 ? _filtroAziendaIdInt : null;
    
    // NUOVO: Filtro Ciclo (Attivo/Passivo)
    private string? _filtroCausaleCiclo;

    private int _filtroControparteIdInt;
    private int? _filtroControparteId => _filtroControparteIdInt > 0 ? _filtroControparteIdInt : null;
    
    private int _filtroCausaleTipoIdInt;
    private int? _filtroCausaleTipoId => _filtroCausaleTipoIdInt > 0 ? _filtroCausaleTipoIdInt : null;
    
    private IEnumerable<string> _filtroStati = new List<string>();
    private int? _filtroViaggioId;
    private int? _filtroDataViaggioId;
    private int _filtroValutaIdInt;
    private int? _filtroValutaId => _filtroValutaIdInt > 0 ? _filtroValutaIdInt : null;
    
    private DateTime? _dataTransazioneDa;
    private DateTime? _dataTransazioneA;
    private DateTime? _dataDocumentoDa;
    private DateTime? _dataDocumentoA;
    private decimal? _importoDa;
    private decimal? _importoA;
    private string? _filtroNumeroDocumento;

    // Checkbox
    private bool _soloConDocumento;
    private bool _soloScadute;
    private bool _soloConViaggio;
    private bool _soloSenzaViaggio;
    private bool _soloConFattura;

    // Ordinamento
    private string _ordinamento = "CONTROPARTE"; // Default aggiornato

    // Errori validazione
    private bool _errorDataTransazione;
    private bool _errorDataDocumento;
    private bool _errorImporto;

    protected override async Task OnInitializedAsync()
    {
        _isSuperAdmin = await TenantContext.IsSuperAdminAsync();
        if (!_isSuperAdmin)
        {
            _currentAziendaId = await TenantContext.GetCurrentAziendaIdAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch { }

            if (_firstField != null)
            {
                await Task.Delay(300);
                await _firstField.FocusAsync();
            }
        }
    }

    public void Dispose()
    {
        try
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("dialogFormHelper.cleanup");
        }
        catch { }
    }

    private void Cancel() => MudDialog.Cancel();

    private void ResetFiltri()
    {
        _filtroAziendaIdInt = 0;
        _filtroCausaleCiclo = null; // Reset ciclo
        _filtroControparteIdInt = 0;
        _filtroCausaleTipoIdInt = 0;
        _filtroStati = new List<string>();
        _filtroViaggioId = null;
        _filtroDataViaggioId = null;
        _filtroValutaIdInt = 0;
        _dataTransazioneDa = null;
        _dataTransazioneA = null;
        _dataDocumentoDa = null;
        _dataDocumentoA = null;
        _importoDa = null;
        _importoA = null;
        _filtroNumeroDocumento = null;
        _soloConDocumento = false;
        _soloScadute = false;
        _soloConViaggio = false;
        _soloSenzaViaggio = false;
        _soloConFattura = false;
        _ordinamento = "CONTROPARTE";

        // Reset errori
        _errorDataTransazione = false;
        _errorDataDocumento = false;
        _errorImporto = false;

        StateHasChanged();
        Snackbar.Add("Filtri resettati", Severity.Info);
    }

    private void OnSoloConViaggioChanged(bool value)
    {
        _soloConViaggio = value;
        if (value) _soloSenzaViaggio = false;
        StateHasChanged();
    }

    private void OnSoloSenzaViaggioChanged(bool value)
    {
        _soloSenzaViaggio = value;
        if (value) _soloConViaggio = false;
        StateHasChanged();
    }

    private bool ValidaFiltri()
    {
        bool isValid = true;
        _errorDataTransazione = false;
        _errorDataDocumento = false;
        _errorImporto = false;

        if (_dataTransazioneDa.HasValue && _dataTransazioneA.HasValue && _dataTransazioneDa > _dataTransazioneA)
        {
            _errorDataTransazione = true;
            Snackbar.Add("Data Transazione: la data inizio non può essere superiore alla data fine", Severity.Warning);
            isValid = false;
        }

        if (_dataDocumentoDa.HasValue && _dataDocumentoA.HasValue && _dataDocumentoDa > _dataDocumentoA)
        {
            _errorDataDocumento = true;
            Snackbar.Add("Data Documento: la data inizio non può essere superiore alla data fine", Severity.Warning);
            isValid = false;
        }

        if (_importoDa.HasValue && _importoA.HasValue && _importoDa > _importoA)
        {
            _errorImporto = true;
            Snackbar.Add("Importo: l'importo minimo non può essere superiore all'importo massimo", Severity.Warning);
            isValid = false;
        }

        if (_filtroDataViaggioId.HasValue && !_filtroViaggioId.HasValue)
        {
            Snackbar.Add("Filtro Viaggio: selezionare prima un Viaggio per filtrare per Data Viaggio", Severity.Warning);
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private async Task EseguiStampa()
    {
        if (!ValidaFiltri())
        {
            Snackbar.Add("Correggi gli errori nei filtri prima di procedere", Severity.Warning);
            return;
        }
        try
        {
            var sessionData = await SessionManager.GetSessionAsync();
            if (sessionData?.User == null)
            {
                Snackbar.Add("Errore: sessione utente non valida", Severity.Error);
                return;
            }
            var userInfo = sessionData.User;

            string? controparteNome = null;
            string? valutaNome = null;
            string? causaleNome = null;

            if (_filtroControparteIdInt == 0)
            {
                controparteNome = "TUTTE LE CONTROPARTI";
            }
            else if (_filtroControparteId.HasValue)
            {
                var controparte = await ContropartiService.GetByIdAsync(_filtroControparteId.Value);
                controparteNome = controparte?.RagioneSociale;
            }

            if (_filtroCausaleTipoId.HasValue)
            {
                var causale = await CausaliService.GetByIdAsync(_filtroCausaleTipoId.Value);
                causaleNome = causale?.CausaleDescrizione;
            }
            else
            {
                causaleNome = "TUTTE LE CAUSALI";
            }

            if (_filtroValutaId.HasValue)
            {
                var valuta = await ValuteService.GetByIdAsync(_filtroValutaId.Value);
                valutaNome = valuta?.ValutaCodiceIso;
            }

            var aziendaIdFiltro = _aziendaIdEffettivo > 0 ? _aziendaIdEffettivo : (int?)null;
            
            // Creazione DTO con i nuovi parametri
            var filtri = new TransazioniFiltriDTO
            {
                AziendaId = aziendaIdFiltro,
                CausaleCiclo = _filtroCausaleCiclo, // Nuovo parametro
                ControparteId = _filtroControparteId, // Renamed from FornitoreId
                CausaleTipoId = _filtroCausaleTipoId,
                Stati = _filtroStati?.Any() == true ? _filtroStati.ToArray() : null,
                ViaggioId = _filtroViaggioId,
                DataViaggioId = _filtroDataViaggioId,
                ValutaId = _filtroValutaId,
                DataTransazioneDa = _dataTransazioneDa.HasValue ? DateOnly.FromDateTime(_dataTransazioneDa.Value).ToDateTime(TimeOnly.MinValue) : null,
                DataTransazioneA = _dataTransazioneA.HasValue ? DateOnly.FromDateTime(_dataTransazioneA.Value).ToDateTime(TimeOnly.MinValue) : null,
                DataDocumentoDa = _dataDocumentoDa.HasValue ? DateOnly.FromDateTime(_dataDocumentoDa.Value).ToDateTime(TimeOnly.MinValue) : null,
                DataDocumentoA = _dataDocumentoA.HasValue ? DateOnly.FromDateTime(_dataDocumentoA.Value).ToDateTime(TimeOnly.MinValue) : null,
                ImportoDa = _importoDa,
                ImportoA = _importoA,
                NumeroDocumento = _filtroNumeroDocumento,
                SoloConDocumento = _soloConDocumento,
                SoloScadute = _soloScadute,
                SoloConViaggio = _soloConViaggio,
                SoloSenzaViaggio = _soloSenzaViaggio,
                SoloConFattura = _soloConFattura,
                ControparteNome = controparteNome,
                ValutaNome = valutaNome,
                TipoMovimentoNome = causaleNome
            };

            var printData = await PrintService.GetDataPerStampaAsync(
                filtri,
                _ordinamento,
                userInfo.ValutaDefaultId,
                userInfo.ValutaCodiceIso,
                userInfo);

            if (printData.Dettagli.Count == 0)
            {
                Snackbar.Add("Nessuna transazione trovata con i filtri applicati", Severity.Warning);
                return;
            }

            Snackbar.Add("Generazione PDF in corso...", Severity.Info);

            var targetFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            var fileName = GestioneViaggi.Services.Printing.PdfFileNameHelper.GetMovementReportFileName(filtri);
            var outputPath = Path.Combine(targetFolder, fileName);
            
            if (System.IO.File.Exists(outputPath))
            {
                System.IO.File.Delete(outputPath);
            }

            await MovTransazioniPrinter.GeneratePdfAsync(printData, outputPath);

            await PdfOpenerService.OpenPdfAsync(outputPath, "Stampa Completata");

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante la generazione del PDF: {ex.Message}", Severity.Error);
        }
    }
}
