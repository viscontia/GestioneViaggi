@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Cryptography
@inject IJSRuntime JS
@inject AziendaLogoService LogoService
@inject ISnackbar Snackbar
@implements IDisposable

<MudDialog close-on-escape-key="true">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Logo Aziendale" : "Nuovo Logo Aziendale")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                
                <!-- TAB 1: Informazioni Base -->
                <MudTabPanel Text="Informazioni Base" Icon="@Icons.Material.Filled.Info">
                    @if (!IsEditMode)
                    {
                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="OnFileSelected"
                                       Accept="image/*"
                                       MaximumFileCount="1">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    Carica Immagine Logo
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                        @if (_selectedFile != null)
                        {
                            <MudAlert Severity="Severity.Success" Class="mt-2">
                                File selezionato: <strong>@_selectedFile.Name</strong> (@FormatFileSize(_selectedFile.Size))
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            <strong>File:</strong> @Entity.OriginalFilename (@Entity.FileFormat.ToUpper() - @FormatFileSize(Entity.FileSizeBytes))
                            @if (Entity.ImageWidth.HasValue && Entity.ImageHeight.HasValue)
                            {
                                <br /><strong>Dimensioni:</strong> @($"{Entity.ImageWidth} x {Entity.ImageHeight} px")
                            }
                        </MudAlert>
                    }

                    @if (Entity?.BinaryData != null && Entity.BinaryData.Length > 0)
                    {
                        <MudPaper Elevation="2" Class="pa-4 mb-4" Style="background-color: #f5f5f5;">
                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                                Anteprima Immagine
                            </MudText>
                            <div style="display: flex; justify-content: center; align-items: center; min-height: 200px; background: repeating-conic-gradient(#e0e0e0 0% 25%, #ffffff 0% 50%) 50% / 20px 20px;">
                                @if (!string.IsNullOrEmpty(_imageDataUrl))
                                {
                                    <img src="@_imageDataUrl" 
                                         alt="@Entity.AltText" 
                                         style="max-width: 100%; max-height: 400px; object-fit: contain; border: 1px solid #ccc; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                                }
                                else
                                {
                                    <MudText Color="Color.Error">Data URL non generato</MudText>
                                }
                            </div>
                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            Nessuna immagine caricata
                        </MudAlert>
                    }

                    <MudSelect @bind-Value="Entity!.LogoType"
                               For="@(() => Entity!.LogoType)"
                               Label="Tipo Logo"
                               Variant="Variant.Outlined"
                               Required="true"
                               Class="mb-3 mt-3"
                               Adornment="Adornment.End"
                               AdornmentText="*"
                               AdornmentColor="Color.Error"
                               HelperText="Tipologia del logo (es. primario, secondario, favicon)">
                        <MudSelectItem Value="@("primary")">Primario</MudSelectItem>
                        <MudSelectItem Value="@("secondary")">Secondario</MudSelectItem>
                        <MudSelectItem Value="@("watermark")">Watermark</MudSelectItem>
                        <MudSelectItem Value="@("favicon")">Favicon</MudSelectItem>
                        <MudSelectItem Value="@("letterhead")">Intestazione</MudSelectItem>
                        <MudSelectItem Value="@("social")">Social Media</MudSelectItem>
                    </MudSelect>

                    <MudSelect @bind-Value="Entity.LogoVariant"
                               For="@(() => Entity.LogoVariant)"
                               Label="Variante"
                               Variant="Variant.Outlined"
                               Class="mb-3"
                               HelperText="Variante visiva del logo">
                        <MudSelectItem Value="@("standard")">Standard</MudSelectItem>
                        <MudSelectItem Value="@("horizontal")">Orizzontale</MudSelectItem>
                        <MudSelectItem Value="@("vertical")">Verticale</MudSelectItem>
                        <MudSelectItem Value="@("icon")">Icona</MudSelectItem>
                        <MudSelectItem Value="@("monochrome")">Monocromatico</MudSelectItem>
                        <MudSelectItem Value="@("inverse")">Inverso</MudSelectItem>
                        <MudSelectItem Value="@("dark")">Scuro</MudSelectItem>
                        <MudSelectItem Value="@("light")">Chiaro</MudSelectItem>
                    </MudSelect>

                    <MudTextField @ref="_altTextField"
                                  @bind-Value="Entity.AltText"
                                  For="@(() => Entity.AltText)"
                                  Label="Testo Alternativo"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Il testo alternativo è obbligatorio"
                                  MaxLength="500"
                                  Class="mb-3"
                                  Adornment="Adornment.End"
                                  AdornmentText="*"
                                  AdornmentColor="Color.Error"
                                  HelperText="Descrizione del logo per accessibilità (SEO e screen reader)" />

                    <MudTextField @bind-Value="Entity.Description"
                                  For="@(() => Entity.Description)"
                                  Label="Descrizione"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Class="mb-3"
                                  HelperText="Note interne sul logo" />

                    <MudNumericField @bind-Value="Entity.Priority"
                                     For="@(() => Entity.Priority)"
                                     Label="Priorità"
                                     Variant="Variant.Outlined"
                                     Min="@((short)1)"
                                     Max="@((short)100)"
                                     T="short"
                                     Class="mb-3"
                                     HelperText="Priorità di visualizzazione (1 = massima priorità)" />

                    <MudStack Row="true" Spacing="4" Class="mt-2">
                        <MudCheckBox @bind-Value="Entity.IsDefault"
                                     For="@(() => Entity.IsDefault)"
                                     Label="Logo Predefinito"
                                     Color="Color.Primary" />

                        <MudCheckBox @bind-Value="Entity.IsActive"
                                     For="@(() => Entity.IsActive)"
                                     Label="Logo Attivo"
                                     Color="Color.Success" />
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 2: Caratteristiche Tecniche -->
                <MudTabPanel Text="Caratteristiche Tecniche" Icon="@Icons.Material.Filled.Settings">
                    <MudStack Spacing="3">
                        @if (Entity.ImageWidth.HasValue && Entity.ImageHeight.HasValue)
                        {
                            <MudAlert Severity="Severity.Info">
                                <strong>Dimensioni:</strong> @Entity.ImageWidth x @Entity.ImageHeight px<br />
                                <strong>Aspect Ratio:</strong> @GetAspectRatioDisplay()
                            </MudAlert>
                        }

                        <MudCheckBox @bind-Value="Entity.HasTransparency"
                                     For="@(() => Entity.HasTransparency)"
                                     Label="Ha Trasparenza"
                                     Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="mb-3">Indica se l'immagine contiene canale alpha</MudText>

                        <MudSelect @bind-Value="Entity.ColorMode"
                                   For="@(() => Entity.ColorMode)"
                                   Label="Modalità Colore"
                                   Variant="Variant.Outlined"
                                   HelperText="Spazio colore dell'immagine">
                            <MudSelectItem Value="@("rgb")">RGB</MudSelectItem>
                            <MudSelectItem Value="@("rgba")">RGBA (con trasparenza)</MudSelectItem>
                            <MudSelectItem Value="@("cmyk")">CMYK (stampa)</MudSelectItem>
                            <MudSelectItem Value="@("grayscale")">Scala di grigi</MudSelectItem>
                            <MudSelectItem Value="@("indexed")">Indicizzato (palette)</MudSelectItem>
                        </MudSelect>

                        <MudSelect @bind-Value="Entity.ColorDepth"
                                   For="@(() => Entity.ColorDepth)"
                                   Label="Profondità Colore (bit)"
                                   Variant="Variant.Outlined"
                                   T="short?"
                                   HelperText="Bit per pixel">
                            <MudSelectItem T="short?" Value="@((short?)1)">1 bit</MudSelectItem>
                            <MudSelectItem T="short?" Value="@((short?)4)">4 bit</MudSelectItem>
                            <MudSelectItem T="short?" Value="@((short?)8)">8 bit</MudSelectItem>
                            <MudSelectItem T="short?" Value="@((short?)16)">16 bit</MudSelectItem>
                            <MudSelectItem T="short?" Value="@((short?)24)">24 bit</MudSelectItem>
                            <MudSelectItem T="short?" Value="@((short?)32)">32 bit</MudSelectItem>
                        </MudSelect>

                        <MudNumericField @bind-Value="Entity.Dpi"
                                         For="@(() => Entity.Dpi)"
                                         Label="DPI (Dots Per Inch)"
                                         Variant="Variant.Outlined"
                                         Min="72"
                                         Max="600"
                                         T="short?"
                                         HelperText="Risoluzione per la stampa (72=web, 300=print)" />

                        <MudCheckBox @bind-Value="Entity.IsCompressed"
                                     For="@(() => Entity.IsCompressed)"
                                     Label="Immagine Compressa"
                                     Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="mb-3">Indica se l'immagine usa compressione lossy (es. JPEG)</MudText>

                        @if (Entity.IsCompressed)
                        {
                            <MudNumericField @bind-Value="Entity.CompressionQuality"
                                            For="@(() => Entity.CompressionQuality)"
                                            Label="Qualità Compressione (%)"
                                            Variant="Variant.Outlined"
                                            Min="1"
                                            Max="100"
                                            T="short?"
                                            Class="mb-3"
                                            HelperText="Livello di qualità JPEG (1-100, dove 100 = massima qualità)" />
                        }

                        <MudCheckBox @bind-Value="Entity.IsWebOptimized"
                                     For="@(() => Entity.IsWebOptimized)"
                                     Label="Ottimizzato per il Web"
                                     Color="Color.Success" />
                        <MudText Typo="Typo.caption">Indica se l'immagine è stata ottimizzata per il web (progressive JPEG, ecc.)</MudText>
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 3: SEO e Brand -->
                <MudTabPanel Text="SEO e Brand" Icon="@Icons.Material.Filled.Lightbulb">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Contesti di Utilizzo</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
                            @foreach (var context in _availableUsageContexts)
                            {
                                var isSelected = Entity.UsageContext?.Contains(context) ?? false;
                                <MudChip T="string"
                                         Text="@context"
                                         Color="@(isSelected ? Color.Primary : Color.Default)"
                                         Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => ToggleUsageContext(context))">
                                    @context
                                </MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Parole Chiave SEO</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                            @if (Entity.SeoKeywords != null)
                            {
                                @foreach (var keyword in Entity.SeoKeywords)
                                {
                                    <MudChip T="string"
                                             Text="@keyword"
                                             Color="Color.Secondary"
                                             OnClose="@(() => RemoveSeoKeyword(keyword))">
                                        @keyword
                                    </MudChip>
                                }
                            }
                        </MudStack>
                        <MudTextField @bind-Value="_newSeoKeyword"
                                      Label="Aggiungi parola chiave"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Add"
                                      OnAdornmentClick="AddSeoKeyword"
                                      OnKeyDown="@HandleSeoKeywordKeyDown"
                                      HelperText="Premi INVIO o clicca + per aggiungere" />

                        <MudTextField @bind-Value="Entity.BrandGuidelinesNotes"
                                      For="@(() => Entity.BrandGuidelinesNotes)"
                                      Label="Note Brand Guidelines"
                                      Variant="Variant.Outlined"
                                      Lines="4"
                                      HelperText="Linee guida aziendali per l'uso del logo (spaziature, colori, vincoli)" />
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 4: Approvazione e Versioning -->
                <MudTabPanel Text="Approvazione e Versioning" Icon="@Icons.Material.Filled.Verified">
                    <MudStack Spacing="3">
                        <MudCheckBox @bind-Value="Entity.IsApproved"
                                     For="@(() => Entity.IsApproved)"
                                     Label="Logo Approvato"
                                     Color="Color.Success" />
                        <MudText Typo="Typo.caption" Class="mb-3">Indica se il logo è stato approvato dal responsabile</MudText>

                        @if (Entity.ApprovalDate.HasValue)
                        {
                            <MudAlert Severity="Severity.Success">
                                <strong>Approvato il:</strong> @Entity.ApprovalDate.Value.ToString("dd/MM/yyyy HH:mm")
                            </MudAlert>
                        }

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">Gestione Versioni</MudText>

                        <MudNumericField @bind-Value="Entity.VersionNumber"
                                         For="@(() => Entity.VersionNumber)"
                                         Label="Numero Versione"
                                         Variant="Variant.Outlined"
                                         Min="@((short)1)"
                                         Max="@((short)999)"
                                         T="short"
                                         ReadOnly="@(!IsEditMode)"
                                         HelperText="Numero progressivo della versione del logo" />

                        <MudCheckBox @bind-Value="Entity.IsCurrentVersion"
                                     For="@(() => Entity.IsCurrentVersion)"
                                     Label="Versione Corrente"
                                     Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="mb-3">Indica se questa è la versione attualmente in uso</MudText>

                        @if (IsEditMode)
                        {
                            <MudAlert Severity="Severity.Info">
                                <strong>Parent Logo ID:</strong> @(Entity.ParentLogoId?.ToString() ?? "Nessun parent")
                            </MudAlert>
                        }
                    </MudStack>
                </MudTabPanel>

            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!IsEditMode && _selectedFile == null)">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _altTextField;
    private IBrowserFile? _selectedFile;
    private string _newSeoKeyword = string.Empty;
    private string? _imageDataUrl;
    private Guid? _lastLoadedLogoId;

    private readonly string[] _availableUsageContexts = new[]
    {
        "web", "print", "social", "email", "presentation", "app", "signage", "packaging"
    };

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public AziendaLogo Entity { get; set; } = new AziendaLogo();

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public int? AziendaId { get; set; }

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsEditMode && Entity != null && Entity.Id != _lastLoadedLogoId)
        {
            _lastLoadedLogoId = Entity.Id;
            await LoadImagePreviewAsync();
        }
        else if (!IsEditMode)
        {
            _lastLoadedLogoId = null;
            _imageDataUrl = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private string GetAspectRatioDisplay()
    {
        if (Entity.ImageWidth.HasValue && Entity.ImageHeight.HasValue && Entity.ImageHeight > 0)
        {
            var ratio = (decimal)Entity.ImageWidth.Value / Entity.ImageHeight.Value;
            return $"{ratio:F4}:1";
        }
        return "N/A";
    }

    private void ToggleUsageContext(string context)
    {
        if (Entity.UsageContext == null)
        {
            Entity.UsageContext = new[] { context };
        }
        else if (Entity.UsageContext.Contains(context))
        {
            Entity.UsageContext = Entity.UsageContext.Where(c => c != context).ToArray();
        }
        else
        {
            Entity.UsageContext = Entity.UsageContext.Append(context).ToArray();
        }
        StateHasChanged();
    }

    private async Task HandleSeoKeywordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddSeoKeyword();
        }
    }

    private async Task AddSeoKeyword()
    {
        if (!string.IsNullOrWhiteSpace(_newSeoKeyword))
        {
            if (Entity.SeoKeywords == null)
            {
                Entity.SeoKeywords = new[] { _newSeoKeyword.Trim() };
            }
            else if (!Entity.SeoKeywords.Contains(_newSeoKeyword.Trim()))
            {
                Entity.SeoKeywords = Entity.SeoKeywords.Append(_newSeoKeyword.Trim()).ToArray();
            }
            _newSeoKeyword = string.Empty;
            StateHasChanged();
        }
    }

    private void RemoveSeoKeyword(string keyword)
    {
        if (Entity.SeoKeywords != null)
        {
            Entity.SeoKeywords = Entity.SeoKeywords.Where(k => k != keyword).ToArray();
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(IBrowserFile? file)
    {
        _selectedFile = file;

        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var fileBytes = memoryStream.ToArray();

                Entity.BinaryData = fileBytes;
                Entity.FileName = SanitizeFileName(file.Name);
                Entity.OriginalFilename = file.Name;
                Entity.FileFormat = Path.GetExtension(file.Name).TrimStart('.');
                Entity.MimeType = file.ContentType;
                Entity.FileSizeBytes = (int)file.Size;
                Entity.FileHash = ComputeSha256Hash(fileBytes);
                Entity.Md5Hash = ComputeMd5Hash(fileBytes);

                using (var imageStream = new MemoryStream(fileBytes))
                {
                    var imageInfo = await SixLabors.ImageSharp.Image.IdentifyAsync(imageStream);
                    Entity.ImageWidth = imageInfo.Width;
                    Entity.ImageHeight = imageInfo.Height;

                    if (imageInfo.Metadata.HorizontalResolution > 0)
                    {
                        Entity.Dpi = (short?)Math.Round(imageInfo.Metadata.HorizontalResolution);
                    }
                }

                if (string.IsNullOrWhiteSpace(Entity.AltText))
                {
                    Entity.AltText = $"Logo aziendale - {Entity.LogoType}";
                }

                _imageDataUrl = ConvertToDataUrl(fileBytes, Entity.MimeType);

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add($"Errore durante il caricamento del file: {ex.Message}", Severity.Error);
            }
        }
    }

    private string SanitizeFileName(string fileName)
    {
        var invalidChars = Path.GetInvalidFileNameChars();
        return string.Join("_", fileName.Split(invalidChars));
    }

    private string ComputeSha256Hash(byte[] data)
    {
        using var sha256 = SHA256.Create();
        var hash = sha256.ComputeHash(data);
        return BitConverter.ToString(hash).Replace("-", "").ToLower();
    }

    private string ComputeMd5Hash(byte[] data)
    {
        using var md5 = MD5.Create();
        var hash = md5.ComputeHash(data);
        return BitConverter.ToString(hash).Replace("-", "").ToLower();
    }

    private async Task LoadImagePreviewAsync()
    {
        if (!IsEditMode || Entity == null || Entity.Id == Guid.Empty)
        {
            _imageDataUrl = null;
            return;
        }

        try
        {
            if (Entity.BinaryData != null && Entity.BinaryData.Length > 0)
            {
                _imageDataUrl = ConvertToDataUrl(Entity.BinaryData, Entity.MimeType);
            }
            else
            {
                var binaryData = await LogoService.GetBinaryDataAsync(Entity.Id);

                if (binaryData != null && binaryData.Length > 0)
                {
                    Entity.BinaryData = binaryData;
                    _imageDataUrl = ConvertToDataUrl(binaryData, Entity.MimeType);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Errore caricamento immagine: {ex.Message}", Severity.Error);
        }
    }

    private string ConvertToDataUrl(byte[] data, string mimeType)
    {
        if (data == null || data.Length == 0)
            return string.Empty;

        if (string.IsNullOrWhiteSpace(mimeType))
            mimeType = "image/png";

        var base64 = Convert.ToBase64String(data);
        return $"data:{mimeType};base64,{base64}";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                if (!IsEditMode && _selectedFile == null)
                {
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                    Snackbar.Add("Selezionare un file immagine", Severity.Warning);
                    return;
                }

                if (CurrentUserId.HasValue)
                {
                    if (!IsEditMode)
                    {
                        Entity.CreatedBy = CurrentUserId.Value;
                    }
                    else
                    {
                        Entity.UpdatedBy = CurrentUserId.Value;
                    }
                }

                if (Entity.UsageContext == null || Entity.UsageContext.Length == 0)
                {
                    Entity.UsageContext = new[] { "web" };
                }

                if (Entity.IsApproved && !Entity.ApprovalDate.HasValue && CurrentUserId.HasValue)
                {
                    Entity.ApprovalDate = DateTime.UtcNow;
                    Entity.ApprovedBy = CurrentUserId.Value;
                }
                else if (!Entity.IsApproved)
                {
                    Entity.ApprovalDate = null;
                    Entity.ApprovedBy = null;
                }

                MudDialog?.Close(DialogResult.Ok(Entity));
            }
            else
            {
                if (_altTextField?.Error == true)
                {
                    await _altTextField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch { }
    }
}
