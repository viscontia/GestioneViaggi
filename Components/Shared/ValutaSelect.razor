@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@inject AnaValuteService ValuteService

@*
    COMPONENT: ValutaSelect
    DESC: Dropdown per la selezione della valuta (ISO 4217).
    AUTORE: Antigravity
    FIX: Risolto crash in MAUI con rendering condizionale e gestione async corretta
    FIX: Convertito da MudSelect a MudAutocomplete per gestire asterisco required + icona ricerca
*@

<MudAutocomplete T="AnaValute"
                 Value="@_selectedValuta"
                 ValueChanged="@OnValutaChanged"
                 SearchFunc="@SearchValute"
                 ToStringFunc="@(v => v != null ? $"{v.ValutaCodiceIso} - {v.ValutaDescrizione}" : string.Empty)"
                 Label="@Label"
                 Variant="Variant.Outlined"
                 Required="@Required"
                 RequiredError="@RequiredError"
                 Disabled="@_isLoading"
                 Class="@GetCssClass()"
                 Dense="true"
                 Clearable="@Clearable"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 AdornmentColor="Color.Primary"
                 ResetValueOnEmptyText="true"
                 CoerceText="true"
                 CoerceValue="false"
                 Strict="false"
                 OpenOnFocus="false"
                 MaxItems="null" />

@code {
    [Parameter] public int SelectedValutaId { get; set; }
    [Parameter] public EventCallback<int> SelectedValutaIdChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Valuta";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Campo obbligatorio";
    [Parameter] public bool Clearable { get; set; } = false;

    private List<AnaValute> _valute = new();
    private AnaValute? _selectedValuta;
    private bool _isLoading = true;
    private bool _loaded = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadValute();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedValuta();
    }

    private void UpdateSelectedValuta()
    {
        if (!_loaded || _valute.Count == 0) return;

        if (SelectedValutaId > 0)
        {
            if (_selectedValuta?.ValutaId != SelectedValutaId)
            {
                _selectedValuta = _valute.FirstOrDefault(v => v.ValutaId == SelectedValutaId);
            }
        }
        else
        {
            _selectedValuta = null;
        }
    }

    private async Task LoadValute()
    {
        try
        {
            _isLoading = true;
            var valute = await ValuteService.GetAllValuteAsync();
            _valute = valute?.ToList() ?? new List<AnaValute>();
            _loaded = true;
            UpdateSelectedValuta();
        }
        catch (Exception ex)
        {
            _valute = new List<AnaValute>();
            System.Diagnostics.Debug.WriteLine($"[ValutaSelect] Errore caricamento valute: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnValutaChanged(AnaValute? valuta)
    {
        _selectedValuta = valuta;
        SelectedValutaId = valuta?.ValutaId ?? 0;
        await SelectedValutaIdChanged.InvokeAsync(SelectedValutaId);
    }

    private async Task<IEnumerable<AnaValute>> SearchValute(string searchText, CancellationToken cancellationToken)
    {
        await Task.CompletedTask;

        if (!_loaded || _valute.Count == 0)
            return Enumerable.Empty<AnaValute>();

        // Se non c'è testo, mostra tutte le valute (sono poche)
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return _valute;
        }

        // Ricerca case-insensitive nel codice ISO o nella descrizione
        return _valute
            .Where(v => v.ValutaCodiceIso.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        v.ValutaDescrizione.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private string GetCssClass()
    {
        var classes = Class ?? "";
        if (Required)
        {
            classes += " required-field";
        }
        return classes.Trim();
    }
}
