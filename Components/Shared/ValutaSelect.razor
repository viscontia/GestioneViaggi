@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@inject AnaValuteService ValuteService

@*
    COMPONENT: ValutaSelect
    DESC: Dropdown per la selezione della valuta (ISO 4217).
    AUTORE: Antigravity
    FIX: Risolto crash in MAUI con rendering condizionale e gestione async corretta
*@

<MudSelect T="int"
           Label="@Label"
           Value="@SelectedValutaId"
           ValueChanged="@OnValueChanged"
           Variant="Variant.Outlined"
           Disabled="@_isLoading"
           Class="@Class"
           Required="@Required"
           RequiredError="@RequiredError"
           Dense="true"
           Clearable="@Clearable"
           Adornment="@(Required ? Adornment.End : Adornment.None)"
           AdornmentText="@(Required ? "*" : "")"
           AdornmentColor="Color.Error"
           AnchorOrigin="Origin.BottomCenter">
    @if (_isLoading)
    {
        <MudSelectItem Value="0">Caricamento...</MudSelectItem>
    }
    else
    {
        @foreach (var valuta in _valute)
        {
            <MudSelectItem Value="@valuta.ValutaId">
                @valuta.ValutaCodiceIso - @valuta.ValutaDescrizione
            </MudSelectItem>
        }
    }
</MudSelect>

@code {
    [Parameter] public int SelectedValutaId { get; set; }
    [Parameter] public EventCallback<int> SelectedValutaIdChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Valuta";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Campo obbligatorio";
    [Parameter] public bool Clearable { get; set; } = false;

    private List<AnaValute> _valute = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadValute();
    }

    private async Task LoadValute()
    {
        try
        {
            _isLoading = true;
            var valute = await ValuteService.GetAllValuteAsync();
            _valute = valute?.ToList() ?? new List<AnaValute>();
        }
        catch (Exception ex)
        {
            _valute = new List<AnaValute>();
            System.Diagnostics.Debug.WriteLine($"[ValutaSelect] Errore caricamento valute: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnValueChanged(int value)
    {
        SelectedValutaId = value;
        await SelectedValutaIdChanged.InvokeAsync(value);
    }
}
