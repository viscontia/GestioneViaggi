@using System.Text.RegularExpressions
@using GestioneViaggi.Helpers
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using MudBlazor
@inject WebTourItinerarioService GiornateService
@inject WebTourItinerarioPassaggiService PassiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* Scheda "Itinerario" (Blocco 6). Pattern Sidebar + Main Board: due MudDropContainer
   PARALLELI (non annidati). Sinistra = riordino giornate (DnD); destra = passi trascinabili
   dentro e TRA le giornate. Live-save: ogni drop/add/edit persiste subito via i service
   (riordino atomico via fn_..._reorder). Immagine del passo rinviata al Blocco 7.
   ECCEZIONE UI: titoli/testi editoriali NON in maiuscolo forzato (destinati al sito). *@

<div class="itinerario-tab">
@if (_loading)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    @if (NumeroGiorni > 0 && _giornate.Count < NumeroGiorni)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            Hai descritto <strong>@_giornate.Count</strong> giornate su <strong>@NumeroGiorni</strong> previste dal viaggio: completa tutte le giornate per poter <strong>pubblicare</strong> (ne mancano @(NumeroGiorni - _giornate.Count)). L'anteprima resta comunque disponibile.
        </MudAlert>
    }
    else if (NumeroGiorni > 0 && _giornate.Count > NumeroGiorni)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            Hai inserito <strong>@_giornate.Count</strong> giornate, più delle <strong>@NumeroGiorni</strong> previste dal viaggio in anagrafica. Assicurati che sia intenzionale (es. giornata opzionale o di riposo).
        </MudAlert>
    }
    <MudGrid>
        <!-- SIDEBAR: sommario giornate (riordino DnD) -->
        <MudItem xs="12" md="3">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1">Giornate</MudText>
                <MudTooltip Text="Aggiungi una Giornata">
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddGiornata" />
                </MudTooltip>
            </div>

            @if (_giornate.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nessuna giornata. Aggiungi la prima.</MudText>
            }
            else
            {
                <MudDropContainer T="WebTourItinerario" @ref="_giornateContainer" Items="_giornate"
                                  ItemsSelector="GiornataInZone" ItemDropped="OnGiornataDropped"
                                  ApplyDropClassesOnDragStarted="true" CanDropClass="dz-can-drop" NoDropClass="dz-no-drop">
                    <ChildContent>
                        <MudDropZone T="WebTourItinerario" Identifier="sidebar" AllowReorder="true"
                                     Class="dz-giornate d-flex flex-column gap-2" />
                    </ChildContent>
                    <ItemRenderer>
                        <MudPaper Elevation="2" Class="pa-2 cursor-grab d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                            <div class="flex-grow-1" style="min-width:0;">
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;">@EtichettaGiorno(context)</MudText>
                                <MudText Typo="Typo.subtitle2"
                                         Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@context.TitoloGiornata</MudText>
                            </div>
                        </MudPaper>
                    </ItemRenderer>
                </MudDropContainer>
            }
        </MudItem>

        <!-- BOARD: dettaglio passi (trascinamento dentro e tra le giornate) -->
        <MudItem xs="12" md="9">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1">Dettaglio giornate</MudText>
                <MudTooltip Text="Come funziona questa pagina">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.HelpOutline"
                               Size="Size.Small" OnClick="OpenHelp">Guida</MudButton>
                </MudTooltip>
            </div>

            @if (_giornate.Count == 0)
            {
                <MudPaper Outlined="true" Class="pa-8 d-flex justify-center">
                    <MudText Color="Color.Secondary">Aggiungi una giornata dalla colonna a sinistra per iniziare l'itinerario.</MudText>
                </MudPaper>
            }
            else
            {
                @foreach (var g in _giornate.OrderBy(x => x.Ordine))
                {
                    var passiGiornata = _passi.Where(p => p.ItinerarioIdFk == g.WebTourItinerarioId).OrderBy(p => p.Ordine).ToList();
                    <MudPaper Outlined="true" Class="pa-3 mb-4">
                        <div class="d-flex align-center gap-2 mb-2">
                            <div class="d-flex flex-column" style="margin:-6px 0;">
                                <MudTooltip Text="Sposta la giornata su">
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                                                   Disabled="@(_giornate.IndexOf(g) == 0)" OnClick="@(() => MoveGiornata(g, -1))" />
                                </MudTooltip>
                                <MudTooltip Text="Sposta la giornata giù">
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                                                   Disabled="@(_giornate.IndexOf(g) == _giornate.Count - 1)" OnClick="@(() => MoveGiornata(g, 1))" />
                                </MudTooltip>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space:nowrap;">@EtichettaGiorno(g)</MudText>
                            <MudTextField T="string" Value="@g.TitoloGiornata" Immediate="false"
                                          ValueChanged="@(v => OnTitoloChanged(g, v))"
                                          Variant="Variant.Text" Placeholder="Titolo della giornata" Class="flex-grow-1" />
                            <MudTooltip Text="Aggiungi passaggio">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@(() => AddPasso(g))" />
                            </MudTooltip>
                            <MudTooltip Text="Elimina giornata">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteGiornata(g))" />
                            </MudTooltip>
                        </div>

                        @if (passiGiornata.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pl-2">Nessun passaggio. Aggiungine uno con il pulsante +.</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2 pa-2">
                                @foreach (var passo in passiGiornata)
                                {
                                    <MudPaper Elevation="1" Class="pa-2 d-flex align-center gap-2"
                                              Style="border-left:3px solid var(--mud-palette-primary);">
                                        <div class="d-flex flex-column" style="margin:-6px 0;">
                                            <MudTooltip Text="Sposta il passaggio su">
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                                                               Disabled="@(passiGiornata.IndexOf(passo) == 0)" OnClick="@(() => MovePasso(passo, -1))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Sposta il passaggio giù">
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                                                               Disabled="@(passiGiornata.IndexOf(passo) == passiGiornata.Count - 1)" OnClick="@(() => MovePasso(passo, 1))" />
                                            </MudTooltip>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(passo.ImmagineUrl))
                                        {
                                            <img src="@passo.ImmagineUrl" alt="@passo.ImmagineDidascalia"
                                                 style="width:48px;height:48px;object-fit:cover;border-radius:4px;flex-shrink:0;" loading="lazy" />
                                        }
                                        <div class="flex-grow-1" style="min-width:0;">
                                            <MudText Typo="Typo.body2"
                                                     Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@Snippet(passo.TestoHtml)</MudText>
                                            @if (!string.IsNullOrWhiteSpace(passo.ImmagineDidascalia))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">🖼 @passo.ImmagineDidascalia</MudText>
                                            }
                                        </div>
                                        <MudTooltip Text="Modifica passaggio">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditPasso(passo))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Elimina passaggio">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeletePasso(passo))" />
                                        </MudTooltip>
                                    </MudPaper>
                                }
                            </div>
                        }
                    </MudPaper>
                }
            }
        </MudItem>
    </MudGrid>
}
</div>

@code {
    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    /// <summary>Durata del viaggio (ana_viaggi.numero_giorni): l'itinerario è Completo solo se tutte le giornate sono descritte.</summary>
    [Parameter] public int NumeroGiorni { get; set; }
    /// <summary>Data di inizio dell'edizione: la data di ogni giornata è derivata da qui (vedi GiornataHelper).</summary>
    [Parameter] public DateTime? DataInizio { get; set; }
    /// <summary>Notifica al parent lo stato (semaforo): Completo se descritte tutte le NumeroGiorni giornate, Parziale se meno, Vuoto se nessuna.</summary>
    [Parameter] public EventCallback<WebTabStato> StatoChanged { get; set; }

    private List<WebTourItinerario> _giornate = new();
    private List<WebTourItinerarioPassaggio> _passi = new();
    private bool _loading = true;
    private bool _tabSetup;
    private int _seenNumeroGiorni = -1;

    private MudDropContainer<WebTourItinerario>? _giornateContainer;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    /// <summary>Se NumeroGiorni cambia (modificato nei Dati Generali a dialog aperto) ricalcola lo stato di completamento.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!_loading && _seenNumeroGiorni != NumeroGiorni)
        {
            _seenNumeroGiorni = NumeroGiorni;
            await NotifyStatoAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_tabSetup)
        {
            _tabSetup = true;
            try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); } catch { /* ignore */ }
        }
    }

    private async Task ReloadAsync()
    {
        _giornate = await GiornateService.ListByContenutoAsync(ContenutoId, AziendaId);
        var passi = new List<WebTourItinerarioPassaggio>();
        foreach (var g in _giornate)
            passi.AddRange(await PassiService.ListByItinerarioAsync(g.WebTourItinerarioId, AziendaId));
        _passi = passi;
        _giornateContainer?.Refresh();
        await NotifyStatoAsync();
        StateHasChanged();
    }

    /// <summary>Vuoto se nessuna giornata; Parziale se descritte meno di NumeroGiorni; Completo se tutte
    /// (o più: caso raro con giornata extra, comunque pubblicabile ma segnalato con warning nella UI).</summary>
    private Task NotifyStatoAsync()
        => StatoChanged.InvokeAsync(WebTabStatoRules.Itinerario(_giornate.Count, NumeroGiorni));

    /// <summary>"Giorno 3 — lun 04/05/2026": la data non è memorizzata, si deriva dalla partenza (GiornataHelper).</summary>
    private string EtichettaGiorno(WebTourItinerario g)
        => GiornataHelper.Etichetta(DataInizio, g.GiornoNumero, NumeroGiorni);

    private Task OpenHelp()
        => DialogService.ShowAsync<WebTourItinerarioHelpDialog>("",
               new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

    // ---- Giornate ------------------------------------------------------------

    private async Task AddGiornata()
    {
        var n = _giornate.Count + 1;
        var g = new WebTourItinerario
        {
            WebTourContenutoIdFk = ContenutoId, AziendaId = AziendaId,
            GiornoNumero = n, Ordine = n, TitoloGiornata = "GIORNO X :"
        };
        var passo = new WebTourItinerarioPassaggio { AziendaId = AziendaId, TestoHtml = string.Empty, Ordine = 1 };
        var edited = await OpenPassoDialog(passo, "Aggiungi passaggio", g);
        if (edited == null) return; // annullato: non creo né giornata né passaggio
        try
        {
            g = await GiornateService.CreateAsync(g); // titolo eventualmente modificato nella modale
            _giornate.Add(g);
            // Una giornata ha sempre >=1 passaggio (titolo e descrizione indivisibili): creo comunque il primo passaggio.
            edited.ItinerarioIdFk = g.WebTourItinerarioId;
            var created = await PassiService.CreateAsync(edited);
            _passi.Add(created);
            _passi = _passi.OrderBy(x => x.ItinerarioIdFk).ThenBy(x => x.Ordine).ToList();
            _giornateContainer?.Refresh();
            await NotifyStatoAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Errore creazione giornata: {ex.Message}", Severity.Error); }
    }

    private async Task OnTitoloChanged(WebTourItinerario g, string value)
    {
        var v = string.IsNullOrWhiteSpace(value) ? "GIORNO X :" : value.Trim();
        if (v == g.TitoloGiornata) return;
        g.TitoloGiornata = v;
        try { await GiornateService.UpdateAsync(g); }
        catch (Exception ex) { Snackbar.Add($"Errore salvataggio titolo: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    /// <summary>Riordino giornate dal board di destra (frecce su/giù): alternativa al DnD della sidebar, stessa persistenza.</summary>
    private async Task MoveGiornata(WebTourItinerario g, int delta)
    {
        var idx = _giornate.IndexOf(g);
        var newIdx = idx + delta;
        if (idx < 0 || newIdx < 0 || newIdx >= _giornate.Count) return;
        _giornate.RemoveAt(idx);
        _giornate.Insert(newIdx, g);
        for (int i = 0; i < _giornate.Count; i++) { _giornate[i].Ordine = i + 1; _giornate[i].GiornoNumero = i + 1; }
        _giornateContainer?.Refresh();
        try { await GiornateService.ReorderAsync(AziendaId, ContenutoId, _giornate.Select(x => x.WebTourItinerarioId).ToList()); }
        catch (Exception ex) { Snackbar.Add($"Errore riordino giornate: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task DeleteGiornata(WebTourItinerario g)
    {
        if (!await ConfirmDelete("Elimina giornata", $"Eliminare \"{g.TitoloGiornata}\" e tutti i suoi passaggi?")) return;
        try
        {
            await GiornateService.DeleteAsync(g.WebTourItinerarioId, AziendaId); // cascata sui passi lato DB
            _passi.RemoveAll(x => x.ItinerarioIdFk == g.WebTourItinerarioId);
            _giornate.Remove(g);
            for (int i = 0; i < _giornate.Count; i++) { _giornate[i].Ordine = i + 1; _giornate[i].GiornoNumero = i + 1; }
            if (_giornate.Count > 0)
                await GiornateService.ReorderAsync(AziendaId, ContenutoId, _giornate.Select(x => x.WebTourItinerarioId).ToList());
            _giornateContainer?.Refresh();
            await NotifyStatoAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Errore eliminazione giornata: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task OnGiornataDropped(MudItemDropInfo<WebTourItinerario> info)
    {
        var g = info.Item;
        if (g is null) return;
        _giornate.Remove(g);
        var idx = Math.Clamp(info.IndexInZone, 0, _giornate.Count);
        _giornate.Insert(idx, g);
        for (int i = 0; i < _giornate.Count; i++) { _giornate[i].Ordine = i + 1; _giornate[i].GiornoNumero = i + 1; }
        _giornateContainer?.Refresh();

        try { await GiornateService.ReorderAsync(AziendaId, ContenutoId, _giornate.Select(x => x.WebTourItinerarioId).ToList()); }
        catch (Exception ex) { Snackbar.Add($"Errore riordino giornate: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    // ---- Passi ---------------------------------------------------------------

    private async Task AddPasso(WebTourItinerario g)
    {
        var passo = new WebTourItinerarioPassaggio
        {
            ItinerarioIdFk = g.WebTourItinerarioId, AziendaId = AziendaId, TestoHtml = string.Empty,
            Ordine = _passi.Count(x => x.ItinerarioIdFk == g.WebTourItinerarioId) + 1
        };
        var oldTitolo = g.TitoloGiornata;
        var edited = await OpenPassoDialog(passo, "Aggiungi passaggio", g);
        if (edited == null) return;
        try
        {
            if (g.TitoloGiornata != oldTitolo) await GiornateService.UpdateAsync(g);
            var created = await PassiService.CreateAsync(edited);
            _passi.Add(created);
            _passi = _passi.OrderBy(x => x.ItinerarioIdFk).ThenBy(x => x.Ordine).ToList();
            _giornateContainer?.Refresh();
        }
        catch (Exception ex) { Snackbar.Add($"Errore creazione passaggio: {ex.Message}", Severity.Error); }
    }

    private async Task EditPasso(WebTourItinerarioPassaggio passo)
    {
        var g = _giornate.FirstOrDefault(x => x.WebTourItinerarioId == passo.ItinerarioIdFk);
        if (g == null) return;
        var oldTitolo = g.TitoloGiornata;
        var edited = await OpenPassoDialog(passo, "Modifica passaggio", g);
        if (edited == null) return;
        try
        {
            if (g.TitoloGiornata != oldTitolo) await GiornateService.UpdateAsync(g);
            await PassiService.UpdateAsync(edited);
            _giornateContainer?.Refresh();
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Errore salvataggio passaggio: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task DeletePasso(WebTourItinerarioPassaggio passo)
    {
        var dayId = passo.ItinerarioIdFk;
        var isUltimo = _passi.Count(x => x.ItinerarioIdFk == dayId) <= 1; // è l'unico passaggio della giornata
        var g = _giornate.FirstOrDefault(x => x.WebTourItinerarioId == dayId);

        var msg = isUltimo
            ? $"È l'unico passaggio della giornata: eliminandolo verrà eliminata anche l'intera giornata \"{g?.TitoloGiornata}\" (titolo e descrizione sono indivisibili). Procedere?"
            : "Eliminare questo passaggio?";
        if (!await ConfirmDelete("Elimina passaggio", msg)) return;

        try
        {
            if (isUltimo && g != null)
            {
                // Ultimo passaggio → elimino l'intera giornata: la cascata DB rimuove anche il passaggio.
                await GiornateService.DeleteAsync(g.WebTourItinerarioId, AziendaId);
                _passi.RemoveAll(x => x.ItinerarioIdFk == dayId);
                _giornate.Remove(g);
                for (int i = 0; i < _giornate.Count; i++) { _giornate[i].Ordine = i + 1; _giornate[i].GiornoNumero = i + 1; }
                if (_giornate.Count > 0)
                    await GiornateService.ReorderAsync(AziendaId, ContenutoId, _giornate.Select(x => x.WebTourItinerarioId).ToList());
                _giornateContainer?.Refresh();
                await NotifyStatoAsync();
            }
            else
            {
                await PassiService.DeleteAsync(passo.WebTourItinerarioPassaggioId, AziendaId);
                _passi.Remove(passo);
                var rest = _passi.Where(x => x.ItinerarioIdFk == dayId).OrderBy(x => x.Ordine).ToList();
                for (int i = 0; i < rest.Count; i++) rest[i].Ordine = i + 1;
                if (rest.Count > 0)
                    await PassiService.ReorderAsync(AziendaId, dayId, rest.Select(x => x.WebTourItinerarioPassaggioId).ToList());
            }
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Errore eliminazione passaggio: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    /// <summary>Riordino dei passaggi DENTRO la stessa giornata con le frecce su/giù (nessun drag&drop).</summary>
    private async Task MovePasso(WebTourItinerarioPassaggio passo, int delta)
    {
        var dayId = passo.ItinerarioIdFk;
        var passiGiornata = _passi.Where(p => p.ItinerarioIdFk == dayId).OrderBy(p => p.Ordine).ToList();
        var idx = passiGiornata.IndexOf(passo);
        var newIdx = idx + delta;
        if (idx < 0 || newIdx < 0 || newIdx >= passiGiornata.Count) return;
        passiGiornata.RemoveAt(idx);
        passiGiornata.Insert(newIdx, passo);
        for (int i = 0; i < passiGiornata.Count; i++) passiGiornata[i].Ordine = i + 1;
        _passi = _passi.OrderBy(x => x.ItinerarioIdFk).ThenBy(x => x.Ordine).ToList();
        try { await PassiService.ReorderAsync(AziendaId, dayId, passiGiornata.Select(x => x.WebTourItinerarioPassaggioId).ToList()); }
        catch (Exception ex) { Snackbar.Add($"Errore riordino passaggi: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    // ---- Helpers -------------------------------------------------------------

    /// <summary>Tutte le giornate vivono nell'unica zona "sidebar" (riordino).</summary>
    private static bool GiornataInZone(WebTourItinerario g, string identifier) => identifier == "sidebar";

    private async Task<WebTourItinerarioPassaggio?> OpenPassoDialog(WebTourItinerarioPassaggio passo, string title, WebTourItinerario giornata)
    {
        var parameters = new DialogParameters<WebTourPassoEditDialog>
        {
            { x => x.Passo, passo },
            { x => x.ContenutoId, ContenutoId },
            { x => x.AziendaId, AziendaId },
            { x => x.Giornata, giornata }
        };
        var options = new DialogOptions { BackdropClick = false, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<WebTourPassoEditDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result!.Canceled ? null : result.Data as WebTourItinerarioPassaggio;
    }

    private async Task<bool> ConfirmDelete(string title, string message)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.Title, title },
            { x => x.ContentText, message }
        };
        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>(title, parameters, new DialogOptions { BackdropClick = false });
        return !(await dialog.Result)!.Canceled;
    }

    /// <summary>Anteprima testuale del passo per la card (tag rimossi, troncata).</summary>
    private static string Snippet(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "(passaggio vuoto)";
        var text = Regex.Replace(html, "<.*?>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = Regex.Replace(text, "\\s+", " ").Trim();
        if (text.Length == 0) return "(passaggio vuoto)";
        return text.Length > 90 ? text[..90] + "…" : text;
    }
}
