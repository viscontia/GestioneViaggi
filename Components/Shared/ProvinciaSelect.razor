@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject ProvinciaService ProvinciaService

<BaseEntitySelect TItem="Provincia" Value="_selectedProvincia" ValueChanged="OnProvinciaChanged"
    SearchFunc="SearchProvince" ToStringFunc="@(p => p?.Descrizione)" Label="@Label" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" Class="@Class" HelperText="@HelperText" AutoFocus="@AutoFocus"
    Validation="@Validation" AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<Provincia> _allProvince = new();
    private List<Provincia> _filteredProvince = new();
    private Provincia? _selectedProvincia;

    [Parameter]
    public int? SelectedProvinciaId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedProvinciaIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Provincia";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La provincia è obbligatoria";

    [Parameter]
    public object? Validation { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la provincia corretta dall'elenco";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter]
    public bool? FilterEsteroOnly { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadProvinceAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyFilter();
        UpdateSelectedProvincia();
    }

    private void UpdateSelectedProvincia()
    {
        if (_filteredProvince == null) return;

        if (SelectedProvinciaId.HasValue)
        {
            if (_selectedProvincia?.Id != SelectedProvinciaId.Value)
            {
                // Search in all province because the selected one might not be in the filtered list
                // (though it should be if logic is correct)
                _selectedProvincia = _allProvince.FirstOrDefault(p => p.Id == SelectedProvinciaId.Value);
            }
        }
        else
        {
            _selectedProvincia = null;
        }
    }

    private async Task LoadProvinceAsync()
    {
        try
        {
            _allProvince = await ProvinciaService.GetAllAsync();
            ApplyFilter();
            UpdateSelectedProvincia();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento province: {ex.Message}");
            _allProvince = new List<Provincia>();
            _filteredProvince = new List<Provincia>();
        }
    }

    private void ApplyFilter()
    {
        if (_allProvince == null) return;

        if (FilterEsteroOnly == true)
        {
            _filteredProvince = _allProvince
            .Where(p => p.Descrizione != null && p.Descrizione.StartsWith("ESTERO", StringComparison.OrdinalIgnoreCase))
            .ToList();
        }
        else if (FilterEsteroOnly == false)
        {
            _filteredProvince = _allProvince
            .Where(p => p.Descrizione != null && !p.Descrizione.StartsWith("ESTERO", StringComparison.OrdinalIgnoreCase))
            .ToList();
        }
        else
        {
            _filteredProvince = _allProvince.ToList();
        }
    }

    private async Task OnProvinciaChanged(Provincia provincia)
    {
        _selectedProvincia = provincia;
        await SelectedProvinciaIdChanged.InvokeAsync(provincia?.Id);
    }

    private async Task<IEnumerable<Provincia>> SearchProvince(string value, CancellationToken token)
    {
        if (_filteredProvince == null)
            return Enumerable.Empty<Provincia>();

        if (string.IsNullOrEmpty(value))
            return _filteredProvince;

        return _filteredProvince.Where(x => x.Descrizione.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
