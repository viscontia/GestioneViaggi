@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject ProvinciaService ProvinciaService

<MudSelect T="int?"
           @ref="_selectRef"
           Value="@SelectedProvinciaId"
           ValueChanged="@SelectedProvinciaIdChanged"
           Label="@Label"
           Variant="Variant.Outlined"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           Class="@ComputedClass"
           HelperText="@HelperText"
           OpenIcon="@Icons.Material.Filled.ArrowDropDown"
           CloseIcon="@Icons.Material.Filled.ArrowDropDown"
           @attributes="AdditionalAttributes">
    @if (_province != null)
    {
        @foreach (var provincia in _province)
        {
            <MudSelectItem T="int?" Value="@provincia.Id">@provincia.Descrizione</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<Provincia>? _province;
    private MudSelect<int?>? _selectRef;
    private bool _focusApplied;

    [Parameter]
    public int? SelectedProvinciaId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedProvinciaIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Provincia";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La provincia è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la provincia corretta dall'elenco";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var baseClass = string.IsNullOrWhiteSpace(Class) ? string.Empty : Class;
            return Required ? string.Join(' ', new[] { baseClass, "required-field" }.Where(x => !string.IsNullOrWhiteSpace(x))) : baseClass;
        }
    }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProvinceAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusApplied && AutoFocus && _selectRef is not null)
        {
            _focusApplied = true;
            await _selectRef.FocusAsync();
        }
    }

    private async Task LoadProvinceAsync()
    {
        try
        {
            // GetAllAsync già ordina per descrizione ASC
            _province = await ProvinciaService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento province: {ex.Message}");
            _province = new List<Provincia>();
        }
    }
}
