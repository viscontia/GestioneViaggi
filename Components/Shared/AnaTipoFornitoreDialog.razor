@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Tipo Fornitore" : "Nuovo Tipo Fornitore")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <MudGrid Spacing="2">
                <!-- Descrizione -->
                <MudItem xs="12">
                    <MudTextField T="string" @ref="_firstField"
                                  Value="@Entity.Descrizione"
                                  ValueChanged="@((string val) => HandleDescrizioneChanged(val))"
                                  For="@(() => Entity.Descrizione)"
                                  Label="Descrizione"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="La descrizione è obbligatoria"
                                  MaxLength="50"
                                  Class="mb-3 uppercase-input"
                                  Adornment="Adornment.End"
                                  AdornmentText="*"
                                  AdornmentColor="Color.Error" />
                </MudItem>

                <!-- Categoria -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Categoria" @bind-Value="Entity.Categoria"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("COSTO")">Costo</MudSelectItem>
                        <MudSelectItem Value="@("RICAVO")">Ricavo</MudSelectItem>
                        <MudSelectItem Value="@("MISTO")">Misto</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Conto Contabile -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Entity.ContoContabileDefault"
                                  Label="Conto Contabile Default"
                                  Variant="Variant.Outlined"
                                  MaxLength="20" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public AnaTipoFornitore Entity { get; set; } = new AnaTipoFornitore();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_firstField != null)
            {
                await Task.Delay(300);
                try
                {
                    await _firstField.FocusAsync();
                }
                catch { }
            }
        }
    }

    public void Dispose()
    {
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void HandleDescrizioneChanged(string value)
    {
        Entity.Descrizione = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                MudDialog?.Close(DialogResult.Ok(Entity));
            }
        }
    }
}
