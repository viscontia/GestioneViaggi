@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

@* Anteprima della newsletter: l'HTML vero, dentro un iframe.
   L'iframe non e' un vezzo — serve a ISOLARE gli stili della newsletter da quelli
   dell'applicazione. Inserito nella pagina, l'HTML della mail erediterebbe il CSS di MudBlazor
   e mostrerebbe qualcosa di diverso da cio' che arrivera' al destinatario, cioe' esattamente
   l'errore che un'anteprima deve evitare. *@

<MudDialog>
    <DialogContent>
        <div class="d-flex align-center gap-2 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" />
            <MudText Typo="Typo.body2">
                È il rendering reale, lo stesso che verrà spedito. Le immagini si vedono solo se
                l'indirizzo è pubblicamente raggiungibile.
            </MudText>
        </div>

        <div style="position:relative;border:1px solid var(--mud-palette-lines-default);border-radius:4px;overflow:hidden;background:#f4f4f4;">
            @* Velo di attesa: copre l'anteprima finche' le immagini non sono caricate e
               impedisce i clic. Senza, l'utente vede per qualche secondo una newsletter a
               pezzi e pensa di averla composta male. *@
            @if (!_pronta)
            {
                <div style="position:absolute;inset:0;z-index:2;background:rgba(255,255,255,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.body1" Class="mt-3">Caricamento delle immagini…</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">L'anteprima si apre appena sono tutte pronte.</MudText>
                </div>
            }
            @* Il contenuto lo scrive JS nel documento dell'iframe: vedi newsletterPreview.js
               per il motivo per cui srcdoc non va bene. *@
            <iframe @ref="_iframe" title="Anteprima newsletter"
                    style="width:100%;height:65vh;border:0;display:block;background:#fff;"></iframe>
        </div>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            Il browser non è un client di posta: Outlook per Windows resta il caso più severo.
            Per una verifica reale usa <strong>Invia prova</strong> verso una casella vera.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Chiudi">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public string Html { get; set; } = string.Empty;

    private ElementReference _iframe;
    private bool _scritto;
    private bool _pronta;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Al primo render l'iframe esiste ma il suo documento puo' non essere ancora pronto:
        // un piccolo ritardo evita l'anteprima vuota al primo colpo.
        if (firstRender && !_scritto && !string.IsNullOrEmpty(Html))
        {
            await Task.Delay(80);
            try
            {
                // La chiamata torna solo quando le immagini sono caricate (o dopo il timeout
                // di sicurezza): e' quello che tiene su il velo di attesa.
                _scritto = await JS.InvokeAsync<bool>("newsletterPreview.scrivi", _iframe, Html, 10000);
            }
            catch (Exception)
            {
                _scritto = false;
            }
            finally
            {
                _pronta = true;
            }
            StateHasChanged();
        }
    }

    private void Chiudi() => MudDialog?.Close();
}
