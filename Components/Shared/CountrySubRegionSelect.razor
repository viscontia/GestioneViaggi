@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using System.Threading
@inject CountrySubRegionService CountrySubRegionService

<BaseEntitySelect TItem="CountrySubRegion"
                  Value="_selectedSubRegion"
                  ValueChanged="OnSubRegionChanged"
                  SearchFunc="SearchSubRegions"
                  ToStringFunc="@(s => s?.Name?.ToUpperInvariant())"
                  Label="@Label"
                  Required="@Required"
                  RequiredError="@RequiredError"
                  Disabled="@Disabled"
                  Class="@($"{Class} uppercase-input")"
                  HelperText="@HelperText"
                  AutoFocus="@AutoFocus"
                  AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<CountrySubRegion>? _subRegions;
    private CountrySubRegion? _selectedSubRegion;

    [Parameter]
    public int? SelectedSubRegionId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedSubRegionIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Sotto-Regione";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La sotto-regione è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la sotto-regione (es: Eastern Europe, Central Asia)";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadSubRegionsAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedSubRegion();
    }

    private void UpdateSelectedSubRegion()
    {
        if (_subRegions == null) return;

        if (SelectedSubRegionId.HasValue)
        {
            if (_selectedSubRegion?.Id != SelectedSubRegionId.Value)
            {
                _selectedSubRegion = _subRegions.FirstOrDefault(s => s.Id == SelectedSubRegionId.Value);
            }
        }
        else
        {
            _selectedSubRegion = null;
        }
    }

    private async Task LoadSubRegionsAsync()
    {
        try
        {
            _subRegions = await CountrySubRegionService.GetAllOrderedByNameAsync();
            UpdateSelectedSubRegion();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento sotto-regioni: {ex.Message}");
            _subRegions = new List<CountrySubRegion>();
        }
    }

    private async Task OnSubRegionChanged(CountrySubRegion subRegion)
    {
        _selectedSubRegion = subRegion;
        await SelectedSubRegionIdChanged.InvokeAsync(subRegion?.Id);
    }

    private async Task<IEnumerable<CountrySubRegion>> SearchSubRegions(string value, CancellationToken token)
    {
        if (_subRegions == null)
            return Enumerable.Empty<CountrySubRegion>();

        if (string.IsNullOrEmpty(value))
            return _subRegions;

        return _subRegions.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
