@using GestioneViaggi.Models
@using GestioneViaggi.Validation.Syntax
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<MudDialog close-on-escape-key="true">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Conto Bancario" : "Nuovo Conto Bancario")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <!-- Nome Banca - OBBLIGATORIO -->
            <MudTextField @ref="_nomeBancaField"
                          Value="@Entity.NomeBanca"
                          ValueChanged="@((string val) => Entity.NomeBanca = val?.ToUpper() ?? string.Empty)"
                          For="@(() => Entity.NomeBanca)"
                          Label="Nome Banca"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il nome della banca è obbligatorio"
                          MaxLength="150"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Nome dell'istituto bancario"
                          OnKeyDown="@HandleKeyDown" />

            <!-- Filiale - Opzionale -->
            <MudTextField @bind-Value="Entity.Filiale"
                          For="@(() => Entity.Filiale)"
                          Label="Filiale (opzionale)"
                          Variant="Variant.Outlined"
                          MaxLength="150"
                          Class="mb-3"
                          HelperText="Nome o codice della filiale" />

            <MudDivider Class="my-4" />

            <!-- IBAN - OBBLIGATORIO -->
            <MudTextField Value="@Entity.Iban"
                          ValueChanged="@((string val) => Entity.Iban = val?.ToUpper().Replace(" ", "") ?? string.Empty)"
                          For="@(() => Entity.Iban)"
                          Label="IBAN"
                          Variant="Variant.Outlined"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateIban))"
                          Required="true"
                          RequiredError="L'IBAN è obbligatorio"
                          Immediate="true"
                          MaxLength="34"
                          Class="mb-3"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Es: IT60X0542811101000000123456" />

            <!-- SWIFT/BIC - Opzionale -->
            <MudTextField Value="@Entity.SwiftBic"
                          ValueChanged="@((string val) => Entity.SwiftBic = val?.ToUpper().Replace(" ", "") ?? string.Empty)"
                          For="@(() => Entity.SwiftBic)"
                          Label="SWIFT/BIC (opzionale)"
                          Variant="Variant.Outlined"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateSwift))"
                          Immediate="true"
                          MaxLength="11"
                          Class="mb-3"
                          HelperText="Es: ABCDITMM oppure ABCDITMMXXX" />

            <!-- Flag Predefinito -->
            <MudCheckBox @bind-Value="Entity.IsPredefinito"
                         For="@(() => Entity.IsPredefinito)"
                         Label="Conto Predefinito"
                         Color="Color.Primary"
                         Class="mb-3" />

            <!-- Note - Opzionali -->
            <MudTextField @bind-Value="Entity.Note"
                          For="@(() => Entity.Note)"
                          Label="Note (opzionale)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-3"
                          HelperText="Informazioni aggiuntive sul conto" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _nomeBancaField;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public AziendaBanca Entity { get; set; } = new AziendaBanca();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private IEnumerable<string> ValidateIban(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            yield return "L'IBAN è obbligatorio";
            yield break;
        }

        var result = BankingValidator.CheckIban(value);
        if (!result.IsValid)
            yield return result.ErrorMessage;
    }

    private IEnumerable<string> ValidateSwift(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            yield break; // SWIFT è opzionale

        var result = BankingValidator.CheckSwift(value);
        if (!result.IsValid)
            yield return result.ErrorMessage;
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                MudDialog?.Close(DialogResult.Ok(Entity));
            }
            else
            {
                if (_nomeBancaField?.Error == true)
                {
                    await _nomeBancaField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch { }
    }
}
