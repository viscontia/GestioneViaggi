@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Validation.Syntax
@using GestioneViaggi.Validation.Semantic
@using Blazored.TextEditor
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-0" Style="max-height: 80vh; overflow-y: auto;">
             <MudTabs @ref="_tabs" ActivePanelIndex="@_activeTabIndex" ActivePanelIndexChanged="OnTabChanged" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" KeepPanelsAlive="true">
                <MudTabPanel Text="Dati Generali" Icon="@Icons.Material.Filled.Flight">
                    <MudForm @ref="_form" Model="@Entity" @bind-IsValid="@_isValid" ValidationDelay="0">

                        <!-- 1. AZIENDA -->
                        @if (IsEditMode)
                        {
                            <MudTextField Value="@Entity.AziendaRagioneSociale" Label="Azienda" ReadOnly="true"
                                Variant="Variant.Outlined" Class="mb-4" />
                        }
                        else
                        {
                            <AziendaSelect @bind-Value="Entity.AziendaId" Label="Azienda" Required="true"
                                Disabled="@(!IsSuperAdmin)" RequiredError="Selezionare l'azienda" Class="mb-4"
                                Items="@_initData?.Aziende" />
                        }

                        <!-- 2. DATI PRINCIPALI VIAGGIO -->
                        <MudGrid>
                            <!-- Nazione -->
                            <MudItem xs="12" sm="6">
                                <CountrySelect SelectedCountryId="@((int?)Entity.NazioneIdFk)"
                                    SelectedCountryIdChanged="@(val => Entity.NazioneIdFk = val ?? 0)" Label="Nazione"
                                    Required="true" Class="mb-3" Items="@_initData?.Nazioni" />
                            </MudItem>

                            <!-- Tipo Viaggio -->
                            <MudItem xs="12" sm="6">
                                <TipoViaggioSelect SelectedId="@((int?)Entity.TipoViaggioIdFk)"
                                    SelectedIdChanged="@(val => Entity.TipoViaggioIdFk = val ?? 0)" Label="Tipo Viaggio"
                                    Required="true" Class="mb-3" Items="@_initData?.TipiViaggio" />
                            </MudItem>

                            <!-- Descrizione Breve -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Entity.DescrizioneBreve" For="@(() => Entity.DescrizioneBreve)"
                                    Label="Descrizione Breve" Variant="Variant.Outlined" Required="true" Class="uppercase-input"
                                    Immediate="true" Converter="@_uppercaseConverter" />
                            </MudItem>

                            <!-- Descrizione Estesa -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Entity.DescrizioneEstesa" For="@(() => Entity.DescrizioneEstesa)"
                                    Label="Descrizione Estesa" Variant="Variant.Outlined" Lines="3" Required="true"
                                    Class="uppercase-input" Immediate="true" Converter="@_uppercaseConverter" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-4" />

                        <!-- 3. DETTAGLI LOGISTICI -->
                        <MudGrid>
                            <!-- Giorni -->
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int" Value="Entity.NumeroGiorni" ValueChanged="@HandleGiorniChanged" For="@(() => Entity.NumeroGiorni)"
                                    Label="Giorni" Variant="Variant.Outlined" Min="1" Max="365" Required="true" />
                            </MudItem>
                            <!-- Notti -->
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int" @bind-Value="Entity.NumeroNotti" For="@(() => Entity.NumeroNotti)"
                                    Label="Notti" Variant="Variant.Outlined" Min="0" Max="365" Required="true" />
                            </MudItem>
                            <!-- Km -->
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int" @bind-Value="Entity.Km" For="@(() => Entity.Km)" Label="Km"
                                    Variant="Variant.Outlined" Min="0" Required="true" />
                            </MudItem>

                            <!-- Pasti al Sacco -->
                            <MudItem xs="6" sm="3" Class="d-flex align-center">
                                <MudCheckBox T="bool" Value="@(Entity.PastiAlSacco == "Y")"
                                    ValueChanged="@(val => Entity.PastiAlSacco = val ? "Y" : "N")" Label="Pasti al Sacco"
                                    Color="Color.Primary" />
                            </MudItem>

                            <!-- Difficoltà (usata dai contenuti web) -->
                            <MudItem xs="6" sm="3">
                                <MudSelect T="string" @bind-Value="Entity.Difficolta" Label="Difficoltà"
                                    Variant="Variant.Outlined" Clearable="true">
                                    <MudSelectItem T="string" Value="@("turistica")">Turistica</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("media")">Media</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("medio_alta")">Medio-alta</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("alta")">Alta</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <!-- Capienza (posti in EQUIPAGGI/MEZZI) — usata dal sito per "posti rimasti" -->
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int?" @bind-Value="Entity.CapienzaMax" Label="Capienza (mezzi)"
                                    Variant="Variant.Outlined" Min="0" Clearable="true"
                                    HelperText="Posti totali in equipaggi. Vuoto = non gestita." />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int?" @bind-Value="Entity.CapienzaAlert" Label="Soglia ultimi posti"
                                    Variant="Variant.Outlined" Min="0" Clearable="true"
                                    HelperText="Sotto questo residuo: &quot;Rimangono solo N posti&quot;." />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-4" />

                        <!-- 4. CLASSIFICAZIONI -->
                        <MudGrid>
                            <!-- Tipo Trattamento -->
                            <MudItem xs="12" sm="4">
                                <TipoTrattamentoSelect SelectedId="@((int?)Entity.TipoTrattamentoIdFk)"
                                    SelectedIdChanged="@(val => Entity.TipoTrattamentoIdFk = val ?? 0)" Label="Trattamento"
                                    Required="true" Items="@_initData?.TipiTrattamento" />
                            </MudItem>
                            <!-- Tipo Pernottamento -->
                            <MudItem xs="12" sm="4">
                                <TipoPernottamentoSelect SelectedId="@((int?)Entity.TipoPernottamentoIdFk)"
                                    SelectedIdChanged="@(val => Entity.TipoPernottamentoIdFk = val ?? 0)" Label="Pernottamento"
                                    Required="true" Items="@_initData?.TipiPernottamento" />
                            </MudItem>
                            <!-- Tipo Avvicinamento -->
                            <MudItem xs="12" sm="4">
                                <TipoAvvicinamentoSelect SelectedId="@((int?)Entity.TipoAvvicinamentoIdFk)"
                                    SelectedIdChanged="@(val => Entity.TipoAvvicinamentoIdFk = val ?? 0)" Label="Avvicinamento"
                                    Required="true" Items="@_initData?.TipiAvvicinamento" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-4" />

                        <!-- 5. NOTE E LINK -->
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Entity.Note" For="@(() => Entity.Note)" Label="Note"
                                    Variant="Variant.Outlined" Lines="2" Class="uppercase-input" Immediate="true"
                                    Converter="@_uppercaseNullableConverter" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Entity.Link" For="@(() => Entity.Link)" Label="Link Documentazione"
                                    Variant="Variant.Outlined" InputType="InputType.Url" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-4" />

                        <!-- 6. INCLUSO / ESCLUSO (mostrati nella scheda tour del sito, tradotti) -->
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            Incluso / Escluso
                            <MudText Typo="Typo.caption" HtmlTag="span" Class="mud-text-secondary">— mostrati nella scheda tour del sito</MudText>
                        </MudText>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-1">La quota comprende</MudText>
                                <div style="height:200px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                                    <BlazoredTextEditor @ref="_edIncluso" Placeholder="Elenco di ciò che è incluso nella quota...">
                                        <ToolbarContent>@ToolbarIncluso</ToolbarContent>
                                    </BlazoredTextEditor>
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-1">La quota non comprende</MudText>
                                <div style="height:200px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
                                    <BlazoredTextEditor @ref="_edEscluso" Placeholder="Elenco di ciò che è escluso...">
                                        <ToolbarContent>@ToolbarIncluso</ToolbarContent>
                                    </BlazoredTextEditor>
                                </div>
                            </MudItem>
                        </MudGrid>

                    </MudForm>
                </MudTabPanel>
                
                <MudTabPanel Icon="@Icons.Material.Filled.DateRange">
                     <TabContent>
                         <div class="d-flex align-center">
                             <MudText Class="ms-2">Date e Costi</MudText>
                             @if (_dates.Count > 0)
                             {
                                 <span class="ms-2 px-2 py-1 rounded-circle mud-elevation-2" 
                                       style="background-color: var(--mud-palette-primary); color: var(--mud-palette-white); font-weight: bold; font-size: 0.75rem; line-height: 1;">
                                     @_dates.Count
                                 </span>
                             }
                         </div>
                     </TabContent>
                     <ChildContent>
                     @if (IsEditMode)
                     {
                         <MudAlert Severity="Severity.Info" Class="mb-3">Le modifiche alle date in questa modalità vengono salvate immediatamente.</MudAlert>
                     }
                     else
                     {
                         <MudAlert Severity="Severity.Info" Class="mb-3">Inserisci le date pianificate. Saranno salvate insieme al viaggio.</MudAlert>
                     }

                     <ViaggioDatesManager @ref="_datesManager" Dates="@_dates" IsLiveMode="@IsEditMode" TripId="@Entity.Id" AziendaId="@GetAziendaId()"
                                          DurationDays="@Entity.NumeroGiorni" Trip="@Entity"
                                          DatesChanged="@(() => StateHasChanged())" OnTripDeleted="HandleTripDeleted" />
                     </ChildContent>
                </MudTabPanel>

                @* Contenuti Web PER EDIZIONE (Blocco 13): solo in edit. Il contenuto è figlio di
                   (viaggio + data_viaggio); la gestione edizione/tab è incapsulata nel manager. *@
                @if (IsEditMode)
                {
                    <MudTabPanel Text="Contenuti Web" Icon="@Icons.Material.Filled.Language">
                        <WebEdizioniManager ViaggioId="@Entity.Id" AziendaId="@GetAziendaId()"
                                            DescrizioneBreve="@Entity.DescrizioneBreve" />
                    </MudTabPanel>
                }
             </MudTabs>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Salvataggio...</MudText>
            }
            else
            {
                <MudText>Salva</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] public AnaViaggiService ViaggiService { get; set; } = default!;
    [Inject] public IDialogService DialogService { get; set; } = default!;
    [Inject] public ISnackbar Snackbar { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;

    [Parameter] public AnaViaggi Entity { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool StartOnDatesTab { get; set; }
    [Parameter] public bool AutoOpenAddDate { get; set; } // Shortcut for "Quick Add"

    private MudTabs _tabs = default!;
    private int _activeTabIndex = 0;

    [Parameter] public int AziendaFk { get; set; } // Current Session AziendaId

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private List<AnaDataViaggio> _dates = new();
    private ViaggioDatesManager? _datesManager;
    private GestioneViaggi.Models.DTOs.ViaggiInitData _initData = new();
    private bool _hasLoadedData = false;

    // Editor Quill Incluso/Escluso (contenuto editoriale per il sito — NON uppercase)
    private BlazoredTextEditor _edIncluso = default!;
    private BlazoredTextEditor _edEscluso = default!;
    private bool _editorsLoaded;

    private static readonly RenderFragment ToolbarIncluso = __builder =>
    {
        <span class="ql-formats">
            <button class="ql-bold"></button>
            <button class="ql-italic"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-list" value="bullet"></button>
            <button class="ql-list" value="ordered"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-clean"></button>
        </span>
    };

    /// <summary>Quill "vuoto" restituisce &lt;p&gt;&lt;br&gt;&lt;/p&gt;: normalizza a NULL.</summary>
    private static string? NormalizeHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var stripped = html.Replace("<p><br></p>", string.Empty).Replace("<p></p>", string.Empty).Trim();
        return stripped.Length == 0 ? null : html;
    }

    private bool IsSuperAdmin => AziendaFk == 0;

    // Converter to enforce Uppercase on typing
    private Converter<string> _uppercaseConverter = new Converter<string>
        {
            SetFunc = value => value?.ToUpperInvariant(),
            GetFunc = text => text?.ToUpperInvariant()
        };

    private Converter<string?> _uppercaseNullableConverter = new Converter<string?>
        {
            SetFunc = value => value?.ToUpperInvariant(),
            GetFunc = text => text?.ToUpperInvariant()
        };

    private int GetAziendaId()
    {
        if (Entity.AziendaId > 0) return Entity.AziendaId;
        return AziendaFk;
    }

    protected override void OnInitialized()
    {
        if (StartOnDatesTab) _activeTabIndex = 1;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Solo carica i dati una volta, quando i parametri sono impostati
        if (_hasLoadedData) return;

        try
        {
            // FAT INIT: Carica tutti i lookup e (se edit) le date in un'unica chiamata
            _initData = await ViaggiService.GetViaggiInitDataAsync(IsEditMode ? Entity.Id : (int?)null);

            if (IsEditMode)
            {
                // CRITICAL: Create a new list instance to trigger Blazor's parameter change detection
                // Simply mutating the existing list might not trigger MudDataGrid to re-render
                _dates = _initData.Dates != null && _initData.Dates.Any()
                    ? new List<AnaDataViaggio>(_initData.Dates)
                    : new List<AnaDataViaggio>();

                // Force UI update after data load
                StateHasChanged();
            }

            _hasLoadedData = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento: {ex.Message}", Severity.Error);
        }

        // Init Azienda Logic
        if (!IsEditMode)
        {
            // If not edit mode, set default azienda from session (if not superadmin)
            if (Entity.AziendaId == 0 && AziendaFk > 0)
            {
                Entity.AziendaId = AziendaFk;
            }

            // Set default scalar values if needed
            if (Entity.NumeroGiorni == 0) Entity.NumeroGiorni = 1;

            // Dates list empty for new
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Init Focus Trap & Tab Navigation helper
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");

                if (StartOnDatesTab)
                {
                     _activeTabIndex = 1;
                     StateHasChanged();
                     
                     if (AutoOpenAddDate)
                     {
                         await Task.Delay(200); // Allow Tabs and DatesManager to render
                         if (_datesManager != null)
                         {
                             await _datesManager.AddDate();
                         }
                     }
                }
            }
            catch { /* Ignore JS errors on init */ }
        }

        // Carica l'HTML esistente negli editor Quill una volta sola, quando i ref sono pronti
        // (i pannelli sono KeepPanelsAlive, quindi esistono anche se il tab attivo è un altro).
        if (!_editorsLoaded && _edIncluso is not null && _edEscluso is not null)
        {
            _editorsLoaded = true;
            try
            {
                await Task.Delay(150); // Quill si inizializza async
                if (!string.IsNullOrWhiteSpace(Entity.Incluso))
                    await _edIncluso.LoadHTMLContent(Entity.Incluso);
                if (!string.IsNullOrWhiteSpace(Entity.Escluso))
                    await _edEscluso.LoadHTMLContent(Entity.Escluso);
            }
            catch { /* Editor non ancora pronto: i campi restano vuoti/modificabili */ }
        }
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (IsSuperAdmin && Entity.AziendaId == 0)
        {
            Snackbar.Add("Selezionare un'azienda obbligatoria", Severity.Warning);
            return;
        }
        // Validate Foreign Keys (Since we use manual binding, MudForm might misreport validity if Value is null but Required fails to block)
        if (Entity.NazioneIdFk == 0)
        {
             Snackbar.Add("Selezionare una Nazione", Severity.Warning);
             return;
        }
        if (Entity.TipoViaggioIdFk == 0)
        {
             Snackbar.Add("Selezionare un Tipo Viaggio", Severity.Warning);
             return;
        }
        if (Entity.TipoTrattamentoIdFk == 0)
        {
             Snackbar.Add("Selezionare un Tipo Trattamento", Severity.Warning);
             return;
        }
        if (Entity.TipoPernottamentoIdFk == 0)
        {
             Snackbar.Add("Selezionare un Tipo Pernottamento", Severity.Warning);
             return;
        }
        if (Entity.TipoAvvicinamentoIdFk == 0)
        {
             Snackbar.Add("Selezionare un Tipo Avvicinamento", Severity.Warning);
             return;
        }

        // CHECK FOR DUPLICATES (Only on Create)
        if (!IsEditMode)
        {
            var duplicates = await ViaggiService.CheckDuplicatesAsync(Entity.DescrizioneBreve, GetAziendaId());
            
            if (duplicates.Count > 0)
            {
                // Build warning message
                var message = "Attenzione: sono stati trovati viaggi simili con parole chiave coincidenti:\n\n";
                foreach (var dup in duplicates.Take(3)) // Show max 3 examples
                {
                    message += $"- {dup.Descrizione} (Parole: {dup.MatchingWords})\n";
                }
                if (duplicates.Count > 3) message += $"... e altri {duplicates.Count - 3} viaggi.\n";
                
                message += "\nSei sicuro di voler creare comunque questo viaggio?";

                bool confirmCreation = await DialogService.ShowMessageBox(
                        "Possibile Duplicato",
                        message,
                        yesText: "Sì, crea comunque",
                        cancelText: "No, annulla") ?? false;

                if (!confirmCreation)
                {
                    return; // Abort save
                }
            }
        }

        // Validate Dates for New Trip
        // Validate Dates for New Trip (Interactive Flow)
        if (!IsEditMode && _dates.Count == 0)
        {
             bool confirm = await DialogService.ShowMessageBox(
                "Attenzione", 
                "Per salvare il nuovo viaggio è necessario inserire almeno una data. Vuoi inserirla ora?", 
                yesText: "Sì, inserisci", 
                cancelText: "No, annulla tutto") ?? false;

             if (!confirm)
             {
                 MudDialog.Cancel();
                 return;
             }
             
             // User wants to insert date.
             // 1. Switch to Dates Tab (to ensure UI context)
             _activeTabIndex = 1;
             StateHasChanged();
             await Task.Delay(100); // Allow render

             // 2. Open Add Date Dialog directly
             if (_datesManager != null)
             {
                 await _datesManager.AddDate();
             }

             // 3. Re-Check: Did user actually save a date?
             if (_dates.Count == 0)
             {
                 // User cancelled the date dialog or didn't save.
                 // "Se anche qui utente fa annulla... si fa rollback e si torna indietro"
                 Snackbar.Add("Nessuna data inserita. Creazione viaggio annullata.", Severity.Info);
                 MudDialog.Cancel();
                 return;
             }
        }

        if (!_form.IsValid)
        {
            Snackbar.Add("Compilare tutti i campi obbligatori prima di salvare.", Severity.Warning);
            return;
        }

        // Incluso/Escluso: raccoglie l'HTML dagli editor Quill (NON uppercase — vanno sul sito)
        try
        {
            if (_editorsLoaded)
            {
                Entity.Incluso = NormalizeHtml(await _edIncluso.GetHTML());
                Entity.Escluso = NormalizeHtml(await _edEscluso.GetHTML());
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore lettura editor Incluso/Escluso: {ex.Message}", Severity.Error);
            return;
        }

        _isSaving = true;
        try
        {
            // Final Normalization (redundant with Converter but safe)
            Entity.DescrizioneBreve = Entity.DescrizioneBreve?.ToUpperInvariant() ?? string.Empty;
            Entity.DescrizioneEstesa = Entity.DescrizioneEstesa?.ToUpperInvariant() ?? string.Empty;
            Entity.Note = Entity.Note?.ToUpperInvariant();

            AnaViaggi result;
            if (IsEditMode)
            {
                result = await ViaggiService.UpdateAsync(Entity);
                // Dates are already saved in Live Mode
                Snackbar.Add("Viaggio aggiornato con successo", Severity.Success);
            }
            else
            {
                // Atomic Create
                int newId = await ViaggiService.CreateTripWithDatesAsync(Entity, _dates);
                Entity.Id = newId;
                result = Entity;
                Snackbar.Add("Viaggio creato con successo", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante il salvataggio: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }



    private async Task OnTabChanged(int index)
    {
        _activeTabIndex = index;

        // Auto-open Add Date Dialog if:
        // 1. We switch to Dates Tab (Index 1)
        // 2. It is a New Trip (!IsEditMode)
        // 3. There are no dates yet
        // 4. We rely on the Manager to pop the dialog
        if (index == 1 && !IsEditMode && _dates.Count == 0 && _datesManager != null)
        {
             // Give UI a moment to render the tab content
             await Task.Delay(100); 
             if (_datesManager != null)
             {
                 await _datesManager.AddDate();
             }
        }
    }

    private void HandleTripDeleted()
    {
        // Trip was deleted (orphaned). Close dialog and signal success (so list refreshes).
        MudDialog.Close(DialogResult.Ok(Entity)); 
    }

    private void HandleGiorniChanged(int value)
    {
        Entity.NumeroGiorni = value;
        // Calcolo automatico notti: Giorni - 1 (minimo 0)
        Entity.NumeroNotti = Math.Max(0, value - 1);
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();
}
