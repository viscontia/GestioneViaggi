@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject CountryRegionService CountryRegionService

<MudSelect T="int?"
           @ref="_selectRef"
           Value="@SelectedRegionId"
           ValueChanged="@SelectedRegionIdChanged"
           Label="@Label"
           Variant="Variant.Outlined"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           Class="@ComputedClass"
           HelperText="@HelperText"
           Placeholder="Seleziona una regione..."
           OpenIcon="@Icons.Material.Filled.ArrowDropDown"
           CloseIcon="@Icons.Material.Filled.ArrowDropDown"
           @attributes="AdditionalAttributes">
    @if (_regions != null)
    {
        <MudSelectItem T="int?" Value="@((int?)null)">-- Seleziona --</MudSelectItem>
        @foreach (var region in _regions)
        {
            <MudSelectItem T="int?" Value="@region.Id">@region.Name</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<CountryRegion>? _regions;
    private MudSelect<int?>? _selectRef;
    private bool _focusApplied;

    [Parameter]
    public int? SelectedRegionId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRegionIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Regione Geografica";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La regione geografica è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la regione geografica (es: Africa, America, Asia)";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var baseClass = string.IsNullOrWhiteSpace(Class) ? string.Empty : Class;
            return Required ? string.Join(' ', new[] { baseClass, "required-field" }.Where(x => !string.IsNullOrWhiteSpace(x))) : baseClass;
        }
    }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusApplied && AutoFocus && _selectRef is not null)
        {
            _focusApplied = true;
            await _selectRef.FocusAsync();
        }
    }

    private async Task LoadRegionsAsync()
    {
        try
        {
            _regions = await CountryRegionService.GetAllOrderedByNameAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento regioni geografiche: {ex.Message}");
            _regions = new List<CountryRegion>();
        }
    }
}
