@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using System.Threading
@inject CountryRegionService CountryRegionService

<BaseEntitySelect TItem="CountryRegion"
                  Value="_selectedRegion"
                  ValueChanged="OnRegionChanged"
                  SearchFunc="SearchRegions"
                  ToStringFunc="@(r => r?.Name)"
                  Label="@Label"
                  Required="@Required"
                  RequiredError="@RequiredError"
                  Disabled="@Disabled"
                  Class="@Class"
                  HelperText="@HelperText"
                  AutoFocus="@AutoFocus"
                  AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<CountryRegion>? _regions;
    private CountryRegion? _selectedRegion;

    [Parameter]
    public int? SelectedRegionId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRegionIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Regione Geografica";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La regione geografica è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la regione geografica (es: Africa, America, Asia)";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedRegion();
    }

    private void UpdateSelectedRegion()
    {
        if (_regions == null) return;

        if (SelectedRegionId.HasValue)
        {
            if (_selectedRegion?.Id != SelectedRegionId.Value)
            {
                _selectedRegion = _regions.FirstOrDefault(r => r.Id == SelectedRegionId.Value);
            }
        }
        else
        {
            _selectedRegion = null;
        }
    }

    private async Task LoadRegionsAsync()
    {
        try
        {
            _regions = await CountryRegionService.GetAllOrderedByNameAsync();
            UpdateSelectedRegion();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento regioni geografiche: {ex.Message}");
            _regions = new List<CountryRegion>();
        }
    }

    private async Task OnRegionChanged(CountryRegion region)
    {
        _selectedRegion = region;
        await SelectedRegionIdChanged.InvokeAsync(region?.Id);
    }

    private async Task<IEnumerable<CountryRegion>> SearchRegions(string value, CancellationToken token)
    {
        if (_regions == null)
            return Enumerable.Empty<CountryRegion>();

        if (string.IsNullOrEmpty(value))
            return _regions;

        return _regions.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
