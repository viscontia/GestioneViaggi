@typeparam TItem
@using MudBlazor
@using System.Threading

<MudAutocomplete T="TItem" Value="Value" ValueChanged="OnValueChanged" SearchFunc="SearchFunc"
    ToStringFunc="ToStringFunc" Label="@Label" Variant="Variant.Outlined" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" Class="@ComputedClass" HelperText="@HelperText" Clearable="true"
    ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false" AdornmentIcon="@Icons.Material.Filled.Search"
    AdornmentColor="Color.Primary" Strict="false" Dense="true" OpenOnFocus="false" @ref="_autocompleteRef"
    Validation="@Validation" MaxItems="null" @attributes="AdditionalAttributes" />

@code {
    private MudAutocomplete<TItem>? _autocompleteRef;

    [Parameter] public TItem? Value { get; set; }
    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<TItem>>>? SearchFunc { get; set; }
    [Parameter] public Func<TItem, string>? ToStringFunc { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public object? Validation { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool HelperTextError { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass =>
    (Required ? $"{Class} required-field" : (Class ?? string.Empty)) + (HelperTextError ? " helper-text-error" : "");

    private async Task OnValueChanged(TItem? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    /// <summary>
    /// Quando chi ci contiene azzera il valore — svuotando una scheda dopo un salvataggio —
    /// il campo deve tornare vuoto anche a vedersi.
    ///
    /// ⚠️ Senza questo, il VALORE è già nullo ma il TESTO scritto resta: la scheda sembra
    /// ancora compilata («GUIDA» nel ruolo dopo «Salva e Nuovo», 2026-09-06) e chi salva di
    /// nuovo crede di aver scelto qualcosa che non è più selezionato. <c>CoerceText</c> da
    /// solo non basta: allinea il testo al valore quando il campo perde il fuoco, e un campo
    /// azzerato da fuori il fuoco non ce l'ha mai avuto.
    ///
    /// ⚠️ Non fa un giro infinito: <c>ClearAsync</c> rilancia il valore nullo, ma al passaggio
    /// successivo <c>_avevaValore</c> è già falso e non si rientra.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var haValore = Value is not null;

        if (_avevaValore && !haValore && _autocompleteRef is not null)
        {
            await _autocompleteRef.ClearAsync();
        }

        _avevaValore = haValore;
    }

    private bool _avevaValore;

    /// <summary>
    /// Porta il fuoco su questo campo. Serve a chi lo contiene: un dialogo che apre una
    /// scheda vuole mettere il cursore sul primo campo, e senza questo metodo l'unico
    /// modo era chiedere all'utente di cliccarci.
    /// </summary>
    public ValueTask FocusAsync()
        => _autocompleteRef is null ? ValueTask.CompletedTask : _autocompleteRef.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoFocus && _autocompleteRef != null)
        {
            await _autocompleteRef.FocusAsync();
        }
    }
}
