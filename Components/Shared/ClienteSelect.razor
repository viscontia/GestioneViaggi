@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject IClienteService ClienteService

<MudAutocomplete T="Cliente" Label="@Label" Value="@SelectedCliente" ValueChanged="@OnValueChanged"
    SearchFunc="@SearchClienti" ToStringFunc="@(x => x == null ? null : $"{x.Cognome} {x.Nome}")"
    ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" AdornmentIcon="@Icons.Material.Filled.Search"
    AdornmentColor="Color.Primary" Required="@Required" RequiredError="@RequiredError" Disabled="@Disabled"
    Class="@Class" Variant="Variant.Outlined" Margin="Margin.Dense">
    <ItemTemplate Context="cliente">
        <div class="d-flex align-center gap-3 py-1">
            <!-- Main: Name (Bold) -->
            <MudText Typo="Typo.body1" Style="font-weight: bold; min-width: 200px;">
                @cliente.Cognome @cliente.Nome
            </MudText>

            <!-- Details: DoB | Email | CF (Mixed in one line) -->
            <div class="d-flex gap-3 align-center" style="opacity: 0.8;">

                @if (cliente.DataNascita.HasValue)
                {
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@cliente.DataNascita.Value.ToString("dd/MM/yyyy")</MudText>
                    </div>
                }

                @if (!string.IsNullOrEmpty(cliente.Email))
                {
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                        <MudText Typo="Typo.body2"
                            Style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @cliente.Email
                        </MudText>
                    </div>
                }

                @if (!string.IsNullOrEmpty(cliente.CodiceFiscale))
                {
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Class="uppercase-text">@cliente.CodiceFiscale</MudText>
                    </div>
                }
            </div>
        </div>
        <MudDivider />
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter] public int AziendaId { get; set; }

    [Parameter] public Cliente? SelectedCliente { get; set; }
    [Parameter] public EventCallback<Cliente?> SelectedClienteChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Cliente";
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string? RequiredError { get; set; } = "Selezionare un cliente";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";

    private async Task<IEnumerable<Cliente>> SearchClienti(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return new List<Cliente>();
        return await ClienteService.SearchAsync(value, AziendaId);
    }

    private async Task OnValueChanged(Cliente? newValue)
    {
        SelectedCliente = newValue;
        await SelectedClienteChanged.InvokeAsync(newValue);
    }
}

<style>
    .uppercase-text {
        text-transform: uppercase;
    }
</style>
