@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject RegioneService RegioneService

<BaseEntitySelect TItem="Regione" Value="_selectedRegione" ValueChanged="OnRegioneChanged" SearchFunc="SearchRegioni"
    ToStringFunc="@(r => r?.Descrizione?.ToUpperInvariant())" Label="@Label" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" Class="@($"{Class} uppercase-input")" HelperText="@HelperText"
    AutoFocus="@AutoFocus" AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<Regione>? _regioni;
    private Regione? _selectedRegione;

    [Parameter]
    public int? SelectedRegioneId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRegioneIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Regione";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La regione è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la regione corretta dall'elenco";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRegioniAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedRegione();
    }

    private void UpdateSelectedRegione()
    {
        if (_regioni == null) return;

        if (SelectedRegioneId.HasValue)
        {
            if (_selectedRegione?.Id != SelectedRegioneId.Value)
            {
                _selectedRegione = _regioni.FirstOrDefault(r => r.Id == SelectedRegioneId.Value);
            }
        }
        else
        {
            _selectedRegione = null;
        }
    }

    private async Task LoadRegioniAsync()
    {
        try
        {
            _regioni = await RegioneService.GetAllOrderedByDescrizioneAsync();
            UpdateSelectedRegione();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento regioni: {ex.Message}");
            _regioni = new List<Regione>();
        }
    }

    private async Task OnRegioneChanged(Regione regione)
    {
        _selectedRegione = regione;
        await SelectedRegioneIdChanged.InvokeAsync(regione?.Id);
    }

    private async Task<IEnumerable<Regione>> SearchRegioni(string value, CancellationToken token)
    {
        if (_regioni == null)
            return Enumerable.Empty<Regione>();

        if (string.IsNullOrEmpty(value))
            return _regioni;

        return _regioni.Where(x => x.Descrizione.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
