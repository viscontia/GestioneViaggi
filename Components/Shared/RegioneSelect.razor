@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject RegioneService RegioneService

<MudSelect T="int?"
           @ref="_selectRef"
           Value="@SelectedRegioneId"
           ValueChanged="@SelectedRegioneIdChanged"
           Label="@Label"
           Variant="Variant.Outlined"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           Class="@ComputedClass"
           HelperText="@HelperText"
           OpenIcon="@Icons.Material.Filled.ArrowDropDown"
           CloseIcon="@Icons.Material.Filled.ArrowDropDown"
           @attributes="AdditionalAttributes">
    @if (_regioni != null)
    {
        @foreach (var regione in _regioni)
        {
            <MudSelectItem T="int?" Value="@regione.Id">@regione.Descrizione</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<Regione>? _regioni;
    private MudSelect<int?>? _selectRef;
    private bool _focusApplied;

    [Parameter]
    public int? SelectedRegioneId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRegioneIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Regione";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La regione è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la regione corretta dall'elenco";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var baseClass = string.IsNullOrWhiteSpace(Class) ? string.Empty : Class;
            return Required ? string.Join(' ', new[] { baseClass, "required-field" }.Where(x => !string.IsNullOrWhiteSpace(x))) : baseClass;
        }
    }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegioniAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusApplied && AutoFocus && _selectRef is not null)
        {
            _focusApplied = true;
            await _selectRef.FocusAsync();
        }
    }

    private async Task LoadRegioniAsync()
    {
        try
        {
            _regioni = await RegioneService.GetAllOrderedByDescrizioneAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento regioni: {ex.Message}");
            _regioni = new List<Regione>();
        }
    }
}
