@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject IClienteService ClienteService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center align-center py-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <!-- Header Sticky & Stats -->
            <MudPaper Elevation="1" Class="sticky-header pa-4 mb-4"
                Style="background-color: var(--mud-palette-background);">
                <!-- Header Content Grid -->
                <MudGrid>
                    <!-- Left: Profile Info -->
                    <MudItem xs="7">
                        <div class="d-flex gap-4 align-center mb-4">
                            @if (Cliente.Foto != null && Cliente.Foto.Length > 0)
                            {
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                                    <MudImage Src="@($"data:{Cliente.FotoMimeType};base64,{Convert.ToBase64String(Cliente.Foto)}")" ObjectFit="ObjectFit.Cover" Style="width:100%; height:100%;" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                                    @GetInitials()
                                </MudAvatar>
                            }
                            
                            <div>
                                <MudText Typo="Typo.h6" Class="mb-0">@Cliente.Cognome @Cliente.Nome</MudText>
                                <MudText Typo="Typo.body2">
                                    @GetAge() anni | @Cliente.Email | @Cliente.Telefono | @(Cliente.CodiceFiscale ?? "-") | @(Cliente.ComuneResidenza?.Nome ?? "-") (@(Cliente.ComuneResidenza?.ProvinciaDescrizione ?? "-"))
                                </MudText>
                            </div>
                        </div>

                         <!-- Chips Filter -->
                        <MudChipSet T="string" SelectedValue="@_selectedFilter" SelectedValueChanged="OnFilterChanged">
                            <MudChip Text="fatti" Value="@("fatti")" Color="Color.Success" Variant="Variant.Filled">
                                @_stats.Fatti FATTI
                            </MudChip>
                            <MudChip Text="da_fare" Value="@("da_fare")" Color="Color.Warning" Variant="Variant.Filled">
                                @_stats.DaFare DA FARE
                            </MudChip>
                            <MudChip Text="non_partecipati" Value="@("non_partecipati")" Color="Color.Error"
                                Variant="Variant.Filled">
                                @_stats.NonPartecipati NON PARTECIPATI
                            </MudChip>
                            <MudChip Text="tutti" Value="@("tutti")" Color="Color.Default" Variant="Variant.Outlined">
                                MOSTRA TUTTI
                            </MudChip>
                        </MudChipSet>
                    </MudItem>

                        <!-- Right: Trend Chart (Custom SVG) & Year Filter -->
                    <MudItem xs="5" Class="d-flex flex-row align-center justify-end gap-4">
                         <!-- Year Filter -->
                         <MudSelect T="int?" Value="_selectedYear" ValueChanged="OnYearChanged" Variant="Variant.Outlined" 
                                    Margin="Margin.Dense" Dense="true" Style="min-width: 140px; background-color: white;" Label="Anno">
                                <MudSelectItem T="int?" Value="null">Tutti</MudSelectItem>
                                @foreach (var y in _years)
                                {
                                    <MudSelectItem T="int?" Value="y">@y</MudSelectItem>
                                }
                         </MudSelect>

                         @if (_chartPoints.Any())
                         {
                             <div class="d-flex flex-column align-center">
                                 <MudText Typo="Typo.caption" Class="mb-1" Style="font-weight:bold; color: var(--mud-palette-text-secondary);">VIAGGI FATTI PER ANNO</MudText>
                                 <div style="width: 320px; height: 160px; position: relative;">
                                    <svg width="100%" height="100%" viewBox="0 0 320 160">
                                    <!-- Background Grid (Horizontal) -->
                                    @for (int i = 0; i <= 5; i++)
                                    {
                                        var y = 140 - (i * 25); // 5 steps
                                        <line x1="30" y1="@y" x2="310" y2="@y" stroke="#e0e0e0" stroke-width="1" />
                                    }

                                    <!-- Background Grid (Vertical) -->
                                    @foreach (var p in _chartPoints)
                                    {
                                        <line x1="@p.X" y1="15" x2="@p.X" y2="140" stroke="#e0e0e0" stroke-width="1" />
                                    }

                                    <!-- Data Line -->
                                    <polyline points="@_svgPoints" fill="none" stroke="#594AE2" stroke-width="3" />

                                    <!-- Points & Labels -->
                                    @foreach (var p in _chartPoints)
                                    {
                                        <!-- Point -->
                                        <circle cx="@p.X" cy="@p.Y" r="4" fill="#594AE2" />
                                        <!-- Value Label -->
                                        @((MarkupString)$"<text x=\"{p.X}\" y=\"{p.Y - 10}\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"bold\" fill=\"#333\">{p.Value}</text>")
                                        <!-- Year Label -->
                                        @((MarkupString)$"<text x=\"{p.X}\" y=\"155\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"bold\" fill=\"#666\">{p.Label}</text>")
                                    }
                                </svg>
                             </div>
                             </div>
                         }
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Body List -->
            <div class="d-flex flex-column gap-3" style="max-height: 60vh; overflow-y: auto;">
            @if (_filteredTravels.Any())
                {
                    @foreach (var viaggio in _filteredTravels)
                    {
                        <MudCard Elevation="1" Class="pa-0"
                            Style="@($"border-left: 6px solid {GetStatusColor(viaggio.StatusCode)};")">
                            <MudCardContent Class="py-2 px-3">
                                <!-- Row 1: Header -->
                                <div class="d-flex justify-space-between align-center mb-1">
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold">
                                         @viaggio.Tipo - @viaggio.Titolo - Dal @viaggio.DataInizio.ToString("dd/MM/yyyy") Al @viaggio.DataFine.ToString("dd/MM/yyyy")
                                    </MudText>
                                </div>

                                <!-- Row 2: Details & Icons -->
                                <div class="d-flex flex-wrap gap-4 align-center">
                                    <!-- Status Badge for clarity -->
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                        Color="@GetStatusColor(viaggio.StatusCode)" Class="ma-0">
                                        @viaggio.StatusDesc.ToUpper()
                                    </MudChip>

                                    <!-- Ruolo -->
                                    <div class="d-flex gap-1 align-center" title="Ruolo">
                                        <MudIcon Icon="@Icons.Material.Filled.DriveEta" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2">@viaggio.Ruolo</MudText>
                                    </div>

                                    <!-- KM -->
                                    <div class="d-flex gap-1 align-center" title="Chilometri">
                                        <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2">@viaggio.Km km</MudText>
                                    </div>

                                    <!-- Giorni -->
                                    <div class="d-flex gap-1 align-center" title="Durata">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                                            Color="Color.Default" />
                                        <MudText Typo="Typo.body2">@viaggio.Giorni gg</MudText>
                                    </div>

                                    <!-- Extra Info: Trattamento, Pernottamento, Costi -->
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        | Tratt.: @ToTitleCase(viaggio.Trattamento) 
                                        | Tipo: Pernott.: @ToTitleCase(viaggio.Pernottamento) 
                                        | Costo Pilota: @FormatCost(viaggio.CostoPilota) 
                                        | Costo Pass.: @FormatCost(viaggio.CostoPasseggero)
                                    </MudText>
                                </div>

                                <!-- Row 3: Passengers (Lazy Load / Expand) -->
                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small"
                                        StartIcon="@Icons.Material.Filled.People" OnClick="@(() => TogglePassengers(viaggio))">
                                        @(viaggio.CompagniViaggio == "" ? "Vedi Passeggeri" : "Nascondi Passeggeri")
                                    </MudButton>

                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                        StartIcon="@Icons.Material.Filled.Group" OnClick="@(() => ToggleParticipants(viaggio))">
                                        @(viaggio.PartecipantiTotali == "" ? "Vedi tutti i Partecipanti" : "Nascondi tutti i Partecipanti")
                                    </MudButton>
                                </div>

                                @if (!string.IsNullOrEmpty(viaggio.CompagniViaggio))
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mt-1 py-1" NoIcon="true">
                                        <MudText Typo="Typo.caption"><b>Con:</b> @viaggio.CompagniViaggio</MudText>
                                    </MudAlert>
                                }

                                @if (!string.IsNullOrEmpty(viaggio.PartecipantiTotali))
                                {
                                    <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Class="mt-1 py-1" NoIcon="true">
                                        <MudText Typo="Typo.caption"><b>Partecipanti:</b> @viaggio.PartecipantiTotali</MudText>
                                    </MudAlert>
                                }

                            </MudCardContent>
                        </MudCard>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info">Nessun viaggio trovato con i filtri selezionati.</MudAlert>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Cliente Cliente { get; set; } = default!;

    private bool _isLoading = true;
    private List<ClienteTravelHistory> _allTravels = new();
    private List<ClienteTravelHistory> _filteredTravels = new();
    private string _selectedFilter = "tutti";
    
    // Year Filter
    private int? _selectedYear = null;
    private List<int> _years = new();

    // Stats Counters
    private (int Fatti, int DaFare, int NonPartecipati) _stats;
    
    // Custom Chart Data
    private class ChartPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
        public int Value { get; set; }
        public string Label { get; set; } = string.Empty;
    }
    private List<ChartPoint> _chartPoints = new();
    private string _svgPoints = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            // Reload full client details using the new function
            var freshCliente = await ClienteService.GetDetailAsync(Cliente.ClienteId);
            if (freshCliente != null)
            {
                Cliente = freshCliente;
            }

            _allTravels = (await ClienteService.GetTravelHistoryAsync(Cliente.ClienteId, Cliente.AziendaFk)).ToList();
            
            // Load Years
            _years = await ClienteService.GetTravelYearsAsync(Cliente.ClienteId);



            // Default Sort (Giallo pinned top, then Date DESC)
            _allTravels = _allTravels
            .OrderByDescending(t => t.StatusCode == 0) // True (1) comes before False (0) -> Giallo top
            .ThenByDescending(t => t.DataInizio)
            .ToList();
            
            // Prepare SVG Chart Data
            CalculateSvgChart();

            ApplyFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento viaggi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private void CalculateSvgChart()
    {
        var doneTravels = _allTravels.Where(t => t.StatusCode == 1).ToList();
        
        if (!doneTravels.Any()) 
        {
            _chartPoints.Clear();
            return;
        };

        var grouped = doneTravels
             .GroupBy(t => t.DataInizio.Year)
             .OrderBy(g => g.Key)
             .ToDictionary(g => g.Key, g => g.Count());

        if (!grouped.Any()) return;

        // Configuration
        double width = 320;
        double height = 160;
        double marginX = 40;
        double marginY = 30; // space for text
        double availableWidth = width - (marginX * 2);
        double availableHeight = height - (marginY * 2);

        int maxVal = grouped.Values.Max();
        // Ensure maxVal is at least something to avoid division by zero
        if (maxVal < 5) maxVal = 5; // Min ceiling
        
        int count = grouped.Count;
        double stepX = count > 1 ? availableWidth / (count - 1) : availableWidth / 2;

        _chartPoints.Clear();
        int i = 0;
        foreach(var item in grouped)
        {
            double x = marginX + (i * stepX);
            // Y is inverted (0 at top). Value 0 should be at bottom (height - marginY)
            // Value maxVal should be at top (marginY)
            double normalizedVal = (double)item.Value / maxVal;
            double y = (height - marginY) - (normalizedVal * availableHeight);
            
            _chartPoints.Add(new ChartPoint 
            { 
                 X = x, 
                 Y = y, 
                 Value = item.Value, 
                 Label = item.Key.ToString() 
            });
            i++;
        }
        
        if (count == 1)
        {
             // Center single point
             _chartPoints[0].X = width / 2;
        }

        _svgPoints = string.Join(" ", _chartPoints.Select(p => $"{p.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{p.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
    }

    private void OnFilterChanged(string selectedChip)
    {
        _selectedFilter = selectedChip;
        ApplyFilter();
    }
    
    private void OnYearChanged(int? year)
    {
        _selectedYear = year;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        // 1. Base Filter: Year
        var baseSet = _allTravels.AsEnumerable();
        
        if (_selectedYear.HasValue)
        {
            baseSet = baseSet.Where(t => t.DataInizio.Year == _selectedYear.Value);
        }
        
        var yearFiltered = baseSet.ToList();

        // 2. Update Stats based on Year Selection
        _stats.Fatti = yearFiltered.Count(t => t.StatusCode == 1);
        _stats.DaFare = yearFiltered.Count(t => t.StatusCode == 0);
        _stats.NonPartecipati = yearFiltered.Count(t => t.StatusCode == 2);

        // 3. Final Filter: Chip Status
        _filteredTravels = _selectedFilter switch
        {
            "fatti" => yearFiltered.Where(t => t.StatusCode == 1).ToList(),
            "da_fare" => yearFiltered.Where(t => t.StatusCode == 0).ToList(),
            "non_partecipati" => yearFiltered.Where(t => t.StatusCode == 2).ToList(),
            _ => yearFiltered
        };
    }

    private async Task TogglePassengers(ClienteTravelHistory viaggio)
    {
        if (string.IsNullOrEmpty(viaggio.CompagniViaggio))
        {
            // Load if not present
            // Hack: storing in 'CompagniViaggio' property for UI simplicity.
            // Ideally should be a boolean '_passengersLoaded' but this avoids extra state map.
            try
            {
                var passengers = await ClienteService.GetTravelPassengersAsync(viaggio.DataViaggioId, Cliente.ClienteId);
                if (passengers.Any())
                {
                    viaggio.CompagniViaggio = string.Join(", ", passengers.Select(p => $"{p.Nominativo}"));
                }
                else
                {
                    viaggio.CompagniViaggio = "Nessun altro passeggero registrato.";
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore caricamento passeggeri: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            // Toggle off (clear) to allow "Hide" logic or simply keep it loaded?
            // User requirement: "Menu a tendina per vedere".
            // To implement "Hide", we need a separate state. For now, let's keep it simple:
            // If loaded, button becomes "Chiudi" and we clear the string?
            // Better: use a boolean in a local wrapper class if needed, but let's try clearing for toggle effect.
            viaggio.CompagniViaggio = "";
        }
    }

    private async Task ToggleParticipants(ClienteTravelHistory viaggio)
    {
        if (string.IsNullOrEmpty(viaggio.PartecipantiTotali))
        {
            try
            {
                var participants = await ClienteService.GetAllParticipantsTravelAsync(viaggio.DataViaggioId);
                if (participants.Any())
                {
                    viaggio.PartecipantiTotali = string.Join(", ", participants);
                }
                else
                {
                    viaggio.PartecipantiTotali = "Nessun partecipante trovato.";
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore caricamento partecipanti: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            viaggio.PartecipantiTotali = "";
        }
    }

    private Color GetStatusColor(int statusCode) => statusCode switch
    {
        1 => Color.Success, // Fatto
        2 => Color.Error, // Non Partecipato
        0 => Color.Warning, // Futuro
        _ => Color.Default
    };

    private string GetInitials() =>
    $"{(Cliente.Nome?.FirstOrDefault())}{(Cliente.Cognome?.FirstOrDefault())}";

    private string GetAge()
    {
        if (!Cliente.DataNascita.HasValue) return "-";
        var age = DateTime.Today.Year - Cliente.DataNascita.Value.Year;
        if (Cliente.DataNascita.Value.Date > DateTime.Today.AddYears(-age)) age--;
        return age.ToString();
    }

    private string ToTitleCase(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input;
        input = input.ToLower();
        return char.ToUpper(input[0]) + input.Substring(1);
    }
    
    private string FormatCost(int cost)
    {
        return cost.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("it-IT")) + " €";
    }

    void Cancel() => MudDialog.Cancel();
}

<style>
    .sticky-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(5px);
        background-color: rgba(255, 255, 255, 0.95);
        /* Adjust for dark mode if needed */
    }

    /* Increase Chart Axis Font Size */
    .mud-charts-xaxis-label, .mud-charts-yaxis-label {
        font-size: 14px !important;
        font-weight: 600 !important;
        fill: var(--mud-palette-text-primary) !important;
    }
</style>
