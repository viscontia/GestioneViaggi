@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@using GestioneViaggi.Validation.Syntax
@using GestioneViaggi.Validation.Semantic
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Components.Shared.AziendaTabs
@inject IJSRuntime JS
@inject AziendaSedeService SedeService
@inject AziendaContattoService ContattoService
@inject AziendaBancaService BancaService
@inject AziendaEmailService EmailService
@inject RepartoAziendaleService RepartoService
@inject AziendaSmtpService SmtpService
@inject AziendaLogoService LogoService
@inject AziendaService AziendaService
@inject AnaRegimiFiscaliService RegimiFiscaliService
@inject GestioneViaggi.Services.Web.WebSitoContenutiService SitoService
@inject ISnackbar Snackbar
@inject GestioneViaggi.Services.Session.ISessionManager SessionManager
@inject GestioneViaggi.Services.Web.WebTraduzioniService TraduzioniService
@inject IDialogService DialogService
@inject GestioneViaggi.Services.Web.WebTraduzioneOrchestratorService Orchestrator
@implements IDisposable
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? $"Modifica Azienda: {Entity.RagioneSociale}" : "Nuova Azienda")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_traducendo)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Traduzione dei testi del sito in corso: @_avanzamentoTraduzione
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1" />
            </MudAlert>
        }
        <div style="height: 600px; overflow-y: auto;">
        @if (!IsEditMode)
        {
            <!-- CREAZIONE: Solo form dati generali -->
            <MudForm @ref="_form" Model="@Entity">

            <!-- Ragione Sociale - OBBLIGATORIO -->
            <MudTextField @ref="_firstField" Value="@Entity.RagioneSociale"
                ValueChanged="@((string val) => HandleRagioneSocialeChanged(val))" For="@(() => Entity.RagioneSociale)"
                Label="Ragione Sociale" Variant="Variant.Outlined" Immediate="true" Required="true"
                RequiredError="La ragione sociale è obbligatoria" MaxLength="255" Class="mb-3 uppercase-input"
                Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                HelperText="Inserire la denominazione completa dell'azienda" OnKeyDown="@HandleKeyDown" />

            <!-- Forma Giuridica - OBBLIGATORIO -->
            <FormaGiuridicaSelect @bind-SelectedFormaGiuridica="Entity.FormaGiuridica" Label="Forma Giuridica"
                Required="true" RequiredError="La forma giuridica è obbligatoria" Class="mb-3" />

            <!-- Partita IVA - OBBLIGATORIO -->
            <MudTextField @bind-Value="Entity.PartitaIva" For="@(() => Entity.PartitaIva)" Label="Partita IVA"
                Validation="@(new Func<string, IEnumerable<string>>(ValidatePartitaIva))" Variant="Variant.Outlined"
                Required="true" RequiredError="La Partita IVA è obbligatoria" Mask="@(new PatternMask("00000000000"))"
                MaxLength="11" Class="mb-3" Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                HelperText="Inserire 11 cifre numeriche" Immediate="true" />

            <!-- Codice Fiscale - Opzionale -->
            <MudTextField Value="@Entity.CodiceFiscale"
                ValueChanged="@((string val) => HandleCodiceFiscaleChanged(val))" For="@(() => Entity.CodiceFiscale)"
                Label="Codice Fiscale (opzionale)"
                Validation="@(new Func<string, IEnumerable<string>>(ValidateCodiceFiscale))" Variant="Variant.Outlined"
                MaxLength="16" Class="mb-3 uppercase-input"
                HelperText="Alfanumerico maiuscolo, 11-16 caratteri (es: 12345678901 o RSSMRA80A01H501X)"
                Immediate="true" />

            <!-- Telefono Principale - OBBLIGATORIO -->
            <MudTextField @bind-Value="Entity.TelefonoPrincipale" For="@(() => Entity.TelefonoPrincipale)"
                Label="Telefono Principale" Validation="@(new Func<string, IEnumerable<string>>(ValidateTelefono))"
                Variant="Variant.Outlined" Required="true" RequiredError="Il telefono principale è obbligatorio"
                MaxLength="30" Class="mb-3" Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                HelperText="Es: +39 0123456789 oppure 0123456789" Immediate="true" />

            <!-- PEC - Opzionale -->
            <MudTextField @bind-Value="Entity.Pec" For="@(() => Entity.Pec)" Label="PEC (opzionale)"
                Validation="@(new Func<string, IEnumerable<string>>(ValidatePec))" Variant="Variant.Outlined"
                MaxLength="255" Class="mb-3" HelperText="Email certificata" Immediate="true" />

            <!-- Codice Destinatario SDI - Con default 0000000 -->
            <MudTextField Value="@Entity.CodiceDestinatarioSdi"
                ValueChanged="@((string val) => HandleCodiceSdiChanged(val))"
                For="@(() => Entity.CodiceDestinatarioSdi)" Label="Codice Destinatario SDI"
                Validation="@(new Func<string, IEnumerable<string>>(ValidateCodiceSdi))" Variant="Variant.Outlined"
                MaxLength="7" Class="mb-3 uppercase-input"
                HelperText="7 caratteri alfanumerici maiuscoli per fatturazione elettronica (default: 0000000)"
                Immediate="true" />

            <!-- Sito Web - Opzionale -->
            <MudTextField @bind-Value="Entity.SitoWeb" For="@(() => Entity.SitoWeb)" Label="Sito Web (opzionale)"
                Validation="@(new Func<string, IEnumerable<string>>(ValidateSitoWeb))"
                Variant="Variant.Outlined" MaxLength="255" Class="mb-3"
                HelperText="URL completo (es: https://www.esempio.it)" Immediate="true" />

            <!-- Sito Web Iscrizione - Opzionale -->
            <MudTextField @bind-Value="Entity.SitoWebIscrizione" For="@(() => Entity.SitoWebIscrizione)"
                Label="Sito Web Iscrizione (opzionale)"
                Validation="@(new Func<string, IEnumerable<string>>(ValidateSitoWebIscrizione))"
                Variant="Variant.Outlined" MaxLength="255" Class="mb-3"
                HelperText="URL del programma di iscrizione clienti dal web" Immediate="true" />

            <MudDivider Class="my-4" />

            <!-- Data Costituzione - Opzionale -->
            <MudDatePicker @bind-Date="Entity.DataCostituzione" For="@(() => Entity.DataCostituzione)"
                Label="Data Costituzione (opzionale)" Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Class="mb-3"
                Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateDataCostituzione))"
                DateFormat="dd/MM/yyyy" Editable="true" TextUpdateSuppression="false" Converter="@_conv1" Placeholder="gg/mm/aaaa"
                HelperText="Digitare la data (es: 15031990) o selezionare dal calendario" />

            <!-- Data Inizio Attività - Opzionale -->
            <MudDatePicker @bind-Date="Entity.DataInizioAttivita" For="@(() => Entity.DataInizioAttivita)"
                Label="Data Inizio Attività (opzionale)"
                Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateDataInizioAttivita))"
                Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Class="mb-3"
                DateFormat="dd/MM/yyyy" Editable="true" TextUpdateSuppression="false" Converter="@_conv2" Placeholder="gg/mm/aaaa"
                HelperText="Digitare la data (es: 15031990) o selezionare dal calendario (deve essere >= Costituzione)" />

            <!-- Capitale Sociale - Opzionale -->
            <MudNumericField @bind-Value="Entity.CapitaleSociale" For="@(() => Entity.CapitaleSociale)"
                Label="Capitale Sociale (opzionale)"
                Validation="@(new Func<decimal?, IEnumerable<string>>(ValidateCapitaleSociale))"
                Variant="Variant.Outlined" Format="N2" Class="mb-3" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Euro" HelperText="Importo in Euro" Immediate="true" />

            <MudDivider Class="my-4" />

            <!-- Provincia REA - Opzionale -->
            <ProvinciaSelect @bind-SelectedProvinciaId="Entity.ReaProvinciaFk" Label="Provincia REA (opzionale)"
                Validation="@(new Func<int?, IEnumerable<string>>(ValidateReaProvincia))" Class="mb-3" />

            <!-- Numero REA - Opzionale -->
            <MudTextField @bind-Value="Entity.ReaNumero" For="@(() => Entity.ReaNumero)" Label="Numero REA (opzionale)"
                Validation="@(new Func<string, IEnumerable<string>>(ValidateReaNumero))" Variant="Variant.Outlined"
                MaxLength="20" Class="mb-3" HelperText="Identificativo REA dell'azienda" Immediate="true" />

            <!-- Data Iscrizione REA - Opzionale -->
            <MudDatePicker @bind-Date="Entity.ReaDataIscrizione" For="@(() => Entity.ReaDataIscrizione)"
                Label="Data Iscrizione REA (opzionale)"
                Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateReaData))" Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima"
                Class="mb-3" DateFormat="dd/MM/yyyy" Editable="true" TextUpdateSuppression="false" Converter="@_conv3" Placeholder="gg/mm/aaaa"
                HelperText="Digitare la data (es: 15031990) o selezionare dal calendario" />

            <MudDivider Class="my-4" />

            <!-- Socio Unico - Checkbox -->
            <MudCheckBox @bind-Value="Entity.SocioUnico" For="@(() => Entity.SocioUnico)" Label="Socio Unico"
                Color="Color.Primary" Class="mb-3" />

            <!-- In Liquidazione - Checkbox -->
            <MudCheckBox @bind-Value="Entity.InLiquidazione" For="@(() => Entity.InLiquidazione)"
                Label="In Liquidazione" Color="Color.Warning" Class="mb-3" />

            <!-- Attivo - Checkbox -->
            <MudCheckBox @bind-Value="Entity.Attivo" For="@(() => Entity.Attivo)" Label="Attivo" Color="Color.Success"
                Class="mb-3" />

            <MudDivider Class="my-4" />

            <!-- Regime Fiscale - OBBLIGATORIO -->
            <MudSelect T="int" Label="Regime Fiscale *" @bind-Value="Entity.RegimeFiscaleFk"
                Variant="Variant.Outlined" Required="true"
                RequiredError="Il regime fiscale è obbligatorio"
                HelperText="Determina il comportamento della UI e dei calcoli IVA"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Gavel"
                Class="mb-3">
                @foreach (var regime in _regimi)
                {
                    <MudSelectItem Value="@regime.RegimeId">@regime.DisplayText</MudSelectItem>
                }
            </MudSelect>

        </MudForm>
        }
        else
        {
            <!-- MODIFICA: Form con TAB per detail. KeepPanelsAlive rimosso intenzionalmente:
                 ogni tab carica i dati solo al click, evitando connessioni simultanee a PgBouncer -->
            <MudTabs Elevation="0" Rounded="true" PanelClass="pa-4" Color="Color.Primary" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Dati Generali" Icon="@Icons.Material.Filled.Business">
                    <MudForm @ref="_form" Model="@Entity">
                        <!-- Ragione Sociale - OBBLIGATORIO -->
                        <MudTextField @ref="_firstField" Value="@Entity.RagioneSociale"
                            ValueChanged="@((string val) => HandleRagioneSocialeChanged(val))" For="@(() => Entity.RagioneSociale)"
                            Label="Ragione Sociale" Variant="Variant.Outlined" Immediate="true" Required="true"
                            RequiredError="La ragione sociale è obbligatoria" MaxLength="255" Class="mb-3 uppercase-input"
                            Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                            HelperText="Inserire la denominazione completa dell'azienda" OnKeyDown="@HandleKeyDown" />

                        <!-- Forma Giuridica -->
                        <FormaGiuridicaSelect @bind-SelectedFormaGiuridica="Entity.FormaGiuridica" Label="Forma Giuridica"
                            Required="true" RequiredError="La forma giuridica è obbligatoria" Class="mb-3" />

                        <!-- Partita IVA -->
                        <MudTextField @bind-Value="Entity.PartitaIva" For="@(() => Entity.PartitaIva)" Label="Partita IVA"
                            Validation="@(new Func<string, IEnumerable<string>>(ValidatePartitaIva))" Variant="Variant.Outlined"
                            Required="true" RequiredError="La Partita IVA è obbligatoria" Mask="@(new PatternMask("00000000000"))"
                            MaxLength="11" Class="mb-3" Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                            HelperText="Inserire 11 cifre numeriche" Immediate="true" />

                        <!-- Codice Fiscale -->
                        <MudTextField Value="@Entity.CodiceFiscale"
                            ValueChanged="@((string val) => HandleCodiceFiscaleChanged(val))" For="@(() => Entity.CodiceFiscale)"
                            Label="Codice Fiscale (opzionale)"
                            Validation="@(new Func<string, IEnumerable<string>>(ValidateCodiceFiscale))" Variant="Variant.Outlined"
                            MaxLength="16" Class="mb-3 uppercase-input"
                            HelperText="Alfanumerico maiuscolo, 11-16 caratteri (es: 12345678901 o RSSMRA80A01H501X)"
                            Immediate="true" />

                        <!-- Telefono -->
                        <MudTextField @bind-Value="Entity.TelefonoPrincipale" For="@(() => Entity.TelefonoPrincipale)"
                            Label="Telefono Principale" Validation="@(new Func<string, IEnumerable<string>>(ValidateTelefono))"
                            Variant="Variant.Outlined" Required="true" RequiredError="Il telefono principale è obbligatorio"
                            MaxLength="30" Class="mb-3" Adornment="Adornment.End" AdornmentText="*" AdornmentColor="Color.Error"
                            HelperText="Es: +39 0123456789 oppure 0123456789" Immediate="true" />

                        <!-- PEC -->
                        <MudTextField @bind-Value="Entity.Pec" For="@(() => Entity.Pec)" Label="PEC (opzionale)"
                            Validation="@(new Func<string, IEnumerable<string>>(ValidatePec))" Variant="Variant.Outlined"
                            MaxLength="255" Class="mb-3" HelperText="Email certificata" Immediate="true" />

                        <!-- SDI -->
                        <MudTextField Value="@Entity.CodiceDestinatarioSdi"
                            ValueChanged="@((string val) => HandleCodiceSdiChanged(val))"
                            For="@(() => Entity.CodiceDestinatarioSdi)" Label="Codice Destinatario SDI"
                            Validation="@(new Func<string, IEnumerable<string>>(ValidateCodiceSdi))" Variant="Variant.Outlined"
                            MaxLength="7" Class="mb-3 uppercase-input"
                            HelperText="7 caratteri alfanumerici maiuscoli per fatturazione elettronica (default: 0000000)"
                            Immediate="true" />

                        <!-- Sito Web -->
                        <MudTextField @bind-Value="Entity.SitoWeb" For="@(() => Entity.SitoWeb)" Label="Sito Web (opzionale)"
                            Validation="@(new Func<string, IEnumerable<string>>(ValidateSitoWeb))"
                            Variant="Variant.Outlined" MaxLength="255" Class="mb-3"
                            HelperText="URL completo (es: https://www.esempio.it)" Immediate="true" />

                        <MudDivider Class="my-4" />

                        <!-- Data Costituzione -->
                        <MudDatePicker @bind-Date="Entity.DataCostituzione" For="@(() => Entity.DataCostituzione)"
                            Label="Data Costituzione (opzionale)" Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Class="mb-3"
                Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateDataCostituzione))"
                            DateFormat="dd/MM/yyyy" Editable="true" TextUpdateSuppression="false" Converter="@_conv4" Placeholder="gg/mm/aaaa"
                            HelperText="Digitare la data (es: 15031990) o selezionare dal calendario" />

                        <!-- Data Inizio Attività -->
                        <MudDatePicker @bind-Date="Entity.DataInizioAttivita" For="@(() => Entity.DataInizioAttivita)"
                            Label="Data Inizio Attività (opzionale)"
                            Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateDataInizioAttivita))"
                            Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Class="mb-3"
                            DateFormat="dd/MM/yyyy" Editable="true" TextUpdateSuppression="false" Converter="@_conv5" Placeholder="gg/mm/aaaa"
                            HelperText="Digitare la data (es: 15031990) o selezionare dal calendario (deve essere >= Costituzione)" />

                        <!-- Capitale Sociale -->
                        <MudNumericField @bind-Value="Entity.CapitaleSociale" For="@(() => Entity.CapitaleSociale)"
                            Label="Capitale Sociale (opzionale)"
                            Validation="@(new Func<decimal?, IEnumerable<string>>(ValidateCapitaleSociale))"
                            Variant="Variant.Outlined" Format="N2" Class="mb-3" Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Euro" HelperText="Importo in Euro" Immediate="true" />

                        <MudDivider Class="my-4" />

                        <!-- REA -->
                        <ProvinciaSelect @bind-SelectedProvinciaId="Entity.ReaProvinciaFk"
                            Label="Provincia REA (opzionale)" Class="mb-3" />
                        <MudTextField @bind-Value="Entity.ReaNumero" For="@(() => Entity.ReaNumero)"
                            Label="Numero REA (opzionale)" Variant="Variant.Outlined" MaxLength="20" Class="mb-3"
                            HelperText="Se specificato, indicare anche la provincia REA" />
                        <MudDatePicker @bind-Date="Entity.ReaDataIscrizione" For="@(() => Entity.ReaDataIscrizione)"
                            Label="Data Iscrizione REA (opzionale)"
                            Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateReaData))"
                            Variant="Variant.Outlined" MinDate="@DateValidator.DataMinimaStorica" MaxDate="@DateValidator.DataMassima" Class="mb-3"
                            DateFormat="dd/MM/yyyy" Editable="true" TextUpdateSuppression="false" Converter="@_conv6" Placeholder="gg/mm/aaaa"
                            HelperText="Digitare la data (es: 15031990) o selezionare dal calendario" />

                        <MudDivider Class="my-4" />

                        <!-- Flags -->
                        <MudCheckBox @bind-Value="Entity.SocioUnico" For="@(() => Entity.SocioUnico)" Label="Socio Unico"
                            Color="Color.Primary" Class="mb-3" />
                        <MudCheckBox @bind-Value="Entity.InLiquidazione" For="@(() => Entity.InLiquidazione)"
                            Label="In Liquidazione" Color="Color.Warning" Class="mb-3" />
                        <MudCheckBox @bind-Value="Entity.Attivo" For="@(() => Entity.Attivo)" Label="Attivo"
                            Color="Color.Success" Class="mb-3" />

                        <MudDivider Class="my-4" />

                        <!-- Regime Fiscale - OBBLIGATORIO -->
                        <MudSelect T="int" Label="Regime Fiscale *" @bind-Value="Entity.RegimeFiscaleFk"
                            Variant="Variant.Outlined" Required="true"
                            RequiredError="Il regime fiscale è obbligatorio"
                            HelperText="Determina il comportamento della UI e dei calcoli IVA"
                            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Gavel"
                            Class="mb-3">
                            @foreach (var regime in _regimi)
                            {
                                <MudSelectItem Value="@regime.RegimeId">@regime.DisplayText</MudSelectItem>
                            }
                        </MudSelect>

                        <MudDivider Class="my-4" />

                        @* L26 (script 692): li mostra il piede del sito pubblico, accanto ai dati societari.
                           Si salvano con «Aggiorna», con una funzione a parte (fn_ana_aziende_garanzie_save). *@
                        <MudText Typo="Typo.subtitle1" Class="mb-1">Garanzie del tour operator</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            Polizza di responsabilità civile e fondo di garanzia (Direttiva UE sui pacchetti turistici):
                            compaiono nel piede del sito. Vuoti = non si mostrano.
                        </MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="7">
                                <MudTextField @bind-Value="_garanzie.PolizzaRcCompagnia" Label="Polizza RC — compagnia"
                                    Variant="Variant.Outlined" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="_garanzie.PolizzaRcNumero" Label="Polizza RC — numero"
                                    Variant="Variant.Outlined" MaxLength="80" />
                            </MudItem>
                            <MudItem xs="12" sm="7">
                                <MudTextField @bind-Value="_garanzie.FondoGaranziaEnte" Label="Fondo di garanzia — ente"
                                    Variant="Variant.Outlined" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="_garanzie.FondoGaranziaEstremi" Label="Fondo di garanzia — estremi"
                                    Variant="Variant.Outlined" MaxLength="150" />
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudTabPanel>

                <MudTabPanel Text="Sedi" Icon="@Icons.Material.Filled.LocationOn" BadgeData="@_sediCount" BadgeColor="Color.Info">
                    <AziendaTabSedi AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Contatti" 
                             Icon="@Icons.Material.Filled.Contacts" 
                             BadgeData="@_contattiCount" 
                             BadgeColor="Color.Info"
                             Disabled="@(_sediCount == null || _sediCount == 0)"
                             ToolTip="@(_sediCount == null || _sediCount == 0 ? "Creare almeno una sede prima di aggiungere contatti" : "")">
                    <AziendaTabContatti AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Banche" Icon="@Icons.Material.Filled.AccountBalance" BadgeData="@_bancheCount" BadgeColor="Color.Info">
                    <AziendaTabBanche AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Email" Icon="@Icons.Material.Filled.Email" BadgeData="@_emailCount" BadgeColor="Color.Info">
                    <AziendaTabEmail AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Reparti" Icon="@Icons.Material.Filled.Groups" BadgeData="@_repartiCount" BadgeColor="Color.Info">
                    <AziendaTabReparti AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="SMTP" Icon="@Icons.Material.Filled.Email" BadgeData="@_smtpCount" BadgeColor="Color.Info">
                    <AziendaTabSmtp AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Logo" Icon="@Icons.Material.Filled.Image" BadgeData="@_logoCount" BadgeColor="Color.Info">
                    <AziendaTabLogo AziendaId="@Entity.Id" OnDataChanged="@LoadBadgeCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Traduzioni" Icon="@Icons.Material.Filled.Translate">
                    <AziendaTabTraduzioni AziendaId="@Entity.Id" />
                </MudTabPanel>

                <MudTabPanel Text="Sito web" Icon="@Icons.Material.Filled.Public">
                    <AziendaTabSitoWeb AziendaId="@Entity.Id" Stato="@_sitoWeb" OnStato="@StateHasChanged" />
                </MudTabPanel>

                <MudTabPanel Text="Funzioni Web" Icon="@Icons.Material.Filled.Language">
                    @*
                        L'indirizzo del sito di iscrizione sta qui e non piu' in «Dati
                        Generali»: e' configurazione del web, ed e' qui che uno lo cerca.
                        ⚠️ E' il dato che il bottone «Iscrizione WEB» della dashboard apre:
                        senza, quel bottone resta spento — con il suo motivo scritto nel
                        suggerimento — e per un'altra azienda basta compilarlo.
                    *@
                    <MudPaper Elevation="0" Class="pa-2 mb-2">
                        <MudText Typo="Typo.subtitle1" Class="mb-1">Sito di iscrizione ai viaggi</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            L'indirizzo che il pulsante «Iscrizione WEB» della dashboard apre nel browser.
                            Lasciandolo vuoto, il pulsante resta disabilitato.
                        </MudText>
                        <div style="max-width:680px;">
                            <MudTextField @bind-Value="Entity.SitoWebIscrizione" For="@(() => Entity.SitoWebIscrizione)"
                                Label="Indirizzo del sito di iscrizione"
                                Validation="@(new Func<string, IEnumerable<string>>(ValidateSitoWebIscrizione))"
                                Variant="Variant.Outlined" MaxLength="255"
                                HelperText="URL completo, es: https://iscrizioni.esempio.it/" Immediate="true" />
                        </div>
                    </MudPaper>

                    <MudDivider Class="my-3" />

                    <AziendaTabFunzioniWeb AziendaId="@Entity.Id" />
                </MudTabPanel>
            </MudTabs>
        }
        </div>
    </DialogContent>
    <DialogActions>
        @* Mentre foto o video si preparano «Aggiorna» aspetta (salverebbe senza); mentre «Aggiorna» invia i file,
           «Annulla» non si può premere (chiuderebbe il dialogo con l'invio ancora in corso: non annullerebbe niente). *@
        @if (_sitoWeb.InPreparazione)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-2">Preparo il video: «Aggiorna» si attiva alla fine.</MudText>
        }
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default" Disabled="@(_traducendo || _salvando)">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_traducendo || _salvando || _sitoWeb.InPreparazione)">
            @if (_salvando)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Un'istanza per campo: il convertitore tiene l'esito dell'ultima conversione,
    // e condividerla farebbe comparire l'errore di un campo sugli altri.
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv1 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv2 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv3 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv4 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv5 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv6 = new();

    private MudForm? _form;
    private MudTextField<string>? _firstField;
    private List<AnaRegimeFiscale> _regimi = new();

    // Badge counts per i TAB
    private int? _sediCount;
    private int? _contattiCount;
    private int? _bancheCount;
    private int? _emailCount;
    private int? _repartiCount;
    private int? _smtpCount;
    private int? _logoCount;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public Azienda Entity { get; set; } = new Azienda();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Carica regimi fiscali per il dropdown
        _regimi = (await RegimiFiscaliService.GetActiveAsync()).ToList();

        // Default per nuove aziende: ORDINARIO
        if (!IsEditMode && Entity.RegimeFiscaleFk == 0)
        {
            var ordinario = _regimi.FirstOrDefault(r => r.RegimeCodice == "ORDINARIO");
            if (ordinario != null)
            {
                Entity.RegimeFiscaleFk = ordinario.RegimeId;
            }
        }

        if (IsEditMode && Entity.Id > 0)
        {
            await LoadBadgeCountsAsync();
            await CaricaGaranzieAsync();
        }
    }

    // Polizza RC e fondo di garanzia (script 692): campi modificabili, letti una volta per azienda
    // (OnParametersSetAsync scatta a ogni ridisegno: rileggere butterebbe via quanto scritto).
    private sealed class GaranzieModifica
    {
        public string? PolizzaRcCompagnia { get; set; }
        public string? PolizzaRcNumero { get; set; }
        public string? FondoGaranziaEnte { get; set; }
        public string? FondoGaranziaEstremi { get; set; }
    }
    private GaranzieModifica _garanzie = new();

    // La scheda «Sito web»: la bozza vive qui, così non si perde cambiando scheda, e «Aggiorna» la salva.
    private readonly GestioneViaggi.Models.Web.SitoWebBozza _sitoWeb = new();
    private int _garanzieCaricatePer;

    /// <summary>
    /// «Aggiorna» controlla anche le traduzioni della scheda «Sito web» (Adriano, 2026-10-20): se ne
    /// mancano o sono da rifare lo dice, e si sceglie se restare a tradurre o chiudere comunque.
    /// Vero = si può chiudere. Un errore nel controllo non blocca il salvataggio (già fatto).
    /// </summary>
    private async Task<bool> TraduzioniSitoWebAPostoAsync()
    {
        try
        {
            if (!_sitoWeb.Caricata || _sitoWeb.AziendaId != Entity.Id)
                await SitoService.CaricaBozzaAsync(_sitoWeb, Entity.Id);
            var elementi = GestioneViaggi.Services.Web.WebSitoContenutiService.ElementiDaTradurre(_sitoWeb);
            var stato = await TraduzioniService.StatoAsync(Entity.Id, elementi);
            var incomplete = stato.Where(x => !x.Completa).ToList();
            if (incomplete.Count == 0) return true;

            var dettaglio = string.Join(" · ", incomplete.Select(x =>
                $"{x.Lingua} {x.Tradotti}/{x.Traducibili}{(x.Obsoleti > 0 ? $" ({x.Obsoleti} da rifare)" : "")}"));
            var scelta = await DialogService.ShowMessageBox(new MessageBoxOptions
            {
                Title = "Traduzioni del sito incomplete",
                MarkupMessage = new MarkupString(
                    $"Le traduzioni della scheda «Sito web» non sono complete: <b>{dettaglio}</b>.<br/>" +
                    "Sul sito, per quei testi, chi visita in quella lingua vedrà l'italiano.<br/><br/>" +
                    "<b>Traduci adesso</b>: traduce quello che manca e chiude (qualche secondo per testo).<br/>" +
                    "<b>Chiudi comunque</b>: chiude; si potrà tradurre in un altro momento.<br/>" +
                    "<b>Torna indietro</b>: resta aperto. Scheda «Sito web» e garanzie sono già salvate; i dati " +
                    "generali dell'anagrafica si salvano quando il dialogo si chiude con «Aggiorna»."),
                YesText = "Traduci adesso",
                NoText = "Chiudi comunque",
                CancelText = "Torna indietro"
            });
            if (scelta == false) return true;     // chiudi comunque
            if (scelta is null) return false;     // torna indietro
            return await TraduciAdessoAsync(elementi);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Stato delle traduzioni del sito non controllato: {ex.Message}", Severity.Warning);
            return true;
        }
    }

    private bool _traducendo;
    private string _avanzamentoTraduzione = "";

    /// <summary>«Traduci adesso» dal controllo di «Aggiorna»: traduce ciò che manca; vero = tutto a posto, si chiude.</summary>
    private async Task<bool> TraduciAdessoAsync(IReadOnlyList<GestioneViaggi.Services.Web.TranslatableItem> elementi)
    {
        _traducendo = true;
        _avanzamentoTraduzione = "raccolta dei testi…";
        StateHasChanged();
        try
        {
            var progress = new Progress<string>(t => { _avanzamentoTraduzione = t; _ = InvokeAsync(StateHasChanged); });
            var (ok, errori, markup, _) = await Orchestrator.TranslateAsync(
                Entity.Id, elementi, GestioneViaggi.Services.Web.WebTraduzioneOrchestratorService.Lingue, progress);
            if (errori > 0)
            {
                Snackbar.Add($"Tradotti {ok} testi, {errori} non riusciti: il dialogo resta aperto (scheda «Sito web», «Lingue»).", Severity.Warning);
                return false;
            }
            if (markup > 0)
                Snackbar.Add($"{markup} testi con formattazione da ricontrollare.", Severity.Warning);
            Snackbar.Add($"Tradotti {ok} testi.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Traduzione non riuscita: {ex.Message}. Il dialogo resta aperto.", Severity.Error);
            return false;
        }
        finally
        {
            _traducendo = false;
            StateHasChanged();
        }
    }

    private async Task CaricaGaranzieAsync()
    {
        if (_garanzieCaricatePer == Entity.Id) return;
        _garanzieCaricatePer = Entity.Id;
        try
        {
            var g = await SitoService.GetGaranzieAsync(Entity.Id);
            _garanzie = new GaranzieModifica
            {
                PolizzaRcCompagnia = g.PolizzaRcCompagnia, PolizzaRcNumero = g.PolizzaRcNumero,
                FondoGaranziaEnte = g.FondoGaranziaEnte, FondoGaranziaEstremi = g.FondoGaranziaEstremi,
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Garanzie del tour operator non lette: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation con JavaScript helper
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }

            // ⚠️ OBBLIGATORIO: Focus manuale sul primo campo (sempre eseguito)
            // Delay di 300ms per permettere rendering completo di MudBlazor
            if (_firstField != null)
            {
                await Task.Delay(300);
                try
                {
                    await _firstField.FocusAsync();
                    Console.WriteLine("Focus manuale applicato al primo campo");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Errore focus manuale: {ex.Message}");
                }
            }
        }
    }

    private void Cancel()
    {
        _sitoWeb.ScartaMedia();   // foto e video scelti e non aggiornati: via anche i file temporanei
        MudDialog?.Cancel();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private void HandleRagioneSocialeChanged(string value)
    {
        Entity.RagioneSociale = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleCodiceFiscaleChanged(string value)
    {
        Entity.CodiceFiscale = value?.ToUpper();
        StateHasChanged();
    }

    private void HandleCodiceSdiChanged(string value)
    {
        Entity.CodiceDestinatarioSdi = value?.ToUpper() ?? "0000000";
        StateHasChanged();
    }

    private bool _salvando;

    // Un salvataggio alla volta, e mai mentre foto o video si preparano (vale anche per Invio da tastiera).
    private async Task HandleSubmit()
    {
        if (_salvando || _sitoWeb.InPreparazione) return;
        _salvando = true;
        StateHasChanged();
        try { await SalvaAsync(); }
        finally { _salvando = false; StateHasChanged(); }
    }

    private async Task SalvaAsync()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                // Validazione custom IValidatableObject
                var validationResults = Entity.Validate(new System.ComponentModel.DataAnnotations.ValidationContext(Entity));
                if (!validationResults.Any())
                {
                    if (IsEditMode && Entity.Id > 0)
                    {
                        try
                        {
                            await SitoService.SaveGaranzieAsync(Entity.Id, new GestioneViaggi.Models.Web.GaranzieAzienda(
                                _garanzie.PolizzaRcCompagnia, _garanzie.PolizzaRcNumero,
                                _garanzie.FondoGaranziaEnte, _garanzie.FondoGaranziaEstremi));
                        }
                        catch (Exception ex)
                        {
                            // Il dialogo resta aperto: niente si perde, e si vede cosa non va.
                            Snackbar.Add($"Garanzie del tour operator non salvate: {ex.Message}", Severity.Error);
                            return;
                        }
                        if (_sitoWeb.Modificata)
                        {
                            try
                            {
                                var utente = (await SessionManager.GetSessionAsync())?.User?.Email ?? "gestionale";
                                await SitoService.SalvaBozzaAsync(_sitoWeb, utente);
                            }
                            catch (Exception ex)
                            {
                                Snackbar.Add($"Scheda «Sito web» non salvata: {ex.Message}", Severity.Error);
                                return;
                            }
                        }
                    }
                    if (IsEditMode && Entity.Id > 0 && !await TraduzioniSitoWebAPostoAsync())
                        return;   // resta aperto: si va a tradurre
                    MudDialog?.Close(DialogResult.Ok(Entity));
                }
                else
                {
                    // Focus sul primo campo in errore
                    if (_firstField != null)
                    {
                        await _firstField.FocusAsync();
                    }
                }
            }
            else
            {
                if (_firstField?.Error == true)
                {
                    await _firstField.FocusAsync();
                }
            }
        }
    }

    private async Task LoadBadgeCountsAsync()
    {
        try
        {
            var counts = await AziendaService.GetBadgeCountsAsync(Entity.Id);

            _sediCount = counts.Sedi;
            _contattiCount = counts.Contatti;
            _bancheCount = counts.Banche;
            _emailCount = counts.Email;
            _repartiCount = counts.Reparti;
            _smtpCount = counts.Smtp;
            _logoCount = counts.Logo;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore durante il caricamento dei badge counts ottimizzato: {ex.Message}");
        }
    }

    // Validatori inline che usano i validatori centralizzati
    private IEnumerable<string> ValidatePartitaIva(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            yield return "La Partita IVA è obbligatoria";
            yield break;
        }

        var result = ItalianFiscalValidator.CheckPartitaIva(value);
        if (!result.IsValid)
        {
            yield return result.ErrorMessage;
        }
    }

    private IEnumerable<string> ValidateCodiceFiscale(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            var result = ItalianFiscalValidator.CheckCodiceFiscale(value);
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    private IEnumerable<string> ValidateTelefono(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            yield return "Il telefono principale è obbligatorio";
            yield break;
        }

        var result = PhoneValidator.CheckTelefonoItaly(value);
        if (!result.IsValid)
        {
            yield return result.ErrorMessage;
        }
    }

    private IEnumerable<string> ValidatePec(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            var result = EmailValidatorPEC.CheckPec(value);
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    private IEnumerable<string> ValidateCodiceSdi(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            yield return "Il Codice SDI è obbligatorio";
            yield break;
        }

        var result = CodeValidator.CheckCodiceSdi(value);
        if (!result.IsValid)
        {
            yield return result.ErrorMessage;
        }
    }

    private IEnumerable<string> ValidateCapitaleSociale(decimal? value)
    {
        if (value.HasValue)
        {
            var result = NumericValidator.CheckCapitaleSociale(value);
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    private IEnumerable<string> ValidateSitoWeb(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            var result = WebsiteValidator.CheckWebsite(value);
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    private IEnumerable<string> ValidateSitoWebIscrizione(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            var result = WebsiteValidator.CheckWebsite(value);
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    /// <summary>
    /// Data di costituzione: prima non era validata affatto. Gli altri due campi avevano solo confronti
    /// CON la costituzione, quindi un refuso sull'anno qui si propagava indisturbato — un anno sbagliato
    /// sposta tutte le date insieme e i confronti restano soddisfatti.
    /// </summary>
    private IEnumerable<string> ValidateDataCostituzione(DateTime? value)
    {
        var esito = DateValidator.CheckDataStorica(value, "La data di costituzione");
        if (!esito.IsValid)
        {
            yield return esito.ErrorMessage;
            yield break;
        }

        if (DateValidator.MotivoDaConfermareStorica(value) is { } motivo)
        {
            yield return $"{motivo} Verifica che sia corretta.";
        }
    }

    private IEnumerable<string> ValidateDataInizioAttivita(DateTime? value)
    {
        var esitoAssoluto = DateValidator.CheckDataStorica(value, "La data di inizio attività");
        if (!esitoAssoluto.IsValid)
        {
            yield return esitoAssoluto.ErrorMessage;
            yield break;
        }

        if (Entity.DataCostituzione.HasValue && value.HasValue)
        {
            var result = DateValidator.CheckDateRange(Entity.DataCostituzione, value, "Costituzione", "Inizio Attività");
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    private IEnumerable<string> ValidateReaNumero(string value)
    {
        if ((Entity.ReaProvinciaFk.HasValue || Entity.ReaDataIscrizione.HasValue) && string.IsNullOrWhiteSpace(value))
        {
            yield return "Il Numero REA è obbligatorio se è presente un dato REA";
        }
    }

    private IEnumerable<string> ValidateReaProvincia(int? value)
    {
        if ((!string.IsNullOrWhiteSpace(Entity.ReaNumero) || Entity.ReaDataIscrizione.HasValue) && !value.HasValue)
        {
            yield return "La Provincia REA è obbligatoria se è presente un dato REA";
        }
    }

    private IEnumerable<string> ValidateReaData(DateTime? value)
    {
        if ((!string.IsNullOrWhiteSpace(Entity.ReaNumero) || Entity.ReaProvinciaFk.HasValue) && !value.HasValue)
        {
            yield return "La Data Iscrizione REA è obbligatoria se è presente un dato REA";
            yield break;
        }

        var esitoAssoluto = DateValidator.CheckDataStorica(value, "La data di iscrizione REA");
        if (!esitoAssoluto.IsValid)
        {
            yield return esitoAssoluto.ErrorMessage;
            yield break;
        }

        if (value.HasValue && Entity.DataCostituzione.HasValue)
        {
            var result = DateValidator.CheckDateRange(Entity.DataCostituzione, value, "Costituzione", "Iscrizione REA");
            if (!result.IsValid)
            {
                yield return result.ErrorMessage;
            }
        }
    }

    public void Dispose()
    {
        _sitoWeb.ScartaMedia();
        try { JS.InvokeVoidAsync("dialogFormHelper.cleanup"); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
