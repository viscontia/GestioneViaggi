@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@if (!string.IsNullOrWhiteSpace(Title))
{
    <MudText Typo="Typo.h5" Class="enterprise-grid-title">@Title</MudText>
}
<MudSpacer />
<MudTextField T="string"
              @key="@("search-field-input")"
              @ref="_searchField"
              Value="@SearchString"
              ValueChanged="@SearchStringChanged"
              Placeholder="Digita per cercare..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              IconSize="Size.Medium"
              Class="mt-0 mr-4 search-field"
              Immediate="true"
              Clearable="true"
              OnKeyDown="@AlTasto"
              AutoFocus="true" />
@* La casella filtra cio' che e' gia' stato letto: se un altro software ha scritto
   nel frattempo — il sito di iscrizione scrive negli stessi clienti — quel dato non
   c'e' e nessuna ricerca puo' trovarlo. Questo pulsante e' il modo di dire "rileggi",
   e lo stesso fa il tasto Invio nella casella. *@
@if (OnRefresh.HasDelegate)
{
    <MudTooltip Text="Rileggi i dati aggiornati (Invio)">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Primary"
                       Class="mr-2"
                       OnClick="@(() => OnRefresh.InvokeAsync())" />
    </MudTooltip>
}
@ChildContent

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? SearchString { get; set; }
    [Parameter] public EventCallback<string> SearchStringChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Rilegge i dati dalla sorgente. Se nessuno lo gestisce, il pulsante non compare.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    private MudTextField<string>? _searchField;

    private string? _lastSearchString;
    private string? _lastTitle;
    private bool _shouldRender = true;
    private bool _hasFocused = false;

    private async Task AlTasto(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && OnRefresh.HasDelegate)
            await OnRefresh.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        // Determina se è necessario un re-render
        _shouldRender = false;

        if (SearchString != _lastSearchString)
        {
            _shouldRender = true;
            _lastSearchString = SearchString;
        }

        if (Title != _lastTitle)
        {
            _shouldRender = true;
            _lastTitle = Title;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Usa FocusAsync nativo di MudBlazor con delay per attendere i re-render della grid
        if (firstRender || !_hasFocused)
        {
            _hasFocused = true;
            // Delay per attendere che la grid parent completi il suo StateHasChanged
            await Task.Delay(600);
            if (_searchField != null)
            {
                await _searchField.FocusAsync();
            }
        }
    }

    protected override bool ShouldRender()
    {
        // Ottimizzazione: blocca re-render inutili causati dal layout engine della griglia
        // Preserva l'istanza DOM quando i dati sono identici
        return _shouldRender;
    }
}
