@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using GestioneViaggi.Services.Shared.Ai
@using MudBlazor
@inject WebTraduzioneOrchestratorService Orchestrator
@inject WebTraduzioniService TraduzioniService
@inject WebAiConsumoService ConsumiService
@inject WebAiAlertService AlertService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* Scheda "Traduzioni" (Blocco 10): traduce i campi editoriali del viaggio (contenuti + passi)
   in EN/DE/FR/ES via Claude, con stato per lingua e revisione. Chiave Claude per-azienda. *@

<div class="traduzioni-tab" style="position:relative;">

@* La traduzione chiama Claude una volta per ogni campo e per ogni lingua: su un tour completo sono
   decine di chiamate e può durare minuti. Overlay a tutta scheda: segnala l'attesa, ne dichiara la
   durata e impedisce clic che partirebbero su dati in cambiamento. *@
<MudOverlay Visible="@_busy" DarkBackground="true" Absolute="true" ZIndex="9">
    <div class="d-flex flex-column align-center gap-2 pa-4 text-center">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color:white;">Traduzione in corso...</MudText>
        <MudText Typo="Typo.body2" Style="color:white;">@_progressoTraduzione</MudText>
        <MudText Typo="Typo.caption" Style="color:white;">Può richiedere 1-2 minuti: non chiudere la finestra.</MudText>
    </div>
</MudOverlay>

@if (_loading)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    @if (_errore != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            Non è stato possibile caricare la scheda: @_errore
        </MudAlert>
    }

    @if (!Orchestrator.SecretKeyConfigurata)
    {
        @* Causa tipica su macOS: l'app lanciata da Finder/IDE non eredita gli export di ~/.zshrc. *@
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            <b>Master key dei segreti non disponibile</b> (variabile d'ambiente <code>GV_SECRET_KEY</code>):
            la chiave Claude non può essere né letta né salvata, quindi la traduzione automatica è disabilitata.
            Le traduzioni già presenti restano consultabili. Avvia l'applicazione da un terminale che
            esporta la variabile, oppure impostala per le app grafiche.
        </MudAlert>
    }

    @* Consumo del credito: l'API non espone il residuo, quindi si mostra quanto ha speso questo
       gestionale. Il dettaglio e la soglia stanno nella scheda Traduzioni dell'anagrafica azienda. *@
    @if (_riepilogo is { Chiamate: > 0 })
    {
        var oltre = _configAi?.SogliaSpesa is > 0 && _spesoPeriodo >= _configAi.SogliaSpesa * 0.9m;
        <MudAlert Severity="@(oltre ? Severity.Warning : Severity.Normal)" Dense="true" Class="mb-3">
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Savings" Size="Size.Small" />
                <span>
                    Traduzioni automatiche: <b>@_riepilogo.Costo.ToString("N2") @_riepilogo.Valuta</b> stimati
                    su @_riepilogo.Chiamate chiamate
                    @if (_configAi?.SogliaSpesa is > 0)
                    {
                        <text> — @_spesoPeriodo.ToString("N2") della soglia di @_configAi.SogliaSpesa.Value.ToString("N2")</text>
                    }
                </span>
                @if (oltre)
                {
                    <b>Soglia quasi raggiunta: verifica il credito sulla console Anthropic.</b>
                }
            </div>
            <MudText Typo="Typo.caption">
                Stima sui consumi di questo gestionale: l'API non espone il credito residuo della chiave.
            </MudText>
        </MudAlert>
    }

    <!-- Chiave Claude per-azienda -->
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Chiave Claude (Anthropic) dell'azienda</MudText>
        <div class="d-flex align-center gap-2">
            <MudTextField @bind-Value="_keyInput" Placeholder="@(_hasKey ? "•••••• (configurata) — incolla per sostituire" : "Incolla la chiave API Claude")"
                          Variant="Variant.Outlined" InputType="InputType.Password" Class="flex-grow-1" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvaChiave" Disabled="@(_busy || !Orchestrator.SecretKeyConfigurata)">Salva chiave</MudButton>
        </div>
        @if (!_hasKey)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">Senza chiave la traduzione automatica non è disponibile.</MudText>
        }
    </MudPaper>

    @if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Nessun campo editoriale da tradurre (compila prima Contenuti Web / Itinerario).</MudAlert>
    }
    else
    {
        <div class="d-flex align-center gap-3 mb-2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Translate"
                       Disabled="@(_busy || !_hasKey || !Orchestrator.SecretKeyConfigurata)" OnClick="TraduciTutto">
                Traduci tutto (@string.Join("/", WebTraduzioneOrchestratorService.Lingue))
            </MudButton>

            @* Controllare a mano 80 traduzioni non è realistico: si verifica un campione e si approva
               il resto. Il vincolo è che il campione copra OGNI lingua. *@
            <MudTooltip Text="@ApprovaTooltip">
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.DoneAll"
                           Disabled="@(_busy || !PuoApprovareTutto)" OnClick="ApprovaTutte">
                    Approva tutte
                </MudButton>
            </MudTooltip>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Revisionate @CoppieRevisionate di @(_items.Count * WebTraduzioneOrchestratorService.Lingue.Length)
            </MudText>
        </div>

        @if (LingueSenzaCampione.Count > 0 && _items.Count > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Per poter approvare tutte le traduzioni in blocco, verificane prima almeno una per ogni lingua
                (clicca una cella e salva con "Revisionato"). Mancano: <b>@string.Join(", ", LingueSenzaCampione)</b>.
            </MudAlert>
        }

        <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto;">
            <thead>
                <tr>
                    <th>Campo</th>
                    @foreach (var l in WebTraduzioneOrchestratorService.Lingue)
                    {
                        <th style="text-align:center;">@l</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var it in _items)
                {
                    <tr>
                        <td>@it.Label</td>
                        @foreach (var l in WebTraduzioneOrchestratorService.Lingue)
                        {
                            var t = Find(it, l);
                            <td style="text-align:center;cursor:@(t != null ? "pointer" : "default");" @onclick="@(() => Rivedi(it, l))">
                                @if (t == null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">—</MudChip>
                                }
                                else if (t.Obsoleto)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">obsoleto</MudChip>
                                }
                                else if (!t.Revisionato)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">da revisionare</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">ok</MudChip>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Clicca una cella tradotta per rivederla. Modificando l'italiano, le traduzioni del campo diventano "obsolete".</MudText>
    }
}
</div>

@code {
    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    /// <summary>Notifica al parent lo stato di completamento (semaforo) rispetto alle lingue target (EN/DE/FR/ES).
    /// LIMITE NOTO: non esiste ancora un concetto di "lingue attive per azienda" nel gestionale — si usano
    /// tutte le lingue di <see cref="WebTraduzioneOrchestratorService.Lingue"/> per ogni azienda.</summary>
    [Parameter] public EventCallback<WebTabStato> StatoChanged { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _tabSetup;
    private bool _hasKey;
    private string? _errore;
    private string _progressoTraduzione = "";
    private WebAiRiepilogo? _riepilogo;
    private WebAiConfig? _configAi;
    private decimal _spesoPeriodo;
    private string? _keyInput;

    private List<TranslatableItem> _items = new();
    private Dictionary<string, WebTraduzione> _traduzioni = new();

    protected override async Task OnInitializedAsync()
    {
        // Un'eccezione qui uscirebbe dal ciclo di vita Blazor e congelerebbe l'intera interfaccia
        // (non solo questa scheda): il caricamento va sempre protetto, come negli altri sotto-tab.
        try { await ReloadAsync(); }
        catch (Exception ex)
        {
            _errore = ex.Message;
            Snackbar.Add($"Errore caricamento traduzioni: {ex.Message}", Severity.Error);
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_tabSetup)
        {
            _tabSetup = true;
            try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); } catch { }
        }
    }

    /// <summary>Coppie campo×lingua revisionate e non obsolete: è ciò che rende Completo il tab.</summary>
    private int CoppieRevisionate => _items.Sum(it => WebTraduzioneOrchestratorService.Lingue
        .Count(l => Find(it, l) is { Revisionato: true, Obsoleto: false }));

    /// <summary>Lingue in cui l'utente ha già verificato a mano almeno una traduzione.</summary>
    private List<string> LingueSenzaCampione => WebTraduzioneOrchestratorService.Lingue
        .Where(l => !_items.Any(it => Find(it, l) is { Revisionato: true, Obsoleto: false }))
        .ToList();

    /// <summary>
    /// L'approvazione in blocco si sblocca solo dopo che l'utente ha verificato almeno una
    /// traduzione <b>per ogni lingua</b>: altrimenti si approverebbe alla cieca una lingua che
    /// nessuno ha nemmeno guardato.
    /// </summary>
    private bool PuoApprovareTutto => _items.Count > 0 && LingueSenzaCampione.Count == 0
                                      && CoppieRevisionate < _items.Count * WebTraduzioneOrchestratorService.Lingue.Length;

    private static string Key(string entita, long entitaId, string campo, string lingua) => $"{entita}|{entitaId}|{campo}|{lingua}";
    private WebTraduzione? Find(TranslatableItem it, string lingua)
        => _traduzioni.TryGetValue(Key(it.Entita, it.EntitaId, it.Campo, lingua), out var t) ? t : null;

    private async Task ReloadAsync()
    {
        _hasKey = !string.IsNullOrWhiteSpace(await Orchestrator.GetClaudeKeyAsync(AziendaId));
        _items = await Orchestrator.GetTranslatableItemsAsync(ContenutoId, AziendaId);

        var ids = _items.Select(i => (i.Entita, i.EntitaId)).ToHashSet();
        var all = await TraduzioniService.ListByAziendaAsync(AziendaId);
        _traduzioni = all.Where(t => ids.Contains((t.Entita, t.EntitaId)))
                         .ToDictionary(t => Key(t.Entita, t.EntitaId, t.Campo, t.Lingua), t => t);
        await CaricaConsumiAsync();
        await NotifyStatoAsync();
        StateHasChanged();
    }

    /// <summary>Riepilogo spesa: totale storico e, se c'è una soglia, quanto è stato speso nel periodo corrente.</summary>
    private async Task CaricaConsumiAsync()
    {
        _riepilogo = await ConsumiService.RiepilogoAsync(AziendaId);
        _configAi = await ConsumiService.GetConfigAsync(AziendaId);
        _spesoPeriodo = _configAi == null
            ? _riepilogo.Costo
            : (await ConsumiService.RiepilogoAsync(AziendaId, _configAi.ConteggioDa)).Costo;
    }

    /// <summary>Completo se tutti i campi traducibili hanno una traduzione in tutte le lingue target; Vuoto se nessuna;
    /// Parziale altrimenti. Nessun campo da tradurre → Completo (vacuamente vero, non blocca la pubblicazione).</summary>
    private Task NotifyStatoAsync()
    {
        var totalPairs = _items.Count * WebTraduzioneOrchestratorService.Lingue.Length;
        var translated = _items.Sum(it => WebTraduzioneOrchestratorService.Lingue.Count(l => Find(it, l) != null));
        return StatoChanged.InvokeAsync(WebTabStatoRules.Traduzioni(totalPairs, translated, CoppieRevisionate));
    }

    private async Task SalvaChiave()
    {
        if (string.IsNullOrWhiteSpace(_keyInput)) { Snackbar.Add("Incolla una chiave.", Severity.Warning); return; }
        _busy = true;
        try
        {
            await Orchestrator.SetClaudeKeyAsync(AziendaId, _keyInput.Trim());
            _keyInput = null; _hasKey = true;
            Snackbar.Add("Chiave salvata.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Errore: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private string ApprovaTooltip => LingueSenzaCampione.Count > 0
        ? $"Verifica prima almeno una traduzione per ogni lingua. Mancano: {string.Join(", ", LingueSenzaCampione)}."
        : PuoApprovareTutto
            ? "Marca revisionate tutte le traduzioni rimanenti di questa edizione."
            : "Tutte le traduzioni sono già revisionate.";

    /// <summary>
    /// Marca revisionate tutte le traduzioni dell'edizione. Non tocca i testi: dichiara che
    /// l'operatore se ne assume la responsabilità dopo il controllo a campione.
    /// </summary>
    private async Task ApprovaTutte()
    {
        var totale = _items.Count * WebTraduzioneOrchestratorService.Lingue.Length;
        var mancanti = totale - CoppieRevisionate;

        var conferma = await DialogService.ShowMessageBox(
            "Approva tutte le traduzioni",
            $"Verranno marcate come revisionate {mancanti} traduzioni su {totale}, senza modificarne il testo. " +
            "Dichiari di averle controllate a campione e di assumertene la responsabilità: finiranno sul sito così come sono.",
            yesText: "Approva tutte", cancelText: "Annulla");
        if (conferma != true) return;

        _busy = true;
        StateHasChanged();
        try
        {
            var n = await TraduzioniService.ApprovaContenutoAsync(ContenutoId, AziendaId, WebTraduzioneOrchestratorService.Lingue);
            await ReloadAsync();
            Snackbar.Add($"Approvate {n} traduzioni.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Errore approvazione: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task TraduciTutto()
    {
        _busy = true;
        _progressoTraduzione = $"0 di {_items.Count * WebTraduzioneOrchestratorService.Lingue.Length}";
        StateHasChanged(); // mostra l'overlay prima di partire, non a operazione conclusa
        try
        {
            var progress = new Progress<string>(m => { _progressoTraduzione = m; StateHasChanged(); });
            var (ok, err) = await Orchestrator.TranslateAsync(AziendaId, _items, WebTraduzioneOrchestratorService.Lingue, progress);
            // Al termine del blocco, non a ogni chiamata: la soglia si controlla una volta e
            // l'eventuale email parte una sola volta (decisione presa dal DB).
            await AlertService.VerificaEAvvisaAsync(AziendaId);
            await ReloadAsync();
            Snackbar.Add($"Traduzioni completate: {ok} ok" + (err > 0 ? $", {err} errori" : ""), err > 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Errore: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Rivedi(TranslatableItem it, string lingua)
    {
        var t = Find(it, lingua);
        if (t == null) return; // niente da rivedere finché non è tradotto
        var parameters = new DialogParameters<WebTraduzioneReviewDialog>
        {
            { x => x.Traduzione, t },
            { x => x.SourceText, it.SourceText },
            { x => x.Label, it.Label },
            { x => x.LinguaLabel, ClaudeTranslationClient.LanguageName(lingua) }
        };
        var options = new DialogOptions { BackdropClick = false, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<WebTraduzioneReviewDialog>("Revisione traduzione", parameters, options);
        var res = await dialog.Result;
        if (res!.Canceled) return;
        try { await TraduzioniService.UpdateAsync(t); await ReloadAsync(); Snackbar.Add("Traduzione aggiornata.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add($"Errore salvataggio: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }
}
