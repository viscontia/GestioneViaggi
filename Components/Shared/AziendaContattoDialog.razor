@using GestioneViaggi.Models
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<MudDialog DefaultFocus="DefaultFocus.FirstChild" CloseOnEscapeKey="true">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Contatto" : "Nuovo Contatto")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <!-- Sede - OBBLIGATORIO (deve essere passata dall'esterno) -->
            <MudTextField Value="@SedeDescription"
                          Label="Sede"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Disabled="true"
                          Class="mb-3"
                          HelperText="La sede è determinata dal contesto" />

            <!-- Nome - OBBLIGATORIO -->
            <MudTextField @ref="_nomeField"
                          Value="@Entity.Nome"
                          ValueChanged="@((string val) => Entity.Nome = val?.ToUpper() ?? string.Empty)"
                          For="@(() => Entity.Nome)"
                          Label="Nome"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il nome è obbligatorio"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Inserire il nome del contatto"
                          OnKeyDown="@HandleKeyDown" />

            <!-- Cognome - OBBLIGATORIO -->
            <MudTextField Value="@Entity.Cognome"
                          ValueChanged="@((string val) => Entity.Cognome = val?.ToUpper() ?? string.Empty)"
                          For="@(() => Entity.Cognome)"
                          Label="Cognome"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il cognome è obbligatorio"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Inserire il cognome del contatto" />

            <!-- Ruolo - OBBLIGATORIO -->
            <MudTextField @bind-Value="Entity.Ruolo"
                          For="@(() => Entity.Ruolo)"
                          Label="Ruolo"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Il ruolo è obbligatorio"
                          MaxLength="150"
                          Class="mb-3"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Es: Amministratore, Responsabile, Referente" />

            <MudDivider Class="my-4" />

            <!-- Telefono Diretto - Opzionale -->
            <MudTextField @bind-Value="Entity.TelefonoDiretto"
                          For="@(() => Entity.TelefonoDiretto)"
                          Label="Telefono Diretto (opzionale)"
                          Variant="Variant.Outlined"
                          MaxLength="30"
                          Class="mb-3"
                          HelperText="Numero di telefono diretto" />

            <!-- Cellulare - Opzionale -->
            <MudTextField @bind-Value="Entity.Cellulare"
                          For="@(() => Entity.Cellulare)"
                          Label="Cellulare (opzionale)"
                          Variant="Variant.Outlined"
                          MaxLength="30"
                          Class="mb-3"
                          HelperText="Numero di cellulare" />

            <!-- Email - Opzionale -->
            <MudTextField @bind-Value="Entity.Email"
                          For="@(() => Entity.Email)"
                          Label="Email (opzionale)"
                          Variant="Variant.Outlined"
                          MaxLength="255"
                          Class="mb-3"
                          HelperText="Indirizzo email del contatto" />

            <!-- Note - Opzionali -->
            <MudTextField @bind-Value="Entity.Note"
                          For="@(() => Entity.Note)"
                          Label="Note (opzionale)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-3"
                          HelperText="Informazioni aggiuntive sul contatto" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _nomeField;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public AziendaContatto Entity { get; set; } = new AziendaContatto();

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public string SedeDescription { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                MudDialog?.Close(DialogResult.Ok(Entity));
            }
            else
            {
                if (_nomeField?.Error == true)
                {
                    await _nomeField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch { }
    }
}
