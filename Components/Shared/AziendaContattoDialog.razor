@using GestioneViaggi.Models
@using GestioneViaggi.Validation.Business
@using GestioneViaggi.Validation.Syntax
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<MudDialog close-on-escape-key="true">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Modifica Contatto" : "Nuovo Contatto")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <!-- Sede - OBBLIGATORIO -->
            <SedeSelect @bind-SelectedSedeId="_sedeIdNullable"
                        AziendaId="@Entity.AziendaIdFk"
                        Label="Sede"
                        Required="true"
                        RequiredError="La sede è obbligatoria"
                        HelperText="Selezionare la sede di riferimento per questo contatto"
                        Class="mb-3" />

            <!-- Nome - OBBLIGATORIO -->
            <MudTextField @ref="_nomeField"
                          Value="@Entity.Nome"
                          ValueChanged="@((string val) => Entity.Nome = val?.ToUpper() ?? string.Empty)"
                          For="@(() => Entity.Nome)"
                          Label="Nome"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il nome è obbligatorio"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Inserire il nome del contatto"
                          OnKeyDown="@HandleKeyDown" />

            <!-- Cognome - OBBLIGATORIO -->
            <MudTextField Value="@Entity.Cognome"
                          ValueChanged="@((string val) => Entity.Cognome = val?.ToUpper() ?? string.Empty)"
                          For="@(() => Entity.Cognome)"
                          Label="Cognome"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Required="true"
                          RequiredError="Il cognome è obbligatorio"
                          MaxLength="100"
                          Class="mb-3 uppercase-input"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Inserire il cognome del contatto" />

            <!-- Ruolo - OBBLIGATORIO -->
            <MudTextField @bind-Value="Entity.Ruolo"
                          For="@(() => Entity.Ruolo)"
                          Label="Ruolo"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Il ruolo è obbligatorio"
                          MaxLength="150"
                          Class="mb-3"
                          Adornment="Adornment.End"
                          AdornmentText="*"
                          AdornmentColor="Color.Error"
                          HelperText="Es: Amministratore, Responsabile, Referente" />

            <MudDivider Class="my-4" />

            @if (_showRecapitoError)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" CloseIcon="@Icons.Material.Filled.Close" 
                          CloseIconClicked="@(() => _showRecapitoError = false)">
                    <strong>Almeno un recapito è obbligatorio:</strong> Inserire Email, Cellulare o Telefono Diretto
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <strong>Almeno un recapito è obbligatorio:</strong> Email, Cellulare o Telefono Diretto
                </MudAlert>
            }

            <!-- Telefono Diretto - Solo numeri, zero significativo -->
            <MudTextField Value="@Entity.TelefonoDiretto"
                          ValueChanged="@((string val) => { Entity.TelefonoDiretto = val; _showRecapitoError = false; })"
                          For="@(() => Entity.TelefonoDiretto)"
                          Label="Telefono Diretto (opzionale)"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateTelefonoDiretto))"
                          Variant="Variant.Outlined"
                          MaxLength="30"
                          Class="mb-3"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Phone"
                          HelperText="Es: +39 0123456789 oppure 0123456789"
                          OnBlur="@OnTelefonoBlur" />

            <!-- Cellulare - Solo numeri, zero significativo -->
            <MudTextField Value="@Entity.Cellulare"
                          ValueChanged="@((string val) => { Entity.Cellulare = val; _showRecapitoError = false; })"
                          For="@(() => Entity.Cellulare)"
                          Label="Cellulare (opzionale)"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateCellulare))"
                          Variant="Variant.Outlined"
                          MaxLength="30"
                          Class="mb-3"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PhoneAndroid"
                          HelperText="Es: +39 333 1234567 oppure 3331234567"
                          OnBlur="@OnCellulareBlur" />

            <!-- Email -->
            <MudTextField Value="@Entity.Email"
                          ValueChanged="@((string val) => { Entity.Email = val; _showRecapitoError = false; })"
                          For="@(() => Entity.Email)"
                          Label="Email (opzionale)"
                          Validation="@(new Func<string, IEnumerable<string>>(ValidateEmail))"
                          Variant="Variant.Outlined"
                          MaxLength="255"
                          Class="mb-3"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          HelperText="Indirizzo email del contatto" />

            <!-- Note - Opzionali -->
            <MudTextField @bind-Value="Entity.Note"
                          For="@(() => Entity.Note)"
                          Label="Note (opzionale)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-3"
                          HelperText="Informazioni aggiuntive sul contatto" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">
            Annulla
        </MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _nomeField;
    private bool _showRecapitoError = false;
    
    private int? _sedeIdNullable
    {
        get => Entity.SedeIdFk == 0 ? null : Entity.SedeIdFk;
        set => Entity.SedeIdFk = value ?? 0;
    }

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public AziendaContatto Entity { get; set; } = new AziendaContatto();

    [Parameter]
    public bool IsEditMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog tab navigation: {ex.Message}");
            }
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }

    private IEnumerable<string> ValidateTelefonoDiretto(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            yield break;

        var cleaned = CleanPhoneNumber(value);
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            yield return "Il numero di telefono non contiene cifre valide.";
            yield break;
        }

        var result = PhoneValidator.CheckTelefonoItaly(cleaned);
        if (!result.IsValid)
            yield return result.ErrorMessage;
    }

    private IEnumerable<string> ValidateCellulare(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            yield break;

        var cleaned = CleanPhoneNumber(value);
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            yield return "Il numero di cellulare non contiene cifre valide.";
            yield break;
        }

        var result = PhoneValidator.CheckTelefonoItaly(cleaned);
        if (!result.IsValid)
            yield return result.ErrorMessage;
    }

    private string CleanPhoneNumber(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return string.Empty;

        var cleaned = new System.Text.StringBuilder();
        bool hasPlus = input.TrimStart().StartsWith("+");
        
        if (hasPlus)
            cleaned.Append("+");

        foreach (char c in input)
        {
            if (char.IsDigit(c))
                cleaned.Append(c);
            else if (c == ' ' || c == '-' || c == '.' || c == '/')
                continue;
        }

        return cleaned.ToString();
    }

    private void OnTelefonoBlur()
    {
        if (!string.IsNullOrWhiteSpace(Entity.TelefonoDiretto))
        {
            var cleaned = CleanPhoneNumber(Entity.TelefonoDiretto);
            if (cleaned != Entity.TelefonoDiretto)
            {
                Entity.TelefonoDiretto = cleaned;
                StateHasChanged();
            }
        }
    }

    private void OnCellulareBlur()
    {
        if (!string.IsNullOrWhiteSpace(Entity.Cellulare))
        {
            var cleaned = CleanPhoneNumber(Entity.Cellulare);
            if (cleaned != Entity.Cellulare)
            {
                Entity.Cellulare = cleaned;
                StateHasChanged();
            }
        }
    }

    private IEnumerable<string> ValidateEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            yield break;

        var result = EmailValidator.CheckEmail(value);
        if (!result.IsValid)
            yield return result.ErrorMessage;
    }

    private async Task HandleSubmit()
    {
        _showRecapitoError = false;
        
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
            {
                var recapitoResult = ContattoValidator.ValidateRecapitoPresence(
                    Entity.Email, 
                    Entity.Cellulare, 
                    Entity.TelefonoDiretto);

                if (!recapitoResult.IsValid)
                {
                    _showRecapitoError = true;
                    StateHasChanged();
                    return;
                }

                MudDialog?.Close(DialogResult.Ok(Entity));
            }
            else
            {
                if (_nomeField?.Error == true)
                {
                    await _nomeField.FocusAsync();
                }
            }
        }
    }

    public void Dispose()
    {
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup");
        }
        catch { }
    }
}
