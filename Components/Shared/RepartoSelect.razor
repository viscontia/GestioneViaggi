@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject RepartoAziendaleService RepartoService

<BaseEntitySelect TItem="RepartoAziendale"
                  Value="_selectedReparto"
                  ValueChanged="OnRepartoChanged"
                  SearchFunc="SearchReparti"
                  ToStringFunc="@(r => r?.NomeReparto)"
                  Label="@Label"
                  Required="@Required"
                  RequiredError="@RequiredError"
                  Disabled="@Disabled"
                  Class="@Class"
                  HelperText="@HelperText"
                  AutoFocus="@AutoFocus"
                  AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<RepartoAziendale>? _reparti;
    private RepartoAziendale? _selectedReparto;
    private int? _currentAziendaId;

    [Parameter]
    public int? AziendaId { get; set; }

    [Parameter]
    public int? SelectedRepartoId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRepartoIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Reparto";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "Il reparto è obbligatorio";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona il reparto dall'elenco";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Se l'AziendaId cambia, ricarica i reparti
        if (_currentAziendaId != AziendaId)
        {
            _currentAziendaId = AziendaId;
            await LoadRepartiAsync();
        }
        else
        {
            UpdateSelectedReparto();
        }
    }

    private void UpdateSelectedReparto()
    {
        if (_reparti == null) return;

        if (SelectedRepartoId.HasValue)
        {
            if (_selectedReparto?.Id != SelectedRepartoId.Value)
            {
                _selectedReparto = _reparti.FirstOrDefault(r => r.Id == SelectedRepartoId.Value);
            }
        }
        else
        {
            _selectedReparto = null;
        }
    }

    private async Task LoadRepartiAsync()
    {
        try
        {
            if (AziendaId.HasValue && AziendaId.Value > 0)
            {
                _reparti = await RepartoService.GetByAziendaIdAsync(AziendaId.Value);
            }
            else
            {
                _reparti = new List<RepartoAziendale>();
            }
            UpdateSelectedReparto();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento reparti: {ex.Message}");
            _reparti = new List<RepartoAziendale>();
        }
    }

    private async Task OnRepartoChanged(RepartoAziendale reparto)
    {
        _selectedReparto = reparto;
        await SelectedRepartoIdChanged.InvokeAsync(reparto?.Id);
    }

    private async Task<IEnumerable<RepartoAziendale>> SearchReparti(string value, CancellationToken token)
    {
        if (_reparti == null)
            return Enumerable.Empty<RepartoAziendale>();

        if (string.IsNullOrEmpty(value))
            return _reparti;

        return _reparti.Where(x => x.NomeReparto.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
