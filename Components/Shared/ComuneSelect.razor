@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@inject ComuneService ComuneService

<BaseEntitySelect @ref="_campo" TItem="Comune" Value="_selectedComune" ValueChanged="OnComuneChanged" SearchFunc="SearchComuni"
    ToStringFunc="@(c => c?.Nome?.ToUpperInvariant() ?? string.Empty)" Label="@Label" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" AutoFocus="@AutoFocus" HelperText="@HelperText"
    Class="@($"{Class} uppercase-input")" Validation="@Validation" AdditionalAttributes="@AdditionalAttributes" />

@code {
    private BaseEntitySelect<Comune>? _campo;

    /// <summary>Porta il fuoco sul campo, per chi apre la scheda su questa tendina.</summary>
    public ValueTask FocusAsync() => _campo?.FocusAsync() ?? ValueTask.CompletedTask;

    private List<Comune> _allComuni = new();
    private Comune? _selectedComune;
    private bool _loaded = false;

    [Parameter]
    public int? SelectedComuneId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedComuneIdChanged { get; set; }

    [Parameter]
    public Comune? SelectedComune { get; set; }

    [Parameter]
    public EventCallback<Comune?> SelectedComuneChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Comune";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string RequiredError { get; set; } = "Il comune è obbligatorio";

    [Parameter]
    public object? Validation { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AutoFocus { get; set; }

    [Parameter]
    public string? HelperText { get; set; } = "Digita per cercare il comune";

    [Parameter]
    public string? Class { get; set; } = "mb-3";

    [Parameter]
    public List<Comune>? Items { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Filtro opzionale per provincia (limita i comuni visualizzati)
    /// </summary>
    [Parameter]
    public int? ProvinciaIdFilter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Priorità 1: Se SelectedComune è già fornito dal genitore, usalo subito
        if (SelectedComune != null)
        {
            _selectedComune = SelectedComune;
        }

        if (Items != null && Items.Count > 0)
        {
            _allComuni = Items;
            _loaded = true;
            SyncSelectedComune();
        }
        else
        {
            await LoadComuniAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (Items != null && Items.Count > 0)
        {
            _allComuni = Items;
            _loaded = true;
        }
        // Si registra solo cio' che non torna: il render normale passa di qui quattro o
        // cinque volte per ogni tasto, e scrivere ogni volta cambierebbe i tempi di cio'
        // che si sta cercando di osservare.
        if (SelectedComuneId.HasValue && SelectedComune is null)
            Traccia($"INCOERENTE: id={SelectedComuneId} ma oggetto NULL " +
                    $"(_selectedComune={(_selectedComune is null ? "NULL" : _selectedComune.Nome)}, caricati={_allComuni.Count})");
        else if (SelectedComune is not null && _selectedComune is null)
            Traccia($"INCOERENTE: oggetto={SelectedComune.Nome} ma _selectedComune NULL");

        SyncSelectedComune();
    }

    private void SyncSelectedComune()
    {
        // Priorità 1: Se SelectedComune è fornito dal genitore, usalo direttamente
        // Questo gestisce il caso in cui il genitore ha già caricato l'oggetto Comune
        if (SelectedComune != null)
        {
            if (_selectedComune?.Id != SelectedComune.Id)
            {
                // Cerca nella lista per consistenza, altrimenti usa l'oggetto passato
                _selectedComune = _loaded && _allComuni.Count > 0
                    ? _allComuni.FirstOrDefault(c => c.Id == SelectedComune.Id) ?? SelectedComune
                    : SelectedComune;
            }
            return;
        }

        // Priorità 2: Usa SelectedComuneId per cercare nella lista
        if (!_loaded || _allComuni.Count == 0) return;

        if (SelectedComuneId.HasValue)
        {
            if (_selectedComune?.Id != SelectedComuneId.Value)
            {
                _selectedComune = _allComuni.FirstOrDefault(c => c.Id == SelectedComuneId.Value);
                // Propaga al genitore se abbiamo risolto l'oggetto
                if (_selectedComune != null)
                {
                    SelectedComuneChanged.InvokeAsync(_selectedComune);
                }
            }
        }
        else
        {
            if (_selectedComune is not null)
                Traccia($"AZZERATO da SyncSelectedComune (era {_selectedComune.Nome}/{_selectedComune.Id}); " +
                        $"SelectedComune=null SelectedComuneId=null");
            _selectedComune = null;
        }
    }

    private async Task LoadComuniAsync()
    {
        try
        {
            _allComuni = await ComuneService.GetAllAsync();
            _loaded = true;
            SyncSelectedComune();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento comuni: {ex.Message}");
            _allComuni = new List<Comune>();
        }
    }

    private async Task OnComuneChanged(Comune? comune)
    {
        Traccia($"OnComuneChanged ricevuto={(comune is null ? "NULL" : comune.Nome + "/" + comune.Id)}");
        _selectedComune = comune;
        await SelectedComuneIdChanged.InvokeAsync(comune?.Id);
        await SelectedComuneChanged.InvokeAsync(comune);
    }

    // TEMPORANEA (2026-08-31): perche' il comune risulta vuoto pur essendo scelto.
    private void Traccia(string testo)
    {
        try
        {
            System.IO.File.AppendAllText("/tmp/gv_comune.log",
                $"{DateTime.Now:HH:mm:ss.fff} [{Label}] {testo}\n");
        }
        catch { }
    }

    private async Task<IEnumerable<Comune>> SearchComuni(string searchText, CancellationToken cancellationToken)
    {
        await Task.CompletedTask;

        if (!_loaded || _allComuni.Count == 0)
            return Enumerable.Empty<Comune>();

        // PERFORMANCE: Se non c'è testo, ritorna lista vuota (forza l'utente a digitare)
        // I comuni sono troppi (migliaia) per mostrarli tutti
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return Enumerable.Empty<Comune>();
        }

        // Filtra per provincia se specificato
        var source = ProvinciaIdFilter.HasValue
        ? _allComuni.Where(c => c.ProvinciaIdFk == ProvinciaIdFilter.Value)
        : _allComuni;

        // Ricerca case-insensitive che inizia con il testo cercato (più veloce)
        var startsWithResults = source
        .Where(c => c.Nome.StartsWith(searchText, StringComparison.OrdinalIgnoreCase))
        .Take(50)
        .ToList();

        // Se ci sono abbastanza risultati, ritorna solo quelli
        if (startsWithResults.Count >= 20)
            return startsWithResults;

        // Altrimenti aggiungi anche i risultati "contiene" (fino a 50 totali)
        var containsResults = source
        .Where(c => !c.Nome.StartsWith(searchText, StringComparison.OrdinalIgnoreCase) &&
        c.Nome.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Take(50 - startsWithResults.Count);

        return startsWithResults.Concat(containsResults).ToList();
    }
}
