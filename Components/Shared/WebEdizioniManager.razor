@using System.Globalization
@using System.Text
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using MudBlazor
@inject WebTourContenutiService ContenutiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject WebTourMappaService MappaService

@* Gestione contenuti web PER EDIZIONE (Blocco 13): il contenuto è figlio di (viaggio + data_viaggio).
   Selettore edizione (date del viaggio) con stato contenuto ed effettuazione; Crea/Clona; 5 sotto-tab. *@

@if (_loading)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else if (_edizioni.Count == 0)
{
    <MudAlert Severity="Severity.Info">Questo viaggio non ha date. Aggiungi le date nella scheda <strong>Date Viaggio</strong>: i contenuti web si creano per singola edizione (data).</MudAlert>
}
else
{
    <div class="d-flex align-center gap-3 flex-wrap mb-3 pr-4">
        <MudSelect T="int" Label="Edizione (data del viaggio)" Value="_selectedDataId" ValueChanged="OnEdizioneChanged"
                   Variant="Variant.Outlined" Dense="true" Style="min-width:340px;">
            @foreach (var e in _edizioni)
            {
                <MudSelectItem T="int" Value="e.DataViaggioId">@FormatEdizione(e)</MudSelectItem>
            }
        </MudSelect>

        @if (_selected != null)
        {
            <MudTooltip Text="@(_selected.HaContenuto
                                ? $"Questa edizione ha una scheda web, in stato \"{_selected.StatoPubblicazione}\"."
                                : "Questa edizione non ha ancora una scheda web: creala o clonala da un'altra data.")">
                <MudChip T="string" Size="Size.Small" Icon="@(_selected.HaContenuto ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                         Color="@(_selected.HaContenuto ? Color.Success : Color.Default)">
                    @(_selected.HaContenuto ? $"Con contenuto ({_selected.StatoPubblicazione})" : "Senza contenuto")
                </MudChip>
            </MudTooltip>

            @* Stato della partenza (flag "Viaggio Effettuato" incrociato col calendario): componente
               riusabile, così la stessa lettura vale ovunque si ragioni su una partenza. *@
            <StatoPartenzaChip Effettuato="@_selected.Effettuato" DataFine="@_selected.DataFine" />
            @if (_selected.HaContenuto)
            {
                @* Verifiche non bloccanti sempre visibili: se compaiono solo all'anteprima o alla
                   pubblicazione, chi non apre mai l'anteprima non le vede. *@
                @if (_verifiche.Count > 0)
                {
                    <MudTooltip Text="Controlli non bloccanti sui contenuti: clicca per vederli">
                        <MudChip T="string" Size="Size.Small" Color="@(WebVerificheRules.ContaSegnalazioni(_verifiche) > 0 ? Color.Warning : Color.Info)"
                                 Icon="@(WebVerificheRules.ContaSegnalazioni(_verifiche) > 0 ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.Info)"
                                 OnClick="ApriVerifiche">
                            @_verifiche.Count @(_verifiche.Count == 1 ? "segnalazione" : "segnalazioni")
                        </MudChip>
                    </MudTooltip>
                }
                <MudTooltip Text="Serve una foto di copertina per l'anteprima" Disabled="@(_stati[TabGalleria] == WebTabStato.Completo)">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" OnClick="Anteprima"
                               Disabled="@(_stati[TabGalleria] != WebTabStato.Completo)">Anteprima</MudButton>
                </MudTooltip>

                @* Eliminazione della scheda: solo su bozza/archiviato. Su una scheda pubblicata il
                   pulsante non compare affatto, così togliere una pagina dal sito resta un atto in due
                   mosse (prima spubblicare, poi eliminare) e non un clic solo. *@
                @if (_selected.StatoPubblicazione != "pubblicato")
                {
                    <MudTooltip Text="Elimina la scheda web di questa edizione (giornate, foto, mappe e traduzioni)">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever"
                                   Disabled="@_busy" OnClick="EliminaScheda">Elimina scheda</MudButton>
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="La scheda è pubblicata: riportala a bozza per poterla eliminare">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="true">Elimina scheda</MudButton>
                    </MudTooltip>
                }
            }
        }
    </div>

    @if (_selected == null)
    {
        <MudText Color="Color.Secondary">Seleziona un'edizione.</MudText>
    }
    else if (!_selected.HaContenuto)
    {
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Class="mb-3">Nessun contenuto web per questa data. Puoi crearne uno nuovo o clonarlo da un'altra edizione dello stesso viaggio.</MudText>
            <div class="d-flex align-center gap-3 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@_busy" OnClick="Crea">Crea contenuto</MudButton>
                @if (_edizioniConContenuto.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">oppure clona da:</MudText>
                    <MudSelect T="long?" @bind-Value="_cloneSourceId" Label="Edizione sorgente" Variant="Variant.Outlined" Dense="true" Style="min-width:300px;">
                        @foreach (var e in _edizioniConContenuto)
                        {
                            <MudSelectItem T="long?" Value="e.ContenutoId">@FormatEdizione(e)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy"
                               Disabled="@(_busy || _cloneSourceId == null)" OnClick="Clona">Clona</MudButton>
                }
            </div>
        </MudPaper>
    }
    else
    {
        <div @key="_selected.ContenutoId">
            <MudTabs ActivePanelIndex="@_activeSubTabIndex" ActivePanelIndexChanged="OnSubTabChanged" Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="py-3 pl-3 pr-6">
                <MudTabPanel Text="Contenuti" Icon="@Icons.Material.Filled.Article" IconColor="@GetTabColor(TabContenuti)">
                    <WebTourContenutiTab @ref="_contenutiTab" ContenutoId="@_selected.ContenutoId!.Value" AziendaId="@AziendaId" DescrizioneBreve="@DescrizioneBreve"
                                          HasUnsavedChangesChanged="OnContenutiDirtyChanged"
                                          StatoChanged="@(s => OnStatoChanged(TabContenuti, s))"
                                          GetTabNonCompletiAltri="@(() => (IReadOnlyList<string>)TabNonCompleti.Where(t => t != TabContenuti).ToList())"
                                          GetVerifiche="@CalcolaVerificheAsync"
                                          GetMotivoNonPubblicabile="@(() => StatoPartenzaRules.MotivoNonPubblicabile(_selected.Effettuato, _selected.DataInizio, DateTime.Today))" />
                </MudTabPanel>
                <MudTabPanel Text="Galleria" Icon="@Icons.Material.Filled.PhotoLibrary" IconColor="@GetTabColor(TabGalleria)">
                    <WebTourGalleriaTab ContenutoId="@_selected.ContenutoId!.Value" AziendaId="@AziendaId"
                                         StatoChanged="@(s => OnStatoChanged(TabGalleria, s))" />
                </MudTabPanel>
                <MudTabPanel Text="Itinerario" Icon="@Icons.Material.Filled.Route" IconColor="@GetTabColor(TabItinerario)">
                    <WebTourItinerarioTab ContenutoId="@_selected.ContenutoId!.Value" AziendaId="@AziendaId" NumeroGiorni="@NumeroGiorni"
                                           DataInizio="@_selected.DataInizio"
                                           StatoChanged="@(s => OnStatoChanged(TabItinerario, s))" />
                </MudTabPanel>
                <MudTabPanel Text="Mappa" Icon="@Icons.Material.Filled.Map" IconColor="@GetTabColor(TabMappa)">
                    <WebTourMappaTab ContenutoId="@_selected.ContenutoId!.Value" AziendaId="@AziendaId"
                                      DataInizio="@_selected.DataInizio" NumeroGiorni="@NumeroGiorni"
                                      StatoChanged="@(s => OnStatoChanged(TabMappa, s))" />
                </MudTabPanel>
                <MudTabPanel Text="Traduzioni" Icon="@Icons.Material.Filled.Translate" IconColor="@GetTabColor(TabTraduzioni)">
                    <WebTraduzioniTab ContenutoId="@_selected.ContenutoId!.Value" AziendaId="@AziendaId"
                                       StatoChanged="@(s => OnStatoChanged(TabTraduzioni, s))" />
                </MudTabPanel>
            </MudTabs>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public int ViaggioId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    [Parameter] public string? DescrizioneBreve { get; set; }
    /// <summary>Durata del viaggio (ana_viaggi.numero_giorni): propagata all'Itinerario per il gating "tutte le giornate descritte".</summary>
    [Parameter] public int NumeroGiorni { get; set; }
    /// <summary>Bubbla al parent (AnaViaggiDialog) lo stato "modifiche non salvate" della scheda Contenuti.</summary>
    [Parameter] public EventCallback<bool> HasUnsavedChangesChanged { get; set; }

    private List<EdizioneViaggio> _edizioni = new();
    private EdizioneViaggio? _selected;
    private int _selectedDataId;
    private long? _cloneSourceId;
    private bool _loading = true;
    private bool _busy;
    private int _activeSubTabIndex;
    private bool _dirty;
    private WebTourContenutiTab? _contenutiTab;
    private IReadOnlyList<Verifica> _verifiche = Array.Empty<Verifica>();

    // Semaforo sotto-tab (Fase 2): stato di completamento per tab, usato per colorare l'icona e (Fase 3) per il gating.
    private const string TabContenuti = "Contenuti";
    private const string TabItinerario = "Itinerario";
    private const string TabGalleria = "Galleria";
    private const string TabMappa = "Mappa";
    private const string TabTraduzioni = "Traduzioni";
    private readonly Dictionary<string, WebTabStato> _stati = new()
    {
        [TabContenuti] = WebTabStato.Vuoto,
        [TabGalleria] = WebTabStato.Vuoto,
        [TabItinerario] = WebTabStato.Vuoto,
        [TabMappa] = WebTabStato.Vuoto,
        [TabTraduzioni] = WebTabStato.Vuoto
    };

    /// <summary>Tab non ancora Completo, nell'ordine dei sotto-tab. Usato dal gating di pubblicazione (Fase 3).</summary>
    public IReadOnlyList<string> TabNonCompleti => _stati.Where(kv => kv.Value != WebTabStato.Completo).Select(kv => kv.Key).ToList();

    private void OnStatoChanged(string tab, WebTabStato stato)
    {
        _stati[tab] = stato;
        StateHasChanged();
    }

    private Color GetTabColor(string tab) => _stati.TryGetValue(tab, out var stato) ? stato.ToColor() : Color.Default;

    /// <summary>
    /// Accende il semaforo di TUTTI i sotto-tab dell'edizione selezionata, leggendo i fatti in una sola query.
    /// Serve perché MudTabs non tiene vivi i pannelli: all'apertura (e dopo un cambio edizione) i sotto-tab non
    /// ancora visitati non esistono e non possono notificare il proprio stato via StatoChanged.
    /// </summary>
    private async Task CaricaStatiAsync()
    {
        var contenutoId = _selected?.ContenutoId;
        var fatti = contenutoId == null
            ? null
            : await ContenutiService.GetStatoSezioniAsync(contenutoId.Value, AziendaId, WebTraduzioneOrchestratorService.Lingue);

        if (fatti == null)
        {
            foreach (var tab in _stati.Keys.ToList()) _stati[tab] = WebTabStato.Vuoto;
            return;
        }

        _stati[TabContenuti] = WebTabStatoRules.Contenuti(fatti.HaSlug, fatti.HaSottotitolo, fatti.HaDescrizione);
        _stati[TabGalleria] = WebTabStatoRules.Galleria(fatti.NumeroImmagini, fatti.HaPrincipale);
        _stati[TabItinerario] = WebTabStatoRules.Itinerario(fatti.NumeroGiornate, NumeroGiorni);
        _stati[TabMappa] = WebTabStatoRules.Mappa();
        _stati[TabTraduzioni] = WebTabStatoRules.Traduzioni(
            fatti.ItemTraducibili * WebTraduzioneOrchestratorService.Lingue.Length,
            fatti.CoppieTradotte, fatti.CoppieRevisionate);

        _verifiche = await CalcolaVerificheAsync();
    }

    /// <summary>
    /// Verifiche NON bloccanti dell'edizione selezionata. Ricalcolate ogni volta invece di riusare
    /// la lista in memoria: alla pubblicazione devono riflettere quello che l'utente ha appena sistemato.
    /// </summary>
    private async Task<IReadOnlyList<Verifica>> CalcolaVerificheAsync()
    {
        var contenutoId = _selected?.ContenutoId;
        if (contenutoId == null) return Array.Empty<Verifica>();

        var fatti = await ContenutiService.GetVerificheAsync(contenutoId.Value, AziendaId);
        if (fatti == null) return Array.Empty<Verifica>();

        // Le traduzioni non si ricontano qui: i conteggi arrivano dalla funzione del semaforo.
        var stato = await ContenutiService.GetStatoSezioniAsync(contenutoId.Value, AziendaId, WebTraduzioneOrchestratorService.Lingue);
        var attese = (stato?.ItemTraducibili ?? 0) * WebTraduzioneOrchestratorService.Lingue.Length;

        return WebVerificheRules.Analizza(fatti, attese, stato?.CoppieTradotte ?? 0);
    }

    private async Task ApriVerifiche()
    {
        _verifiche = await CalcolaVerificheAsync();
        var parameters = new DialogParameters<WebVerificheDialog> { { x => x.Verifiche, _verifiche } };
        await DialogService.ShowAsync<WebVerificheDialog>("Verifica contenuti", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
    }

    private IEnumerable<EdizioneViaggio> _edizioniConContenuto => _edizioni.Where(e => e.HaContenuto);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _edizioni = await ContenutiService.ListEdizioniAsync(ViaggioId, AziendaId);
        if (_selectedDataId != 0)
            _selected = _edizioni.FirstOrDefault(e => e.DataViaggioId == _selectedDataId);
        if (_selected == null && _edizioni.Count > 0)
        {
            _selected = _edizioni[0];
            _selectedDataId = _selected.DataViaggioId;
        }
        await CaricaStatiAsync();
    }

    private async Task OnEdizioneChanged(int dataId)
    {
        if (dataId == _selectedDataId) return;

        if (_dirty && !await ConfirmDiscardOrSaveAsync())
        {
            StateHasChanged(); // ripristina la selezione precedente nel MudSelect
            return;
        }

        _selectedDataId = dataId;
        _selected = _edizioni.FirstOrDefault(e => e.DataViaggioId == dataId);
        _cloneSourceId = null;
        await CaricaStatiAsync(); // il semaforo dell'edizione precedente non deve restare acceso
    }

    /// <summary>Guard cambio sotto-tab (Contenuti/Itinerario/Galleria/Mappa/Traduzioni) con modifiche non salvate.</summary>
    private async Task OnSubTabChanged(int index)
    {
        var previousIndex = _activeSubTabIndex;
        _activeSubTabIndex = index;

        if (previousIndex != index && _dirty)
        {
            if (!await ConfirmDiscardOrSaveAsync())
            {
                _activeSubTabIndex = previousIndex; // annulla il cambio tab
                StateHasChanged();
            }
        }
    }

    private async Task OnContenutiDirtyChanged(bool dirty)
    {
        _dirty = dirty;
        await HasUnsavedChangesChanged.InvokeAsync(dirty);
    }

    /// <summary>Salva la scheda Contenuti se ha modifiche non salvate. Usato dal guard del dialog padre (Chiudi).</summary>
    /// <summary>true se il manager è già sulla sotto-scheda "Contenuti": la X del dialog la usa per
    /// decidere se tornare ai Contenuti o uscire davvero dal viaggio.</summary>
    public bool IsOnContenuti => _activeSubTabIndex == 0;

    /// <summary>Riporta alla sotto-scheda "Contenuti" (indice 0) restando nel manager. Usato dal pulsante "Chiudi" del dialog viaggio.</summary>
    public void GoToContenuti()
    {
        _activeSubTabIndex = 0;
        StateHasChanged();
    }

    public async Task<bool> SaveActiveIfDirtyAsync()
    {
        if (_contenutiTab == null) return true;
        return await _contenutiTab.SaveIfDirtyAsync();
    }

    /// <summary>Modifiche non salvate: chiede Salva/Scarta/Annulla. Ritorna true se si può procedere (salvato o scartato).</summary>
    private async Task<bool> ConfirmDiscardOrSaveAsync()
    {
        var result = await DialogService.ShowMessageBox(
            "Modifiche non salvate",
            "Ci sono modifiche non salvate nei Contenuti. Vuoi salvarle prima di continuare?",
            yesText: "Salva", noText: "Scarta", cancelText: "Annulla");

        if (result == null) return false; // Annulla: resta dove sei
        if (result == true) return await SaveActiveIfDirtyAsync(); // Salva: procedi solo se il salvataggio riesce
        return true; // Scarta: procedi perdendo le modifiche
    }

    private async Task Crea()
    {
        if (_selected == null) return;
        _busy = true;
        try
        {
            var nuovo = await ContenutiService.CreateAsync(new WebTourContenuto
            {
                ViaggioIdFk = ViaggioId,
                DataViaggioIdFk = _selected.DataViaggioId,
                AziendaId = AziendaId,
                Slug = BuildSlug(_selected),
                StatoPubblicazione = "bozza"
            });
            Snackbar.Add("Contenuto creato.", Severity.Success);
            await ReloadAsync();
            _selected = _edizioni.FirstOrDefault(e => e.DataViaggioId == _selectedDataId);
        }
        catch (Exception ex) { Snackbar.Add($"Errore creazione: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Confronta le giornate che verrebbero copiate con la durata della partenza di destinazione e,
    /// se non coincidono, lascia decidere all'utente. Il caso è reale: il trigger sulle date valida la
    /// durata solo quando la data viene inserita o modificata, quindi cambiando il numero di giorni in
    /// anagrafica le partenze già esistenti mantengono la loro (verificato: stesso viaggio con una
    /// partenza di 6 giorni e una di 4). Ci si arriva anche con un itinerario di origine incompleto.
    /// Ritorna null se l'utente rinuncia, altrimenti il limite di giornate da passare al clone.
    /// </summary>
    private async Task<(bool Procedi, int? MaxGiornate)> ChiediGiornateDaClonareAsync(long sorgenteId)
    {
        var sorgente = _edizioni.FirstOrDefault(e => e.ContenutoId == sorgenteId);
        var stato = await ContenutiService.GetStatoSezioniAsync(sorgenteId, AziendaId, WebTraduzioneOrchestratorService.Lingue);
        var giornate = stato?.NumeroGiornate ?? 0;
        var durataDest = _selected?.Giorni;

        // Senza itinerario da copiare o senza date sulla destinazione non c'è nulla da confrontare.
        if (giornate == 0 || durataDest is not { } giorniDest || giornate == giorniDest) return (true, null);

        var righeOrigine = sorgente == null ? "" : $" (dal {sorgente.DataInizio:dd/MM/yyyy} al {sorgente.DataFine:dd/MM/yyyy})";
        var righeDest = $" (dal {_selected!.DataInizio:dd/MM/yyyy} al {_selected.DataFine:dd/MM/yyyy})";

        string messaggio;
        string testoConferma;
        int? max;

        if (giornate > giorniDest)
        {
            // Destinazione più corta: si copiano solo le giornate che ci stanno. L'ultima va rivista a
            // mano perché accorciare il viaggio cambia il finale, e non è una decisione automatizzabile.
            var scartate = giornate - giorniDest;
            // Testi montati fuori dall'interpolazione: il parser Razor si perde sulle stringhe
            // interpolate annidate dentro un'altra interpolata.
            var frasePerse = scartate == 1
                ? "l'ultima giornata non verrà copiata"
                : $"le ultime {scartate} giornate non verranno copiate";
            messaggio =
                $"L'edizione di origine{righeOrigine} ha <b>{giornate} giornate</b> di itinerario, " +
                $"ma la partenza di destinazione{righeDest} dura <b>{giorniDest} giorni</b>.<br/><br/>" +
                $"Clonando, verrebbero copiate solo le prime <b>{giorniDest} giornate</b>: " +
                $"{frasePerse}, " +
                "insieme alle mappe abbinate.<br/><br/>" +
                $"<b>Serve poi una verifica manuale</b>: la giornata {giorniDest} dell'itinerario clonato descrive una tappa intermedia, " +
                "non una conclusione. In un viaggio più corto il finale cambia (si rientra al punto di partenza? ci si ferma dove si è arrivati?) " +
                "e va riscritto a mano.";
            testoConferma = $"Clona le prime {giorniDest} giornate";
            max = giorniDest;
        }
        else
        {
            // Destinazione più lunga: si copia tutto, ma resteranno giornate scoperte.
            var mancanti = giorniDest - giornate;
            var fraseMancanti = mancanti == 1
                ? "resterà 1 giornata da scrivere a mano"
                : $"resteranno {mancanti} giornate da scrivere a mano";
            messaggio =
                $"L'edizione di origine{righeOrigine} ha <b>{giornate} giornate</b> di itinerario, " +
                $"ma la partenza di destinazione{righeDest} dura <b>{giorniDest} giorni</b>.<br/><br/>" +
                $"Verranno clonate tutte le {giornate} giornate disponibili: {fraseMancanti}.";
            testoConferma = "Clona comunque";
            max = null;
        }

        var conferma = await DialogService.ShowMessageBox(new MessageBoxOptions
        {
            Title = "Le giornate non coincidono",
            MarkupMessage = new MarkupString(messaggio),
            YesText = testoConferma,
            CancelText = "Non clonare"
        });

        return conferma == true ? (true, max) : (false, null);
    }

    private async Task Clona()
    {
        if (_selected == null || _cloneSourceId == null) return;

        var (procedi, maxGiornate) = await ChiediGiornateDaClonareAsync(_cloneSourceId.Value);
        if (!procedi) return;

        _busy = true;
        try
        {
            await ContenutiService.ClonaAsync(_cloneSourceId.Value, _selected.DataViaggioId, AziendaId, maxGiornate);
            Snackbar.Add(maxGiornate is { } n
                ? $"Contenuto clonato con le prime {n} giornate: rivedi la giornata {n}, era una tappa intermedia."
                : "Contenuto clonato.", Severity.Success);
            _cloneSourceId = null;
            await ReloadAsync();
            _selected = _edizioni.FirstOrDefault(e => e.DataViaggioId == _selectedDataId);
        }
        catch (Exception ex) { Snackbar.Add($"Errore clone: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Elimina la scheda web dell'edizione selezionata. La conferma elenca cosa si sta perdendo:
    /// l'eliminazione è irreversibile e porta via anche giornate, foto, mappe e traduzioni revisionate,
    /// cioè il lavoro editoriale più costoso da rifare.
    /// </summary>
    private async Task EliminaScheda()
    {
        if (_selected?.ContenutoId is not { } contenutoId) return;
        if (_selected.StatoPubblicazione == "pubblicato")
        {
            Snackbar.Add("La scheda è pubblicata: riportala a bozza prima di eliminarla.", Severity.Warning);
            return;
        }

        var stato = await ContenutiService.GetStatoSezioniAsync(contenutoId, AziendaId, WebTraduzioneOrchestratorService.Lingue);
        var mappe = (await MappaService.ListByContenutoAsync(contenutoId, AziendaId)).Count;

        var voci = new List<string>();
        if (stato is { NumeroGiornate: > 0 }) voci.Add($"{stato.NumeroGiornate} giornate di itinerario, con i loro passaggi");
        if (stato is { NumeroImmagini: > 0 }) voci.Add($"{stato.NumeroImmagini} immagini in galleria");
        if (mappe > 0) voci.Add($"{mappe} mappe caricate da GPX");
        if (stato is { CoppieTradotte: > 0 }) voci.Add($"{stato.CoppieTradotte} traduzioni, comprese quelle già revisionate");

        var elenco = voci.Count == 0
            ? "La scheda è ancora vuota: non c'è nulla di compilato da perdere."
            : "Insieme alla scheda spariscono:<ul><li>" + string.Join("</li><li>", voci) + "</li></ul>";

        var conferma = await DialogService.ShowMessageBox(new MessageBoxOptions
        {
            Title = "Eliminare la scheda web?",
            MarkupMessage = new MarkupString(
                $"Stai per eliminare la scheda di contenuti web dell'edizione <b>{FormatEdizione(_selected)}</b>.<br/><br/>" +
                elenco +
                "<br/><b>L'operazione non è reversibile</b> e non esiste un cestino da cui recuperarla.<br/><br/>" +
                "I file di foto e mappe restano in archivio (possono essere condivisi con una scheda clonata), " +
                "ma testi, ordinamento e revisioni delle traduzioni vanno rifatti da capo."),
            YesText = "Elimina definitivamente",
            CancelText = "Annulla"
        });
        if (conferma != true) return;

        _busy = true;
        try
        {
            await ContenutiService.DeleteAsync(contenutoId, AziendaId);
            Snackbar.Add("Scheda web eliminata.", Severity.Success);
            _activeSubTabIndex = 0;
            await OnContenutiDirtyChanged(false); // la scheda non c'è più: nessuna modifica da salvare
            await ReloadAsync();
            _selected = _edizioni.FirstOrDefault(e => e.DataViaggioId == _selectedDataId);
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Anteprima()
    {
        if (_selected?.ContenutoId == null) return;
        var parameters = new DialogParameters<WebTourAnteprimaDialog>
        {
            { x => x.ContenutoId, _selected.ContenutoId.Value },
            { x => x.AziendaId, AziendaId },
            { x => x.Verifiche, await CalcolaVerificheAsync() }
        };
        await DialogService.ShowAsync<WebTourAnteprimaDialog>("Anteprima pagina web", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true, Position = DialogPosition.Center });
    }

    private string FormatEdizione(EdizioneViaggio e)
    {
        var range = $"{e.DataInizio?.ToString("dd/MM/yyyy") ?? "?"} – {e.DataFine?.ToString("dd/MM/yyyy") ?? "?"}";
        var stato = e.HaContenuto ? $"• {e.StatoPubblicazione}" : "• senza contenuto";
        var eff = e.Effettuato ? " • effettuato" : "";
        return $"{range} {stato}{eff}";
    }

    private string BuildSlug(EdizioneViaggio e)
    {
        var baseSlug = Slugify(DescrizioneBreve);
        var suffix = e.DataInizio?.ToString("yyyy-MM-dd") ?? _selectedDataId.ToString();
        return string.IsNullOrEmpty(baseSlug) ? $"tour-{suffix}" : $"{baseSlug}-{suffix}";
    }

    private static string Slugify(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var normalized = text.Trim().ToLowerInvariant().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);
        foreach (var c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) == UnicodeCategory.NonSpacingMark) continue;
            sb.Append(char.IsLetterOrDigit(c) ? c : '-');
        }
        var slug = System.Text.RegularExpressions.Regex.Replace(sb.ToString(), "-{2,}", "-").Trim('-');
        return slug.Length > 140 ? slug[..140].Trim('-') : slug;
    }
