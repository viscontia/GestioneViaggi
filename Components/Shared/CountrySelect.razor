@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject CountryService CountryService

<BaseEntitySelect TItem="Country" Value="_selectedCountry" ValueChanged="OnCountryChanged" SearchFunc="SearchCountries"
    ToStringFunc="@(c => c?.Name?.ToUpperInvariant())" Label="@Label" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" Class="@($"{Class} uppercase-input")" HelperText="@HelperText"
    AutoFocus="@AutoFocus" AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<Country>? _countries;
    private Country? _selectedCountry;

    [Parameter]
    public int? SelectedCountryId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedCountryIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Paese";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "Il paese è obbligatorio";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona il paese dall'elenco";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public List<Country>? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Items != null)
        {
            _countries = Items;
            UpdateSelectedCountry();
        }
        else
        {
            await LoadCountriesAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (Items != null)
        {
            _countries = Items;
        }
        UpdateSelectedCountry();
    }

    private void UpdateSelectedCountry()
    {
        if (_countries == null) return;

        if (SelectedCountryId.HasValue)
        {
            if (_selectedCountry?.Id != SelectedCountryId.Value)
            {
                _selectedCountry = _countries.FirstOrDefault(c => c.Id == SelectedCountryId.Value);
            }
        }
        else
        {
            _selectedCountry = null;
        }
    }

    private async Task LoadCountriesAsync()
    {
        try
        {
            _countries = await CountryService.GetAllOrderedByNameAsync();
            UpdateSelectedCountry();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento paesi: {ex.Message}");
            _countries = new List<Country>();
        }
    }

    private async Task OnCountryChanged(Country country)
    {
        _selectedCountry = country;
        await SelectedCountryIdChanged.InvokeAsync(country?.Id);
    }

    private async Task<IEnumerable<Country>> SearchCountries(string value, CancellationToken token)
    {
        if (_countries == null)
            return Enumerable.Empty<Country>();

        if (string.IsNullOrEmpty(value))
            return _countries;

        return _countries.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
