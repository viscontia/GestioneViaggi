@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject CountryService CountryService

<MudSelect T="int?"
           @ref="_selectRef"
           Value="@SelectedCountryId"
           ValueChanged="@SelectedCountryIdChanged"
           Label="@Label"
           Variant="Variant.Outlined"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           Class="@ComputedClass"
           HelperText="@HelperText"
           Placeholder="Seleziona un paese..."
           OpenIcon="@Icons.Material.Filled.ArrowDropDown"
           CloseIcon="@Icons.Material.Filled.ArrowDropDown"
           @attributes="AdditionalAttributes">
    @if (_countries != null)
    {
        <MudSelectItem T="int?" Value="@((int?)null)">-- Seleziona --</MudSelectItem>
        @foreach (var country in _countries)
        {
            <MudSelectItem T="int?" Value="@country.Id">@country.Name</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<Country>? _countries;
    private MudSelect<int?>? _selectRef;
    private bool _focusApplied;

    [Parameter]
    public int? SelectedCountryId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedCountryIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Paese";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "Il paese è obbligatorio";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona il paese dall'elenco";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var baseClass = string.IsNullOrWhiteSpace(Class) ? string.Empty : Class;
            return Required ? string.Join(' ', new[] { baseClass, "required-field" }.Where(x => !string.IsNullOrWhiteSpace(x))) : baseClass;
        }
    }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCountriesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusApplied && AutoFocus && _selectRef is not null)
        {
            _focusApplied = true;
            await _selectRef.FocusAsync();
        }
    }

    private async Task LoadCountriesAsync()
    {
        try
        {
            _countries = await CountryService.GetAllOrderedByNameAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento paesi: {ex.Message}");
            _countries = new List<Country>();
        }
    }
}
