@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject RipartizioneGeograficaService RipGeoService

<MudSelect T="int?"
           @ref="_selectRef"
           Value="@SelectedRipGeoId"
           ValueChanged="@SelectedRipGeoIdChanged"
           Label="@Label"
           Variant="Variant.Outlined"
           Required="@Required"
           RequiredError="@RequiredError"
           Disabled="@Disabled"
           Class="@ComputedClass"
           HelperText="@HelperText"
           OpenIcon="@Icons.Material.Filled.ArrowDropDown"
           CloseIcon="@Icons.Material.Filled.ArrowDropDown"
           @attributes="AdditionalAttributes">
    @if (_ripartizioni != null)
    {
        @foreach (var ripgeo in _ripartizioni)
        {
            <MudSelectItem T="int?" Value="@ripgeo.Id">@ripgeo.Descrizione</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<RipartizioneGeografica>? _ripartizioni;
    private MudSelect<int?>? _selectRef;
    private bool _focusApplied;

    [Parameter]
    public int? SelectedRipGeoId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRipGeoIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Ripartizione Geografica";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La ripartizione geografica è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la ripartizione geografica corretta dall'elenco";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var baseClass = string.IsNullOrWhiteSpace(Class) ? string.Empty : Class;
            return Required ? string.Join(' ', new[] { baseClass, "required-field" }.Where(x => !string.IsNullOrWhiteSpace(x))) : baseClass;
        }
    }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRipartizioniAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusApplied && AutoFocus && _selectRef is not null)
        {
            _focusApplied = true;
            await _selectRef.FocusAsync();
        }
    }

    private async Task LoadRipartizioniAsync()
    {
        try
        {
            // GetAllAsync già ordina per descrizione ASC
            _ripartizioni = await RipGeoService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento ripartizioni geografiche: {ex.Message}");
            _ripartizioni = new List<RipartizioneGeografica>();
        }
    }
}
