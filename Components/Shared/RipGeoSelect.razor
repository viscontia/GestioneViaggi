@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using System.Threading
@inject RipartizioneGeograficaService RipGeoService

<BaseEntitySelect TItem="RipartizioneGeografica" Value="_selectedRipGeo" ValueChanged="OnRipGeoChanged"
    SearchFunc="SearchRipartizioni" ToStringFunc="@(r => r?.Descrizione?.ToUpperInvariant())" Label="@Label"
    Required="@Required" RequiredError="@RequiredError" Disabled="@Disabled" Class="@($"{Class} uppercase-input")"
    HelperText="@HelperText" HelperTextError="@HelperTextError" AutoFocus="@AutoFocus"
    AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<RipartizioneGeografica>? _ripartizioni;
    private List<RipartizioneGeografica>? _filteredRipartizioni;
    private RipartizioneGeografica? _selectedRipGeo;

    [Parameter]
    public int? SelectedRipGeoId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedRipGeoIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Ripartizione Geografica";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La ripartizione geografica è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la ripartizione geografica corretta dall'elenco";

    [Parameter]
    public bool HelperTextError { get; set; } = false;

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter]
    public bool? FilterEsteroOnly { get; set; } = null;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRipartizioniAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyFilter();
        UpdateSelectedRipGeo();
    }

    private void UpdateSelectedRipGeo()
    {
        if (_ripartizioni == null) return;

        if (SelectedRipGeoId.HasValue)
        {
            if (_selectedRipGeo?.Id != SelectedRipGeoId.Value)
            {
                _selectedRipGeo = _ripartizioni.FirstOrDefault(r => r.Id == SelectedRipGeoId.Value);
            }
        }
        else
        {
            _selectedRipGeo = null;
        }
    }

    private void ApplyFilter()
    {
        if (_ripartizioni == null) return;

        if (FilterEsteroOnly == true)
        {
            _filteredRipartizioni = _ripartizioni
            .Where(r => r.Descrizione != null && r.Descrizione.StartsWith("ESTERO", StringComparison.OrdinalIgnoreCase))
            .ToList();
        }
        else if (FilterEsteroOnly == false)
        {
            _filteredRipartizioni = _ripartizioni
            .Where(r => r.Descrizione != null && !r.Descrizione.StartsWith("ESTERO", StringComparison.OrdinalIgnoreCase))
            .ToList();
        }
        else
        {
            _filteredRipartizioni = _ripartizioni.ToList();
        }
    }

    private async Task LoadRipartizioniAsync()
    {
        try
        {
            _ripartizioni = await RipGeoService.GetAllAsync();
            UpdateSelectedRipGeo();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento ripartizioni geografiche: {ex.Message}");
            _ripartizioni = new List<RipartizioneGeografica>();
        }
    }

    private async Task OnRipGeoChanged(RipartizioneGeografica ripGeo)
    {
        _selectedRipGeo = ripGeo;
        await SelectedRipGeoIdChanged.InvokeAsync(ripGeo?.Id);
    }

    private async Task<IEnumerable<RipartizioneGeografica>> SearchRipartizioni(string value, CancellationToken token)
    {
        if (_filteredRipartizioni == null)
            return Enumerable.Empty<RipartizioneGeografica>();

        if (string.IsNullOrEmpty(value))
            return _filteredRipartizioni;

        return _filteredRipartizioni.Where(x => x.Descrizione.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
