@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@inject AnaFornitoriService FornitoriService
@inject ITenantContext TenantContext

@*
    COMPONENT: FornitoreSelect
    DESC: Autocomplete per la selezione di un Fornitore con ricerca testuale.
*@

<MudAutocomplete T="AnaFornitore"
                 Label="@Label"
                 Value="@_selectedFornitore"
                 ValueChanged="@OnFornitoreChanged"
                 SearchFunc="@SearchFornitori"
                 ToStringFunc="@(f => f?.RagioneSociale?.ToUpperInvariant())"
                 Required="@Required"
                 RequiredError="@RequiredError"
                 Variant="Variant.Outlined"
                 Dense="true"
                 Clearable="@Clearable"
                 Disabled="@Disabled"
                 ResetValueOnEmptyText="true"
                 CoerceText="false"
                 CoerceValue="false"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 AdornmentColor="Color.Primary"
                 Class="uppercase-input">
    <ItemTemplate Context="fornitore">
        <MudText Typo="Typo.body2">@fornitore.RagioneSociale</MudText>
        @if (!string.IsNullOrEmpty(fornitore.NomeBreve))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@fornitore.NomeBreve</MudText>
        }
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter] public int SelectedFornitoreId { get; set; }
    [Parameter] public EventCallback<int> SelectedFornitoreIdChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Fornitore";
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Campo obbligatorio";
    [Parameter] public bool Clearable { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;

    /// <summary>
    /// AziendaId esplicito per filtrare i fornitori.
    /// Se specificato, ha precedenza sul TenantContext.
    /// Utile per SuperAdmin che deve selezionare l'azienda prima di vedere i fornitori.
    /// </summary>
    [Parameter] public int? AziendaId { get; set; }

    private List<AnaFornitore> _fornitori = new List<AnaFornitore>();
    private AnaFornitore? _selectedFornitore;
    private int? _lastLoadedAziendaId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Ricarica i fornitori se l'AziendaId è cambiata
        if (AziendaId != _lastLoadedAziendaId)
        {
            await LoadData();
        }

        // Aggiorna il fornitore selezionato quando cambia l'ID
        UpdateSelectedFornitore();
    }

    private void UpdateSelectedFornitore()
    {
        if (_fornitori == null || _fornitori.Count == 0) return;

        if (SelectedFornitoreId > 0)
        {
            if (_selectedFornitore?.Id != SelectedFornitoreId)
            {
                _selectedFornitore = _fornitori.FirstOrDefault(f => f.Id == SelectedFornitoreId);
            }
        }
        else
        {
            _selectedFornitore = null;
        }
    }

    private async Task LoadData()
    {
        // Usa AziendaId parametro se specificato, altrimenti TenantContext
        int? aziendaId = AziendaId ?? await TenantContext.GetCurrentAziendaIdAsync();

        if (aziendaId.HasValue && aziendaId.Value > 0)
        {
            var result = await FornitoriService.GetAllAsync(aziendaId.Value);
            _fornitori = result.ToList();
            _lastLoadedAziendaId = aziendaId;
            UpdateSelectedFornitore();
        }
        else
        {
            _fornitori = new List<AnaFornitore>();
            _selectedFornitore = null;
            _lastLoadedAziendaId = null;
        }
    }

    private async Task OnFornitoreChanged(AnaFornitore? fornitore)
    {
        _selectedFornitore = fornitore;
        await SelectedFornitoreIdChanged.InvokeAsync(fornitore?.Id ?? 0);
    }

    private async Task<IEnumerable<AnaFornitore>> SearchFornitori(string value, CancellationToken token)
    {
        if (_fornitori == null || _fornitori.Count == 0)
            return Enumerable.Empty<AnaFornitore>();

        // Se non c'è testo di ricerca, mostra tutti
        if (string.IsNullOrWhiteSpace(value))
            return _fornitori;

        // Cerca in RagioneSociale e NomeBreve
        return _fornitori.Where(f =>
            (f.RagioneSociale?.Contains(value, StringComparison.InvariantCultureIgnoreCase) == true) ||
            (f.NomeBreve?.Contains(value, StringComparison.InvariantCultureIgnoreCase) == true)
        );
    }
}
