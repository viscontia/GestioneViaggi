@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject AnaViaggiService ViaggiService

<BaseEntitySelect TItem="AnaViaggi" Value="_selectedTrip" ValueChanged="OnTripChanged" SearchFunc="SearchTrips"
    ToStringFunc="@(t => t?.DescrizioneBreve?.ToUpperInvariant())" Label="@Label" Required="@Required"
    RequiredError="@RequiredError" Disabled="@Disabled" Class="@Class" HelperText="@HelperText" AutoFocus="@AutoFocus"
    AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<AnaViaggi>? _trips;
    private AnaViaggi? _selectedTrip;

    [Parameter]
    public int? SelectedId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedIdChanged { get; set; }

    [Parameter] public int AziendaId { get; set; } // Context for filtering

    [Parameter]
    public string Label { get; set; } = "Viaggio";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "Il viaggio è obbligatorio";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Cerca un viaggio...";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTripsAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedTrip();
    }

    private void UpdateSelectedTrip()
    {
        if (_trips == null) return;

        if (SelectedId.HasValue)
        {
            if (_selectedTrip?.Id != SelectedId.Value)
            {
                _selectedTrip = _trips.FirstOrDefault(x => x.Id == SelectedId.Value);
            }
        }
        else
        {
            _selectedTrip = null;
        }
    }

    private async Task LoadTripsAsync()
    {
        try
        {
            // Load all trips for the given company or unfiltered if AziendaId is null/0?
            // The service handles AziendaId filtering.
            _trips = await ViaggiService.GetAllAsync(AziendaId);
            UpdateSelectedTrip();
        }
        catch (Exception)
        {
            // Fallback
            _trips = new List<AnaViaggi>();
        }
    }

    private async Task OnTripChanged(AnaViaggi trip)
    {
        _selectedTrip = trip;
        await SelectedIdChanged.InvokeAsync(trip?.Id);
    }

    private async Task<IEnumerable<AnaViaggi>> SearchTrips(string value, CancellationToken token)
    {
        if (_trips == null)
            return Enumerable.Empty<AnaViaggi>();

        if (string.IsNullOrEmpty(value))
            return _trips;

        return _trips.Where(x => x.DescrizioneBreve != null &&
        x.DescrizioneBreve.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
