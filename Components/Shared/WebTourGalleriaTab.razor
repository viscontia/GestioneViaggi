@using Microsoft.AspNetCore.Components.Forms
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using GestioneViaggi.Services.Shared.Storage
@using MudBlazor
@inject WebTourImmaginiService ImmaginiService
@inject IWebMediaStorage Storage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* Scheda "Galleria" (Blocco 7). Upload multiplo → ottimizzazione WebP (ImageSharp) →
   Supabase Storage (IWebMediaStorage) → record web_tour_immagini. Griglia con DnD reorder,
   copertina (principale), alt/titolo in dialog. Live-save. storage_path = verità, URL ricomposto. *@

<div class="galleria-tab">
@if (_loading)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <div class="d-flex align-center gap-3 mb-3">
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept="image/*" AppendMultipleFiles="true"
                       MaximumFileCount="30" MaxFileSize="20971520" FilesChanged="OnFilesSelected" Disabled="@_uploading">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@_uploading">
                    Carica immagini
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>
        @if (_uploading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Caricamento in corso...</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_immagini.Count immagini · trascina per riordinare</MudText>
        }
    </div>

    @if (_immagini.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-8 d-flex justify-center">
            <MudText Color="Color.Secondary">Nessuna immagine. Carica le foto del tour.</MudText>
        </MudPaper>
    }
    else
    {
        <MudDropContainer T="WebTourImmagine" @ref="_container" Items="_immagini"
                          ItemsSelector="ImmagineInZone" ItemDropped="OnDropped"
                          ApplyDropClassesOnDragStarted="true" CanDropClass="dz-can-drop">
            <ChildContent>
                <MudDropZone T="WebTourImmagine" Identifier="gallery" AllowReorder="true" Class="dz-gallery" />
            </ChildContent>
            <ItemRenderer>
                <MudPaper Elevation="2" Class="@CardClass(context)" Style="width:180px;">
                    <div class="thumb-wrap cursor-grab">
                        <img src="@context.Url" alt="@context.AltText" class="thumb" loading="lazy" />
                        @if (context.Tipo == "principale")
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.Star" Class="badge-cover">Copertina</MudChip>
                        }
                    </div>
                    <div class="pa-1">
                        <MudText Typo="Typo.caption" Style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            @(string.IsNullOrWhiteSpace(context.Titolo) ? "(senza titolo)" : context.Titolo)
                        </MudText>
                        <div class="d-flex justify-space-between">
                            <MudTooltip Text="Imposta come copertina">
                                <MudIconButton Icon="@(context.Tipo == "principale" ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                               Color="@(context.Tipo == "principale" ? Color.Primary : Color.Default)" Size="Size.Small"
                                               OnClick="@(() => SetPrincipale(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Modifica alt/titolo">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditImmagine(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Elimina">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteImmagine(context))" />
                            </MudTooltip>
                        </div>
                    </div>
                </MudPaper>
            </ItemRenderer>
        </MudDropContainer>
    }
}
</div>

@code {
    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }

    private const long MaxUploadBytes = 20L * 1024 * 1024;

    private List<WebTourImmagine> _immagini = new();
    private bool _loading = true;
    private bool _uploading;
    private bool _tabSetup;
    private MudDropContainer<WebTourImmagine>? _container;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_tabSetup)
        {
            _tabSetup = true;
            try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); } catch { /* ignore */ }
        }
    }

    private async Task ReloadAsync()
    {
        _immagini = await ImmaginiService.ListByContenutoAsync(ContenutoId, AziendaId);
        _container?.Refresh();
        StateHasChanged();
    }

    private static bool ImmagineInZone(WebTourImmagine img, string identifier) => identifier == "gallery";

    private static string CardClass(WebTourImmagine img)
        => img.Tipo == "principale" ? "img-card img-card-cover" : "img-card";

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files is null || files.Count == 0) return;
        _uploading = true;
        try
        {
            foreach (var file in files)
            {
                try
                {
                    // Copia in memoria: lo stream del browser è forward-only, ImageSharp preferisce seekable.
                    using var buffer = new MemoryStream();
                    await using (var src = file.OpenReadStream(MaxUploadBytes))
                        await src.CopyToAsync(buffer);
                    buffer.Position = 0;

                    var processed = await WebImageProcessor.ToOptimizedWebpAsync(buffer);
                    var storagePath = $"{AziendaId}/{ContenutoId}/{Guid.NewGuid():N}.webp";
                    using var upStream = new MemoryStream(processed.Bytes);
                    await Storage.UploadAsync(storagePath, upStream, processed.Mime);

                    var img = new WebTourImmagine
                    {
                        WebTourContenutoIdFk = ContenutoId, AziendaId = AziendaId, Tipo = "galleria",
                        StoragePath = storagePath, Url = Storage.BuildPublicUrl(storagePath),
                        Larghezza = processed.Width, Altezza = processed.Height, Mime = processed.Mime,
                        Ordine = _immagini.Count + 1
                    };
                    img = await ImmaginiService.CreateAsync(img);
                    _immagini.Add(img);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Errore su '{file.Name}': {ex.Message}", Severity.Error);
                }
            }
            _container?.Refresh();
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task OnDropped(MudItemDropInfo<WebTourImmagine> info)
    {
        var img = info.Item;
        if (img is null) return;
        _immagini.Remove(img);
        var idx = Math.Clamp(info.IndexInZone, 0, _immagini.Count);
        _immagini.Insert(idx, img);
        for (int i = 0; i < _immagini.Count; i++) _immagini[i].Ordine = i + 1;
        _container?.Refresh();

        try { await ImmaginiService.ReorderAsync(AziendaId, ContenutoId, _immagini.Select(x => x.WebTourImmagineId).ToList()); }
        catch (Exception ex) { Snackbar.Add($"Errore riordino: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task SetPrincipale(WebTourImmagine img)
    {
        try
        {
            await ImmaginiService.SetPrincipaleAsync(img.WebTourImmagineId, AziendaId, ContenutoId);
            foreach (var i in _immagini) i.Tipo = "galleria";
            img.Tipo = "principale";
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Errore copertina: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task EditImmagine(WebTourImmagine img)
    {
        var parameters = new DialogParameters<WebTourImmagineEditDialog> { { x => x.Immagine, img } };
        var options = new DialogOptions { BackdropClick = false, FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<WebTourImmagineEditDialog>("Modifica immagine", parameters, options);
        if ((await dialog.Result)!.Canceled) return;
        try { await ImmaginiService.UpdateAsync(img); _container?.Refresh(); StateHasChanged(); }
        catch (Exception ex) { Snackbar.Add($"Errore salvataggio: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task DeleteImmagine(WebTourImmagine img)
    {
        if (!await ConfirmDelete("Elimina immagine", "Eliminare questa immagine?")) return;
        try
        {
            await ImmaginiService.DeleteAsync(img.WebTourImmagineId, AziendaId);
            try { await Storage.DeleteAsync(img.StoragePath); } catch { /* orfano storage tollerato */ }
            _immagini.Remove(img);
            for (int i = 0; i < _immagini.Count; i++) _immagini[i].Ordine = i + 1;
            if (_immagini.Count > 0)
                await ImmaginiService.ReorderAsync(AziendaId, ContenutoId, _immagini.Select(x => x.WebTourImmagineId).ToList());
            _container?.Refresh();
        }
        catch (Exception ex) { Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error); await ReloadAsync(); }
    }

    private async Task<bool> ConfirmDelete(string title, string message)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.Title, title },
            { x => x.ContentText, message }
        };
        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>(title, parameters, new DialogOptions { BackdropClick = false });
        return !(await dialog.Result)!.Canceled;
    }
}
