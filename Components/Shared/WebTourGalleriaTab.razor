@using Microsoft.AspNetCore.Components.Forms
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using GestioneViaggi.Services.Shared.Storage
@using MudBlazor
@inject WebTourImmaginiService ImmaginiService
@inject IWebMediaStorage Storage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* Scheda "Galleria" (Blocco 7). Upload multiplo → ottimizzazione WebP (ImageSharp) →
   Supabase Storage (IWebMediaStorage) → record web_tour_immagini. La copertina (principale) è
   messa in evidenza in cima; le altre foto in vista Dettaglio sono grandi e in colonna verticale
   (una per riga, immagine + campi affiancati) per un editing comodo; la vista Griglia è una
   panoramica compatta di sola lettura. Titolo/alt-text editabili inline con salvataggio
   automatico all'uscita dal campo. storage_path = verità, URL ricomposto. *@

<div class="galleria-tab">
<style>
    /* Stili GLOBALI (non scoped): le card sono rese da RenderFragment-field e lo scoped CSS
       (::deep) non le raggiunge. Prefissati .galleria-tab per non collidere con altri componenti. */
    .galleria-tab .img-card { width: 180px; overflow: hidden; }
    .galleria-tab .img-card-cover { width: 360px; outline: 3px solid var(--mud-palette-primary); outline-offset: -3px; }
    .galleria-tab .img-card-mini { width: 120px; }
    .galleria-tab .img-card-row { width: 100%; overflow: hidden; }
    .galleria-tab .thumb-wrap { position: relative; }
    .galleria-tab .thumb-wrap-row { position: relative; flex: 0 0 auto; }
    .galleria-tab .thumb { width: 100%; height: 120px; object-fit: contain; display: block; background: var(--mud-palette-background-grey); }
    .galleria-tab .img-card-cover .thumb { height: auto; max-height: 300px; }
    .galleria-tab .img-card-mini .thumb { height: 90px; }
    .galleria-tab .thumb-row { width: 280px; height: auto; max-height: 340px; object-fit: contain; display: block; background: var(--mud-palette-background-grey); }
    .galleria-tab .badge-cover { position: absolute; top: 8px; left: 8px; font-weight: 700; }
</style>
<MudOverlay Visible="_uploading" DarkBackground="true" ZIndex="2000">
    <MudPaper Class="pa-6 d-flex flex-column align-center gap-3" Elevation="4">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.body1">Caricamento foto @_uploadCurrent di @_uploadTotal…</MudText>
    </MudPaper>
</MudOverlay>
<MudOverlay Visible="_busy" DarkBackground="true" ZIndex="2000">
    <MudPaper Class="pa-6 d-flex flex-column align-center gap-3" Elevation="4">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.body1">Attendere…</MudText>
    </MudPaper>
</MudOverlay>

@if (_loading)
{
    <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    var copertina = _immagini.FirstOrDefault(i => i.Tipo == "principale");
    var altre = _immagini.Where(i => i.Tipo != "principale").ToList();

    RenderFragment<WebTourImmagine> CardTemplateCopertina = img =>
    @<MudPaper Elevation="4" Class="img-card img-card-cover">
        <div class="thumb-wrap">
            <img src="@img.Url" alt="@img.AltText" class="thumb" loading="lazy" />
            <MudChip T="string" Color="Color.Primary" Size="Size.Medium" Icon="@Icons.Material.Filled.Star" Class="badge-cover">COPERTINA</MudChip>
        </div>
        <div class="pa-2">
            <MudTextField T="string" @bind-Value="img.Titolo" @bind-Value:after="@(() => SaveCampi(img))"
                          Label="Titolo" Placeholder="Tooltip al passaggio del mouse" Variant="Variant.Text" Margin="Margin.Dense" FullWidth="true" Class="mb-1" />
            <MudTextField T="string" @bind-Value="img.AltText" @bind-Value:after="@(() => SaveCampi(img))"
                          Label="Testo alternativo" Placeholder="Per screen reader / SEO / fallback" Variant="Variant.Text" Margin="Margin.Dense" FullWidth="true" Class="mb-2" />
            <div class="d-flex justify-space-between">
                <MudTooltip Text="Imposta come copertina">
                    <MudIconButton Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SetPrincipale(img))" />
                </MudTooltip>
                <MudTooltip Text="Elimina">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteImmagine(img))" />
                </MudTooltip>
            </div>
        </div>
    </MudPaper>;

    RenderFragment<WebTourImmagine> CardTemplateDettaglio = img =>
    @<MudPaper Elevation="2" Class="img-card-row">
        <div class="d-flex">
            <div class="thumb-wrap-row">
                <img src="@img.Url" alt="@img.AltText" class="thumb-row" loading="lazy" />
            </div>
            <div class="pa-3 flex-grow-1 d-flex flex-column justify-space-between">
                <div>
                    <MudTextField T="string" @bind-Value="img.Titolo" @bind-Value:after="@(() => SaveCampi(img))"
                                  Label="Titolo" Placeholder="Tooltip al passaggio del mouse" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Class="mb-2" />
                    <MudTextField T="string" @bind-Value="img.AltText" @bind-Value:after="@(() => SaveCampi(img))"
                                  Label="Testo alternativo" Placeholder="Per screen reader / SEO / fallback" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                </div>
                <div class="d-flex justify-end gap-2 mt-2">
                    <MudTooltip Text="Imposta come copertina">
                        <MudIconButton Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small" OnClick="@(() => SetPrincipale(img))" />
                    </MudTooltip>
                    <MudTooltip Text="Elimina">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteImmagine(img))" />
                    </MudTooltip>
                </div>
            </div>
        </div>
    </MudPaper>;

    RenderFragment<WebTourImmagine> CardTemplateGriglia = img =>
    @<MudPaper Elevation="2" Class="img-card img-card-mini" Style="width:120px;">
        <div class="thumb-wrap">
            <img src="@img.Url" alt="@img.AltText" class="thumb" loading="lazy" />
            @if (img.Tipo == "principale")
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.Star" Class="badge-cover">COPERTINA</MudChip>
            }
        </div>
        <div class="d-flex justify-space-between pa-1">
            <MudTooltip Text="Imposta come copertina">
                <MudIconButton Icon="@(img.Tipo == "principale" ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                               Color="@(img.Tipo == "principale" ? Color.Primary : Color.Default)" Size="Size.Small"
                               OnClick="@(() => SetPrincipale(img))" />
            </MudTooltip>
            <MudTooltip Text="Elimina">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteImmagine(img))" />
            </MudTooltip>
        </div>
    </MudPaper>;

    <MudButtonGroup Class="mb-3" Color="Color.Primary">
        <MudButton Variant="@(!_vistaGriglia ? Variant.Filled : Variant.Outlined)" StartIcon="@Icons.Material.Filled.ViewAgenda" OnClick="@(() => _vistaGriglia = false)">Dettaglio</MudButton>
        <MudButton Variant="@(_vistaGriglia ? Variant.Filled : Variant.Outlined)" StartIcon="@Icons.Material.Filled.GridView" OnClick="@(() => _vistaGriglia = true)">Griglia</MudButton>
    </MudButtonGroup>

    <div class="d-flex align-center gap-3 mb-3">
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" @ref="_fileUpload" Accept="image/*" AppendMultipleFiles="false"
                       MaximumFileCount="30" MaxFileSize="20971520" FilesChanged="OnFilesSelected" Disabled="@_uploading">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@_uploading">
                    Carica immagini
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_immagini.Count immagini</MudText>
    </div>

    @if (_immagini.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-8 d-flex justify-center">
            <MudText Color="Color.Secondary">Nessuna immagine. Carica le foto del tour.</MudText>
        </MudPaper>
    }
    else
    {
        @if (!_vistaGriglia)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Applica a tutte le foto</MudText>
                <div class="d-flex gap-3 flex-wrap align-end">
                    <MudTextField T="string" @bind-Value="_masterTitolo" Label="Titolo (applica a tutte)"
                                  HelperText="Il titolo è usato come tooltip quando l'utente posiziona il mouse sopra l'immagine."
                                  Variant="Variant.Outlined" Style="min-width:280px;" />
                    <MudTextField T="string" @bind-Value="_masterAltText" Label="Testo alternativo (applica a tutte)"
                                  HelperText="Questo testo verrà usato da screen reader, motori di ricerca, oppure quando l'immagine non può essere caricata."
                                  Variant="Variant.Outlined" Style="min-width:280px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplicaATutte">Applica a tutte le foto</MudButton>
                </div>
            </MudPaper>
        }

        @if (_vistaGriglia)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                In vista Griglia i campi Titolo e Testo alternativo non sono modificabili. Passa alla vista <strong>Dettaglio</strong> per modificarli.
            </MudAlert>
            <div style="display:grid; grid-template-columns:repeat(auto-fill, 130px); gap:12px; justify-content:start;">
                @foreach (var img in _immagini.OrderByDescending(i => i.Tipo == "principale"))
                {
                    <div @key="img.WebTourImmagineId">
                        @CardTemplateGriglia(img)
                    </div>
                }
            </div>
        }
        else
        {
            if (copertina != null)
            {
                <div class="mb-4" @key="copertina.WebTourImmagineId">
                    @CardTemplateCopertina(copertina)
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Nessuna copertina impostata: scegline una con la stella ⭐</MudAlert>
            }

            <MudText Typo="Typo.subtitle2" Class="mb-2">@(copertina != null ? "Altre foto" : "Foto")</MudText>
            <div class="d-flex flex-column gap-4">
                @foreach (var img in altre)
                {
                    <div @key="img.WebTourImmagineId">
                        @CardTemplateDettaglio(img)
                    </div>
                }
            </div>
        }
    }
}
</div>

@code {
    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    /// <summary>Notifica al parent lo stato di completamento (semaforo): Completo se >=1 immagine + copertina impostata.</summary>
    [Parameter] public EventCallback<WebTabStato> StatoChanged { get; set; }

    private const long MaxUploadBytes = 20L * 1024 * 1024;

    private List<WebTourImmagine> _immagini = new();
    private bool _loading = true;
    private bool _uploading;
    private int _uploadCurrent;
    private int _uploadTotal;
    private bool _tabSetup;
    private bool _vistaGriglia;
    private bool _busy;
    private string? _masterTitolo;
    private string? _masterAltText;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUpload;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_tabSetup)
        {
            _tabSetup = true;
            try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); } catch { /* ignore */ }
        }
    }

    private async Task ReloadAsync()
    {
        _immagini = await ImmaginiService.ListByContenutoAsync(ContenutoId, AziendaId);
        await NotifyStatoAsync();
        StateHasChanged();
    }

    /// <summary>Vuoto se nessuna immagine; Parziale se immagini senza copertina; Completo se >=1 immagine + copertina.</summary>
    private Task NotifyStatoAsync()
    {
        var stato = _immagini.Count == 0
            ? WebTabStato.Vuoto
            : _immagini.Any(i => i.Tipo == "principale") ? WebTabStato.Completo : WebTabStato.Parziale;
        return StatoChanged.InvokeAsync(stato);
    }

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (files is null || files.Count == 0) return;
        _uploading = true;
        _uploadTotal = files.Count;
        _uploadCurrent = 0;
        var saltate = new List<string>();
        var errori = new List<string>();
        try
        {
            for (int i = 0; i < files.Count; i++)
            {
                var file = files[i];
                _uploadCurrent = i + 1;
                StateHasChanged();

                // Dedup per nome file (stesso contenuto): confronto case-insensitive, trim.
                var nomeFile = file.Name?.Trim() ?? string.Empty;
                if (_immagini.Any(x => string.Equals((x.NomeFile ?? string.Empty).Trim(), nomeFile, StringComparison.OrdinalIgnoreCase)))
                {
                    saltate.Add(nomeFile);
                    continue;
                }

                try
                {
                    // Copia in memoria: lo stream del browser è forward-only, ImageSharp preferisce seekable.
                    using var buffer = new MemoryStream();
                    await using (var src = file.OpenReadStream(MaxUploadBytes))
                        await src.CopyToAsync(buffer);
                    buffer.Position = 0;

                    var processed = await WebImageProcessor.ToOptimizedWebpAsync(buffer);
                    var storagePath = $"{AziendaId}/{ContenutoId}/{Guid.NewGuid():N}.webp";
                    using var upStream = new MemoryStream(processed.Bytes);
                    await Storage.UploadAsync(storagePath, upStream, processed.Mime);

                    var img = new WebTourImmagine
                    {
                        WebTourContenutoIdFk = ContenutoId, AziendaId = AziendaId, Tipo = "galleria",
                        StoragePath = storagePath, Url = Storage.BuildPublicUrl(storagePath),
                        Larghezza = processed.Width, Altezza = processed.Height, Mime = processed.Mime,
                        Ordine = _immagini.Count + 1, NomeFile = file.Name
                    };
                    img = await ImmaginiService.CreateAsync(img);
                    _immagini.Add(img);
                }
                catch (Exception ex)
                {
                    errori.Add($"{file.Name}: {ex.Message}");
                }
            }
            await NotifyStatoAsync();
            StateHasChanged();

            if (saltate.Count > 0)
            {
                var elenco = string.Join(", ", saltate.Take(5));
                if (saltate.Count > 5) elenco += $" e altre {saltate.Count - 5}";
                Snackbar.Add($"Saltate {saltate.Count} foto già presenti: {elenco}.", Severity.Warning);
            }
            if (errori.Count > 0)
            {
                var elenco = string.Join("; ", errori.Take(5));
                if (errori.Count > 5) elenco += $"; e altri {errori.Count - 5} errori";
                Snackbar.Add($"Errore su {errori.Count} foto: {elenco}", Severity.Error);
            }
        }
        finally
        {
            _uploading = false;
            try { if (_fileUpload != null) await _fileUpload.ClearAsync(); } catch { /* ignore */ }
        }
    }

    private async Task SetPrincipale(WebTourImmagine img)
    {
        _busy = true;
        StateHasChanged();
        try
        {
            await ImmaginiService.SetPrincipaleAsync(img.WebTourImmagineId, AziendaId, ContenutoId);
            foreach (var i in _immagini) i.Tipo = "galleria";
            img.Tipo = "principale";
            await NotifyStatoAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Errore copertina: {ex.Message}", Severity.Error); await ReloadAsync(); }
        finally { _busy = false; }
    }

    private async Task SaveCampi(WebTourImmagine img)
    {
        try { await ImmaginiService.UpdateAsync(img); }
        catch (Exception ex) { Snackbar.Add($"Errore salvataggio: {ex.Message}", Severity.Error); }
    }

    private async Task ApplicaATutte()
    {
        var titolo = _masterTitolo?.Trim();
        var altText = _masterAltText?.Trim();
        if (string.IsNullOrEmpty(titolo) && string.IsNullOrEmpty(altText))
        {
            Snackbar.Add("Compila almeno un campo.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.Title, "Applica a tutte" },
            { x => x.ContentText, $"Sovrascrivere titolo/testo alternativo di tutte le {_immagini.Count} foto?" },
            { x => x.ButtonText, "Applica" },
            { x => x.Color, Color.Primary }
        };
        var confirmDialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("Applica a tutte", parameters, new DialogOptions { BackdropClick = false });
        if ((await confirmDialog.Result)!.Canceled) return;

        foreach (var img in _immagini)
        {
            if (!string.IsNullOrEmpty(titolo)) img.Titolo = titolo;
            if (!string.IsNullOrEmpty(altText)) img.AltText = altText;
            try { await ImmaginiService.UpdateAsync(img); }
            catch (Exception ex) { Snackbar.Add($"Errore su una foto: {ex.Message}", Severity.Error); }
        }
        StateHasChanged();
    }

    private async Task DeleteImmagine(WebTourImmagine img)
    {
        if (!await ConfirmDelete("Elimina immagine", "Eliminare questa immagine?")) return;
        _busy = true;
        StateHasChanged();
        try
        {
            await ImmaginiService.DeleteAsync(img.WebTourImmagineId, AziendaId);
            try { await Storage.DeleteAsync(img.StoragePath); } catch { /* orfano storage tollerato */ }
            _immagini.Remove(img);
            for (int i = 0; i < _immagini.Count; i++) _immagini[i].Ordine = i + 1;
            if (_immagini.Count > 0)
                await ImmaginiService.ReorderAsync(AziendaId, ContenutoId, _immagini.Select(x => x.WebTourImmagineId).ToList());
            await NotifyStatoAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error); await ReloadAsync(); }
        finally { _busy = false; }
    }

    private async Task<bool> ConfirmDelete(string title, string message)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.Title, title },
            { x => x.ContentText, message }
        };
        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>(title, parameters, new DialogOptions { BackdropClick = false });
        return !(await dialog.Result)!.Canceled;
    }
}
