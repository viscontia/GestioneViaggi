@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Services.Printing
@using GestioneViaggi.Components.Shared
@using GestioneViaggi.Models.DTOs
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext
@inject ISessionManager SessionManager
@inject BilancioViaggioPrintService PrintService
@inject AnaViaggiService ViaggiService
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IPdfOpenerService PdfOpenerService

@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">

                @* RIGA 1: Azienda (se superadmin, solo in modalità menu) *@
                @if (_isSuperAdmin && !_modalitaViaggioPrefissato)
                {
                    <MudItem xs="12">
                        <AziendaSelect Value="@_filtroAziendaIdInt"
                                       ValueChanged="OnAziendaSelezionataChanged"
                                       Label="Azienda"
                                       Clearable="true" />
                    </MudItem>
                }

                @* BANNER info: filtro attivo sui viaggi con movimenti (solo modalità menu) *@
                @if (!_modalitaViaggioPrefissato)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Info">
                            Sono visibili solo i Viaggi che hanno dei movimenti contabili.
                        </MudAlert>
                    </MudItem>
                }

                @* BANNER warning: nessun viaggio con movimenti *@
                @if (_nessunViaggioDisponibile)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.WarningAmber">
                            @_messaggioBanner
                        </MudAlert>
                    </MudItem>
                }

                @* RIGA 2: Selezione Viaggio *@
                <MudItem xs="12">
                    <ViaggioSelect @bind-SelectedViaggioId="_selectedViaggioId"
                                   AziendaId="@_aziendaIdEffettivo"
                                   Label="Seleziona Viaggio *"
                                   FilterOnlyWithTransactions="@(!_modalitaViaggioPrefissato)"
                                   Disabled="@(_nessunViaggioDisponibile || _modalitaViaggioPrefissato)"
                                   Required="true"
                                   Clearable="false" />
                </MudItem>

                @* RIGA 3: Selezione Data Viaggio *@
                <MudItem xs="12">
                    <DataViaggioBilancioSelect @bind-SelectedDataViaggioId="_selectedDataViaggioId"
                                               ViaggioId="@_selectedViaggioId"
                                               Label="Data Viaggio *"
                                               Disabled="@_nessunViaggioDisponibile"
                                               Required="true"
                                               Clearable="true" />
                    <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1 d-block">
                        Sono visualizzate solo le date in cui ci sono movimenti contabili.
                    </MudText>
                </MudItem>

                @* RIGA 4: Selezione Valuta Report (Opzionale) *@
                <MudItem xs="12">
                    <ValutaSelect SelectedValutaId="_selectedValutaId"
                                  SelectedValutaIdChanged="@(val => _selectedValutaId = val)"
                                  Label="Valuta Report (Default: Valuta Utente)"
                                  Clearable="true" />
                </MudItem>

                @* RIGA 5: Periodo (Opzionale) *@
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Documento Da (Opzionale)" @bind-Date="_dataDa"
                                   Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data Documento A (Opzionale)" @bind-Date="_dataA"
                                   Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        @if (!_modalitaViaggioPrefissato)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterListOff" OnClick="ResetFiltri">
                Reset
            </MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print"
                   OnClick="EseguiStampa" Disabled="@_nessunViaggioDisponibile">
            Stampa
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;

    // Parametri di apertura
    [Parameter] public int? InitialViaggioId { get; set; }
    [Parameter] public int? InitialAziendaId { get; set; }

    // Sessione e tenant
    private bool _isSuperAdmin;
    private int? _currentAziendaId;
    private int _aziendaIdEffettivo => _isSuperAdmin ? (_filtroAziendaId ?? 0) : (_currentAziendaId ?? 0);

    // Filtri
    private int _filtroAziendaIdInt;
    private int? _filtroAziendaId => _filtroAziendaIdInt > 0 ? _filtroAziendaIdInt : null;

    private int? _selectedViaggioId;
    private int? _selectedDataViaggioId;
    private int _selectedValutaId;

    private DateTime? _dataDa;
    private DateTime? _dataA;

    // Stato UI
    private bool _nessunViaggioDisponibile;
    private string _messaggioBanner = string.Empty;

    // True = aperto da DataGrid con viaggio specifico; False = aperto da menu
    private bool _modalitaViaggioPrefissato => InitialViaggioId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _isSuperAdmin = await TenantContext.IsSuperAdminAsync();

        var sessionData = await SessionManager.GetSessionAsync();
        if (sessionData?.User?.ValutaDefaultId > 0)
            _selectedValutaId = sessionData.User.ValutaDefaultId.Value;

        if (_isSuperAdmin && InitialAziendaId.HasValue && InitialAziendaId.Value > 0)
        {
            // Superadmin da DataGrid: pre-imposta l'azienda del viaggio selezionato
            _filtroAziendaIdInt = InitialAziendaId.Value;
        }
        else if (!_isSuperAdmin)
        {
            _currentAziendaId = await TenantContext.GetCurrentAziendaIdAsync();
        }

        if (_modalitaViaggioPrefissato)
        {
            // Da DataGrid: pre-seleziona il viaggio e verifica se ha movimenti
            _selectedViaggioId = InitialViaggioId!.Value;
            await VerificaViaggioPrefissatoAsync(InitialViaggioId.Value);
        }
        else
        {
            // Da menu: verifica se esistono viaggi con movimenti per l'azienda
            if (!_isSuperAdmin)
                await VerificaViaggiDisponibiliAsync();
        }
    }

    /// <summary>
    /// Scenario da DataGrid: verifica se il viaggio specifico ha movimenti contabili.
    /// </summary>
    private async Task VerificaViaggioPrefissatoAsync(int viaggioId)
    {
        try
        {
            var aziendaId = _aziendaIdEffettivo > 0 ? (int?)_aziendaIdEffettivo : null;
            var viaggiConMovimenti = await ViaggiService.GetViaggiWithTransactionsAsync(aziendaId);
            if (!viaggiConMovimenti.Any(v => v.Id == viaggioId))
            {
                _nessunViaggioDisponibile = true;
                _messaggioBanner = "Il viaggio selezionato non ha movimenti contabili. Non è possibile generare il bilancio.";
            }
        }
        catch
        {
            _nessunViaggioDisponibile = false;
        }
    }

    /// <summary>
    /// Scenario da menu: verifica se esistono viaggi con movimenti per l'azienda.
    /// </summary>
    private async Task VerificaViaggiDisponibiliAsync()
    {
        try
        {
            var aziendaId = _aziendaIdEffettivo > 0 ? (int?)_aziendaIdEffettivo : null;
            var viaggi = await ViaggiService.GetViaggiWithTransactionsAsync(aziendaId);
            if (!viaggi.Any())
            {
                _nessunViaggioDisponibile = true;
                _messaggioBanner = "Non è possibile generare il Bilancio Viaggio: non esistono movimenti contabili per i viaggi di questa azienda.";
            }
        }
        catch
        {
            _nessunViaggioDisponibile = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); }
            catch { }
        }
    }

    public void Dispose()
    {
        try { ((IJSInProcessRuntime)JS).InvokeVoid("dialogFormHelper.cleanup"); }
        catch { }
    }

    private void Cancel() => MudDialog.Cancel();

    private void ResetFiltri()
    {
        _filtroAziendaIdInt = 0;
        _selectedViaggioId = null;
        _selectedDataViaggioId = null;
        _selectedValutaId = 0;
        _dataDa = null;
        _dataA = null;
        _nessunViaggioDisponibile = false;
        _messaggioBanner = string.Empty;
        StateHasChanged();
    }

    private async Task OnAziendaSelezionataChanged(int newValue)
    {
        _filtroAziendaIdInt = newValue;
        _selectedViaggioId = null;
        _selectedDataViaggioId = null;
        _nessunViaggioDisponibile = false;
        _messaggioBanner = string.Empty;
        if (newValue > 0)
            await VerificaViaggiDisponibiliAsync();
        StateHasChanged();
    }

    private bool ValidaFiltri()
    {
        if (!_selectedViaggioId.HasValue || _selectedViaggioId <= 0)
        {
            Snackbar.Add("Selezionare un viaggio", Severity.Warning);
            return false;
        }

        if (!_selectedDataViaggioId.HasValue || _selectedDataViaggioId <= 0)
        {
            Snackbar.Add("Selezionare una data viaggio", Severity.Warning);
            return false;
        }

        if (_dataDa.HasValue && _dataA.HasValue && _dataDa > _dataA)
        {
            Snackbar.Add("La data inizio non può essere superiore alla data fine", Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task EseguiStampa()
    {
        if (!ValidaFiltri()) return;

        try
        {
            var sessionData = await SessionManager.GetSessionAsync();
            if (sessionData?.User == null)
            {
                Snackbar.Add("Errore sessione utente", Severity.Error);
                return;
            }

            Snackbar.Add("Generazione report in corso...", Severity.Info);

            var printData = await PrintService.GetBilancioPrintDataAsync(
                _aziendaIdEffettivo,
                _selectedViaggioId!.Value,
                _selectedDataViaggioId,
                _dataDa,
                _dataA,
                sessionData.User.Username ?? "Utente",
                _selectedValutaId > 0 ? _selectedValutaId : sessionData.User.ValutaDefaultId
            );

            if (!printData.Dettagli.Any())
            {
                Snackbar.Add("Nessun documento contabile trovato per i criteri selezionati. Stampa annullata.", Severity.Warning);
                return;
            }

            var pdfBytes = await PrintService.GeneratePdfAsync(printData);

            var targetFolder = PdfOpenerService.GetPdfOutputFolder();
            var fileName = $"Bilancio_Viaggi_{DateTime.Now:yyyyMMddHHmmss}.pdf";
            var outputPath = Path.Combine(targetFolder, fileName);

            if (System.IO.File.Exists(outputPath)) System.IO.File.Delete(outputPath);
            await System.IO.File.WriteAllBytesAsync(outputPath, pdfBytes);
            await PdfOpenerService.OpenPdfAsync(outputPath, "Stampa Completata");

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore generazione PDF: {ex.Message}", Severity.Error);
        }
    }
}
