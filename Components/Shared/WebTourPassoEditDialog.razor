@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using GestioneViaggi.Services.CRUD
@using Blazored.TextEditor
@using MudBlazor
@inject WebTourImmaginiService ImmaginiService
@inject UserPreferenzeService Prefs

@* Editor di un passo dell'itinerario (Blocco 6, + picker immagine Blocco 7). Quill on-demand.
   ECCEZIONE UI: testo e didascalia NON in maiuscolo forzato (destinati al sito). *@

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_titoloGiornata" Label="Titolo della giornata" Immediate="true"
                      Placeholder="es. GIORNO 3 : Dorgali - Baunei - Arbatax" Variant="Variant.Outlined" Class="mb-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-1">Testo del passaggio</MudText>
        <div class="passo-editor" style="height:240px; border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column;">
            <BlazoredTextEditor @ref="_editor" Placeholder="Descrivi questo momento della giornata...">
                <ToolbarContent>
                    <select class="ql-header">
                        <option selected=""></option>
                        <option value="3"></option>
                    </select>
                    <span class="ql-formats">
                        <button class="ql-bold"></button>
                        <button class="ql-italic"></button>
                        <button class="ql-underline"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered"></button>
                        <button class="ql-list" value="bullet"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-link"></button>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-clean"></button>
                    </span>
                </ToolbarContent>
            </BlazoredTextEditor>
        </div>

        <!-- Immagine dalla galleria (Blocco 7) -->
        <div class="d-flex justify-space-between align-center flex-wrap mt-4 mb-1">
            <MudText Typo="Typo.subtitle2">Immagine (dalla galleria del viaggio)</MudText>
            @if (_galleria.Count > 0)
            {
                <div class="d-flex align-center gap-2" style="min-width:220px; max-width:300px;">
                    <MudText Typo="Typo.caption" Style="white-space:nowrap;">Dimensione miniature</MudText>
                    <MudSlider T="int" Min="96" Max="400" Step="8" Value="_thumbSize" ValueChanged="OnThumbSizeChanged" />
                </div>
            }
        </div>
        @if (_galleria.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nessuna immagine in galleria. Caricane dal tab "Galleria".</MudText>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2" style="max-height:@(MaxPickerHeight)px; overflow-y:auto;">
                <MudPaper Elevation="0" Class="pa-1 d-flex flex-column align-center justify-center"
                          Style="@($"{ThumbStyle(null)}border-style:dashed;background:var(--mud-palette-background-grey);")" @onclick="@(() => Select(null))">
                    <MudIcon Icon="@Icons.Material.Outlined.HideImage" Size="Size.Small"
                             Color="@(_selectedStoragePath is null ? Color.Primary : Color.Default)" />
                    <MudText Typo="Typo.caption" Class="mt-1">Nessuna</MudText>
                </MudPaper>
                @foreach (var img in _galleria)
                {
                    <MudPaper Elevation="@(_selectedStoragePath == img.StoragePath ? 4 : 0)" Class="pa-0"
                              Style="@ThumbStyle(img.StoragePath)" @onclick="@(() => Select(img))">
                        <img src="@img.Url" alt="@img.AltText" style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    </MudPaper>
                }
            </div>
        }

        <MudTextField @bind-Value="_didascalia" Label="Didascalia immagine (opzionale)" Variant="Variant.Outlined"
                      MaxLength="255" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salva" Disabled="@_saving">
            @(_saving ? "Salvataggio..." : "Salva passaggio")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* Editor Quill del passaggio: deve scrollare verticalmente sui testi lunghi.
       Regole globali perché gli elementi .ql-* sono creati da Quill via JS
       (il CSS scoped non li raggiunge). Vincolo l'altezza del container così
       .ql-editor (height:100% + overflow-y:auto di default) può scrollare. */
    .passo-editor .ql-toolbar { flex: 0 0 auto; }
    .passo-editor .ql-container { flex: 1 1 auto; min-height: 0; }
    .passo-editor .ql-editor { overflow-y: auto; }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Passo da modificare (i valori vengono applicati solo al Salva).</summary>
    [Parameter, EditorRequired] public WebTourItinerarioPassaggio Passo { get; set; } = default!;
    [Parameter, EditorRequired] public long ContenutoId { get; set; }
    [Parameter, EditorRequired] public int AziendaId { get; set; }
    /// <summary>Giornata a cui appartiene il passaggio: consente di modificarne il titolo dalla modale.</summary>
    [Parameter, EditorRequired] public WebTourItinerario Giornata { get; set; } = default!;

    private BlazoredTextEditor _editor = default!;
    private string? _didascalia;
    private string? _titoloGiornata;
    private bool _saving;
    private bool _htmlLoaded;

    private List<WebTourImmagine> _galleria = new();
    private string? _selectedStoragePath;
    private string? _selectedUrl;

    /// <summary>Chiave preferenza utente "nascosta" (sys_utente_preferenze), condivisa con WebTourGalleriaTab.</summary>
    private const string ThumbSizePrefKey = "galleria.thumb_size";
    private int _thumbSize = 120;
    private int MaxPickerHeight => _thumbSize + 60;

    protected override async Task OnInitializedAsync()
    {
        _titoloGiornata = Giornata?.TitoloGiornata;
        _didascalia = Passo.ImmagineDidascalia;
        _selectedStoragePath = Passo.ImmagineStoragePath;
        _selectedUrl = Passo.ImmagineUrl;
        try { _galleria = await ImmaginiService.ListByContenutoAsync(ContenutoId, AziendaId); }
        catch { _galleria = new(); }

        var pref = await Prefs.GetAsync(ThumbSizePrefKey);
        if (int.TryParse(pref, out var savedThumbSize))
        {
            _thumbSize = Math.Clamp(savedThumbSize, 96, 400);
        }
    }

    private async Task OnThumbSizeChanged(int value)
    {
        _thumbSize = value;
        await Prefs.SetAsync(ThumbSizePrefKey, value.ToString());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_htmlLoaded)
        {
            _htmlLoaded = true;
            for (var attempt = 0; attempt < 3; attempt++)
            {
                try
                {
                    await Task.Delay(150); // Quill si inizializza async
                    if (!string.IsNullOrWhiteSpace(Passo.TestoHtml))
                        await _editor.LoadHTMLContent(Passo.TestoHtml);
                    break;
                }
                catch when (attempt < 2) { /* riprova */ }
            }
        }
    }

    private void Select(WebTourImmagine? img)
    {
        _selectedStoragePath = img?.StoragePath;
        _selectedUrl = img?.Url;
    }

    private string ThumbStyle(string? storagePath)
    {
        var selected = _selectedStoragePath == storagePath;
        var border = selected ? "2px solid var(--mud-palette-primary)" : "1px solid var(--mud-palette-lines-default)";
        var height = (int)Math.Round(_thumbSize * 0.75);
        return $"width:{_thumbSize}px;height:{height}px;overflow:hidden;cursor:pointer;border:{border};border-radius:4px;";
    }

    private async Task Salva()
    {
        _saving = true;
        try
        {
            if (Giornata != null && !string.IsNullOrWhiteSpace(_titoloGiornata)) Giornata.TitoloGiornata = _titoloGiornata.Trim();
            Passo.TestoHtml = NormalizeHtml(await _editor.GetHTML()) ?? string.Empty;
            Passo.ImmagineDidascalia = string.IsNullOrWhiteSpace(_didascalia) ? null : _didascalia.Trim();
            Passo.ImmagineStoragePath = _selectedStoragePath;
            Passo.ImmagineUrl = _selectedUrl;
            MudDialog.Close(DialogResult.Ok(Passo));
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Quill "vuoto" restituisce &lt;p&gt;&lt;br&gt;&lt;/p&gt;: normalizza a NULL.</summary>
    private static string? NormalizeHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var stripped = html.Replace("<p><br></p>", string.Empty).Replace("<p></p>", string.Empty).Trim();
        return stripped.Length == 0 ? null : html;
    }
}
