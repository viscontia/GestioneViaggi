@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AziendaLogoService LogoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<div class="pa-4">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Loghi Aziendali</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Small"
                       OnClick="@(() => OpenLogoDialog(null))">
                Nuovo Logo
            </MudButton>
        </MudStack>

        <MudTable Items="@_logos" Dense="true" Hover="true" Striped="true" Class="enterprise-grid" FixedHeader="false" Height="auto">
            <HeaderContent>
                <MudTh>Tipo</MudTh>
                <MudTh>Variante</MudTh>
                <MudTh>File</MudTh>
                <MudTh>Dimensione</MudTh>
                <MudTh Style="text-align: center;">Predefinito</MudTh>
                <MudTh Style="text-align: center;">Attivo</MudTh>
                <MudTh Style="text-align: center; width: 100px;">Azioni</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tipo">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.LogoType.ToUpper()</MudChip>
                </MudTd>
                <MudTd DataLabel="Variante">@(context.LogoVariant ?? "-")</MudTd>
                <MudTd DataLabel="File">
                    <strong>@context.FileName</strong>
                    <br />
                    <small class="mud-text-secondary">@context.FileFormat.ToUpper() - @FormatFileSize(context.FileSizeBytes)</small>
                </MudTd>
                <MudTd DataLabel="Dimensione">
                    @if (context.ImageWidth.HasValue && context.ImageHeight.HasValue)
                    {
                        <span>@context.ImageWidth x @context.ImageHeight px</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </MudTd>
                <MudTd DataLabel="Predefinito" Style="text-align: center;">
                    <MudIcon Icon="@(context.IsDefault ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)"
                             Color="@(context.IsDefault ? Color.Warning : Color.Default)" />
                </MudTd>
                <MudTd DataLabel="Attivo" Style="text-align: center;">
                    <MudIcon Icon="@(context.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(context.IsActive ? Color.Success : Color.Error)" />
                </MudTd>
                <MudTd DataLabel="Azioni" Style="text-align: center;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Warning"
                                   OnClick="@(() => OpenLogoDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteLogo(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_logos.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                Nessun logo caricato.
            </MudAlert>
        }
    }
</div>

@code {
    [Parameter]
    public int AziendaId { get; set; }

    [Parameter]
    public EventCallback OnDataChanged { get; set; }

    private List<AziendaLogo> _logos = new();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (AziendaId > 0)
        {
            await LoadLogosAsync();
        }
    }

    private async Task LoadLogosAsync()
    {
        _loading = true;
        try
        {
            _logos = await LogoService.GetByAziendaIdAsync(AziendaId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento loghi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatFileSize(int bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task OpenLogoDialog(AziendaLogo? logo)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim == null || !Guid.TryParse(userIdClaim.Value, out var currentUserId))
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Errore: Utente non autenticato", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Entity"] = logo?.Clone() ?? new AziendaLogo { AziendaIdFk = AziendaId },
            ["IsEditMode"] = logo != null,
            ["AziendaId"] = AziendaId,
            ["CurrentUserId"] = currentUserId
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<AziendaLogoDialog>(
            logo == null ? "Nuovo Logo Aziendale" : "Modifica Logo Aziendale",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is { Canceled: false, Data: AziendaLogo updatedLogo })
        {
            try
            {
                if (logo == null)
                {
                    await LogoService.CreateAsync(updatedLogo);
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                    Snackbar.Add("Logo aziendale caricato con successo", Severity.Success);
                }
                else
                {
                    updatedLogo.Id = logo.Id;
                    updatedLogo.UpdatedBy = currentUserId;
                    await LogoService.UpdateAsync(updatedLogo);
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                    Snackbar.Add("Logo aziendale aggiornato con successo", Severity.Success);
                }

                await LoadLogosAsync();
                await OnDataChanged.InvokeAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteLogo(AziendaLogo logo)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Conferma Eliminazione",
            $"Confermi l'eliminazione del logo '{logo.FileName}'?",
            yesText: "Elimina",
            cancelText: "Annulla");

        if (result == true)
        {
            try
            {
                await LogoService.DeleteAsync(logo.Id);
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add("Logo aziendale eliminato con successo", Severity.Success);
                await LoadLogosAsync();
                await OnDataChanged.InvokeAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add($"Errore durante l'eliminazione: {ex.Message}", Severity.Error);
            }
        }
    }
}
