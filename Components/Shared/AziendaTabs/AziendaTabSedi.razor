    /* Success - Operativa */
    .mud-theme-dark .mud-chip.mud-chip-color-success {
        background-color: rgba(52, 211, 153, 0.2) !important;
        color: #6EE7B7 !important;
        border: 1px solid rgba(52, 211, 153, 0.3) !important;
    }
    
    /* Warning - Magazzino */
    .mud-theme-dark .mud-chip.mud-chip-color-warning {
