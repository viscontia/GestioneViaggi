@using GestioneViaggi.Models
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Services.Shared.Storage
@using GestioneViaggi.Services.Web
@using MudBlazor
@inject WebSitoContenutiService SitoService
@inject WebImmaginiLibreriaService LibreriaService
@inject AziendaEmailService EmailService
@inject ISessionManager SessionManager
@inject ISnackbar Snackbar
@implements IDisposable

@* Scheda «Sito web» dell'azienda (voce L28, script 692). Ciò che il sito pubblico mostra e che
   decide il titolare: qui, non nel codice del sito (il prodotto serve più tour operator).
   Sotto-schede: Home (Tappa 4A del sito), Chi siamo e FAQ (4C, script 703 e 704), Testi legali (4B).
   Ogni salvataggio aggiorna il sito da solo entro 1–2 minuti (coda di rigenerazione). *@

<MudTabs Elevation="0" Rounded="true" PanelClass="pt-3" Border="false">
    <MudTabPanel Text="Home" Icon="@Icons.Material.Filled.Home">
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            <div style="max-width:760px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    L'apertura della home del sito e il blocco «In evidenza». I testi si scrivono in italiano e si
                    traducono con il riquadro «Lingue» in fondo. Dopo il salvataggio il sito si aggiorna entro 1–2 minuti.
                </MudText>

                @* — Apertura — *@
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Apertura della home</MudText>

                    @* Foto e video (698): si scelgono qui e vanno al sito con «Aggiorna», come i testi. *@
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Foto d'apertura</MudText>
                    @if (FotoMostrata is { } fm)
                    {
                        <ArchivioSrc Url="@fm.Src" Context="url"><img src="@url" alt="Foto d'apertura"
                             style="max-width:100%; max-height:220px; border-radius:6px; display:block;" class="mb-1" /></ArchivioSrc>
                        <MudText Typo="Typo.caption" Color="@(fm.Larghezza is < 1600 ? Color.Warning : Color.Secondary)">
                            @fm.Nota
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nessuna foto: la home mostra il motto su fondo blu.</MudText>
                    }
                    <div class="d-flex gap-2 mt-2 mb-3">
                        <FileUploader Accept="image/*" MaxByte="@MaxFotoBytes" MostraAttesa="false"
                                      EstensioniAmmesse="@(new[] { ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif" })"
                                      OnFile="@ScegliFoto">
                            <Attivatore>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Image">Scegli foto</MudButton>
                            </Attivatore>
                        </FileUploader>
                        @if (FotoMostrata is not null)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@TogliFoto">Togli foto</MudButton>
                        }
                    </div>

                    <MudText Typo="Typo.subtitle2" Class="mb-1">Video d'apertura (facoltativo)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1" Style="display:block;">
                        Gira sotto il motto, muto e in ripetizione; la foto resta come copertina (mentre il video si carica, e per chi
                        ha chiesto di ridurre le animazioni). Va bene anche il video del telefono: il gestionale lo prepara da solo
                        (primi @((int)WebVideoProcessor.MaxSecondi) secondi, senza audio). Meglio 10–20 secondi.
                    </MudText>
                    @if (VideoMostrato is { } vm)
                    {
                        <ArchivioSrc Url="@vm.Src" Context="url"><video src="@url" muted autoplay loop playsinline
                               style="max-width:100%; max-height:220px; border-radius:6px; display:block;" class="mb-1"></video></ArchivioSrc>
                        <MudText Typo="Typo.caption" Color="@(vm.Avviso ? Color.Warning : Color.Secondary)">@vm.Nota</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nessun video: la home mostra la foto.</MudText>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <FileUploader Accept="video/*" MaxByte="@MaxVideoBytes" MostraAttesa="false" Disabilitato="@_preparoVideo"
                                      EstensioniAmmesse="@(new[] { ".mov", ".mp4", ".m4v" })"
                                      MessaggioEstensione="Video ammessi: MOV o MP4 (come quelli del telefono)."
                                      OnFile="@ScegliVideo">
                            <Attivatore>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Movie" Disabled="@_preparoVideo">
                                    @(_preparoVideo ? "Preparo il video…" : "Scegli video")
                                </MudButton>
                            </Attivatore>
                        </FileUploader>
                        @if (_preparoVideo)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        }
                        @if (VideoMostrato is not null && !_preparoVideo)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@TogliVideo">Togli video</MudButton>
                        }
                    </div>

                    <MudTextField T="string" Label="Motto" Value="@Stato.Bozza.Motto"
                                  ValueChanged="@(v => { Stato.Bozza.Motto = v; Cambiato(); })" Immediate="true"
                                  Variant="Variant.Outlined" MaxLength="@WebSitoContenuti.MaxMotto" Counter="@WebSitoContenuti.MaxMotto"
                                  HelperText="Il titolo grande della home. L'ultima parola si colora in arancio." Class="mt-3" />
                    <MudTextField T="string" Label="Titolo" Value="@Stato.Bozza.TitoloHome"
                                  ValueChanged="@(v => { Stato.Bozza.TitoloHome = v; Cambiato(); })" Immediate="true"
                                  Variant="Variant.Outlined" Lines="2" MaxLength="@WebSitoContenuti.MaxTitoloHome" Counter="@WebSitoContenuti.MaxTitoloHome"
                                  HelperText="Sotto il motto, più piccolo. Una o due frasi." Class="mt-2" />
                    <MudTextField T="string" Label="Sottotitolo (facoltativo)" Value="@Stato.Bozza.SottotitoloHome"
                                  ValueChanged="@(v => { Stato.Bozza.SottotitoloHome = v; Cambiato(); })" Immediate="true"
                                  Variant="Variant.Outlined" Lines="2" MaxLength="@WebSitoContenuti.MaxSottotitoloHome" Counter="@WebSitoContenuti.MaxSottotitoloHome"
                                  HelperText="Sotto il titolo. Vuoto = non si mostra." Class="mt-2" />
                </MudPaper>

                @* — Messaggi del sito — *@
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Messaggi dal sito</MudText>
                    <MudSelect T="int?" Label="Email che riceve i messaggi del modulo Contatti" Value="@Stato.Bozza.EmailMessaggiFk"
                               ValueChanged="@(v => { Stato.Bozza.EmailMessaggiFk = v; Cambiato(); })"
                               Variant="Variant.Outlined"
                               HelperText="Chi scrive dal sito riceve la risposta da questo indirizzo. Le email si gestiscono nella scheda «Email».">
                        <MudSelectItem T="int?" Value="@((int?)null)">L'email principale@(_principale is null ? "" : $" ({_principale})")</MudSelectItem>
                        @foreach (var e in _email)
                        {
                            <MudSelectItem T="int?" Value="@((int?)e.Id)">@e.Email@(e.IsPrincipale ? " (principale)" : "")</MudSelectItem>
                        }
                    </MudSelect>
                </MudPaper>

                @* — In evidenza — *@
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">In evidenza</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Un blocco della home con fino a 3 tour scelti (per esempio quelli di Capodanno). Un tour che non è più
                        pubblicato sparisce da solo dal sito; senza tour il blocco non si mostra.
                    </MudText>
                    <MudTextField T="string" Label="Titolo del blocco" Value="@Stato.Bozza.EvidenzaTitolo"
                                  ValueChanged="@(v => { Stato.Bozza.EvidenzaTitolo = v; Cambiato(); })" Immediate="true"
                                  Variant="Variant.Outlined" MaxLength="@WebSitoContenuti.MaxEvidenzaTitolo"
                                  Counter="@WebSitoContenuti.MaxEvidenzaTitolo" Class="mb-2" />

                    @for (var i = 0; i < Stato.Evidenza.Count; i++)
                    {
                        var pos = i;
                        var id = Stato.Evidenza[pos];
                        <div class="d-flex align-center gap-1 mb-1">
                            <MudText Typo="Typo.body2" Style="min-width:1.5em;">@(pos + 1).</MudText>
                            <MudText Typo="Typo.body2" Class="flex-grow-1">@NomeTour(id)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(pos == 0)"
                                           OnClick="@(() => Sposta(pos, -1))" title="Sposta su" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(pos == Stato.Evidenza.Count - 1)"
                                           OnClick="@(() => Sposta(pos, 1))" title="Sposta giù" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => { Stato.Evidenza.RemoveAt(pos); Cambiato(); })" title="Togli" />
                        </div>
                    }

                    @if (Stato.Evidenza.Count < 3)
                    {
                        <MudSelect T="long?" Label="Aggiungi un tour" Value="@((long?)null)" ValueChanged="@Aggiungi"
                                   Variant="Variant.Outlined" Dense="true" Class="mt-2"
                                   Disabled="@(!TourDisponibili.Any())"
                                   HelperText="@(TourDisponibili.Any() ? "Solo i tour pubblicati con partenza futura (quelli che il sito mostra)." : "Non ci sono altri tour pubblicati da aggiungere.")">
                            @foreach (var t in TourDisponibili)
                            {
                                <MudSelectItem T="long?" Value="@((long?)t.ContenutoId)">@t.Etichetta</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Al massimo 3 tour: per aggiungerne un altro, togline uno.</MudText>
                    }
                </MudPaper>

                <div class="d-flex align-center gap-2 mb-3">
                    @if (Stato.Modificata)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">Modifiche non salvate: si salvano con «Aggiorna».</MudText>
                    }
                    else if (Stato.Salvato.Updated is { } u)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Salvato il @u.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(string.IsNullOrEmpty(Stato.Salvato.UpdatedBy) ? "" : $" da {Stato.Salvato.UpdatedBy}")
                        </MudText>
                    }
                </div>

                <TraduzioniPanel AziendaId="@AziendaId"
                                 Elementi="@WebSitoContenutiService.ElementiHome(Stato.Salvato)"
                                 Revisione="@_revisione"
                                 InAttesaDiSalvataggio="@Stato.Modificata"
                                 PrimaDiTradurre="@(() => SalvaPerTradurre(WebSitoContenutiService.ElementiHome))"
                                 SpiegaPrimaDiTradurre="@(Stato.Modificata ? "Salva le modifiche e poi traduce." : null)"
                                 Nota="Si traducono motto, titolo, sottotitolo e titolo «In evidenza». I titoli dei tour si traducono nella loro scheda web." />
            </div>
        }
    </MudTabPanel>

    @* Chi siamo (pezzo 4C, script 703): testo e due foto facoltative (1 in cima, 2 a metà testo). Testo vuoto = la
       pagina non c'è (le foto da sole non bastano). Le foto si caricano come quella della home, all'«Aggiorna». *@
    <MudTabPanel Text="Chi siamo" Icon="@Icons.Material.Filled.Groups">
        @if (!_loading)
        {
            <div style="max-width:900px;">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    La pagina «Chi siamo» del sito, con la voce nel menu. Testo vuoto = la pagina non c'è. Le foto sono
                    facoltative: la prima va in cima, grande; la seconda a metà del testo.
                </MudAlert>
                <div class="d-flex flex-wrap gap-4 mb-3">
                    @for (var i = 0; i < 2; i++)
                    {
                        var pos = i;
                        <div style="width:300px;">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">@(pos == 0 ? "Foto in cima" : "Foto a metà testo")</MudText>
                            @if (FotoChiSiamoMostrata(pos) is { } fm)
                            {
                                <ArchivioSrc Url="@fm.Src" Context="url"><img src="@url" alt="@(pos == 0 ? "Foto in cima" : "Foto a metà testo")"
                                     style="max-width:100%; max-height:180px; border-radius:6px; display:block;" class="mb-1" /></ArchivioSrc>
                                <MudText Typo="Typo.caption" Color="@(pos == 0 && fm.Larghezza is < 1600 ? Color.Warning : Color.Secondary)">@fm.Nota</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Nessuna foto.</MudText>
                            }
                            <div class="d-flex gap-2 mt-2">
                                <FileUploader Accept="image/*" MaxByte="@MaxFotoBytes" MostraAttesa="false"
                                              EstensioniAmmesse="@(new[] { ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif" })"
                                              OnFile="@(f => ScegliFotoChiSiamo(pos, f))">
                                    <Attivatore>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Image">Scegli foto</MudButton>
                                    </Attivatore>
                                </FileUploader>
                                @if (FotoChiSiamoMostrata(pos) is not null)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => TogliFotoChiSiamo(pos))">Togli foto</MudButton>
                                }
                            </div>
                        </div>
                    }
                </div>
                <style>.editor-html-bozza .ql-editor { max-height: 360px; overflow-y: auto; }</style>
                <div class="d-flex align-center mb-1">
                    <MudText Typo="Typo.subtitle2">Testo</MudText>
                    @if (Stato.Salvato.ChiSiamoAggiornato is { } a)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">— ultimo aggiornamento sul sito: @a.ToLocalTime().ToString("dd/MM/yyyy")</MudText>
                    }
                </div>
                <EditorHtmlBozza Testo="@Stato.Bozza.ChiSiamo" TestoChanged="@(v => { Stato.Bozza.ChiSiamo = v; Cambiato(); })"
                                 Placeholder="Chi siete, da quando organizzate viaggi, le guide, il modo di viaggiare…" />
                <TraduzioniPanel AziendaId="@AziendaId" Class="mt-4"
                                 Elementi="@WebSitoContenutiService.ElementiChiSiamo(Stato.Salvato)"
                                 Revisione="@_revisione"
                                 InAttesaDiSalvataggio="@Stato.Modificata"
                                 PrimaDiTradurre="@(() => SalvaPerTradurre(WebSitoContenutiService.ElementiChiSiamo))"
                                 SpiegaPrimaDiTradurre="@(Stato.Modificata ? "Salva le modifiche e poi traduce." : null)"
                                 Nota="Si traduce il testo di Chi siamo." />
            </div>
        }
    </MudTabPanel>

    @* FAQ (pezzo 4C, script 704): gruppi con le loro domande, nell'ordine. Sul sito vanno solo le domande attive e con
       risposta; un gruppo senza domande così non si vede, e senza nessuna la pagina non c'è. Tutto si salva con
       «Aggiorna» (l'elenco intero: ciò che si toglie qui si cancella, con le sue traduzioni). L'editor di una risposta
       si apre solo quando serve: trenta editor aperti insieme renderebbero la scheda pesante. *@
    <MudTabPanel Text="FAQ" Icon="@Icons.Material.Filled.QuestionAnswer">
        @if (!_loading)
        {
            <div style="max-width:900px;">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Le domande frequenti del sito, divise in gruppi (per esempio «Prima di partire», «Mezzi e attrezzatura»),
                    con il link nel piede. Sul sito vanno solo le domande <b>attive</b> e con la risposta; un gruppo senza
                    domande così non si vede, e senza nessuna la pagina non c'è.
                </MudAlert>
                <style>.editor-html-bozza .ql-editor { max-height: 360px; overflow-y: auto; }</style>
                @for (var gi = 0; gi < Stato.Faq.Count; gi++)
                {
                    var gPos = gi;
                    var g = Stato.Faq[gPos];
                    <MudPaper @key="g" Outlined="true" Class="pa-3 mb-3">
                        <div class="d-flex align-center gap-1">
                            <MudTextField T="string" Label="@($"Gruppo {gPos + 1}")" Value="@g.Nome"
                                          ValueChanged="@(v => { g.Nome = v ?? ""; Cambiato(); })" Immediate="true"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="@FaqGruppo.MaxNome"
                                          Error="@string.IsNullOrWhiteSpace(g.Nome)" ErrorText="Serve un nome" Class="flex-grow-1" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(gPos == 0)"
                                           OnClick="@(() => SpostaGruppo(gPos, -1))" title="Sposta il gruppo su" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(gPos == Stato.Faq.Count - 1)"
                                           OnClick="@(() => SpostaGruppo(gPos, 1))" title="Sposta il gruppo giù" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => { Stato.Faq.RemoveAt(gPos); Cambiato(); })" title="Togli il gruppo e le sue domande" />
                        </div>
                        @for (var qi = 0; qi < g.Domande.Count; qi++)
                        {
                            var qPos = qi;
                            var d = g.Domande[qPos];
                            <div @key="d" class="mt-2 pl-3" style="border-left:3px solid var(--mud-palette-lines-default);">
                                <div class="d-flex align-center gap-1">
                                    <MudTextField T="string" Label="@($"Domanda {qPos + 1}")" Value="@d.Domanda"
                                                  ValueChanged="@(v => { d.Domanda = v ?? ""; Cambiato(); })" Immediate="true"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="@FaqDomanda.MaxDomanda"
                                                  Error="@string.IsNullOrWhiteSpace(d.Domanda)" ErrorText="Scrivi la domanda" Class="flex-grow-1" />
                                    <MudSwitch T="bool" Value="@d.Attiva" ValueChanged="@(v => { d.Attiva = v; Cambiato(); })"
                                               Color="Color.Success" Size="Size.Small" Label="Attiva" />
                                    <MudIconButton Icon="@(_risposteAperte.Contains(d) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Edit)"
                                                   Size="Size.Small" OnClick="@(() => ApriChiudiRisposta(d))"
                                                   title="@(_risposteAperte.Contains(d) ? "Chiudi la risposta" : "Scrivi la risposta")" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(qPos == 0)"
                                                   OnClick="@(() => SpostaDomanda(g, qPos, -1))" title="Sposta su" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(qPos == g.Domande.Count - 1)"
                                                   OnClick="@(() => SpostaDomanda(g, qPos, 1))" title="Sposta giù" />
                                    @if (Stato.Faq.Count > 1)
                                    {
                                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                                            <ActivatorContent>
                                                <MudIconButton Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" title="Sposta in un altro gruppo" />
                                            </ActivatorContent>
                                            <ChildContent>
                                                @foreach (var altro in Stato.Faq.Where(x => !ReferenceEquals(x, g)))
                                                {
                                                    var destinazione = altro;
                                                    <MudMenuItem OnClick="@(() => SpostaInGruppo(g, d, destinazione))">
                                                        @(string.IsNullOrWhiteSpace(destinazione.Nome) ? "(gruppo senza nome)" : destinazione.Nome)
                                                    </MudMenuItem>
                                                }
                                            </ChildContent>
                                        </MudMenu>
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => { g.Domande.RemoveAt(qPos); Cambiato(); })" title="Togli la domanda" />
                                </div>
                                @if (string.IsNullOrWhiteSpace(d.Risposta) && !_risposteAperte.Contains(d))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">Senza risposta: sul sito non compare.</MudText>
                                }
                                else if (!d.Attiva)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Non attiva: sul sito non compare.</MudText>
                                }
                                @if (_risposteAperte.Contains(d))
                                {
                                    <EditorHtmlBozza Testo="@d.Risposta" TestoChanged="@(v => { d.Risposta = v; Cambiato(); })"
                                                     Altezza="220" Placeholder="La risposta…" />
                                }
                            </div>
                        }
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Class="mt-2"
                                   OnClick="@(() => AggiungiDomanda(g))">Aggiungi domanda</MudButton>
                    </MudPaper>
                }
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                           OnClick="@AggiungiGruppo">Aggiungi gruppo</MudButton>
                <TraduzioniPanel AziendaId="@AziendaId" Class="mt-4"
                                 Elementi="@WebSitoContenutiService.ElementiFaq(Stato.FaqSalvate)"
                                 Revisione="@_revisione"
                                 InAttesaDiSalvataggio="@Stato.Modificata"
                                 PrimaDiTradurre="@(() => SalvaPerTradurreBozza(b => WebSitoContenutiService.ElementiFaq(b.FaqSalvate)))"
                                 SpiegaPrimaDiTradurre="@(Stato.Modificata ? "Salva le modifiche e poi traduce." : null)"
                                 Nota="Si traducono i nomi dei gruppi e le domande attive con la risposta (quelle che il sito mostra)." />
            </div>
        }
    </MudTabPanel>

    @* Testi legali (pezzo 4B, script 701): note legali, privacy, cookie. Un testo vuoto = la pagina non c'è sul sito.
       I dati dell'azienda (titolare, sede, P.IVA, email) NON si scrivono qui: il sito li mette da solo in cima alla
       pagina, presi dall'anagrafica. *@
    <MudTabPanel Text="Testi legali" Icon="@Icons.Material.Filled.Gavel">
        @if (!_loading)
        {
            <div style="max-width:900px;">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Ogni testo diventa una pagina del sito (Note legali, Privacy, Cookie), con il link nel piede. Un testo
                    vuoto = la pagina non c'è. I dati dell'azienda (titolare, sede, P.IVA, email) non vanno scritti qui: il
                    sito li mette da solo in cima alla pagina, presi dall'anagrafica.
                </MudAlert>
                <style>.editor-html-bozza .ql-editor { max-height: 360px; overflow-y: auto; }</style>
                @foreach (var (chiave, titolo, aggiornato) in TestiLegali)
                {
                    var k = chiave;
                    <div class="d-flex align-center mb-1 mt-3">
                        <MudText Typo="Typo.subtitle2">@titolo</MudText>
                        @if (aggiornato is { } a)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">— ultimo aggiornamento sul sito: @a.ToLocalTime().ToString("dd/MM/yyyy")</MudText>
                        }
                    </div>
                    <EditorHtmlBozza Testo="@TestoBozza(k)" TestoChanged="@(v => ImpostaTesto(k, v))"
                                     Placeholder="@($"Testo della pagina «{titolo}»…")" />
                }
                <TraduzioniPanel AziendaId="@AziendaId" Class="mt-4"
                                 Elementi="@WebSitoContenutiService.ElementiTestiLegali(Stato.Salvato)"
                                 Revisione="@_revisione"
                                 InAttesaDiSalvataggio="@Stato.Modificata"
                                 PrimaDiTradurre="@(() => SalvaPerTradurre(WebSitoContenutiService.ElementiTestiLegali))"
                                 SpiegaPrimaDiTradurre="@(Stato.Modificata ? "Salva le modifiche e poi traduce." : null)"
                                 Nota="Testi legali: la traduzione automatica va riletta (sul sito, nelle altre lingue, è scritto che fa fede il testo italiano)." />
            </div>
        }
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter, EditorRequired] public int AziendaId { get; set; }

    /// <summary>Lo stato della scheda, tenuto dal dialogo: sopravvive al cambio di scheda.</summary>
    [Parameter, EditorRequired] public SitoWebBozza Stato { get; set; } = new();

    /// <summary>Avvisa il dialogo quando cambia la preparazione di foto o video (abilita o no «Aggiorna»).</summary>
    [Parameter] public EventCallback OnStato { get; set; }

    // Chiudere il dialogo (Annulla) mentre il video si prepara interrompe la preparazione: niente file lasciati in giro.
    private readonly CancellationTokenSource _chiusura = new();
    public void Dispose() { _chiusura.Cancel(); _chiusura.Dispose(); }

    private bool _loading = true;
    private int _revisione;

    private List<WebImmagineLibreria> _foto = new();
    private List<AziendaEmail> _email = new();
    private string? _principale;
    private List<TourPubblicatoScelta> _tour = new();

    private const long MaxFotoBytes = 30L * 1024 * 1024;
    /// <summary>Il video del telefono così com'è: un minuto in 4K pesa ~400 MB, ma se ne usano solo 20 s.</summary>
    private const long MaxVideoBytes = 500L * 1024 * 1024;
    private bool _preparoVideo;

    private sealed record Anteprima(string Src, int? Larghezza, string Nota, bool Avviso = false);

    // Cosa si vede ora: la foto appena scelta, altrimenti quella salvata (dalla scheda o, come ripiego, dalla libreria).
    private Anteprima? FotoMostrata
    {
        get
        {
            if (Stato.FotoTolta) return null;
            if (Stato.FotoNuova is { } n)
                return new(n.Anteprima, n.Larghezza, $"Nuova foto, {n.Larghezza}×{n.Altezza}: va sul sito con «Aggiorna».");
            if (Stato.Salvato.FotoHomeUrl is { } u)
                return new(u, Stato.Salvato.FotoHomeLarghezza, $"{Stato.Salvato.FotoHomeLarghezza}×{Stato.Salvato.FotoHomeAltezza}");
            if (_foto.FirstOrDefault(f => f.WebImmagineLibreriaId == Stato.Salvato.FotoHomeFk) is { } l)
                return new(l.Url, l.Larghezza,
                    $"Dalla libreria immagini ({l.Larghezza}×{l.Altezza}, la misura delle newsletter): sugli schermi grandi si vedrà " +
                    "sgranata. Con «Scegli foto» si carica a piena qualità.");
            return null;
        }
    }

    private Anteprima? VideoMostrato
    {
        get
        {
            if (Stato.VideoTolto) return null;
            if (Stato.VideoNuovo is { } v)
                return new(AnteprimaVideo(v), v.Larghezza,
                    v.Accorciato
                        ? $"Il video dura {Durata(v.DurataOriginale)}: per la home si usano i primi {(int)WebVideoProcessor.MaxSecondi} secondi. Va sul sito con «Aggiorna»."
                        : $"Nuovo video, {Durata(v.Durata)}: va sul sito con «Aggiorna».",
                    Avviso: v.Accorciato);
            if (Stato.Salvato.VideoHomeTelefonoUrl is { } u)
                return new(u, Stato.Salvato.VideoHomeLarghezza,
                    $"{Stato.Salvato.VideoHomeLarghezza}×{Stato.Salvato.VideoHomeAltezza}, {Durata((double)(Stato.Salvato.VideoHomeDurata ?? 0))}");
            return null;
        }
    }

    // L'anteprima del video appena preparato (versione telefono, qualche centinaio di KB): letta una volta sola.
    private string? _anteprimaVideo;
    private string? _anteprimaVideoDi;
    private string AnteprimaVideo(WebVideoProcessor.VideoPreparato v)
    {
        if (_anteprimaVideoDi != v.FileTelefono)
        {
            _anteprimaVideo = $"data:{WebVideoProcessor.Mime};base64,{Convert.ToBase64String(File.ReadAllBytes(v.FileTelefono))}";
            _anteprimaVideoDi = v.FileTelefono;
        }
        return _anteprimaVideo!;
    }

    private static string Durata(double secondi) =>
        secondi >= 60 ? $"{(int)secondi / 60}:{(int)secondi % 60:00}" : $"{secondi:0.#} secondi";

    private async Task ScegliFoto(FileUploader.FileDaCaricare f)
    {
        if (await PreparaFoto(f) is not { } foto) return;
        Stato.FotoNuova = foto;
        Stato.FotoTolta = false;
        Cambiato();
    }

    // Una foto della scheda (home, Chi siamo): come le gallerie dei tour, 2000 px in WebP (non la versione da
    // newsletter della libreria). Mentre si prepara, «Aggiorna» resta fermo. null = dialogo chiuso nel frattempo.
    private async Task<FotoHomeNuova?> PreparaFoto(FileUploader.FileDaCaricare f)
    {
        Stato.InPreparazione = true;
        await OnStato.InvokeAsync();
        try
        {
            var img = await WebImageProcessor.ToOptimizedWebpAsync(f.Contenuto, _chiusura.Token);
            return new FotoHomeNuova(img.Bytes, img.Width, img.Height, img.Mime);
        }
        catch (OperationCanceledException) { return null; }
        finally
        {
            Stato.InPreparazione = false;
            if (!_chiusura.IsCancellationRequested) await OnStato.InvokeAsync();
        }
    }

    // Chi siamo: come la foto della home, una per posizione (indice 0 = in cima, 1 = a metà testo).
    private Anteprima? FotoChiSiamoMostrata(int i)
    {
        if (Stato.FotoChiSiamoTolta[i]) return null;
        if (Stato.FotoChiSiamoNuova[i] is { } n)
            return new(n.Anteprima, n.Larghezza, $"Nuova foto, {n.Larghezza}×{n.Altezza}: va sul sito con «Aggiorna».");
        var (url, l, h) = Stato.Salvato.FotoChiSiamo(i + 1);
        return url is null ? null : new(url, l, $"{l}×{h}");
    }

    private async Task ScegliFotoChiSiamo(int i, FileUploader.FileDaCaricare f)
    {
        if (await PreparaFoto(f) is not { } foto) return;
        Stato.FotoChiSiamoNuova[i] = foto;
        Stato.FotoChiSiamoTolta[i] = false;
        Cambiato();
    }

    private void TogliFotoChiSiamo(int i)
    {
        if (Stato.FotoChiSiamoNuova[i] is not null) Stato.FotoChiSiamoNuova[i] = null;
        else Stato.FotoChiSiamoTolta[i] = true;
        Cambiato();
    }

    // «Togli» toglie ciò che si vede: la foto appena scelta (si torna a quella salvata), altrimenti quella salvata.
    private void TogliFoto()
    {
        if (Stato.FotoNuova is not null) Stato.FotoNuova = null;
        else Stato.FotoTolta = true;
        Cambiato();
    }

    private async Task ScegliVideo(FileUploader.FileDaCaricare f)
    {
        // Lo stream del componente si chiude subito dopo: il video si copia in un file temporaneo e si prepara da lì.
        var cartella = Path.Combine(Path.GetTempPath(), "GestioneViaggi-video");
        Directory.CreateDirectory(cartella);
        var copia = Path.Combine(cartella, $"originale-{Guid.NewGuid():N}{Path.GetExtension(f.Nome)}");
        _preparoVideo = true;
        Stato.InPreparazione = true;
        await OnStato.InvokeAsync();
        var ct = _chiusura.Token;
        try
        {
            await using (var dest = File.Create(copia))
                await f.Contenuto.CopyToAsync(dest, ct);
            var v = await WebVideoProcessor.PreparaAsync(copia, ct);
            if (ct.IsCancellationRequested) { v.Cancella(); return; }   // dialogo chiuso nel frattempo
            Stato.VideoNuovo?.Cancella();
            Stato.VideoNuovo = v;
            Stato.VideoTolto = false;
            Cambiato();
        }
        catch (OperationCanceledException) { /* Annulla durante la preparazione: il database non è stato toccato */ }
        catch (Exception ex)
        {
            Snackbar.Add($"Video non preparato: {ex.Message}", Severity.Error);
        }
        finally
        {
            try { File.Delete(copia); } catch { }
            _preparoVideo = false;
            Stato.InPreparazione = false;
            if (!ct.IsCancellationRequested) await OnStato.InvokeAsync();
        }
    }

    private void TogliVideo()
    {
        if (Stato.VideoNuovo is { } v) { v.Cancella(); Stato.VideoNuovo = null; }
        else Stato.VideoTolto = true;
        Cambiato();
    }
    private IEnumerable<TourPubblicatoScelta> TourDisponibili => _tour.Where(t => !Stato.Evidenza.Contains(t.ContenutoId));

    // Un tour scelto può non essere più pubblicato: resta nell'elenco (il sito lo salta da solo), ma si dice.
    private string NomeTour(long id) =>
        _tour.FirstOrDefault(t => t.ContenutoId == id)?.Etichetta ?? $"Tour {id} — non più pubblicato: sul sito non compare";

    // La scheda viene ricreata a ogni clic sulla sua linguetta: le liste di scelta si rileggono (poche
    // righe), la bozza no — sta nel dialogo, e ricaricarla butterebbe via le modifiche non salvate.
    private bool _montata;

    protected override async Task OnParametersSetAsync()
    {
        if (AziendaId <= 0 || _montata) return;
        _montata = true;
        _loading = true;
        try
        {
            if (!Stato.Caricata || Stato.AziendaId != AziendaId)
                await SitoService.CaricaBozzaAsync(Stato, AziendaId);
            await CaricaScelteAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Scheda «Sito web» non letta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CaricaScelteAsync()
    {
        _foto = await LibreriaService.ListAsync(AziendaId);
        _email = await EmailService.GetByAziendaIdAsync(AziendaId);
        _principale = _email.OrderByDescending(e => e.IsPrincipale).ThenBy(e => e.Id).FirstOrDefault()?.Email;
        _tour = await SitoService.ListTourPubblicatiAsync(AziendaId);
    }

    private void Cambiato() => Stato.Modificata = true;

    private void Aggiungi(long? id)
    {
        if (id is not { } v || Stato.Evidenza.Contains(v) || Stato.Evidenza.Count >= 3) return;
        Stato.Evidenza.Add(v);
        Cambiato();
    }

    private void Sposta(int pos, int verso)
    {
        var nuova = pos + verso;
        if (nuova < 0 || nuova >= Stato.Evidenza.Count) return;
        (Stato.Evidenza[pos], Stato.Evidenza[nuova]) = (Stato.Evidenza[nuova], Stato.Evidenza[pos]);
        Cambiato();
    }

    // Si traduce ciò che è salvato: con modifiche in sospeso, «Traduci» prima le salva (è un'azione
    // esplicita; dopo, «Annulla» non le toglie più). Senza modifiche non salva niente.
    // — Testi legali (ogni editor si carica e si rilegge da solo: EditorHtmlBozza) —
    private IEnumerable<(string Chiave, string Titolo, DateTime? Aggiornato)> TestiLegali =>
    [
        ("note_legali", "Note legali", Stato.Salvato.NoteLegaliAggiornato),
        ("privacy", "Privacy", Stato.Salvato.PrivacyAggiornato),
        ("cookie", "Cookie", Stato.Salvato.CookieAggiornato),
    ];

    private string? TestoBozza(string k) => k switch { "note_legali" => Stato.Bozza.NoteLegali, "privacy" => Stato.Bozza.Privacy, _ => Stato.Bozza.Cookie };

    private void ImpostaTesto(string k, string? html)
    {
        switch (k)
        {
            case "note_legali": Stato.Bozza.NoteLegali = html; break;
            case "privacy": Stato.Bozza.Privacy = html; break;
            default: Stato.Bozza.Cookie = html; break;
        }
        Cambiato();
    }

    // — FAQ: tutto nella bozza; si salva con «Aggiorna» —
    // Le risposte aperte nell'editor (per riferimento: una domanda nuova non ha ancora l'id).
    private readonly HashSet<FaqDomanda> _risposteAperte = new(ReferenceEqualityComparer.Instance);

    private void ApriChiudiRisposta(FaqDomanda d)
    {
        if (!_risposteAperte.Remove(d)) _risposteAperte.Add(d);
    }

    private void AggiungiGruppo()
    {
        Stato.Faq.Add(new FaqGruppo());
        Cambiato();
    }

    private void AggiungiDomanda(FaqGruppo g)
    {
        var d = new FaqDomanda();
        g.Domande.Add(d);
        _risposteAperte.Add(d);
        Cambiato();
    }

    private void SpostaGruppo(int pos, int verso)
    {
        var nuova = pos + verso;
        if (nuova < 0 || nuova >= Stato.Faq.Count) return;
        (Stato.Faq[pos], Stato.Faq[nuova]) = (Stato.Faq[nuova], Stato.Faq[pos]);
        Cambiato();
    }

    private void SpostaDomanda(FaqGruppo g, int pos, int verso)
    {
        var nuova = pos + verso;
        if (nuova < 0 || nuova >= g.Domande.Count) return;
        (g.Domande[pos], g.Domande[nuova]) = (g.Domande[nuova], g.Domande[pos]);
        Cambiato();
    }

    // In fondo al gruppo di destinazione; la domanda resta la stessa (id e traduzioni conservati).
    private void SpostaInGruppo(FaqGruppo da, FaqDomanda d, FaqGruppo a)
    {
        if (!da.Domande.Remove(d)) return;
        a.Domande.Add(d);
        Cambiato();
    }

    private Task<IReadOnlyList<TranslatableItem>?> SalvaPerTradurre(Func<WebSitoContenuti, List<TranslatableItem>> elementi) =>
        SalvaPerTradurreBozza(b => elementi(b.Salvato));

    private async Task<IReadOnlyList<TranslatableItem>?> SalvaPerTradurreBozza(Func<SitoWebBozza, List<TranslatableItem>> elementi)
    {
        if (Stato.Modificata)
        {
            try
            {
                var utente = (await SessionManager.GetSessionAsync())?.User?.Email ?? "gestionale";
                await SitoService.SalvaBozzaAsync(Stato, utente);
                _revisione++;
            }
            catch (Exception ex)
            {
                // Il database spiega già cosa non va (per esempio: più di 3 tour, email di un'altra azienda).
                Snackbar.Add($"Non salvato, quindi non tradotto: {ex.Message}", Severity.Error);
                return null;
            }
        }
        return elementi(Stato);
    }
}
