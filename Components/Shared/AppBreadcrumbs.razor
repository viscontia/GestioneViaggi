@using Microsoft.AspNetCore.Components.Routing
@using GestioneViaggi.Services.Navigation
@inject NavigationManager NavigationManager
@inject ITabManagerService TabManager
@implements IDisposable

<MudBreadcrumbs Items="_items" Separator=">">
    <ItemTemplate Context="item">
        <MudLink Href="@item.Href" Disabled="@item.Disabled" Color="Color.Inherit">
            @if (!string.IsNullOrEmpty(item.Icon))
            {
                <MudIcon Icon="@item.Icon" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
            }
            <span style="vertical-align: middle;">@item.Text</span>
        </MudLink>
    </ItemTemplate>
</MudBreadcrumbs>

@code {
    private List<BreadcrumbItem> _items = new();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        TabManager.OnTabsChanged += OnTabsChanged;
        UpdateBreadcrumbs();
    }

    private void OnTabsChanged()
    {
        UpdateBreadcrumbs();
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    private void UpdateBreadcrumbs()
    {
        _items = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/", disabled: false, icon: Icons.Material.Filled.Home)
        };

        var activeTab = TabManager.GetActiveTab();
        if (activeTab != null && activeTab.Route != "/")
        {
            var icon = GetIconForRoute(activeTab.Icon);
            _items.Add(new BreadcrumbItem(activeTab.Title, href: null, disabled: true, icon: icon));
        }
    }

    private string GetIconForRoute(string iconName)
    {
        return iconName.ToLower() switch
        {
            "dashboard" => Icons.Material.Filled.Dashboard,
            "people" => Icons.Material.Filled.People,
            "table" => Icons.Material.Filled.TableChart,
            "car" => Icons.Material.Filled.DirectionsCar,
            "print" => Icons.Material.Filled.Print,
            "settings" => Icons.Material.Filled.Settings,
            _ => Icons.Material.Filled.ChevronRight
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        TabManager.OnTabsChanged -= OnTabsChanged;
    }
}
