@code {
    [Parameter]
    public EventCallback OnItemClick { get; set; }

    private string _dashboardRoute = "/dashboard-admin";
    private bool _newsletterVisible = true;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        _dashboardRoute = user?.IsSuperAdmin == true
            ? "/dashboard-superadmin"
            : "/dashboard-admin";

        // Gating best-effort della voce Newsletter (la pagina resta la guardia autoritativa).
        // Se nessuna azienda è selezionata (es. SuperAdmin) la voce resta visibile.
        try
        {
            var aziendaId = await TenantContext.GetCurrentAziendaIdAsync();
            _newsletterVisible = aziendaId is null || await WebFunzioniService.IsNewsletterEnabledAsync(aziendaId.Value);
        }
        catch
        {
            _newsletterVisible = true;
        }
    }

    private void OpenTab(string route, string title, string icon)
    {
        if (!TabManager.CanOpenTab())
        {
            Snackbar.Add($"Impossibile aprire '{title}': limite di {TabManager.MaxTabs} tab raggiunto. Chiudi una tab per continuare.", Severity.Warning, config =>
            {
                config.VisibleStateDuration = 4000;
            });
            return;
        }

        bool opened = TabManager.OpenTab(route, title, icon);
        if (opened)
        {
            Snackbar.Add($"Tab aperto: {title}", Severity.Success, config =>
            {
                config.VisibleStateDuration = 2000;
            });
        }
    }

    private async Task OpenTabAndNotify(string route, string title, string icon)
    {
        OpenTab(route, title, icon);
        await OnItemClick.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        // Perform logout - force reload will reset everything
        await AuthService.LogoutAsync();

        // Force reload to login page (this will destroy all components and tabs)
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task OpenStampaSchedaDataViaggio()
    {
        await OnItemClick.InvokeAsync();

        var user = await AuthService.GetCurrentUserAsync();
        var parameters = new DialogParameters
        {
            ["AziendaId"] = user?.AziendaId ?? 0,
            ["IsSuperAdmin"] = user?.IsSuperAdmin ?? false,
            ["PrintType"] = GestioneViaggi.Models.PrintType.TravelDataSheet
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<TravelDataSelectorDialog>("Stampa Scheda Data Viaggio", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is int dataViaggioId)
        {
            try
            {
                var data = await PrintService.GetPrintDataAsync(dataViaggioId);

                // STANDARD: Save to Downloads (usa metodo centralizzato per macOS sandboxato)
                var targetFolder = PdfOpenerService.GetPdfOutputFolder();

                // Create descriptive filename
                var fileName = GestioneViaggi.Services.Printing.PdfFileNameHelper.GetTravelSheetFileName(data.Header);
                var filePath = Path.Combine(targetFolder, fileName);

                // STANDARD: Overwrite check
                if (System.IO.File.Exists(filePath))
                {
                    System.IO.File.Delete(filePath);
                }

                await GestioneViaggi.Services.Printing.ViaggiPrinter.GeneratePdfAsync(data, filePath);

                // STANDARD: Confirmation and Open
                bool? confirm = await DialogService.ShowMessageBox(
                    "Stampa Completata",
                    $"Il file è stato salvato in Downloads:\n{fileName}\n\nVuoi aprirlo?",
                    yesText: "Sì, Apri", cancelText: "No");

                if (confirm == true)
                {
                    // STANDARD: Cross-Platform Open
#if MACCATALYST
                    System.Diagnostics.Process.Start("open", $"\"{filePath}\"");
#else
                    await Launcher.Default.OpenAsync(new OpenFileRequest
                    {
                        Title = "Scheda Viaggio",
                        File = new ReadOnlyFile(filePath)
                    });
#endif
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore stampa: {ex.Message}", Severity.Error);
            }
        }
    }

