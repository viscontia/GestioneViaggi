@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Navigation
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ITabManagerService TabManager
@inject ISnackbar Snackbar

<MudNavMenu>
    <MudNavLink Icon="@Icons.Material.Filled.Dashboard"
                OnClick="@(() => OpenTab("/dashboard-admin", "Dashboard", "dashboard"))">
        Dashboard
    </MudNavLink>

    <MudNavGroup Title="Anagrafiche" Icon="@Icons.Material.Filled.AccountBox" Expanded="false">
        <!-- Qui potrai aggiungere sottovoci in futuro -->
    </MudNavGroup>

    <MudNavGroup Title="Tabelle" Icon="@Icons.Material.Filled.TableChart" Expanded="false">

        <!-- Tabelle Geografiche -->
        <MudNavGroup Title="Tabelle Geografiche" Icon="@Icons.Material.Filled.Public" Expanded="false">
            <MudNavLink Icon="@Icons.Material.Filled.Public"
                        OnClick="@(() => OpenTab("/tabelle/nazioni", "Nazioni", "table"))">
                Nazioni
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Map"
                        OnClick="@(() => OpenTab("/tabelle/regioni", "Regioni", "table"))">
                Regioni
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.LocationCity"
                        OnClick="@(() => OpenTab("/tabelle/capoluoghi", "Capoluoghi", "table"))">
                Capoluogo di Regione
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Landscape"
                        OnClick="@(() => OpenTab("/tabelle/ripartizioni-geografiche", "Ripartizioni Geografiche", "table"))">
                Ripartizioni Geografiche
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Terrain"
                        OnClick="@(() => OpenTab("/tabelle/province", "Province", "table"))">
                Province
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Place"
                        OnClick="@(() => OpenTab("/tabelle/comuni", "Comuni", "table"))">
                Comuni
            </MudNavLink>
        </MudNavGroup>

        <!-- Tabelle Viaggi -->
        <MudNavGroup Title="Tabelle Viaggi" Icon="@Icons.Material.Filled.Explore" Expanded="false">
            <MudNavLink Icon="@Icons.Material.Filled.Category"
                        OnClick="@(() => OpenTab("/tabelle/tipologie-viaggio", "Tipologie Viaggio", "table"))">
                Tipologie Viaggio
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.People"
                        OnClick="@(() => OpenTab("/tabelle/tipologie-partecipanti", "Tipologie Partecipanti", "table"))">
                Tipologie Partecipanti
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Hotel"
                        OnClick="@(() => OpenTab("/tabelle/tipologie-alloggi", "Tipologie Alloggi", "table"))">
                Tipologie Alloggi
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Restaurant"
                        OnClick="@(() => OpenTab("/tabelle/tipologie-trattamento-alberghiero", "Tipologie Tratt. Alberghiero", "table"))">
                Tipologie Tratt. Alberghiero
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.NightsStay"
                        OnClick="@(() => OpenTab("/tabelle/tipologie-pernottamento", "Tipologie Pernottamento", "table"))">
                Tipologie di Pernottamento
            </MudNavLink>
        </MudNavGroup>

        <!-- Tabelle Mezzi -->
        <MudNavGroup Title="Tabelle Mezzi" Icon="@Icons.Material.Filled.DirectionsCar" Expanded="false">
            <MudNavLink Icon="@Icons.Material.Filled.CarRental"
                        OnClick="@(() => OpenTab("/tabelle/marche-veicoli", "Marche Veicoli", "table"))">
                Marche Veicoli
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.DirectionsCar"
                        OnClick="@(() => OpenTab("/tabelle/mezzi-modelli", "Modelli Veicoli", "table"))">
                Modelli Veicoli
            </MudNavLink>

            <MudNavLink Icon="@Icons.Material.Filled.Category"
                        OnClick="@(() => OpenTab("/tabelle/tipologie-veicoli", "Tipologie Veicoli", "table"))">
                Tipologie Veicoli
            </MudNavLink>
        </MudNavGroup>

    </MudNavGroup>

    <MudNavLink Icon="@Icons.Material.Filled.DirectionsCar"
                OnClick="@(() => OpenTab("/viaggi", "Viaggi", "car"))">
        Viaggi
    </MudNavLink>

    <MudNavLink Icon="@Icons.Material.Filled.Print"
                OnClick="@(() => OpenTab("/stampe", "Stampe", "print"))">
        Stampe
    </MudNavLink>

    <MudNavLink Icon="@Icons.Material.Filled.Settings"
                OnClick="@(() => OpenTab("/configurazione", "Configurazione", "settings"))">
        Configurazione
    </MudNavLink>

    <MudDivider Class="my-2" />

    <div class="mud-nav-item" @onclick="HandleLogout" style="cursor: pointer; display: flex; align-items: center; padding: 8px 16px;">
        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Medium" Class="mr-3" />
        <MudText>Logout</MudText>
    </div>
</MudNavMenu>

@code {
    private void OpenTab(string route, string title, string icon)
    {
        if (!TabManager.CanOpenTab())
        {
            Snackbar.Add($"Impossibile aprire '{title}': limite di {TabManager.MaxTabs} tab raggiunto. Chiudi una tab per continuare.", Severity.Warning, config =>
            {
                config.VisibleStateDuration = 4000;
            });
            return;
        }

        bool opened = TabManager.OpenTab(route, title, icon);
        if (opened)
        {
            Snackbar.Add($"Tab aperto: {title}", Severity.Success, config =>
            {
                config.VisibleStateDuration = 2000;
            });
        }
    }

    private async Task HandleLogout()
    {
        // Perform logout - force reload will reset everything
        await AuthService.LogoutAsync();

        // Force reload to login page (this will destroy all components and tabs)
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
