@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Models.DTOs
@using MudBlazor
@inject MovClientiAlloggiService AlloggiService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @if (Room.MovClientiAlloggioPk > 0)
            {
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                @($"Modifica Camera #{Room.MovClientiAlloggioPk}")
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
                @("Nuova Camera")
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            <TipoAlloggioSelect DataViaggioId="@Room.DataViaggioIdFk"
                                @bind-SelectedId="Room.TipoAlloggioIdFk"
                                SelectedItemChanged="@(t => _tipoScelto = t)"
                                PersoneDaSistemare="@Occupants.Count"
                                Required="true"
                                Class="mb-4" />

            @{
                var selectedTipo = _tipoScelto;
                var currentOccupantsCount = Occupants.Count;
            }

            <MudPaper Class="pa-3" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.subtitle2">Occupanti Attuali</MudText>
                    
                    @if (selectedTipo != null)
                    {
                        @if (currentOccupantsCount <= selectedTipo.NumeroOccupanti)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircle">
                                @currentOccupantsCount/@selectedTipo.NumeroOccupanti
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Icon="@Icons.Material.Filled.Warning">
                                @currentOccupantsCount/@selectedTipo.NumeroOccupanti
                            </MudChip>
                        }
                    }
                    else if (Room.TipoAlloggioIdFk > 0)
                    {
                         <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                            Tipo Non Trovato
                        </MudChip>
                    }
                </div>

                @if (Occupants.Any())
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var occupant in Occupants)
                        {
                            <MudPaper Class="d-flex align-center justify-space-between pa-2" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-surface);">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Typo="Typo.body2">@occupant.Nominativo</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@occupant.Ruolo</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                Size="Size.Small"
                                                Color="Color.Error"
                                                OnClick="@(() => RemoveOccupant(occupant.ClienteId))" />
                            </MudPaper>
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block text-center">
                        Nessun occupante
                    </MudText>
                }

                @if (selectedTipo != null && currentOccupantsCount < selectedTipo.NumeroOccupanti)
                {
                    <MudSelect T="int?" Label="Aggiungi Occupante"
                                @bind-Value="_selectedOccupantToAdd"
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense"
                                Clearable="true"
                                Placeholder="Seleziona partecipante..."
                                Class="mt-2">
                        @foreach (var participant in AvailableParticipants)
                        {
                            <MudSelectItem Value="@((int?)participant.ClienteId)">
                                @participant.Nominativo
                                @if (IsParticipantInAnotherRoom(participant.ClienteId))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-2">
                                        Già assegnato
                                    </MudChip>
                                }
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (_selectedOccupantToAdd.HasValue)
                    {
                        <MudButton Variant="Variant.Filled"
                                    Color="Color.Primary"
                                    Size="Size.Small"
                                    FullWidth="true"
                                    Class="mt-2"
                                    OnClick="AddSelectedOccupant">
                            Aggiungi alla Camera
                        </MudButton>
                    }
                }
                else if (selectedTipo == null && Room.TipoAlloggioIdFk == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Seleziona un "Tipo Camera" per aggiungere occupanti.
                    </MudAlert>
                }
            </MudPaper>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(!CanSave())">
            @if (Room.MovClientiAlloggioPk > 0) { @("Aggiorna Camera") } else { @("Crea Camera") }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public MovClientiAlloggi Room { get; set; } = new();
    [Parameter] public List<ViaggioAlloggiAdvancedDialog.OccupantViewModel> Occupants { get; set; } = new();
    /// <summary>
    /// Il tipo attualmente scelto, che <see cref="TipoAlloggioSelect"/> comunica quando
    /// cambia (e al caricamento). ⚠️ Prima questa scheda riceveva l'elenco INTERO dalla
    /// scheda che la apriva e ci cercava dentro: un secondo elenco, che poteva non essere
    /// quello giusto per la partenza.
    /// </summary>
    private TipoAlloggio? _tipoScelto;
    [Parameter] public List<ParticipantsViewDTO> AllParticipants { get; set; } = new();
    // Pass existing rooms to check for conflicts
    [Parameter] public List<ViaggioAlloggiAdvancedDialog.RoomViewModel> ExistingRooms { get; set; } = new();

    private int? _selectedOccupantToAdd;

    private void Cancel() => MudDialog.Cancel();

    private void RemoveOccupant(int clienteId)
    {
        Occupants.RemoveAll(o => o.ClienteId == clienteId);
    }

    private void AddSelectedOccupant()
    {
        if (!_selectedOccupantToAdd.HasValue) return;
        
        var participant = AllParticipants.FirstOrDefault(p => p.ClienteId == _selectedOccupantToAdd.Value);
        if (participant != null && !Occupants.Any(o => o.ClienteId == participant.ClienteId))
        {
            Occupants.Add(new ViaggioAlloggiAdvancedDialog.OccupantViewModel
            {
                ClienteId = participant.ClienteId,
                Nominativo = participant.Nominativo,
                Ruolo = participant.Ruolo
            });
        }
        _selectedOccupantToAdd = null;
    }

    private IEnumerable<ParticipantsViewDTO> AvailableParticipants => 
        AllParticipants.Where(p => 
            !Occupants.Any(o => o.ClienteId == p.ClienteId) && // Not already in THIS room
            !IsParticipantInAnotherRoom(p.ClienteId));         // Not in OTHER rooms (optional: allow stealing?)

    private bool IsParticipantInAnotherRoom(int clienteId)
    {
        return ExistingRooms.Any(r => 
            r.AlloggioPk != Room.MovClientiAlloggioPk && 
            r.Occupanti.Any(o => o.ClienteId == clienteId));
    }

    private bool CanSave()
    {
        if (Room.TipoAlloggioIdFk <= 0) return false;
        if (!Occupants.Any()) return false;
        return _tipoScelto != null && Occupants.Count <= _tipoScelto.NumeroOccupanti;
    }

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok(new { Room, Occupants }));
    }
}
