@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@inject MarcaVeicoloService MarcaVeicoloService

<BaseEntitySelect TItem="MarcaVeicolo"
                  Value="_selectedItem"
                  ValueChanged="OnValueChanged"
                  SearchFunc="SearchFunc"
                  ToStringFunc="@(x => x?.Descrizione)"
                  Label="@Label"
                  Required="@Required"
                  RequiredError="@RequiredError"
                  Disabled="@Disabled"
                  Class="@Class"
                  HelperText="@HelperText"
                  AutoFocus="@AutoFocus"
                  AdditionalAttributes="AdditionalAttributes" />

@code {
    private List<MarcaVeicolo>? _items;
    private MarcaVeicolo? _selectedItem;

    [Parameter]
    public int? SelectedId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Marca Veicolo";

    [Parameter]
    public bool Required { get; set; } = false;

    [Parameter]
    public string RequiredError { get; set; } = "La marca è obbligatoria";

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string Class { get; set; } = "mb-3";

    [Parameter]
    public string HelperText { get; set; } = "Seleziona la marca del veicolo";

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override void OnParametersSet()
    {
        UpdateSelection();
    }

    private void UpdateSelection()
    {
        if (_items == null) return;

        if (SelectedId.HasValue)
        {
            if (_selectedItem?.Id != SelectedId.Value)
            {
                _selectedItem = _items.FirstOrDefault(x => x.Id == SelectedId.Value);
            }
        }
        else
        {
            _selectedItem = null;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            // Il service restituisce già ordinato per descrizione
            _items = await MarcaVeicoloService.GetAllAsync();
            UpdateSelection();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore caricamento marche veicoli: {ex.Message}");
            _items = new List<MarcaVeicolo>();
        }
    }

    private async Task OnValueChanged(MarcaVeicolo item)
    {
        _selectedItem = item;
        await SelectedIdChanged.InvokeAsync(item?.Id);
    }

    private async Task<IEnumerable<MarcaVeicolo>> SearchFunc(string value, CancellationToken token)
    {
        if (_items == null)
            return Enumerable.Empty<MarcaVeicolo>();

        if (string.IsNullOrEmpty(value))
            return _items;

        return _items.Where(x => x.Descrizione.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
