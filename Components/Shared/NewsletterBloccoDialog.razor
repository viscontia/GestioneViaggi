@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using Blazored.TextEditor
@using MudBlazor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NewsletterRenderService RenderService
@inject NewsletterMediaService MediaService

@* Modifica di un singolo blocco della newsletter. I campi mostrati dipendono dal tipo:
   far vedere "link" su un separatore confonderebbe e basta. *@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3">@Etichetta</MudText>

        @if (Blocco.Tipo == "tour")
        {
            @* Il senso del blocco tour: scegli l'edizione e i campi si compilano da soli.
               Restano modificabili a mano dopo. *@
            <MudPaper Outlined="true" Class="pa-3 mb-4">
                <div class="d-flex align-center gap-3 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_caricando"
                               StartIcon="@Icons.Material.Filled.TravelExplore" OnClick="ScegliEdizione">
                        @(Blocco.DataViaggioIdFk.HasValue ? "Cambia tour" : "Scegli il tour")
                    </MudButton>
                    @if (_caricando)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Lettura del tour e conversione della copertina…</MudText>
                    }
                    else if (Blocco.DataViaggioIdFk.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.Check">Compilato dal tour</MudChip>
                    }
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    Titolo, periodo e testo sono <strong>modificabili qui sotto</strong>: quelli del tour
                    servono da punto di partenza. Le modifiche restano nella newsletter e non toccano la
                    scheda del viaggio.
                </MudText>

                @if (_avvisoBozza)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                        La scheda web di questo tour è ancora in <strong>bozza</strong>: il collegamento
                        porterebbe a una pagina che sul sito non esiste. Pubblicala prima di inviare.
                    </MudAlert>
                }
                @if (_avvisoSenzaSito)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                        L'azienda non ha un sito web configurato: il collegamento non è stato compilato.
                    </MudAlert>
                }
            </MudPaper>
        }

        @if (Mostra("titolo"))
        {
            <MudTextField @bind-Value="Blocco.Titolo" Label="Titolo" Variant="Variant.Outlined"
                          MaxLength="255" Class="mb-3" @ref="_primoCampo" />
        }

        @if (Mostra("sottotitolo"))
        {
            <MudTextField @bind-Value="Blocco.Sottotitolo" Label="Sottotitolo" Variant="Variant.Outlined"
                          MaxLength="255" Class="mb-3" />
        }

        @if (Mostra("corpo"))
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Testo</MudText>
            <div style="height:220px;border:1px solid var(--mud-palette-lines-default);border-radius:4px;overflow:hidden;display:flex;flex-direction:column;"
                 class="mb-3">
                <BlazoredTextEditor @ref="_editor" Placeholder="Scrivi il testo del blocco...">
                    <ToolbarContent>
                        <select class="ql-header"><option selected=""></option><option value="2"></option><option value="3"></option></select>
                        <span class="ql-formats"><button class="ql-bold"></button><button class="ql-italic"></button><button class="ql-underline"></button></span>
                        <span class="ql-formats"><button class="ql-list" value="ordered"></button><button class="ql-list" value="bullet"></button></span>
                        <span class="ql-formats"><button class="ql-link"></button></span>
                        <span class="ql-formats"><button class="ql-clean"></button></span>
                    </ToolbarContent>
                </BlazoredTextEditor>
            </div>
        }

        @if (Mostra("immagine"))
        {
            @* Scelta dalla galleria, non un URL scritto a mano: l'utente non sa cosa sia un URL,
               ne' dove prenderlo. La conversione in JPEG per l'email la fa il codice. *@
            <div class="mb-3">
                <ImmaginePicker Immagini="@Galleria"
                                Titolo="Immagine (dalla galleria dell'azienda)"
                                TestoGalleriaVuota="Nessuna foto in galleria. Caricane dalla scheda Contenuti Web di un tour."
                                SelectedStoragePath="@Blocco.ImmagineStoragePath"
                                SelectedUrl="@Blocco.ImmagineUrl"
                                OnScelta="OnImmagineScelta" />
            </div>
            <MudTextField @bind-Value="Blocco.ImmagineAlt" Label="Testo alternativo" Variant="Variant.Outlined"
                          MaxLength="255" Class="mb-3"
                          HelperText="Compare al posto della foto finché il destinatario non la scarica." />
        }

        @if (Mostra("link"))
        {
            <MudTextField @bind-Value="Blocco.LinkUrl" Label="Indirizzo del collegamento" Variant="Variant.Outlined"
                          MaxLength="500" Class="mb-3" />
            <MudTextField @bind-Value="Blocco.LinkEtichetta" Label="Testo del pulsante" Variant="Variant.Outlined"
                          MaxLength="100" Class="mb-3" Placeholder="Vai alla pagina del Tour" />
        }

        @if (Mostra("layout"))
        {
            <div class="d-flex gap-3">
                <MudSelect T="string" @bind-Value="Blocco.Layout" Label="Disposizione" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="string" Value="@("pieno")">Piena larghezza</MudSelectItem>
                    <MudSelectItem T="string" Value="@("sinistra")">Immagine a sinistra</MudSelectItem>
                    <MudSelectItem T="string" Value="@("destra")">Immagine a destra</MudSelectItem>
                </MudSelect>

                @if (Blocco.Tipo == "tour")
                {
                    <MudSelect T="short" @bind-Value="Blocco.Colonne" Label="Affiancamento" Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="short" Value="@((short)1)">Da solo</MudSelectItem>
                        <MudSelectItem T="short" Value="@((short)2)">Affiancato al tour seguente</MudSelectItem>
                    </MudSelect>
                }
            </div>
        }

        @if (Blocco.Tipo == "separatore")
        {
            <MudAlert Severity="Severity.Info" Dense="true">Il separatore non ha contenuto: disegna solo una linea.</MudAlert>
        }
        @if (Blocco.Tipo is "intestazione" or "footer")
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Questo blocco si compila da sé con i dati dell'azienda: logo, ragione sociale, indirizzo e recapiti.
                La composizione del footer si cambia in <strong>Anagrafica Aziende → Funzioni Web</strong>.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Annulla">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Conferma">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public WebNewsletterBlocco Blocco { get; set; } = new();
    [Parameter] public string Etichetta { get; set; } = "Blocco";
    [Parameter] public bool IsSuperAdmin { get; set; }

    /// <summary>Galleria dell'azienda, caricata dalla pagina e passata qui gia' pronta.</summary>
    [Parameter] public List<ImmaginePicker.Voce> Galleria { get; set; } = new();

    private MudTextField<string>? _primoCampo;
    private BlazoredTextEditor? _editor;
    private bool _editorCaricato;

    /// <summary>
    /// Scelta dell'immagine dalla galleria: converte subito in JPEG per l'email.
    /// La galleria produce WebP, che Outlook non mostra - farlo qui significa che il problema
    /// e' risolto prima ancora dell'anteprima, invece di scoprirlo a newsletter spedita.
    /// </summary>
    private async Task OnImmagineScelta(ImmaginePicker.Voce? v)
    {
        if (v is null)
        {
            Blocco.ImmagineUrl = null;
            Blocco.ImmagineStoragePath = null;
            return;
        }

        Blocco.ImmagineStoragePath = v.StoragePath;
        if (string.IsNullOrWhiteSpace(Blocco.ImmagineAlt)) Blocco.ImmagineAlt = v.Alt ?? v.Contesto;

        _caricando = true;
        StateHasChanged();
        try
        {
            Blocco.ImmagineUrl = await MediaService.ConvertiDaUrlAsync(v.Url, v.StoragePath) ?? v.Url;
        }
        catch
        {
            Blocco.ImmagineUrl = v.Url;
        }
        finally { _caricando = false; }
    }
    private bool _caricando;
    private bool _avvisoBozza;
    private bool _avvisoSenzaSito;

    /// <summary>
    /// Sceglie l'edizione e compila il riquadro: titolo, periodo, testo, copertina (convertita in
    /// JPEG per l'email) e collegamento. Riusa il selettore condiviso TravelDataSelectorDialog
    /// invece di duplicarne la logica di scelta viaggio + data.
    /// </summary>
    private async Task ScegliEdizione()
    {
        var parameters = new DialogParameters<TravelDataSelectorDialog>
        {
            { x => x.AziendaId, Blocco.AziendaId },
            { x => x.IsSuperAdmin, IsSuperAdmin },
            { x => x.TitoloPersonalizzato, "Scegli il tour da inserire" },
            { x => x.EtichettaConferma, "Usa questo tour" }
        };
        var dlg = await DialogService.ShowAsync<TravelDataSelectorDialog>("Scegli il tour", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, BackdropClick = false });
        var res = await dlg.Result;
        if (res!.Canceled || res.Data is not int dataViaggioId) return;

        _caricando = true; _avvisoBozza = false; _avvisoSenzaSito = false;
        StateHasChanged();
        try
        {
            var dati = await RenderService.GetDatiTourAsync(dataViaggioId, Blocco.AziendaId);
            if (dati is null)
            {
                Snackbar.Add("Questa partenza non ha una scheda di contenuti web: creala prima di inserirla in newsletter.", Severity.Warning);
                return;
            }

            // I testi restano sempre modificabili a mano: la compilazione automatica precompila,
            // non blocca. Percio' se il riquadro contiene gia' dei testi non li si sostituisce
            // di nascosto - si chiede. Sostituire in silenzio il titolo che l'operatore ha appena
            // riscritto e' il tipo di perdita che fa arrabbiare e che non lascia tracce.
            var haTesti = !string.IsNullOrWhiteSpace(Blocco.Titolo)
                       || !string.IsNullOrWhiteSpace(Blocco.Sottotitolo)
                       || !string.IsNullOrWhiteSpace(Blocco.CorpoHtml);

            var sostituisciTesti = true;
            if (haTesti)
            {
                var conferma = new DialogParameters<DeleteConfirmationDialog>
                {
                    { x => x.Title, "Testi già presenti" },
                    { x => x.ContentText, "Questo riquadro contiene già dei testi. Vuoi sostituirli con quelli del tour scelto? " +
                                          "Rispondendo No si aggiornano solo immagine e collegamento." },
                    { x => x.ButtonText, "Sostituisci i testi" },
                    { x => x.Color, Color.Warning }
                };
                var cdlg = await DialogService.ShowAsync<DeleteConfirmationDialog>("Testi già presenti", conferma,
                    new DialogOptions { BackdropClick = false });
                sostituisciTesti = !(await cdlg.Result)!.Canceled;
            }

            // Dati strutturali: si aggiornano sempre, perche' sono il legame col tour scelto.
            Blocco.DataViaggioIdFk = dataViaggioId;
            Blocco.ImmagineUrl = dati.ImmagineUrl;
            Blocco.ImmagineStoragePath = dati.ImmagineStoragePath;
            Blocco.LinkUrl = dati.LinkCompleto;

            if (sostituisciTesti)
            {
                Blocco.Titolo = dati.Titolo;
                Blocco.Sottotitolo = dati.Periodo;
                Blocco.ImmagineAlt = dati.Titolo;
                if (!string.IsNullOrWhiteSpace(dati.Testo))
                {
                    Blocco.CorpoHtml = $"<p>{dati.Testo}</p>";
                    if (_editor != null) { try { await _editor.LoadHTMLContent(Blocco.CorpoHtml); } catch { } }
                }
            }
            else
            {
                // Riempio solo cio' che era vuoto: aiutare senza cancellare.
                if (string.IsNullOrWhiteSpace(Blocco.Titolo)) Blocco.Titolo = dati.Titolo;
                if (string.IsNullOrWhiteSpace(Blocco.Sottotitolo)) Blocco.Sottotitolo = dati.Periodo;
                if (string.IsNullOrWhiteSpace(Blocco.ImmagineAlt)) Blocco.ImmagineAlt = dati.Titolo;
                if (string.IsNullOrWhiteSpace(Blocco.CorpoHtml) && !string.IsNullOrWhiteSpace(dati.Testo))
                    Blocco.CorpoHtml = $"<p>{dati.Testo}</p>";
            }

            if (string.IsNullOrWhiteSpace(Blocco.LinkEtichetta))
                Blocco.LinkEtichetta = "Vai alla pagina del Tour";

            _avvisoBozza = !dati.Pubblicato;
            _avvisoSenzaSito = string.IsNullOrWhiteSpace(dati.LinkCompleto);
        }
        catch (Exception ex) { Snackbar.Add($"Errore lettura tour: {ex.Message}", Severity.Error); }
        finally { _caricando = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Regola UI del progetto: focus sul primo campo all'apertura della form.
            if (_primoCampo != null)
            {
                await Task.Delay(150);
                await _primoCampo.FocusAsync();
            }
        }

        // Quill si popola DOPO il render: caricarlo prima non avrebbe effetto.
        if (!_editorCaricato && _editor != null && Mostra("corpo"))
        {
            _editorCaricato = true;
            try
            {
                await Task.Delay(120);
                if (!string.IsNullOrWhiteSpace(Blocco.CorpoHtml))
                    await _editor.LoadHTMLContent(Blocco.CorpoHtml);
            }
            catch (Exception ex) { Snackbar.Add($"Editor non inizializzato: {ex.Message}", Severity.Warning); }
        }
    }

    /// <summary>Legge il contenuto dell'editor nel blocco. Vuoto = null, non stringa vuota.</summary>
    private async Task LeggiEditorAsync()
    {
        if (_editor is null || !Mostra("corpo")) return;
        try
        {
            var html = await _editor.GetHTML();
            // Quill produce <p><br></p> per un documento vuoto: e' vuoto a tutti gli effetti,
            // e salvarlo cosi' farebbe passare la validazione su un blocco che non ha contenuto.
            var senzaTag = System.Text.RegularExpressions.Regex.Replace(html ?? "", "<.*?>", "").Trim();
            Blocco.CorpoHtml = string.IsNullOrWhiteSpace(System.Net.WebUtility.HtmlDecode(senzaTag)) ? null : html;
        }
        catch (Exception ex) { Snackbar.Add($"Testo non letto: {ex.Message}", Severity.Warning); }
    }

    /// <summary>Quali gruppi di campi hanno senso per il tipo di blocco corrente.</summary>
    private bool Mostra(string gruppo) => Blocco.Tipo switch
    {
        "testata"   => gruppo is "titolo" or "sottotitolo" or "immagine",
        "testo"     => gruppo is "corpo" or "layout",
        "tour"      => gruppo is "titolo" or "sottotitolo" or "corpo" or "immagine" or "link" or "layout",
        "immagine"  => gruppo is "immagine" or "link" or "layout",
        "pulsante"  => gruppo is "link" or "layout",
        _           => false
    };

    /// <summary>
    /// Un blocco incompleto non si salva: sarebbe uno spazio bianco nella newsletter spedita,
    /// e nessuno se ne accorgerebbe fino a quel momento. Stessa regola usata prima dell'invio.
    /// </summary>
    private async Task Conferma()
    {
        await LeggiEditorAsync();

        var errore = GestioneViaggi.Validation.Business.NewsletterBloccoValidator.Valida(Blocco);
        if (errore != null)
        {
            Snackbar.Add(errore, Severity.Warning);
            return;
        }
        MudDialog?.Close(DialogResult.Ok(Blocco));
    }

    private void Annulla() => MudDialog?.Cancel();
}
