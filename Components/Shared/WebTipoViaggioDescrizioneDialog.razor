@using GestioneViaggi.Models.Web
@using MudBlazor
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

@* Dialog CRUD di una descrizione web di tipo viaggio (Blocco 8).
   NB: lo Slug resta minuscolo (è un URL). La DescrizioneWeb è in MAIUSCOLO forzato (linea guida UI del progetto). *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEditMode ? "Modifica Descrizione Web" : "Nuova Descrizione Web")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Entity">
            <MudTextField T="string" @ref="_firstField" Value="@Entity.DescrizioneWeb"
                          ValueChanged="@((string value) => Entity.DescrizioneWeb = value?.ToUpper() ?? string.Empty)"
                          For="@(() => Entity.DescrizioneWeb)" Label="Descrizione (mostrata sul sito)"
                          Variant="Variant.Outlined" Immediate="true" Required="true"
                          RequiredError="La descrizione è obbligatoria" Validation="@ValidateDescrizioneMinLen"
                          MaxLength="50" tabindex="1" Class="mb-3 uppercase-input" />

            <MudTextField T="string" @bind-Value="Entity.Slug" For="@(() => Entity.Slug)" Label="Slug (URL)"
                          Variant="Variant.Outlined" Immediate="true" Required="true"
                          RequiredError="Lo slug è obbligatorio" MaxLength="50" tabindex="2" Class="mb-3"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.AutoFixHigh"
                          AdornmentColor="Color.Primary" AdornmentAriaLabel="Genera slug dalla descrizione"
                          OnAdornmentClick="GenerateSlug"
                          HelperText="Minuscolo, senza spazi (es. viaggi-4x4). Univoco. Usa la bacchetta per generarlo dalla descrizione." />

            <MudNumericField T="int" @bind-Value="Entity.Ordine" Label="Ordine" Variant="Variant.Outlined"
                             Min="1" tabindex="3" Validation="@ValidateOrdine"
                             HelperText="Posizione nell'elenco: deve essere univoco." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Annulla</MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Primary">
            @(IsEditMode ? "Aggiorna" : "Crea")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private MudTextField<string>? _firstField;

    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public WebTipoViaggioDescrizione Entity { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    /// <summary>Ordini già usati dalle ALTRE descrizioni: per validare l'unicità dell'ordine.</summary>
    [Parameter] public HashSet<int> OrdiniUsati { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation"); } catch { }
            if (_firstField != null)
            {
                await Task.Delay(300);
                try { await _firstField.FocusAsync(); } catch { }
            }
        }
    }

    public void Dispose()
    {
        try { JS.InvokeVoidAsync("dialogFormHelper.cleanup"); } catch { }
    }

    private void Cancel() => MudDialog?.Cancel();

    /// <summary>Genera lo slug (minuscolo, trattini) dalla descrizione. Richiede una descrizione non vuota.</summary>
    private void GenerateSlug()
    {
        if (string.IsNullOrWhiteSpace(Entity.DescrizioneWeb))
        {
            Snackbar.Add("Inserisci prima la descrizione: lo slug si genera da lì.", Severity.Warning);
            return;
        }
        Entity.Slug = Slugify(Entity.DescrizioneWeb);
    }

    /// <summary>La descrizione deve avere almeno 3 caratteri (es. sigle come UTV, MTB). Il vuoto lo gestisce Required.</summary>
    private static string? ValidateDescrizioneMinLen(string value)
        => !string.IsNullOrWhiteSpace(value) && value.Trim().Length < 3
            ? "Inserisci almeno 3 caratteri (es. UTV, MTB)."
            : null;

    /// <summary>L'ordine deve essere >=1 e non già usato da un'altra descrizione.</summary>
    private string? ValidateOrdine(int value)
        => value < 1 ? "L'ordine deve essere almeno 1."
           : OrdiniUsati.Contains(value) ? "Ordine già usato da un'altra descrizione."
           : null;

    private static string Slugify(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var normalized = text.Trim().ToLowerInvariant().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);
        foreach (var c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) == UnicodeCategory.NonSpacingMark) continue;
            sb.Append(char.IsLetterOrDigit(c) ? c : '-');
        }
        var slug = Regex.Replace(sb.ToString(), "-{2,}", "-").Trim('-');
        return slug.Length > 50 ? slug[..50].Trim('-') : slug;
    }

    private async Task HandleSubmit()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (_form.IsValid)
                MudDialog?.Close(DialogResult.Ok(Entity));
            else if (_firstField?.Error == true)
                await _firstField.FocusAsync();
        }
    }
}
