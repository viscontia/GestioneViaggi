@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using MudBlazor
@using GestioneViaggi.Helpers
@inject IAuthenticationService AuthService
@inject AnaViaggiService ViaggiService
@inject MovClientiViaggiService MovClientiService
@inject MovClientiAlloggiService AlloggiService
@inject TipoPartecipanteService TipoPartecipanteService
@inject IClienteService ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
            <MudForm @ref="_form" Model="@_currentEntity" @bind-IsValid="@_isValid">
                
                <MudText Typo="Typo.h6" Class="mb-1" Color="Color.Primary">⚡️ Iscrizione Veloce</MudText>

                @* ⚠️ Va detto QUI a che cosa serve: la scheda non ha modo di far capire da sola
                   che iscrive una persona per volta, e chi ci prova con una coppia perde tempo
                   — la matrimoniale non e' scegliibile, e capirne il motivo e' impossibile
                   senza questa riga (Adriano, 2026-09-07). *@
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Iscrive <b>una persona che viaggia da sola</b>: il pilota che parte per conto suo.
                    Per una coppia, una famiglia o chiunque condivida la sistemazione con altri, usa
                    <b>Partecipanti</b> sulla partenza: lì si iscrivono tutti e poi si compongono le camere.
                </MudAlert>

                <!-- STEP 1: CONTEXT SELECTION -->
                <MudCard Elevation="0" Outlined="true" Class="pa-3 mb-4 bg-light">
                    <!-- 1. Select Viaggio (Only Future?) -->
                    <MudSelect T="int" Label="Seleziona Viaggio" Value="_selectedViaggioId" ValueChanged="OnViaggioChanged"
                               Required="true" AdornmentIcon="@Icons.Material.Filled.FlightTakeoff" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach(var v in _viaggiList) 
                        {
                            <MudSelectItem Value="@v.Id">@v.DescrizioneBreve</MudSelectItem>
                        }
                    </MudSelect>

                    <!-- 2. Select Date -->
                    <MudSelect T="int" Label="Seleziona Data" Value="_selectedDataId" ValueChanged="OnDataChanged"
                               Disabled="@(_selectedViaggioId == 0)" Required="true" 
                               AdornmentIcon="@Icons.Material.Filled.CalendarMonth" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach(var d in _dateList)
                        {
                            <MudSelectItem Value="@d.Id">Dal @d.DataInizio?.ToString("dd/MM/yyyy") al @d.DataFine?.ToString("dd/MM/yyyy")</MudSelectItem>
                        }
                    </MudSelect>
                    @* L'elenco qui mostra solo partenze future, ma la data puo' essere passata
                       mentre la finestra era aperta, o la partenza puo' essere stata marcata come
                       effettuata. Chi guarda deve capire subito perche' non puo' proseguire. *@
                    @if (_partenzaConclusa)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                            @_motivoNonIscrivibile
                        </MudAlert>
                    }
                </MudCard>

                <!-- STEP 2: PARTICIPANT DATA -->
                @if (_selectedDataId > 0 && !_partenzaConclusa)
                {
                    <ClienteSelect @bind-SelectedCliente="@_selectedCliente"
                                   AziendaId="@_currentAziendaId"
                                   Required="true" 
                                   RequiredError="Selezionare un cliente"
                                   Class="mb-3" />

                    <MudGrid Spacing="2">
                         <MudItem xs="6">
                             <MudSelect T="int" Label="Ruolo" @bind-Value="_currentEntity.TipoPartecipanteIdFk" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                 @foreach(var t in _tipoPartecipanti)
                                 {
                                     <MudSelectItem Value="@t.Id">@t.Descrizione</MudSelectItem>
                                 }
                             </MudSelect>
                         </MudItem>
                         <MudItem xs="6" Class="d-flex align-center">
                             <MudCheckBox @bind-Value="@_hasDog" Label="Con Cane" Color="Color.Warning" Dense="true" />
                         </MudItem>
                    </MudGrid>

                    @* Chi guida deve poter descrivere il mezzo: il database lo pretende
                       (tipo_partecipante_dati_mezzo_obb), e finora questa form non lo chiedeva
                       nemmeno — cosi' da qui un pilota non si poteva iscrivere. *@
                    @if (IsPilot(_currentEntity.TipoPartecipanteIdFk))
                    {
                        <DatiMezzoPartecipante Entity="_currentEntity" />
                    }

                    <MudDivider Class="my-4" />

                    <!-- Accommodation -->
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>🏠 Alloggio</b></MudText>
                        <MudSwitch @bind-Value="@_wantsAccommodation" Label="Assegna la camera adesso" Color="Color.Success" Size="Size.Small" />
                    </div>

                    @if (_wantsAccommodation)
                    {
                         @* Qui si iscrive una persona per volta: il gruppo e' di uno. *@
                         @* ⚠️ Solo le sistemazioni da UN posto. Senza il filtro l'elenco le
                            mostrava tutte, matrimoniale compresa: la si poteva scegliere e il
                            salvataggio veniva poi rifiutato dal database (SqlScripts/616),
                            perche' la capienza deve corrispondere agli occupanti. Offrire una
                            scelta che verra' rifiutata e' peggio che non offrirla. *@
                         <TipoAlloggioSelect DataViaggioId="@_selectedDataId"
                                             @bind-SelectedId="_currentAlloggio.TipoAlloggioIdFk"
                                             CapienzaEsatta="1"
                                             PersoneDaSistemare="1"
                                             HelperText="Solo sistemazioni da un posto: qui si iscrive chi viaggia da solo"
                                             Required="@_wantsAccommodation"
                                             Class="mb-3" />
                    }
                }

            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudTooltip Text="@(_motivoNonIscrivibile ?? "Iscrive il partecipante")">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                       Disabled="@(!_isValid || _partenzaConclusa)">Inserisci</MudButton>
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // Lists
    private List<GestioneViaggi.Models.AnaViaggi> _viaggiList = new();
    private List<GestioneViaggi.Models.AnaDataViaggio> _dateList = new();
    private List<TipoPartecipante> _tipoPartecipanti = new();

    // Selection
    private int _selectedViaggioId;
    private int _selectedDataId;
    private Cliente? _selectedCliente;

    // Entity
    private MovClientiViaggi _currentEntity = new();
    private MovClientiAlloggi _currentAlloggio = new();
    private bool _hasDog;
    private bool _wantsAccommodation = true;

    // UI State
    private MudForm _form = default!;
    private bool _isValid;

    /// <summary>
    /// Se la partenza scelta e' gia' conclusa. Lo dice il database
    /// (<c>fn_partenza_conclusa</c>, SqlScripts/578), la stessa definizione che rifiuta
    /// l'inserimento: qui non si riscrive un confronto di date per conto proprio.
    /// </summary>
    private string? _motivoNonIscrivibile;
    private bool _partenzaConclusa => _motivoNonIscrivibile is not null;

    protected override async Task OnInitializedAsync()
    {
         // Load Lookups
        _tipoPartecipanti = (await TipoPartecipanteService.GetAllAsync()).ToList();
        // I tipi di sistemazione NON si caricano qui: dipendono dalla partenza, che
        // l'utente sceglie dopo. Si leggono in OnDataChanged.

        // Load Future Viaggi (Optimized)
        // SECURITY: Filter by user's company
        var user = await AuthService.GetCurrentUserAsync();
        var allViaggi = await ViaggiService.GetAllAsync(user?.AziendaId, DateTime.Now.Year, false, true); 
        _viaggiList = allViaggi.OrderBy(x => x.DescrizioneBreve).ToList();
    }

    private async Task OnDataChanged(int dataId)
    {
        _selectedDataId = dataId;
        _motivoNonIscrivibile = dataId > 0 ? await MovClientiService.MotivoNonIscrivibileAsync(dataId) : null;

        // ⚠️ Rileggere le sistemazioni ammesse e azzerare quella non piu' valida non si fa
        // piu' qui: lo fa TipoAlloggioSelect quando gli cambia la partenza sotto. Era una
        // regola scritta in questa scheda sola, e le altre due non ce l'avevano.
    }

    private async Task OnViaggioChanged(int viaggioId)
    {
        _selectedViaggioId = viaggioId;
        _selectedDataId = 0;
        _motivoNonIscrivibile = null;
        
        // Load Dates for this Trip
        var dates = await ViaggiService.GetDatesByTripIdAsync(viaggioId, null, false, true); // Future Only
        _dateList = dates.ToList();
    }

    private int _currentAziendaId => _viaggiList.FirstOrDefault(v => v.Id == _selectedViaggioId)?.AziendaId ?? 0;

    /// <summary>
    /// Il ruolo dice se questa persona guida. Si legge dal dato
    /// (<c>tipo_partecipante_pilota</c>), non dalla descrizione: «PILOTA MOTO PROPRIA» e
    /// «GUIDA IN SECONDA» guidano entrambi, e nessuna regola sul testo li tiene insieme.
    /// </summary>
    private bool IsPilot(int tipoId) => _tipoPartecipanti.FirstOrDefault(x => x.Id == tipoId)?.Pilota ?? false;

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            _currentEntity.ViaggioIdFk = _selectedViaggioId;
            _currentEntity.DataViaggioIdFk = _selectedDataId;
            _currentEntity.ClienteIdFk = _selectedCliente!.ClienteId;
            _currentEntity.MovClienteViaggioCaneSino = _hasDog ? "Y" : "N";

            // La validazione del database prima di scrivere: se manca l'email di chi guida
            // la chiede e la salva, invece di limitarsi a rifiutare l'iscrizione.
            if (!await IscrizionePartecipante.PuoProcedereAsync(
                    _currentEntity, modifica: false, MovClientiService, ClienteService, DialogService, Snackbar))
                return;

            await MovClientiService.AddParticipantAsync(_currentEntity);

            if (_wantsAccommodation && _currentAlloggio.TipoAlloggioIdFk > 0)
            {
                // ⚠️ La stessa scrittura di tutte le altre: fn_alloggi_salva_camera.
                // Questa scheda aveva una strada sua (AddAccommodationAsync), che non
                // controllava la capienza e non toglieva la persona da un'altra camera.
                _currentAlloggio.ViaggioIdFk = _selectedViaggioId;
                _currentAlloggio.DataViaggioIdFk = _selectedDataId;
                await AlloggiService.SalvaCameraAsync(
                    _currentAlloggio, new[] { _selectedCliente.ClienteId });
            }

            Snackbar.Add("Inserimento completato!", Severity.Success);
            
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
