@using GestioneViaggi.Models.Web
@using Blazored.TextEditor
@using MudBlazor
@inject ISnackbar Snackbar

@* Revisione di una traduzione (Blocco 10): sorgente IT a sinistra (sola lettura) e traduzione
   editabile; toggle "revisionato".

   I campi *_html contengono markup prodotto dall'editor RichText. Farli modificare come TESTO
   con i tag a vista è da evitare: l'utente non deve sapere cosa sia un <strong>, e ogni tag
   toccato per sbaglio rompe la pagina pubblica. Qui si usa quindi lo STESSO editor visuale con
   cui si scrive l'italiano: si vede il grassetto, non il tag.
   Effetto collaterale utile: Quill normalizza il markup al caricamento, quindi aprire e salvare
   una traduzione con HTML corrotto (capita: il modello a volte sbaglia i tag) la ripara. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Label — @LinguaLabel</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Sorgente (italiano)</MudText>
        <MudPaper Outlined="true" Class="pa-2 mb-3" Style="max-height:180px;overflow:auto;">
            @if (CampoHtml)
            {
                <div class="rev-html">@((MarkupString)SourceText)</div>
            }
            else
            {
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@SourceText</MudText>
            }
        </MudPaper>

        <MudText Typo="Typo.caption" Color="Color.Secondary">Traduzione (@LinguaLabel)</MudText>

        @if (CampoHtml)
        {
            <div style="border:1px solid var(--mud-palette-lines-default); border-radius:4px; overflow:hidden; display:flex; flex-direction:column; min-height:220px;">
                <BlazoredTextEditor @ref="_editor" Placeholder="Traduzione...">
                    <ToolbarContent>
                        <span class="ql-formats">
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-list" value="ordered"></button>
                            <button class="ql-list" value="bullet"></button>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-link"></button>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-clean"></button>
                        </span>
                    </ToolbarContent>
                </BlazoredTextEditor>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                Modifica il testo come in un documento: la formattazione si applica con i pulsanti qui sopra.
            </MudText>
        }
        else
        {
            <MudTextField @bind-Value="_testo" Variant="Variant.Outlined" Lines="4" AutoGrow="true" AutoFocus="true" />
        }

        <MudCheckBox @bind-Value="_revisionato" Label="Revisionato (traduzione verificata)" Color="Color.Primary" Class="mt-2" />
        @if (Traduzione.Obsoleto)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Questa traduzione è segnata obsoleta (l'italiano è cambiato).</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_salvando" OnClick="Salva">Salva</MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* Il markup dell'editor arriva con margini propri: qui vanno compattati per non sprecare spazio. */
    .rev-html p { margin: 0 0 .4rem 0; }
    .rev-html p:last-child { margin-bottom: 0; }
    .rev-html ul, .rev-html ol { margin: 0 0 .4rem 1.2rem; padding: 0; }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public WebTraduzione Traduzione { get; set; } = default!;
    [Parameter, EditorRequired] public string SourceText { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string LinguaLabel { get; set; } = "";

    private string? _testo;
    private bool _revisionato;
    private bool _salvando;
    private BlazoredTextEditor? _editor;
    private bool _htmlCaricato;

    /// <summary>
    /// Campi scritti con l'editor RichText, quindi da modificare visualmente.
    /// Il suffisso <c>_html</c> NON basta: <c>viaggio_incluso</c>/<c>viaggio_escluso</c> contengono
    /// markup pur non chiamandosi così (verificato sui dati), e con la sola regola sul nome finivano
    /// davanti all'utente come tag grezzi.
    /// </summary>
    private static readonly HashSet<string> CampiRichText = new(StringComparer.OrdinalIgnoreCase)
    {
        "descrizione_html", "info_pernottamento_html", "info_pasti_html",
        "info_equipaggiamento_html", "altre_info_html", "testo_html",
        "viaggio_incluso", "viaggio_escluso"
    };

    /// <summary>
    /// true se il campo va trattato come HTML. Oltre all'elenco esplicito si guarda il contenuto:
    /// se il testo contiene tag va comunque mostrato reso, altrimenti un campo aggiunto in futuro e
    /// dimenticato nell'elenco tornerebbe a mostrare markup all'utente.
    /// </summary>
    private bool CampoHtml =>
        (Traduzione.Campo is { } c && (CampiRichText.Contains(c) || c.EndsWith("_html", StringComparison.OrdinalIgnoreCase)))
        || ContieneTag(SourceText) || ContieneTag(Traduzione.Testo);

    private static bool ContieneTag(string? testo)
        => !string.IsNullOrEmpty(testo)
           && System.Text.RegularExpressions.Regex.IsMatch(testo, "<[a-zA-Z/][^>]*>");

    protected override void OnInitialized()
    {
        _testo = Traduzione.Testo;
        _revisionato = Traduzione.Revisionato;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!CampoHtml || _htmlCaricato || _editor is null) return;
        _htmlCaricato = true;

        // Quill può non essere ancora pronto al primo render: stesso schema con ritentativi
        // già usato in WebTourContenutiTab.
        for (var tentativo = 0; tentativo < 3; tentativo++)
        {
            try
            {
                await Task.Delay(150);
                if (!string.IsNullOrWhiteSpace(_testo))
                    await _editor.LoadHTMLContent(_testo);
                break;
            }
            catch when (tentativo < 2)
            {
                // riprova
            }
        }
    }

    private async Task Salva()
    {
        _salvando = true;
        try
        {
            if (CampoHtml && _editor is not null)
            {
                var html = await _editor.GetHTML();
                // Un editor svuotato produce "<p><br></p>": salvarlo significherebbe pubblicare un
                // paragrafo vuoto al posto della traduzione.
                if (string.IsNullOrWhiteSpace(StripHtml(html)))
                {
                    Snackbar.Add("La traduzione non può restare vuota.", Severity.Warning);
                    return;
                }
                _testo = html;
            }
            else if (string.IsNullOrWhiteSpace(_testo))
            {
                Snackbar.Add("La traduzione non può restare vuota.", Severity.Warning);
                return;
            }

            Traduzione.Testo = _testo ?? string.Empty;
            Traduzione.Revisionato = _revisionato;
            Traduzione.Obsoleto = false;        // una revisione risolve l'obsolescenza
            Traduzione.TradottoAuto = false;    // toccata a mano
            MudDialog.Close(DialogResult.Ok(Traduzione));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore lettura editor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    /// <summary>Testo senza tag, per capire se il contenuto è realmente vuoto.</summary>
    private static string StripHtml(string? html)
        => string.IsNullOrEmpty(html)
            ? string.Empty
            : System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", string.Empty)
                .Replace("&nbsp;", " ").Trim();

    private void Cancel() => MudDialog.Cancel();
}
