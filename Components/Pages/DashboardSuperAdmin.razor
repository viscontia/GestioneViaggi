@page "/dashboard-superadmin"
@using GestioneViaggi.Services.Authentication
@using MudBlazor
@using GestioneViaggi.Services.Navigation
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Statistics
@attribute [Authorize(Roles = "superadmin")]
@layout DashboardLayout
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject StatisticCountAziende StatAziende
@inject StatisticCountClienti StatClienti
@inject StatisticCountViaggi StatViaggi
@inject StatisticCountViaggiFatti StatViaggiFatti
@inject StatisticCountViaggiDaFare StatViaggiDaFare
@inject StatisticRevenue StatRevenue
@inject StatisticYearService StatYear
@inject ITabManagerService TabManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Services.Shared.IRecentActivityService ActivityService
@inject Services.Printing.ITravelPrintService PrintService
@inject Services.Printing.IRoomingListPrintService RoomingListPrintService

@if (!_isLoaded)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100vh;">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    <MudText Typo="Typo.h6" Class="mt-4">Caricamento Dashboard...</MudText>
</MudStack>
}
else
{
    <MudStack Spacing="4" Class="fade-in-content">

    <!-- Header -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
                    Dashboard Super Admin
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Benvenuto, @_currentUser?.FullName - Accesso globale a tutte le aziende
                </MudText>
            </div>
            @if (_selectedYear == _currentYear)
                {
                    <div class="ml-4" style="width: 200px; flex: none;">
                        <MudTooltip>
                            <TooltipContent>
                                <MudText Typo="Typo.body2" Align="Align.Left">
                                    <b>Anno Intero (YoY):</b> Confronto con l'intero anno precedente.<br />
                                    <b>Su Periodo (PoP):</b> Confronto con lo stesso periodo (date esatte) dell'anno precedente.
                                </MudText>
                            </TooltipContent>
                            <ChildContent>
                                <MudSelect T="ComparisonMode" Value="_comparisonMode" ValueChanged="OnComparisonModeChanged"
                                    Label="Modalità Confronto" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="ComparisonMode.FullYear">Anno Intero (YoY)</MudSelectItem>
                                    <MudSelectItem Value="ComparisonMode.PeriodOverPeriod">Su Periodo (PoP)</MudSelectItem>
                                </MudSelect>
                            </ChildContent>
                        </MudTooltip>
                    </div>
                }
                <div class="d-flex" style="width: 250px; flex: none;">
                    <MudMenu @bind-Open="_isMenuOpen" Label="@GetYearLabel()" Variant="Variant.Outlined"
                        EndIcon="@Icons.Material.Filled.KeyboardArrowDown" FullWidth="true"
                        AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                        <MudList T="int" SelectedValue="_selectedYear" SelectedValueChanged="OnYearChanged" Dense="true"
                            Style="max-height: 350px; overflow-y: auto;">
                            @* Anno Corrente *@
                            <MudListItem Value="@_currentYear">
                                <MudText Typo="Typo.body1"><b>@_currentYear (corrente)</b></MudText>
                            </MudListItem>

                            <MudDivider />

                            @* Anni Passati *@
                            <MudListItem Text="Anni Passati">
                                <NestedList>
                                    @foreach (var year in _pastYears)
                                    {
                                        <MudListItem Value="@year">@year</MudListItem>
                                    }
                                </NestedList>
                            </MudListItem>

                            @* Anni Futuri *@
                            <MudListItem Text="Anni Futuri">
                                <NestedList>
                                    @foreach (var year in _futureYears)
                                    {
                                        <MudListItem Value="@year">@year</MudListItem>
                                    }
                                </NestedList>
                            </MudListItem>
                        </MudList>
                    </MudMenu>
                </div>
            </MudStack>
        </MudPaper>

        <!-- Stats Cards -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" Class="col-custom-6">
                <MudPaper Elevation="2" Class="pa-4 cursor-pointer stat-card-interactive" Style="height: 100%; border: 1px solid var(--mud-palette-divider, transparent);" @onclick="@(() => NavigateToSection($"/anagrafiche/aziende?year={_selectedYear}", $"Anagrafica Aziende {_selectedYear}", "business"))">
                    <MudTooltip Placement="Placement.Top" RootStyle="display: block; width: 100%;">
                        <TooltipContent>
                            @GetTooltipContent(_statsAziende, "Aziende", true)
                        </TooltipContent>
                        <ChildContent>
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 4px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large"
                                        Color="Color.Primary" />
                                    <MudStack Spacing="0" AlignItems="AlignItems.End">
                                        <MudChip T="string" Size="Size.Large"
                                            Color="@(GetTrendColor(_statsAziende?.PercentageChange ?? 0))"
                                            Variant="Variant.Text"
                                            Icon="@(GetTrendIcon(_statsAziende?.PercentageChange ?? 0))">
                                            @(_statsAziende?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                        </MudChip>
                                        <MudText Typo="Typo.body1"
                                            Color="@(GetTrendColor(_statsAziende?.PercentageChange ?? 0))"
                                            Style="font-weight: bold" Class="mr-2">
                                            @(_statsAziende?.Increment.ToString("+0;-0;0"))
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Style="height: 60px; width: 100%;">
                                    <MudText Typo="Typo.h3" Style="font-weight: 700; line-height: 1.2;">@(_statsAziende?.MainValue ?? 0)</MudText>
                        <MudPaper Height="60px" Elevation="0" Class="d-flex align-end ml-4" Style="flex: 1; min-width: 60px; max-width: 140px; background: transparent;">
                        @if (_statsAziende?.TrendData?.Count == 12)
                        {
                                <svg width="100%" height="100%" viewBox="0 0 140 60" preserveAspectRatio="none" aria-hidden="true">
                                    @{
                                        var data = _statsAziende.TrendData;
                                        var max = data.Any() ? data.Max() : 1;
                                        if (max == 0) max = 1;
                                        var barWidth = 140.0 / 12.0;
                                        var gap = 2.0;
                                        barWidth -= gap;

                                        for (int i = 0; i < 12; i++)
                                        {
                                            var val = (i < data.Count) ? data[i] : 0;
                                            var height = (val / max) * 60.0;
                                            var x = i * (barWidth + gap);
                                            var y = 60.0 - height;
                                            var monthName = System.Globalization.CultureInfo.GetCultureInfo("it-IT").DateTimeFormat.GetAbbreviatedMonthName(i + 1);
                                            var toolTip = $"{monthName}: {val}";

                                            <!-- Background Bar (Placeholder) -->
                                            <rect x="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="0" width="@barWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)" height="60" fill="#e0e0e0" rx="2">
                                                <title>@toolTip</title>
                                            </rect>

                                            <!-- Data Bar -->
                                            @if (val > 0)
                                            {
                                                <rect x="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" width="@barWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)" height="@height.ToString(System.Globalization.CultureInfo.InvariantCulture)" fill="@Colors.DeepPurple.Default" rx="2">
                                                    <title>@toolTip</title>
                                                </rect>
                                            }
                                        }
                                    }
                                </svg>
                        }
                        else
                        {
                            <div class="chart-skeleton" style="width: 140px; height: 60px;"></div>
                        }
                        </MudPaper>
                                </MudStack>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 4px;">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Aziende Totali</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetTotalLabelSuffix()
                                            </MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.body2" Style="font-size: 12px; color: var(--mud-palette-text-secondary);">(% @_selectedYear su
                                            @(_selectedYear - 1))
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </ChildContent>
                    </MudTooltip>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="col-custom-6">
