@page "/dashboard-superadmin"
@using GestioneViaggi.Services.Authentication
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Statistics
@attribute [Authorize(Roles = "superadmin")]
@layout DashboardLayout
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject StatisticCountAziende StatAziende
@inject StatisticCountClienti StatClienti
@inject StatisticCountViaggi StatViaggi
@inject StatisticCountViaggiFatti StatViaggiFatti
@inject StatisticCountViaggiDaFare StatViaggiDaFare
@inject StatisticRevenue StatRevenue

<MudStack Spacing="4">

    <!-- Header -->
    <MudPaper Elevation="2" Class="pa-4">
        <div>
            <MudText Typo="Typo.h4" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
                Dashboard Super Admin
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Benvenuto, @_currentUser?.FullName - Accesso globale a tutte le aziende
            </MudText>
        </div>
    </MudPaper>

    <!-- Stats Cards -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Primary" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large" Color="@(GetTrendColor(_statsAziende?.PercentageChange ?? 0))" 
                                         Variant="Variant.Text" Icon="@(GetTrendIcon(_statsAziende?.PercentageChange ?? 0))">
                                    @(_statsAziende?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                </MudChip>
                                <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsAziende?.PercentageChange ?? 0))" Style="font-weight: bold" Class="mr-2">
                                    @(_statsAziende?.Increment.ToString("+0;-0;0"))
                                </MudText>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h4">@(_statsAziende?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Aziende Totali</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(% @DateTime.Now.Year su @(DateTime.Now.Year - 1))</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Success" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large" Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))" 
                                         Variant="Variant.Text" Icon="@(GetTrendIcon(_statsClienti?.PercentageChange ?? 0))">
                                    @(_statsClienti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                </MudChip>
                                <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))" Style="font-weight: bold" Class="mr-2">
                                    @(_statsClienti?.Increment.ToString("+0;-0;0"))
                                </MudText>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h4">@(_statsClienti?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Clienti Totali</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(% @DateTime.Now.Year su @(DateTime.Now.Year - 1))</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Size="Size.Large" Color="Color.Info" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large" Color="@(GetTrendColor(_statsViaggi?.PercentageChange ?? 0))" 
                                         Variant="Variant.Text" Icon="@(GetTrendIcon(_statsViaggi?.PercentageChange ?? 0))">
                                    @(_statsViaggi?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                </MudChip>
                                <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsViaggi?.PercentageChange ?? 0))" Style="font-weight: bold" Class="mr-2">
                                    @(_statsViaggi?.Increment.ToString("+0;-0;0"))
                                </MudText>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h4">@(_statsViaggi?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Viaggi Totali</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(% @DateTime.Now.Year su @(DateTime.Now.Year - 1))</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EuroSymbol" Size="Size.Large" Color="Color.Tertiary" />
                        <MudText Typo="Typo.h4">@(_statsRevenue?.MainValue ?? 0)</MudText>
                        <MudText Typo="Typo.body2">Fatturato</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Secondary" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large" Color="@(GetTrendColor(_statsViaggiFatti?.PercentageChange ?? 0))" 
                                         Variant="Variant.Text" Icon="@(GetTrendIcon(_statsViaggiFatti?.PercentageChange ?? 0))">
                                    @(_statsViaggiFatti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                </MudChip>
                                <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsViaggiFatti?.PercentageChange ?? 0))" Style="font-weight: bold" Class="mr-2">
                                    @(_statsViaggiFatti?.Increment.ToString("+0;-0;0"))
                                </MudText>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h4">@(_statsViaggiFatti?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Viaggi fatti @DateTime.Now.Year</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">fino al @DateTime.Now.ToString("dd/MM/yyyy")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Warning" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large" Color="@(GetTrendColor(_statsViaggiDaFare?.PercentageChange ?? 0))" 
                                         Variant="Variant.Text" Icon="@(GetTrendIcon(_statsViaggiDaFare?.PercentageChange ?? 0))">
                                    @(_statsViaggiDaFare?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                </MudChip>
                                <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsViaggiDaFare?.PercentageChange ?? 0))" Style="font-weight: bold" Class="mr-2">
                                    @(_statsViaggiDaFare?.Increment.ToString("+0;-0;0"))
                                </MudText>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h4">@(_statsViaggiDaFare?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Viaggi da fare @DateTime.Now.Year</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">fino al 31/12/@DateTime.Now.Year</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Quick Actions -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Azioni Rapide</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business">
                    Gestisci Aziende
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.People">
                    Gestisci Utenti
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Settings">
                    Configurazione Sistema
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Info Note -->
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Hai accesso completo a tutte le funzionalità e dati del sistema. Usa i permessi di SuperAdmin con responsabilità.
        </MudAlert>

</MudStack>

@code {
    private Models.UserInfo? _currentUser;
    private StatisticResult? _statsAziende;
    private StatisticResult? _statsClienti;
    private StatisticResult? _statsViaggi;
    private StatisticResult? _statsRevenue;
    private StatisticResult? _statsViaggiFatti;
    private StatisticResult? _statsViaggiDaFare;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
        
        // Load Statistics
        var tasks = new Task[]
        {
            Task.Run(async () => _statsAziende = await StatAziende.GetStatsAsync()),
            Task.Run(async () => _statsClienti = await StatClienti.GetStatsAsync()),
            Task.Run(async () => _statsViaggi = await StatViaggi.GetStatsAsync()),
            Task.Run(async () => _statsRevenue = await StatRevenue.GetStatsAsync()),
            Task.Run(async () => _statsViaggiFatti = await StatViaggiFatti.GetStatsAsync()),
            Task.Run(async () => _statsViaggiDaFare = await StatViaggiDaFare.GetStatsAsync())
        };

        await Task.WhenAll(tasks);
    }

    private Color GetTrendColor(double value) => value switch
    {
        > 0 => Color.Success,
        < 0 => Color.Error,
        _ => Color.Default
    };

    private string GetTrendIcon(double value) => value switch
    {
        > 0 => Icons.Material.Filled.TrendingUp,
        < 0 => Icons.Material.Filled.TrendingDown,
        _ => Icons.Material.Filled.TrendingFlat
    };
}
