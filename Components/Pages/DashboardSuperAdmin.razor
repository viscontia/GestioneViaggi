                                        </MudStack>
                                        <MudText Typo="Typo.body2" Style="font-size: 12px; color: var(--mud-palette-text-secondary);">(% @_selectedYear su
                                            @(_selectedYear - 1))
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </ChildContent>
                    </MudTooltip>
                </MudPaper>
            </MudItem>
