@page "/dashboard-superadmin"
@using GestioneViaggi.Services.Authentication
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Statistics
@attribute [Authorize(Roles = "superadmin")]
@layout DashboardLayout
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject StatisticCountAziende StatAziende
@inject StatisticCountClienti StatClienti
@inject StatisticCountViaggi StatViaggi
@inject StatisticCountViaggiFatti StatViaggiFatti
@inject StatisticCountViaggiDaFare StatViaggiDaFare
@inject StatisticRevenue StatRevenue
@inject StatisticYearService StatYear

@if (!_isLoaded)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100vh;">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    <MudText Typo="Typo.h6" Class="mt-4">Caricamento Dashboard...</MudText>
</MudStack>
}
else
{
    <MudStack Spacing="4">

    <!-- Header -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
                    Dashboard Super Admin
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Benvenuto, @_currentUser?.FullName - Accesso globale a tutte le aziende
                </MudText>
            </div>
            @if (_selectedYear == _currentYear)
                {
                    <div class="ml-4" style="width: 200px; flex: none;">
                        <MudTooltip>
                            <TooltipContent>
                                <MudText Typo="Typo.body2" Align="Align.Left">
                                    <b>Anno Intero (YoY):</b> Confronto con l'intero anno precedente.<br />
                                    <b>Su Periodo (PoP):</b> Confronto con lo stesso periodo (date esatte) dell'anno precedente.
                                </MudText>
                            </TooltipContent>
                            <ChildContent>
                                <MudSelect T="ComparisonMode" Value="_comparisonMode" ValueChanged="OnComparisonModeChanged"
                                    Label="Modalità Confronto" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="ComparisonMode.FullYear">Anno Intero (YoY)</MudSelectItem>
                                    <MudSelectItem Value="ComparisonMode.PeriodOverPeriod">Su Periodo (PoP)</MudSelectItem>
                                </MudSelect>
                            </ChildContent>
                        </MudTooltip>
                    </div>
                }
                <div class="d-flex" style="width: 250px; flex: none;">
                    <MudMenu @bind-Open="_isMenuOpen" Label="@GetYearLabel()" Variant="Variant.Outlined"
                        EndIcon="@Icons.Material.Filled.KeyboardArrowDown" FullWidth="true"
                        AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                        <MudList T="int" SelectedValue="_selectedYear" SelectedValueChanged="OnYearChanged" Dense="true"
                            Style="max-height: 350px; overflow-y: auto;">
                            @* Anno Corrente *@
                            <MudListItem Value="@_currentYear">
                                <MudText Typo="Typo.body1"><b>@_currentYear (corrente)</b></MudText>
                            </MudListItem>

                            <MudDivider />

                            @* Anni Passati *@
                            <MudListItem Text="Anni Passati">
                                <NestedList>
                                    @foreach (var year in _pastYears)
                                    {
                                        <MudListItem Value="@year">@year</MudListItem>
                                    }
                                </NestedList>
                            </MudListItem>

                            @* Anni Futuri *@
                            <MudListItem Text="Anni Futuri">
                                <NestedList>
                                    @foreach (var year in _futureYears)
                                    {
                                        <MudListItem Value="@year">@year</MudListItem>
                                    }
                                </NestedList>
                            </MudListItem>
                        </MudList>
                    </MudMenu>
                </div>
            </MudStack>
        </MudPaper>

        <!-- Stats Cards -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudTooltip Placement="Placement.Top">
                    <TooltipContent>
                        @GetTooltipContent(_statsAziende, "Aziende", true)
                    </TooltipContent>
                    <ChildContent>
                        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large"
                                        Color="Color.Primary" />
                                    <MudStack Spacing="0" AlignItems="AlignItems.End">
                                        <MudChip T="string" Size="Size.Large"
                                            Color="@(GetTrendColor(_statsAziende?.PercentageChange ?? 0))"
                                            Variant="Variant.Text"
                                            Icon="@(GetTrendIcon(_statsAziende?.PercentageChange ?? 0))">
                                            @(_statsAziende?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                        </MudChip>
                                        <MudText Typo="Typo.body1"
                                            Color="@(GetTrendColor(_statsAziende?.PercentageChange ?? 0))"
                                            Style="font-weight: bold" Class="mr-2">
                                            @(_statsAziende?.Increment.ToString("+0;-0;0"))
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.h4">@(_statsAziende?.MainValue ?? 0)</MudText>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">Aziende Totali</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetTotalLabelSuffix()
                                            </MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(% @_selectedYear su
                                            @(_selectedYear - 1))
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </ChildContent>
                </MudTooltip>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudTooltip Placement="Placement.Top">
                    <TooltipContent>
                        @GetTooltipContent(_statsClienti, "Clienti", true)
                    </TooltipContent>
                    <ChildContent>
                        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Success" />
                                    <MudStack Spacing="0" AlignItems="AlignItems.End">
                                        <MudChip T="string" Size="Size.Large"
                                            Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))"
                                            Variant="Variant.Text"
                                            Icon="@(GetTrendIcon(_statsClienti?.PercentageChange ?? 0))">
                                            @(_statsClienti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                        </MudChip>
                                        <MudText Typo="Typo.body1"
                                            Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))"
                                            Style="font-weight: bold" Class="mr-2">
                                            @(_statsClienti?.Increment.ToString("+0;-0;0"))
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.h4">@(_statsClienti?.MainValue ?? 0)</MudText>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">Clienti Totali</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetTotalLabelSuffix()
                                            </MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(% @_selectedYear su
                                            @(_selectedYear - 1))
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </ChildContent>
                </MudTooltip>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudTooltip Placement="Placement.Top">
                    <TooltipContent>
                        @GetTooltipContent(_statsViaggi, "Viaggi", true)
                    </TooltipContent>
                    <ChildContent>
                        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Size="Size.Large"
                                        Color="Color.Info" />
                                    <MudStack Spacing="0" AlignItems="AlignItems.End">
                                        <MudChip T="string" Size="Size.Large"
                                            Color="@(GetTrendColor(_statsViaggi?.PercentageChange ?? 0))"
                                            Variant="Variant.Text"
                                            Icon="@(GetTrendIcon(_statsViaggi?.PercentageChange ?? 0))">
                                            @(_statsViaggi?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                        </MudChip>
                                        <MudText Typo="Typo.body1"
                                            Color="@(GetTrendColor(_statsViaggi?.PercentageChange ?? 0))"
                                            Style="font-weight: bold" Class="mr-2">
                                            @(_statsViaggi?.Increment.ToString("+0;-0;0"))
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.h4">@(_statsViaggi?.MainValue ?? 0)</MudText>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">Viaggi Totali</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetTotalLabelSuffix()
                                            </MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(% @_selectedYear su
                                            @(_selectedYear - 1))
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </ChildContent>
                </MudTooltip>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EuroSymbol" Size="Size.Large" Color="Color.Tertiary" />
                        <MudText Typo="Typo.h4">@(_statsRevenue?.MainValue ?? 0)</MudText>
                            <MudText Typo="Typo.body2">Fatturato</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudTooltip Placement="Placement.Top">
                        <TooltipContent>
                            @GetTooltipContent(_statsViaggiFatti, "Viaggi Fatti", false)
                        </TooltipContent>
                        <ChildContent>
                            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large"
                                            Color="Color.Secondary" />
                                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                                            <MudChip T="string" Size="Size.Large"
                                                Color="@(GetTrendColor(_statsViaggiFatti?.PercentageChange ?? 0))"
                                                Variant="Variant.Text"
                                                Icon="@(GetTrendIcon(_statsViaggiFatti?.PercentageChange ?? 0))">
                                                @(_statsViaggiFatti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                                        </MudChip>
                                        <MudText Typo="Typo.body1"
                                            Color="@(GetTrendColor(_statsViaggiFatti?.PercentageChange ?? 0))"
                                            Style="font-weight: bold" Class="mr-2">
                                            @(_statsViaggiFatti?.Increment.ToString("+0;-0;0"))
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.h4">@(_statsViaggiFatti?.MainValue ?? 0)</MudText>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">Viaggi fatti</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">nel @_selectedYear</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">fino al
                                            @GetEffectiveEndDate().ToString("dd/MM/yyyy")</MudText>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </ChildContent>
                    </MudTooltip>
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudTooltip Placement="Placement.Top">
                        <TooltipContent>
                            @GetTooltipContent(_statsViaggiDaFare, "Viaggi Da Fare", false)
                        </TooltipContent>
                        <ChildContent>
                            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Warning" />
                                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                                            <MudChip T="string" Size="Size.Large"
                                                Color="@(GetTrendColor(GetDisplayPercentage(_statsViaggiDaFare)))"
                                                Variant="Variant.Text"
                                                Icon="@(GetTrendIcon(GetDisplayPercentage(_statsViaggiDaFare)))">
                                                @(GetDisplayPercentage(_statsViaggiDaFare).ToString("+0.#;-0.#;0"))%
                                        </MudChip>
                                        <MudText Typo="Typo.body1"
                                            Color="@(GetTrendColor(GetDisplayPercentage(_statsViaggiDaFare)))"
                                            Style="font-weight: bold" Class="mr-2">
                                            @(GetDisplayIncrement(_statsViaggiDaFare).ToString("+0;-0;0"))
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.h4">@(_statsViaggiDaFare?.MainValue ?? 0)</MudText>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">@GetViaggiDaFareLabel()</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetViaggiDaFareSubtitle()
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </ChildContent>
                    </MudTooltip>
                </MudItem>
            </MudGrid>

            <!-- Quick Actions -->
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Azioni Rapide</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business">
                        Gestisci Aziende
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.People">
                        Gestisci Utenti
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Settings">
                        Configurazione Sistema
                    </MudButton>
                </MudStack>
            </MudPaper>

            <!-- Info Note -->
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Hai accesso completo a tutte le funzionalità e dati del sistema. Usa i permessi di SuperAdmin con
                responsabilità.
            </MudAlert>

        </MudStack>
}

@code {
    private bool _isLoaded = false;
    private Models.UserInfo? _currentUser;
    private bool _isMenuOpen;
    private ComparisonMode _comparisonMode = ComparisonMode.FullYear;
    private StatisticResult? _statsAziende;
    private StatisticResult? _statsClienti;
    private StatisticResult? _statsViaggi;
    private StatisticResult? _statsRevenue;
    private StatisticResult? _statsViaggiFatti;
    private StatisticResult? _statsViaggiDaFare;

    private int _selectedYear = DateTime.Now.Year;
    private int _currentYear = DateTime.Now.Year;
    private List<int> _pastYears = new();
    private List<int> _futureYears = new();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();

        _currentYear = DateTime.Now.Year;
        // Fetch oldest year from DB (null for global/SuperAdmin)
        int oldestYear = await StatYear.GetMaxOldYearCompanyAsync(null);

        // Forced Logic: Always show at least 5 years back
        int startYear = Math.Min(oldestYear, _currentYear - 5);

        // Anni passati (dal più recente al più vecchio)
        _pastYears.Clear();
        for (int i = _currentYear - 1; i >= startYear; i--)
        {
            _pastYears.Add(i);
        }

        // Anni futuri (dal più vicino al più lontano)
        _futureYears.Clear();
        for (int i = _currentYear + 1; i <= _currentYear + 5; i++)
        {
            _futureYears.Add(i);
        }

        // Ensure selected year is valid
        if (_selectedYear < startYear || _selectedYear > _currentYear + 5)
        {
            _selectedYear = _currentYear;
        }

        await LoadStatsAsync();

        // FIX RENDER: MacCatalyst needs a delay to properly re-render interactive elements after navigation
        await Task.Delay(150);
        _isLoaded = true;
    }

    private string GetYearLabel()
    {
        string suffix = _selectedYear == _currentYear ? " (corrente)" : "";
        return $"Anno: {_selectedYear}{suffix}";
    }

    private async Task OnYearSelected(int year)
    {
        if (_selectedYear != year)
        {
            _selectedYear = year;
            await LoadStatsAsync();
        }
    }

    private async Task OnYearChanged(int year)
    {
        _selectedYear = year;
        _isMenuOpen = false;
        // Reset comparison mode when changing year (optional, but requested logic implies PoP relevant mainly for current year)
        if (_selectedYear != _currentYear) _comparisonMode = ComparisonMode.FullYear;
        await LoadStatsAsync();
    }

    private async Task OnComparisonModeChanged(ComparisonMode mode)
    {
        _comparisonMode = mode;
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        // Load Statistics
        var tasks = new Task[]
        {
Task.Run(async () => _statsAziende = await StatAziende.GetStatsAsync(_selectedYear, _comparisonMode)),
Task.Run(async () => _statsClienti = await StatClienti.GetStatsAsync(_selectedYear, null, _comparisonMode)),
Task.Run(async () => _statsViaggi = await StatViaggi.GetStatsAsync(_selectedYear, null, _comparisonMode)),
Task.Run(async () => _statsRevenue = await StatRevenue.GetStatsAsync(_selectedYear, null, _comparisonMode)),
Task.Run(async () => _statsViaggiFatti = await StatViaggiFatti.GetStatsAsync(_selectedYear, null, _comparisonMode)),
Task.Run(async () => _statsViaggiDaFare = await StatViaggiDaFare.GetStatsAsync(_selectedYear, null, _comparisonMode))
        };

        await Task.WhenAll(tasks);
    }

    private DateTime GetEffectiveEndDate()
    {
        DateTime endOfYear = new DateTime(_selectedYear, 12, 31);
        return DateTime.Today < endOfYear ? DateTime.Today : endOfYear;
    }

    private Color GetTrendColor(double value) => value switch
    {
        > 0 => Color.Success,
        < 0 => Color.Error,
        _ => Color.Default
    };

    private RenderFragment GetTooltipContent(StatisticResult? stats, string entityName, bool isStockMetric)
    {
        if (stats == null) return builder => { };

        return builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "pa-3");

            // Header: Total Value - "684 Clienti Totali al 12/01/2026"
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "style", "font-size: 1.2em; font-weight: bold; margin-bottom: 8px;");

            string dateContext = _selectedYear == _currentYear ? $"al {DateTime.Today:dd/MM/yyyy}" : $"nel {_selectedYear}";
            builder.AddContent(4, $"{stats.MainValue:N0} {entityName} {(isStockMetric ? "Totali" : "")} {dateContext}");
            builder.CloseElement(); // div header

            builder.OpenElement(5, "div");
            builder.AddAttribute(6, "style", "font-size: 1.1em;");

            // Define labels and values based on ComparisonMode and Entity
            string labelCurr = "";
            string labelPrev = "";
            long valueCurr = stats.CurrentYearValue;
            long valuePrev = stats.PreviousYearValue;

            if (_comparisonMode == ComparisonMode.PeriodOverPeriod && _selectedYear == _currentYear)
            {
                // PoP Mode
                // "Questo Periodo (dal 01/01/2026 al 12/01/2026): +3"
                // "Periodo prec. (dal 01/01/2025 al 12/01/2025): +681"
                string currDates = $"(dal 01/01/{_selectedYear} al {DateTime.Today:dd/MM/yyyy})";
                string prevDates = $"(dal 01/01/{_selectedYear - 1} al {DateTime.Today.AddYears(-1):dd/MM/yyyy})";

                labelCurr = $"• Questo Periodo {currDates}:";
                labelPrev = $"• Periodo prec. {prevDates}:";

                if (isStockMetric)
                {
                    // For stock metrics in PoP (Hybrid), using ReferenceFlowValue for previous year "flow"
                    valuePrev = stats.ReferenceFlowValue ?? 0;
                }
                // Else (Flow metrics): valuePrev is already stats.PreviousYearValue which is correct flow.
            }
            else
            {
                // YoY Mode (Full Year)
                // Clienti/Aziende: "Acquisiti/Creati nel 2026"
                if (entityName == "Clienti" || entityName == "Aziende")
                {
                    labelCurr = $"• Acquisiti/Creati nel {_selectedYear}:";
                }
                else if (entityName == "Viaggi")
                {
                    labelCurr = $"• Creati nel {_selectedYear}:";
                }
                else if (entityName == "Viaggi Fatti" || stats == _statsViaggiFatti)
                {
                    labelCurr = $"• Realizzati nel {_selectedYear}:";
                }
                else // Viaggi Da Fare
                {
                    labelCurr = $"• Preparati nel {_selectedYear}:";
                }

                labelPrev = $"• Periodo prec. (fino al {_selectedYear - 1}):";
            }

            // Render Row 1
            builder.OpenElement(7, "div");
            builder.AddAttribute(8, "class", "d-flex justify-space-between");
            builder.AddContent(9, labelCurr);
            builder.OpenElement(10, "span");
            builder.AddAttribute(11, "style", "font-weight: bold; margin-left: 8px;");
            builder.AddContent(12, $"{valueCurr:+0;-0;0}");
            builder.CloseElement();
            builder.CloseElement();

            // Render Row 2
            builder.OpenElement(13, "div");
            builder.AddAttribute(14, "class", "d-flex justify-space-between");
            builder.AddContent(15, labelPrev);
            builder.OpenElement(16, "span");
            builder.AddAttribute(17, "style", "font-weight: bold; margin-left: 8px;");
            builder.AddContent(18, $"{valuePrev:+0;-0;0}");
            builder.CloseElement();
            builder.CloseElement();

            builder.CloseElement(); // div body
            builder.CloseElement(); // div main
        };
    }

    private string GetTrendIcon(double value) => value switch
    {
        > 0 => Icons.Material.Filled.TrendingUp,
        < 0 => Icons.Material.Filled.TrendingDown,
        _ => Icons.Material.Filled.TrendingFlat
    };

    private string GetTotalLabelSuffix()
    {
        return _selectedYear == DateTime.Now.Year ? "Fino ad oggi" : $"a tutto il {_selectedYear}";
    }

    private string GetViaggiDaFareLabel()
    {
        return _selectedYear < _currentYear ? "Viaggi non fatti" : $"Viaggi da fare {_selectedYear}";
    }

    private string GetViaggiDaFareSubtitle()
    {
        return _selectedYear < _currentYear ? $"nel {_selectedYear}" : $"fino al 31/12/{_selectedYear}";
    }

    private double GetDisplayPercentage(StatisticResult? stats)
    {
        if (stats == null) return 0;
        // If future year and value is 0, show 0% instead of -100%
        if (_selectedYear > _currentYear && stats.MainValue == 0) return 0;
        return stats.PercentageChange;
    }

    private double GetDisplayIncrement(StatisticResult? stats)
    {
        if (stats == null) return 0;
        // If future year and value is 0, show 0 increment instead of negative
        if (_selectedYear > _currentYear && stats.MainValue == 0) return 0;
        return stats.Increment;
    }
}
