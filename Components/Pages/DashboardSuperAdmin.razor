                                                                <title>@toolTip</title>
                                                            </rect>
                                                        }
                                                    }
                                                }
                                            </svg>
                                    }
                                    else
                                    {
                                        <div class="chart-skeleton" style="width: 140px; height: 60px;"></div>
                                    }
                                    </MudPaper>
                                </MudStack>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 4px;">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Clienti Totali</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetTotalLabelSuffix()
