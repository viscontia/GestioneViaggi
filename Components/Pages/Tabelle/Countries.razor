@page "/tabelle/nazioni"
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.UI
@using MudBlazor
@inject CountryService Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStatusBarService StatusBarService
@attribute [Authorize]
@implements IDisposable

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
        <MudText Typo="Typo.h6">ERRORE:</MudText>
        <MudText>@_errorMessage</MudText>
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body1" Class="mb-4">Debug Info: Items loaded: @_items?.Count</MudText>

    @if (_items != null)
    {
        <MudDataGrid T="Country"
                     Items="@_items"
                     Filterable="true"
                     SortMode="SortMode.Multiple"
                     Groupable="false"
                     QuickFilter="@_quickFilter"
                     @bind-SelectedItem="_selectedItem"
                     Breakpoint="Breakpoint.None"
                     Elevation="1">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Gestione Nazioni</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" 
                              Placeholder="Cerca..." 
                              Adornment="Adornment.Start" 
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              IconSize="Size.Medium" 
                              Class="mt-0" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenCreateDialog"
                           Class="ml-4">
                    Nuovo
                </MudButton>
            </ToolBarContent>

            <Columns>
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                            <MudTooltip Text="Modifica">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Elimina">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => DeleteItem(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Name" Title="Nome Nazione" />
                <PropertyColumn Property="x => x.Nationality" Title="Nazionalità" />
                <PropertyColumn Property="x => x.CountryCode" Title="Codice" HeaderClass="col-sm" />
                <PropertyColumn Property="x => x.IsoAlpha2" Title="ISO" HeaderClass="col-sm" />
                <PropertyColumn Property="x => x.Capital" Title="Capitale" />
                <PropertyColumn Property="x => x.Population" Title="Popolazione" Format="N0" HeaderClass="col-lg justify-end" CellClass="col-lg" CellStyle="text-align: right;" />
                <PropertyColumn Property="x => x.AreaKm2" Title="Area (kmq)" Format="N2" HeaderClass="col-lg justify-end" CellClass="col-lg" CellStyle="text-align: right;" />
                <PropertyColumn Property="x => x.RegionName" Title="Regione" />
                <PropertyColumn Property="x => x.SubRegionName" Title="Sotto-Regione" />
                <PropertyColumn Property="x => x.IntermediateName" Title="Reg. Intermedia" />
                <PropertyColumn Property="x => x.OrganizationName" Title="Organizzazione" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="Country" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>

        </MudDataGrid>
    }
}

@code {
    private List<Country> _items = new();
    private Country? _selectedItem;
    private string _errorMessage = string.Empty;

    private string _searchString = string.Empty;
    private Func<Country, bool> _quickFilter => x => Search(x, _searchString);

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("Countries.OnInitializedAsync: Started");
        try 
        {
            StatusBarService.SetCurrentTable("eba_countries");
            Console.WriteLine("Countries.OnInitializedAsync: StatusBar set");
            await LoadDataAsync();
            Console.WriteLine("Countries.OnInitializedAsync: Data loaded");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Countries.OnInitializedAsync Error: {ex}");
            _errorMessage = ex.Message;
        }
    }

    public void Dispose()
    {
        StatusBarService.SetCurrentTable(null);
    }

    private async Task LoadDataAsync()
    {
        try
        {
            Console.WriteLine("Countries.LoadDataAsync: Calling Service");
            _errorMessage = string.Empty;
            _items = await Service.GetAllOrderedByNameAsync();
            Console.WriteLine($"Countries.LoadDataAsync: Service returned {_items?.Count ?? 0} items");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Countries.LoadDataAsync Error: {ex}");
            _errorMessage = $"Errore durante il caricamento: {ex.Message}";
        }
    }

    private bool Search(Country item, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (item.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.Nationality?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.CountryCode?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.IsoAlpha2?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.Capital?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.RegionName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.SubRegionName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.IntermediateName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.OrganizationName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CountryDialog>
        {
            { x => x.Entity, new Country() },
            { x => x.IsEditMode, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CountryDialog>("Nuova Nazione", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is Country newItem)
        {
            try
            {
                var created = await Service.CreateAsync(newItem);
                await LoadDataAsync();
                Snackbar.Add("Nazione creata con successo", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(Country item)
    {
        var parameters = new DialogParameters<CountryDialog>
        {
            { x => x.Entity, new Country
                {
                    Id = item.Id,
                    Name = item.Name,
                    Nationality = item.Nationality,
                    CountryCode = item.CountryCode,
                    IsoAlpha2 = item.IsoAlpha2,
                    Capital = item.Capital,
                    Population = item.Population,
                    AreaKm2 = item.AreaKm2,
                    RegionId = item.RegionId,
                    SubRegionId = item.SubRegionId,
                    IntermediateRegionId = item.IntermediateRegionId,
                    OrganizationRegionId = item.OrganizationRegionId
                }
            },
            { x => x.IsEditMode, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CountryDialog>("Modifica Nazione", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is Country editedItem)
        {
            try
            {
                await Service.UpdateAsync(editedItem);
                await LoadDataAsync();
                Snackbar.Add("Nazione aggiornata con successo", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteItem(Country item)
    {
        var parameters = new DialogParameters
        {
            { "Title", "Attenzione" },
            { "ContentText", $"Vuoi veramente cancellare questo record? ({item.Name})" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var success = await Service.DeleteAsync(item.Id);
                if (success)
                {
                    _items.Remove(item);
                    Snackbar.Add("Nazione eliminata con successo", Severity.Success);
                    StateHasChanged();
                }
                else
                {
                    Snackbar.Add("Impossibile eliminare la nazione", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }
}
