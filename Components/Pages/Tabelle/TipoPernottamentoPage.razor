@page "/tabelle/tipologie-pernottamento"
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.UI
@using MudBlazor
@using GestioneViaggi.Components.Shared
@inject TipoPernottamentoService Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStatusBarService StatusBarService
@attribute [Authorize]
@implements IDisposable

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
        <MudText Typo="Typo.h6">ERRORE:</MudText>
        <MudText>@_errorMessage</MudText>
    </MudAlert>
}
else
{
    <EnterpriseDataGrid T="TipoPernottamento"
                        Items="@_items"
                        Title="Gestione Tipologie di Pernottamento"
                        SearchFunction="@Search"
                        @bind-SelectedItem="_selectedItem">

        <ToolBarActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateDialog">
                Nuovo
            </MudButton>
        </ToolBarActions>

        <Columns>
            <PropertyColumn Property="x => x.Descrizione" Title="Descrizione" />

            <TemplateColumn Title="Con Albergo" SortBy="x => x.ConAlbergo">
                <CellTemplate>
                    <MudCheckBox Value="@context.Item.ConAlbergo" ReadOnly="true" Color="Color.Primary" Dense="true" />
                </CellTemplate>
            </TemplateColumn>

            <EnterpriseActionsColumn T="TipoPernottamento"
                                     OnEdit="@OpenEditDialog"
                                     OnDelete="@DeleteItem" />
        </Columns>

    </EnterpriseDataGrid>
}

@code {
    private List<TipoPernottamento> _items = new();
    private TipoPernottamento? _selectedItem;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        StatusBarService.SetCurrentTable("ana_tipo_pernottamento");
        await LoadDataAsync();
    }

    public void Dispose()
    {
        StatusBarService.SetCurrentTable(null);
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _errorMessage = string.Empty;
            _items = await Service.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Errore durante il caricamento: {ex.Message}";
        }
    }

    private bool Search(TipoPernottamento item, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (item.Descrizione?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<TipoPernottamentoDialog>
        {
            { x => x.Entity, new TipoPernottamento() },
            { x => x.IsEditMode, false }
        };

        var options = new DialogOptions { BackdropClick = false, 
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
         };

        var dialog = await DialogService.ShowAsync<TipoPernottamentoDialog>("Nuovo", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is TipoPernottamento newItem)
        {
            try
            {
                var created = await Service.CreateAsync(newItem);
                _items.Add(created);
                Snackbar.Add("Creato con successo", Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(TipoPernottamento item)
    {
        var parameters = new DialogParameters<TipoPernottamentoDialog>
        {
            { x => x.Entity, new TipoPernottamento 
                { 
                    Id = item.Id, 
                    Descrizione = item.Descrizione,
                    ConAlbergoDb = item.ConAlbergoDb 
                } 
            },
            { x => x.IsEditMode, true }
        };

        var options = new DialogOptions { BackdropClick = false, 
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
         };

        var dialog = await DialogService.ShowAsync<TipoPernottamentoDialog>("Modifica", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is TipoPernottamento updatedItem)
        {
            try
            {
                var updated = await Service.UpdateAsync(updatedItem);
                var index = _items.FindIndex(c => c.Id == updated.Id);
                if (index >= 0)
                {
                    _items[index] = updated;
                }
                Snackbar.Add("Aggiornato con successo", Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteItem(TipoPernottamento item)
    {
        var parameters = new DialogParameters
        {
            { "Title", "Attenzione" },
            { "ContentText", $"Vuoi veramente cancellare questo record? ({item.Descrizione})" }
        };

        var options = new DialogOptions { BackdropClick = false,  CloseButton = true, MaxWidth = MaxWidth.ExtraSmall  };

        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var success = await Service.DeleteAsync(item.Id);
                if (success)
                {
                    _items.Remove(item);
                    Snackbar.Add("Eliminato con successo", Severity.Success);
                    StateHasChanged();
                }
                else
                {
                    Snackbar.Add("Impossibile eliminare", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }
}
