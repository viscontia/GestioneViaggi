@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using Microsoft.JSInterop
@inject AnaValuteService ValuteService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudForm Model="@Valuta" @ref="_form" Validation="@(new Func<object, string, Task<IEnumerable<string>>>((obj, prop) => Task.FromResult<IEnumerable<string>>(Array.Empty<string>())))">
             <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Codice ISO" 
                                  Value="@Valuta.ValutaCodiceIso"
                                  ValueChanged="@((string s) => Valuta.ValutaCodiceIso = s?.ToUpper() ?? string.Empty)"
                                  @ref="_firstField"
                                  Required="true"
                                  RequiredError="Codice ISO obbligatorio"
                                  MaxLength="3"
                                  Variant="Variant.Outlined" 
                                  HelperText="Es. EUR, USD"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Flag"
                                  Class="uppercase-input"
                                  tabindex="1" />
                </MudItem>
                 <MudItem xs="12" sm="6">
                    <MudTextField Label="Simbolo" 
                                  Value="@Valuta.ValutaSimbolo"
                                  ValueChanged="@((string s) => Valuta.ValutaSimbolo = s?.ToUpper())"
                                  Variant="Variant.Outlined" 
                                  MaxLength="5"
                                  HelperText="Es. €, $"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                  Class="uppercase-input"
                                  tabindex="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Descrizione" 
                                  Value="@Valuta.ValutaDescrizione"
                                  ValueChanged="@((string s) => Valuta.ValutaDescrizione = s?.ToUpper() ?? string.Empty)"
                                  Required="true"
                                  RequiredError="Descrizione obbligatoria"
                                  Variant="Variant.Outlined"
                                  Class="uppercase-input"
                                  tabindex="3" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField Label="Decimali" 
                                     @bind-Value="Valuta.ValutaDecimali" 
                                     Variant="Variant.Outlined" 
                                     Min="0" Max="4"
                                     tabindex="4" />
                </MudItem>
                 <MudItem xs="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="Valuta.ValutaAttiva" Label="Attiva" Color="Color.Success" tabindex="5" />
                </MudItem>
                <MudItem xs="12">
                     <MudSwitch @bind-Value="Valuta.ValutaIsBase" Label="È Valuta Base (EUR)" Color="Color.Warning" Disabled="@(Valuta.ValutaIsBase)" tabindex="6" />
                     @if(Valuta.ValutaIsBase)
                     {
                         <MudText Typo="Typo.caption" Color="Color.Warning">Attenzione: cambiare la valuta base può avere effetti su tutto il sistema.</MudText>
                     }
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AnaValute Valuta { get; set; } = new();

    private MudForm _form = default!;
    private MudTextField<string>? _firstField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
                
                if (_firstField != null)
                {
                    await Task.Delay(300);
                    await _firstField.FocusAsync();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up dialog: {ex.Message}");
            }
        }
    }

    public void Dispose()
    {
        try { JS.InvokeVoidAsync("dialogFormHelper.cleanup"); } catch { }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();

        if (_form.IsValid)
        {
            try
            {
                if (Valuta.ValutaId == 0)
                {
                    await ValuteService.CreateAsync(Valuta);
                    Snackbar.Add("Valuta creata con successo", Severity.Success);
                }
                else
                {
                    await ValuteService.UpdateAsync(Valuta);
                    Snackbar.Add("Valuta aggiornata con successo", Severity.Success);
                }
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }
}
