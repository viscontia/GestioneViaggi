@page "/forgot-password"
@using GestioneViaggi.Models
@using GestioneViaggi.Services.Authentication
@inject PasswordResetService ResetService
@inject NavigationManager Navigation
@layout LoginLayout

<div class="login-fullscreen-container">
    <MudPaper Class="glass-login-card pa-8" Elevation="3" Style="max-width: 440px; width: 100%;">

        <!-- Logo e Titolo -->
        <div class="d-flex flex-column align-center mb-6">
            <MudImage Src="images/logo-gestione-viaggi.png" Alt="Gestione Viaggi Logo" Width="80" Class="mb-3" />
            <MudText Typo="Typo.h5" Class="login-title" Style="color: white; font-weight: bold;">
                @(_currentStep switch
                {
                    Step.EnterEmail => "Password dimenticata",
                    Step.EnterCode => "Verifica codice",
                    Step.NewPassword => "Nuova password",
                    Step.Success => "Fatto!",
                    _ => "Password dimenticata"
                })
            </MudText>
            <MudText Typo="Typo.body2" Class="login-subtitle mt-1" Style="color: rgba(255, 255, 255, 0.9);">
                @(_currentStep switch
                {
                    Step.EnterEmail => "Inserisci la tua email per ricevere un codice di verifica",
                    Step.EnterCode => "Inserisci il codice a 6 cifre ricevuto via email",
                    Step.NewPassword => "Scegli una nuova password sicura",
                    Step.Success => "La password è stata reimpostata con successo",
                    _ => ""
                })
            </MudText>
        </div>

        <!-- Alert Messaggi -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }
        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Variant="Variant.Filled">
                @_infoMessage
            </MudAlert>
        }

        <!-- STEP 1: Inserimento Email -->
        @if (_currentStep == Step.EnterEmail)
        {
            <MudStack Spacing="4">
                <MudTextField
                    @ref="_emailField"
                    @bind-Value="_email"
                    Placeholder="La tua email"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Email"
                    Disabled="@_isLoading"
                    Class="login-input"
                    Margin="Margin.Dense"
                    InputType="InputType.Email"
                    @onkeydown="HandleEmailKeyDown" />

                <MudButton
                    Variant="Variant.Filled"
                    Size="Size.Large"
                    FullWidth="true"
                    Disabled="@_isLoading"
                    Class="login-button py-2"
                    OnClick="HandleRequestReset">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Invio in corso...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" Size="Size.Small" />
                        <span>Invia codice di reset</span>
                    }
                </MudButton>

                <MudLink Href="/login" Underline="Underline.Hover" Class="forgot-password-link">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Torna al login
                </MudLink>
            </MudStack>
        }

        <!-- STEP 2: Inserimento Codice -->
        @if (_currentStep == Step.EnterCode)
        {
            <MudStack Spacing="4">
                <MudTextField
                    @ref="_codeField"
                    @bind-Value="_resetCode"
                    Placeholder="000000"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Pin"
                    Disabled="@_isLoading"
                    Class="login-input"
                    Margin="Margin.Dense"
                    MaxLength="6"
                    Style="letter-spacing: 8px; font-size: 1.4rem; text-align: center; font-weight: 700;"
                    @onkeydown="HandleCodeKeyDown" />

                @if (_expiresAt.HasValue)
                {
                    <div style="text-align: center;">
                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">
                            Il codice scade tra @GetRemainingTime()
                        </MudText>
                    </div>
                }

                <MudButton
                    Variant="Variant.Filled"
                    Size="Size.Large"
                    FullWidth="true"
                    Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_resetCode) || _resetCode.Length != 6)"
                    Class="login-button py-2"
                    OnClick="HandleValidateCode">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Verifica in corso...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" Size="Size.Small" />
                        <span>Verifica codice</span>
                    }
                </MudButton>

                <MudLink Underline="Underline.Hover" Class="forgot-password-link" @onclick="HandleResendCode" Style="cursor: pointer;">
                    Rinvia codice
                </MudLink>

                <MudLink Href="/login" Underline="Underline.Hover" Class="forgot-password-link">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    Torna al login
                </MudLink>
            </MudStack>
        }

        <!-- STEP 3: Nuova Password -->
        @if (_currentStep == Step.NewPassword)
        {
            <MudStack Spacing="4">
                <MudTextField
                    @ref="_newPasswordField"
                    @bind-Value="_newPassword"
                    Placeholder="Nuova password"
                    Variant="Variant.Outlined"
                    InputType="@_newPasswordInputType"
                    Adornment="Adornment.End"
                    AdornmentIcon="@_newPasswordIcon"
                    OnAdornmentClick="ToggleNewPasswordVisibility"
                    Disabled="@_isLoading"
                    Class="login-input"
                    Margin="Margin.Dense" />

                <MudTextField
                    @bind-Value="_confirmPassword"
                    Placeholder="Conferma password"
                    Variant="Variant.Outlined"
                    InputType="@_confirmPasswordInputType"
                    Adornment="Adornment.End"
                    AdornmentIcon="@_confirmPasswordIcon"
                    OnAdornmentClick="ToggleConfirmPasswordVisibility"
                    Disabled="@_isLoading"
                    Class="login-input"
                    Margin="Margin.Dense"
                    @onkeydown="HandlePasswordKeyDown" />

                <!-- Requisiti Password -->
                <div style="padding: 0 4px;">
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.6); margin-bottom: 4px;">Requisiti password:</MudText>
                    <MudText Typo="Typo.caption" Style="@($"color: {(HasMinLength ? "#10B981" : "rgba(255,255,255,0.5)")}")">
                        @(HasMinLength ? "\u2713" : "\u2717") Almeno 8 caratteri
                    </MudText>
                    <MudText Typo="Typo.caption" Style="@($"color: {(HasUpperCase ? "#10B981" : "rgba(255,255,255,0.5)")}")">
                        @(HasUpperCase ? "\u2713" : "\u2717") Almeno una lettera maiuscola
                    </MudText>
                    <MudText Typo="Typo.caption" Style="@($"color: {(HasSpecialChar ? "#10B981" : "rgba(255,255,255,0.5)")}")">
                        @(HasSpecialChar ? "\u2713" : "\u2717") Almeno un carattere speciale
                    </MudText>
                    <MudText Typo="Typo.caption" Style="@($"color: {(PasswordsMatch ? "#10B981" : "rgba(255,255,255,0.5)")}")">
                        @(PasswordsMatch ? "\u2713" : "\u2717") Le password corrispondono
                    </MudText>
                </div>

                <MudButton
                    Variant="Variant.Filled"
                    Size="Size.Large"
                    FullWidth="true"
                    Disabled="@(_isLoading || !IsPasswordValid)"
                    Class="login-button py-2"
                    OnClick="HandleResetPassword">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Reset in corso...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-2" Size="Size.Small" />
                        <span>Reimposta password</span>
                    }
                </MudButton>
            </MudStack>
        }

        <!-- STEP 4: Successo -->
        @if (_currentStep == Step.Success)
        {
            <MudStack Spacing="4" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large"
                         Style="color: #10B981; font-size: 64px;" />

                <MudButton
                    Variant="Variant.Filled"
                    Size="Size.Large"
                    FullWidth="true"
                    Class="login-button py-2"
                    OnClick="@(() => Navigation.NavigateTo("/login"))">
                    <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" Size="Size.Small" />
                    <span>Vai al login</span>
                </MudButton>
            </MudStack>
        }

    </MudPaper>
</div>

@code {
    private enum Step { EnterEmail, EnterCode, NewPassword, Success }

    private Step _currentStep = Step.EnterEmail;
    private bool _isLoading;
    private string? _errorMessage;
    private string? _infoMessage;

    // Step 1
    private string _email = string.Empty;
    private MudTextField<string>? _emailField;

    // Step 2
    private string _resetCode = string.Empty;
    private MudTextField<string>? _codeField;
    private DateTime? _expiresAt;

    // Step 3
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _newPasswordVisible;
    private bool _confirmPasswordVisible;
    private MudTextField<string>? _newPasswordField;

    // Password visibility
    private InputType _newPasswordInputType => _newPasswordVisible ? InputType.Text : InputType.Password;
    private string _newPasswordIcon => _newPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    private InputType _confirmPasswordInputType => _confirmPasswordVisible ? InputType.Text : InputType.Password;
    private string _confirmPasswordIcon => _confirmPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    // Password validation
    private bool HasMinLength => _newPassword.Length >= 8;
    private bool HasUpperCase => _newPassword.Any(char.IsUpper);
    private bool HasSpecialChar => _newPassword.Any(c => "!@#$%^&*()_+-=[]{};\':\"\\|,.<>/?".Contains(c));
    private bool PasswordsMatch => !string.IsNullOrEmpty(_confirmPassword) && _newPassword == _confirmPassword;
    private bool IsPasswordValid => HasMinLength && HasUpperCase && HasSpecialChar && PasswordsMatch;

    private void ToggleNewPasswordVisibility() => _newPasswordVisible = !_newPasswordVisible;
    private void ToggleConfirmPasswordVisibility() => _confirmPasswordVisible = !_confirmPasswordVisible;

    private string GetRemainingTime()
    {
        if (!_expiresAt.HasValue) return "";
        var remaining = _expiresAt.Value - DateTime.UtcNow;
        if (remaining.TotalSeconds <= 0) return "scaduto";
        return $"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}";
    }

    // === STEP 1: Richiedi reset ===

    private async Task HandleEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoading)
            await HandleRequestReset();
    }

    private async Task HandleRequestReset()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Inserisci un indirizzo email.";
            return;
        }

        try
        {
            var addr = new System.Net.Mail.MailAddress(_email);
            if (addr.Address != _email)
            {
                _errorMessage = "Formato email non valido.";
                return;
            }
        }
        catch
        {
            _errorMessage = "Formato email non valido.";
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var (success, message) = await ResetService.RequestResetAsync(_email);

            if (success)
            {
                _expiresAt = DateTime.UtcNow.AddMinutes(15);
                _infoMessage = message;
                _errorMessage = null;
                _currentStep = Step.EnterCode;
            }
            else
            {
                _errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Errore di connessione. Riprova più tardi.";
            Console.WriteLine($"Reset request error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // === STEP 2: Valida codice ===

    private async Task HandleCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoading && _resetCode.Length == 6)
            await HandleValidateCode();
    }

    private async Task HandleValidateCode()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (string.IsNullOrWhiteSpace(_resetCode) || _resetCode.Length != 6)
        {
            _errorMessage = "Inserisci il codice a 6 cifre.";
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var (isValid, userId, email, message) = await ResetService.ValidateCodeAsync(_resetCode);

            if (isValid)
            {
                _infoMessage = null;
                _errorMessage = null;
                _currentStep = Step.NewPassword;
            }
            else
            {
                _errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Errore di connessione. Riprova più tardi.";
            Console.WriteLine($"Code validation error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleResendCode()
    {
        _errorMessage = null;
        _infoMessage = null;
        _resetCode = string.Empty;
        _currentStep = Step.EnterEmail;
        StateHasChanged();
    }

    // === STEP 3: Reset password ===

    private async Task HandlePasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoading && IsPasswordValid)
            await HandleResetPassword();
    }

    private async Task HandleResetPassword()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (!IsPasswordValid)
        {
            _errorMessage = "Verifica che la password soddisfi tutti i requisiti.";
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var (success, message) = await ResetService.ResetPasswordAsync(_resetCode, _newPassword);

            if (success)
            {
                _errorMessage = null;
                _infoMessage = message;
                _currentStep = Step.Success;
            }
            else
            {
                _errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Errore di connessione. Riprova più tardi.";
            Console.WriteLine($"Password reset error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
