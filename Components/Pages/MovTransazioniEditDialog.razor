@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Components.Shared
@using GestioneViaggi.Models.DTOs
@using GestioneViaggi.Validation.Core
@using GestioneViaggi.Validation.Semantic
@using Microsoft.Extensions.Logging
@inject MovTransazioniService TransazioniService
@inject AnaTipiCausaliService CausaliService
@inject AnaAliquoteIvaService AliquoteIvaService
@inject AnaValuteService ValuteService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext
@inject ISessionManager SessionManager
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject FiscalCalculationService FiscalCalcService
@inject ILogger<MovTransazioniEditDialog> _logger
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@_dialogTitle</MudText>
            <MudTooltip Text="Guida alla registrazione contabile">
                <MudButton StartIcon="@Icons.Material.Filled.HelpOutline" 
                           Color="Color.Info" 
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="@OpenHelpAsync">
                    Guida
                </MudButton>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@Transazione" @ref="_form" id="mov-transazioni-form" Validation="@(new Func<object, string, Task<IEnumerable<string>>>((obj, prop) => Task.FromResult<IEnumerable<string>>(Array.Empty<string>())))">
            <MudGrid>
                <!-- RIGA 1: Data e Tipo -->
                <MudItem xs="6">
                    <MudDatePicker @ref="_firstField"
                                   Label="Data Transazione *"
                                   @bind-Date="_dataTransazione"
                                   Required="true"
                                   RequiredError="Data obbligatoria"
                                   Variant="Variant.Outlined"
                                   Editable="true" Class="campo-data" TextUpdateSuppression="false"
                                   Converter="@_conv1" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                   AnchorOrigin="Origin.BottomCenter" />
                </MudItem>
                <MudItem xs="6">
                    <CausaleSelect SelectedCausaleId="Transazione.TransazioneCausaleTipoId"
                                   SelectedCausaleIdChanged="@OnCausaleChanged"
                                   AziendaId="@AziendaId"
                                   Items="@_initData.Causali"
                                   Label="Causale Contabile *"
                                   Required="true" />
                </MudItem>

                <!-- RIGA 2: Controparte e Descrizione -->
                <MudItem xs="12" sm="6">
                    <ControparteSelect @bind-SelectedControparteId="Transazione.TransazioneControparteId"
                                       AziendaId="@AziendaId"
                                       Items="@_initData.Controparti"
                                       CausaleCiclo="@_causaleCicloCorrente"
                                       Label="@(_causaleCicloCorrente == "ATTIVO" ? "Cliente *" : _causaleCicloCorrente == "PASSIVO" ? "Fornitore *" : "Controparte *")"
                                       Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Descrizione *"
                                  Value="@Transazione.TransazioneCausale"
                                  ValueChanged="@((string val) => HandleCausaleChanged(val))"
                                  Required="true"
                                  RequiredError="Descrizione obbligatoria"
                                  Variant="Variant.Outlined"
                                  Class="uppercase-input" />
                </MudItem>

                <!-- RIGA 3: Importo e Valuta -->
                <MudItem xs="6">
                    <MudNumericField @bind-Value="Transazione.TransazioneImporto"
                                     Label="Importo *"
                                     Format="N2"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                </MudItem>
                <MudItem xs="6">
                    <ValutaSelect SelectedValutaId="Transazione.TransazioneValutaId"
                                  SelectedValutaIdChanged="@OnValutaChanged"
                                  Items="@_initData.Valute"
                                  Label="Valuta *"
                                  Required="true" />
                </MudItem>

                <!-- SEZIONE DETTAGLIO RIGHE (MASTER-DETAIL) -->
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudText Typo="Typo.subtitle2">
                            <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="mr-1" />
                            Dettaglio Righe
                        </MudText>
                        <MudStack Row="true">
                            @if (_showHelperCalcolo)
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                           Color="Color.Secondary"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="@ApplicaCalcoloRegime"
                                           Disabled="@(Transazione.TransazioneImporto <= 0)">
                                    Applica Calcolo Regime
                                </MudButton>
                            }
                            <MudButton StartIcon="@Icons.Material.Filled.Add" 
                                       Color="Color.Primary" 
                                       Variant="Variant.Outlined" 
                                       Size="Size.Small"
                                       OnClick="@AddRiga">
                                Aggiungi Riga
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    <MudDataGrid T="MovTransazioniRighe" Items="@Transazione.Righe" EditMode="DataGridEditMode.Cell" 
                                 ReadOnly="false" Bordered="true" Dense="true" Hover="true">
                        <Columns>
                            <PropertyColumn Property="x => x.RigaNumero" Title="#" Editable="false" HeaderStyle="width: 50px;" />
                            <TemplateColumn Title="Descrizione" CellStyle="min-width: 250px;">
                                <EditTemplate>
                                    <MudTextField Value="@context.Item.RigaDescrizione" 
                                                  ValueChanged="@((string s) => context.Item.RigaDescrizione = s?.ToUpper() ?? string.Empty)"
                                                  Variant="Variant.Text" 
                                                  Margin="Margin.Dense" 
                                                  Class="uppercase-input" />
                                </EditTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Tipo" HeaderStyle="width: 150px;">
                                <EditTemplate>
                                    <MudSelect @bind-Value="context.Item.RigaTipo" Margin="Margin.Dense" T="string">
                                        <MudSelectItem Value="@("PRESTAZIONE")">Prestazione</MudSelectItem>
                                        <MudSelectItem Value="@("CASSA_PREV")">Cassa Prev.</MudSelectItem>
                                        <MudSelectItem Value="@("BOLLO")">Bollo</MudSelectItem>
                                        <MudSelectItem Value="@("SPESA_ART15")">Spese Art.15</MudSelectItem>
                                    </MudSelect>
                                </EditTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Imponibile" HeaderStyle="width: 120px;">
                                <EditTemplate>
                                    <MudNumericField @bind-Value="context.Item.RigaImponibile" Margin="Margin.Dense" Format="N2" Culture="@(new System.Globalization.CultureInfo("it-IT"))" T="decimal" OnBlur="@(() => OnRigaImponibileChanged(context.Item))" />
                                </EditTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="IVA (%)" HeaderStyle="width: 130px;">
                                <EditTemplate>
                                    <AliquotaIvaSelect SelectedAliquotaId="context.Item.RigaAliquotaIvaFk"
                                                      SelectedAliquotaIdChanged="@((id) => OnRigaAliquotaChanged(context.Item, id))"
                                                      AziendaId="@AziendaId"
                                                      Items="@_initData.AliquoteIva" />
                                </EditTemplate>
                                <CellTemplate>
                                    @(context.Item != null ? $"{context.Item.AliquotaIvaCodice} ({context.Item.AliquotaIvaPercentuale}%)" : "")
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.RigaIvaValore" Title="IVA Val." Editable="false" HeaderStyle="width: 100px;" Format="N2" />
                            <PropertyColumn Property="x => x.RigaLordo" Title="Lordo" Editable="false" HeaderStyle="width: 100px;" Format="N2" />
                            <TemplateColumn CellStyle="width: 50px;" Editable="false">
                                <CellTemplate>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveRiga(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                    
                    <!-- Riepilogo Totali Calcolati -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px;">
                            <MudGrid>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.h6" Color="Color.Primary">IMPONIBILE: @(Transazione.Righe?.Sum(r => r.RigaImponibile).ToString("N2") ?? "0,00") €</MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.h6" Color="Color.Primary">IVA: @(Transazione.Righe?.Sum(r => r.RigaIvaValore).ToString("N2") ?? "0,00") €</MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudText Typo="Typo.h6" Color="Color.Primary">TOTALE: @(Transazione.Righe?.Sum(r => r.RigaLordo).ToString("N2") ?? "0,00") €</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                </MudItem>

                <!-- RIGA 5: Stato Pagamento -->
                <MudItem xs="12">
                    <MudSelect T="string" Label="Stato Pagamento" @bind-Value="Transazione.TransazioneStato" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("DA_PAGARE")">Da Pagare</MudSelectItem>
                        <MudSelectItem Value="@("PAGATO")">Pagato</MudSelectItem>
                        <MudSelectItem Value="@("PARZIALMENTE_PAGATO")">Parzialmente Pagato</MudSelectItem>
                        <MudSelectItem Value="@("ANNULLATO")">Annullato</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- RIGA 5: Numero Documento e Data Documento (vicini) -->
                <MudItem xs="6">
                    <MudTextField Label="N. Documento / Fattura"
                                  Value="@Transazione.TransazioneNumeroDocumento"
                                  ValueChanged="@((string val) => HandleNumeroDocumentoChanged(val))"
                                  Variant="Variant.Outlined"
                                  Class="uppercase-input"
                                  Error="@_numeroDocumentoError"
                                  ErrorText="@_numeroDocumentoErrorText" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="Data Documento"
                                   @bind-Date="_dataDocumento"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Class="campo-data" TextUpdateSuppression="false"
                                   Converter="@_conv2" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                   Clearable="true"
                                   Error="@_dataDocumentoError"
                                   ErrorText="@_dataDocumentoErrorText" />
                </MudItem>

                <!-- RIGA 7: Note -->
                <MudItem xs="12">
                    <MudTextField Label="Note"
                                  Value="@Transazione.TransazioneNote"
                                  ValueChanged="@((string val) => HandleNoteChanged(val))"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Class="uppercase-input" />
                </MudItem>

                <!-- RIGA 8: Date Scadenza e Pagamento -->
                <MudItem xs="6">
                    <MudDatePicker Label="@(_scadenzaObbligatoria ? "Data Scadenza *" : "Data Scadenza")"
                                   @bind-Date="_dataScadenza"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Class="campo-data" TextUpdateSuppression="false"
                                   Converter="@_conv3" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                   Clearable="true"
                                   Required="@_scadenzaObbligatoria"
                                   Error="@_dataScadenzaError"
                                   ErrorText="@_dataScadenzaErrorText" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="Data Pagamento"
                                   @bind-Date="_dataPagamento"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Editable="true" Class="campo-data" TextUpdateSuppression="false"
                                   Converter="@_conv4" DateFormat="dd/MM/yyyy" Placeholder="gg/mm/aaaa"
                                   Clearable="true"
                                   Error="@_dataPagamentoError"
                                   ErrorText="@_dataPagamentoErrorText" />
                </MudItem>

                <!-- RIGA 9: Viaggio e Data Viaggio -->
                <MudItem xs="6">
                    <ViaggioSelect @bind-SelectedViaggioId="Transazione.TransazioneViaggioId"
                                   AziendaId="@AziendaId"
                                   CustomItems="@_initData.Viaggi"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="6">
                    <DataViaggioSelect @bind-SelectedDataViaggioId="Transazione.TransazioneDataViaggioId"
                                       ViaggioId="@Transazione.TransazioneViaggioId"
                                       Clearable="true" />
                </MudItem>

            </MudGrid>

            @if(Transazione.TransazioneId > 0 && Transazione.TransazioneLordoEur.HasValue && Transazione.ValutaCodiceIso != "EUR")
            {
                 <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true">
                     Controvalore calcolato: <b>@Transazione.TransazioneLordoEur?.ToString("N2") EUR</b> (da @Transazione.TransazioneImporto.ToString("N2") @Transazione.ValutaCodiceIso)
                 </MudAlert>
            }

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isLoading">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isLoading">
            @if (_isLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Attendere...</MudText>
            }
            else
            {
                @("Salva")
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Un'istanza per campo: il convertitore tiene l'esito dell'ultima conversione,
    // e condividerla farebbe comparire l'errore di un campo sugli altri.
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv1 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv2 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv3 = new();
    private readonly GestioneViaggi.Helpers.ConvertitoreDataFlessibile _conv4 = new();

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public MovTransazioni Transazione { get; set; } = new();
    [Parameter] public int AziendaId { get; set; }

    private string _dialogTitle => Transazione.TransazioneId == 0 ? "Nuova Transazione" : "Modifica Transazione";

    private MudForm _form = default!;
    private MudDatePicker? _firstField;
    private DateTime? _dataTransazione;
    private DateTime? _dataDocumento;
    private DateTime? _dataScadenza;
    private DateTime? _dataPagamento;

    // Validation error flags
    private bool _numeroDocumentoError = false;
    private string _numeroDocumentoErrorText = string.Empty;
    private bool _dataDocumentoError = false;
    private string _dataDocumentoErrorText = string.Empty;
    private bool _dataScadenzaError = false;
    private string _dataScadenzaErrorText = string.Empty;
    private bool _dataPagamentoError = false;
    private string _dataPagamentoErrorText = string.Empty;

    // Scadenza reattiva properties
    private AnaTipoCausale? _selectedCausale;
    private bool _scadenzaObbligatoria = false;
    private int? _giorniScadenzaDefault = null;

    // Ciclo contabile corrente (ATTIVO/PASSIVO) per filtraggio controparti
    private string? _causaleCicloCorrente = null;

    // ==========================================
    // IVA - Gestione Reattiva
    // ==========================================
    private bool _valutaIsEur = true;
    private bool _causaleGeneraIva = false;
    private bool _causaleRichiedeIva = false;
    private decimal? _aliquotaPercentuale = null;

    // Helper calcolo regime fiscale
    private bool _showHelperCalcolo = false;

    // Loading flag
    private bool _isLoading = false;
    private TransazioneInitData _initData = new();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            // FAT INIT: Carica tutto in un'unica chiamata
            _initData = await TransazioniService.GetTransazioneInitDataAsync(AziendaId, 
                Transazione.TransazioneId > 0 ? Transazione.TransazioneId : null);

            _showHelperCalcolo = _initData.ShowHelperCalcolo;

            if (Transazione.TransazioneId == 0)
            {
                _dataTransazione = DateTime.Today;
                Transazione.TransazioneStato = "DA_PAGARE";
                Transazione.TransazioneAziendaId = AziendaId;

                // Imposta la valuta di default dell'utente corrente
                var session = await SessionManager.GetSessionAsync();
                if (session?.User?.ValutaDefaultId.HasValue == true)
                {
                    Transazione.TransazioneValutaId = session.User.ValutaDefaultId.Value;
                    var defaultValuta = _initData.Valute.FirstOrDefault(v => v.ValutaId == Transazione.TransazioneValutaId);
                    if (defaultValuta != null)
                    {
                        Transazione.ValutaCodiceIso = defaultValuta.ValutaCodiceIso;
                    }
                }
            }
            else
            {
                // Se i dati della transazione sono ritornati dal Fat Init (già mappati con join), usiamoli
                if (_initData.Transazione != null)
                {
                    Transazione = _initData.Transazione;
                }

                _dataTransazione = Transazione.TransazioneData;
                _dataDocumento = Transazione.TransazioneDataDocumento;
                _dataScadenza = Transazione.TransazioneDataScadenza;
                _dataPagamento = Transazione.TransazioneDataPagamento;

                if (Transazione.TransazioneCausaleTipoId > 0)
                {
                    _selectedCausale = _initData.Causali.FirstOrDefault(c => c.CausaleId == Transazione.TransazioneCausaleTipoId);
                    if (_selectedCausale != null)
                    {
                        _scadenzaObbligatoria = _selectedCausale.CausaleRichiedeScadenza;
                        _giorniScadenzaDefault = _selectedCausale.CausaleGiorniScadenzaDefault;
                        _causaleCicloCorrente = _selectedCausale.CausaleCiclo;
                        _causaleGeneraIva = _selectedCausale.CausaleGeneraIva;
                        _causaleRichiedeIva = _selectedCausale.CausaleRichiedeIva;
                        _aliquotaPercentuale = Transazione.AliquotaIvaPercentuale;
                    }
                }
            }
            
            _valutaIsEur = (Transazione.ValutaCodiceIso == "EUR");

            if (Transazione.TransazioneId == 0 && !Transazione.Righe.Any() && Transazione.TransazioneImporto > 0)
            {
                AddRigaDefault();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Errore durante l'inizializzazione del dialog transazioni");
            Snackbar.Add("Errore durante il caricamento dei dati iniziali", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void AddRigaDefault()
    {
        var r = new MovTransazioniRighe
        {
            RigaNumero = 1,
            RigaDescrizione = Transazione.TransazioneCausale ?? "NUOVA RIGA",
            RigaTipo = "PRESTAZIONE",
            RigaImponibile = Transazione.TransazioneImporto,
            RigaAliquotaIvaFk = Transazione.TransazioneAliquotaIvaFk ?? 0
        };
        
        // Se abbiamo l'aliquota di testata, usiamola
        if (Transazione.AliquotaIvaPercentuale.HasValue)
        {
            r.AliquotaIvaPercentuale = Transazione.AliquotaIvaPercentuale;
            r.AliquotaIvaCodice = Transazione.AliquotaIvaCodice;
            CalcolaDatiRiga(r);
        }
        
        Transazione.Righe.Add(r);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation tra i campi della form
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch { }

            // Focus automatico sul primo campo
            if (_firstField != null)
            {
                await Task.Delay(300);
                await _firstField.FocusAsync();
            }
        }
    }

    public void Dispose()
    {
        // Cleanup dei listener JavaScript per la navigazione TAB
        try
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("dialogFormHelper.cleanup");
        }
        catch { }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            await _form.Validate();

        // Reset error states
        _numeroDocumentoError = false;
        _numeroDocumentoErrorText = string.Empty;
        _dataDocumentoError = false;
        _dataDocumentoErrorText = string.Empty;
        _dataScadenzaError = false;
        _dataScadenzaErrorText = string.Empty;
        _dataPagamentoError = false;
        _dataPagamentoErrorText = string.Empty;

        bool hasValidationErrors = false;

        // Validazione custom: Viaggio e DataViaggio devono essere entrambi presenti o entrambi assenti
        bool viaggioPresente = Transazione.TransazioneViaggioId.HasValue && Transazione.TransazioneViaggioId.Value > 0;
        bool dataViaggioPresente = Transazione.TransazioneDataViaggioId.HasValue && Transazione.TransazioneDataViaggioId.Value > 0;

        if (viaggioPresente != dataViaggioPresente)
        {
            Snackbar.Add("Se si seleziona un Viaggio, è obbligatorio selezionare anche la Data Viaggio (e viceversa)", Severity.Warning);
            return;
        }

        // Validazione: Numero Documento e Data Documento devono essere entrambi presenti o entrambi assenti
        bool hasNumeroDocumento = !string.IsNullOrWhiteSpace(Transazione.TransazioneNumeroDocumento);
        bool hasDataDocumento = _dataDocumento.HasValue;

        if (hasNumeroDocumento && !hasDataDocumento)
        {
            _dataDocumentoError = true;
            _dataDocumentoErrorText = "Se si inserisce il numero documento, è obbligatorio inserire anche la data documento";
            hasValidationErrors = true;
        }
        else if (!hasNumeroDocumento && hasDataDocumento)
        {
            _numeroDocumentoError = true;
            _numeroDocumentoErrorText = "Se si inserisce la data documento, è obbligatorio inserire anche il numero documento";
            hasValidationErrors = true;
        }

        // Validazione: Scadenza obbligatoria per causali che la richiedono
        if (_scadenzaObbligatoria && !_dataScadenza.HasValue)
        {
            _dataScadenzaError = true;
            _dataScadenzaErrorText = "La data scadenza è obbligatoria per questa causale";
            hasValidationErrors = true;
        }

        // Validazione: Data Scadenza >= Data Documento (se entrambi presenti)
        if (_dataDocumento.HasValue && _dataScadenza.HasValue && _dataScadenza.Value < _dataDocumento.Value)
        {
            _dataScadenzaError = true;
            _dataScadenzaErrorText = "La data scadenza deve essere maggiore o uguale alla data documento";
            hasValidationErrors = true;
        }

        // Validazione: Data Pagamento >= Data Documento (se entrambi presenti)
        if (_dataDocumento.HasValue && _dataPagamento.HasValue && _dataPagamento.Value < _dataDocumento.Value)
        {
            _dataPagamentoError = true;
            _dataPagamentoErrorText = "La data pagamento deve essere maggiore o uguale alla data documento";
            hasValidationErrors = true;
        }

        // Validazione: Data Pagamento >= Data Scadenza (se entrambi presenti)
        if (_dataScadenza.HasValue && _dataPagamento.HasValue && _dataPagamento.Value < _dataScadenza.Value)
        {
            _dataPagamentoError = true;
            _dataPagamentoErrorText = "La data pagamento deve essere maggiore o uguale alla data scadenza";
            hasValidationErrors = true;
        }

        // Plausibilità dell'anno: controllo ASSOLUTO. Tutti gli altri controlli sulle date di questa form
        // sono relativi (pagamento >= documento, pagamento >= scadenza) e un refuso sull'anno li supera
        // indenne. Non è teoria: in produzione è stata trovata una transazione del 20/02/2022 con data
        // pagamento 20/02/2202 — una cifra fuori posto, mai segnalata.
        foreach (var (data, etichetta) in new[]
        {
            (_dataTransazione, "Data Transazione"), (_dataDocumento, "Data Documento"),
            (_dataScadenza, "Data Scadenza"), (_dataPagamento, "Data Pagamento")
        })
        {
            var esitoAnno = DateValidator.CheckAnnoPlausibile(data, etichetta);
            if (!esitoAnno.IsValid)
            {
                Snackbar.Add(esitoAnno.ErrorMessage, Severity.Error);
                hasValidationErrors = true;
            }
        }

        if (hasValidationErrors)
        {
            StateHasChanged();
            return;
        }

        // Date insolite ma legittime: si chiede conferma, non si vieta. Qui la tolleranza è quella
        // contabile (l'anno precedente è lavoro ordinario), diversa da quella dei viaggi.
        foreach (var (data, etichetta) in new[]
        {
            (_dataTransazione, "Data Transazione"), (_dataDocumento, "Data Documento"),
            (_dataScadenza, "Data Scadenza"), (_dataPagamento, "Data Pagamento")
        })
        {
            if (DateValidator.MotivoDaConfermare(data, null, DateValidator.AnniIndietroContabilita) is { } motivo)
            {
                var conferma = await DialogService.ShowMessageBox(
                    "Data insolita",
                    $"{etichetta}: {motivo} {ValidationMessages.ConfermaDataInsolita}",
                    yesText: "Sì, è corretta", cancelText: "Correggo");
                if (conferma != true) return;
            }
        }

        if (_form.IsValid)
        {
            // Sync UI dates back to model
            if (_dataTransazione.HasValue)
                Transazione.TransazioneData = _dataTransazione.Value;

            Transazione.TransazioneDataDocumento = _dataDocumento;
            Transazione.TransazioneDataScadenza = _dataScadenza;
            Transazione.TransazioneDataPagamento = _dataPagamento;

            try
            {
                string? warningMessage = null;
                var session = await SessionManager.GetSessionAsync();
                string currentUser = session?.User?.Username ?? "System";

                if (Transazione.TransazioneId == 0)
                {
                    // Imposta l'utente che crea il record
                    Transazione.CreatedBy = currentUser;
                    var (transazioneId, warning) = await TransazioniService.CreateAsync(Transazione);
                    warningMessage = warning;
                    Snackbar.Add("Transazione creata con successo", Severity.Success);
                }
                else
                {
                    // Imposta l'utente che aggiorna il record
                    Transazione.UpdatedBy = currentUser;
                    warningMessage = await TransazioniService.UpdateAsync(Transazione);
                    Snackbar.Add("Transazione aggiornata con successo", Severity.Success);
                }

                // Mostra warning se il tasso di cambio è stato recuperato con fallback
                if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    Snackbar.Add(warningMessage, Severity.Warning, config =>
                    {
                        config.VisibleStateDuration = 10000; // 10 secondi per permetterne la lettura
                    });
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante il salvataggio: {ex.Message}", Severity.Error);
            }
        }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ========== HANDLERS PER CONVERSIONE AUTOMATICA IN MAIUSCOLO ==========

    private void HandleCausaleChanged(string value)
    {
        Transazione.TransazioneCausale = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleNumeroDocumentoChanged(string value)
    {
        Transazione.TransazioneNumeroDocumento = value?.ToUpper();
        StateHasChanged();
    }

    private void HandleNoteChanged(string value)
    {
        Transazione.TransazioneNote = value?.ToUpper();
        StateHasChanged();
    }

    private async Task OnCausaleChanged(int causaleId)
    {
        Transazione.TransazioneCausaleTipoId = causaleId;
        _selectedCausale = _initData.Causali.FirstOrDefault(c => c.CausaleId == causaleId);

        if (_selectedCausale != null)
        {
            _scadenzaObbligatoria = _selectedCausale.CausaleRichiedeScadenza;
            _giorniScadenzaDefault = _selectedCausale.CausaleGiorniScadenzaDefault;

            // Imposta il ciclo contabile corrente per filtraggio controparti
            _causaleCicloCorrente = _selectedCausale.CausaleCiclo;

            // Auto-calcola scadenza se abilitato e non già impostata
            if (_selectedCausale.CausaleGeneraScadenzaAuto
                && !_dataScadenza.HasValue
                && _giorniScadenzaDefault.HasValue)
            {
                DateTime baseDate = _dataDocumento ?? _dataTransazione ?? DateTime.Today;
                _dataScadenza = baseDate.AddDays(_giorniScadenzaDefault.Value);
            }

            // =========================================
            // LOGICA IVA - Metadati causale
            // =========================================
            _causaleGeneraIva = _selectedCausale.CausaleGeneraIva;
            _causaleRichiedeIva = _selectedCausale.CausaleRichiedeIva;

            // Auto-imposta aliquota default se causale la prevede
            if (_causaleGeneraIva && Transazione.TransazioneAliquotaIvaFk == null
                && _selectedCausale.CausaleAliquotaIvaDefaultFk.HasValue)
            {
                Transazione.TransazioneAliquotaIvaFk = _selectedCausale.CausaleAliquotaIvaDefaultFk.Value;

                // Recupera la percentuale IVA per l'aliquota default
                var aliquota = _initData.AliquoteIva.FirstOrDefault(a => a.IvaId == _selectedCausale.CausaleAliquotaIvaDefaultFk.Value);
                if (aliquota != null)
                {
                    Transazione.AliquotaIvaPercentuale = aliquota.IvaPercentuale;
                    _aliquotaPercentuale = aliquota.IvaPercentuale;
                }
            }

            // Auto-imposta modalità input se non specificata
            if (Transazione.TransazioneIvaModalitaInput == null)
            {
                Transazione.TransazioneIvaModalitaInput = _selectedCausale.CausaleCiclo == "PASSIVO"
                    ? "LORDO"
                    : "NETTO";
            }

            // Se causale non genera IVA, azzera i campi
            if (!_causaleGeneraIva)
            {
                Transazione.TransazioneAliquotaIvaFk = null;
                Transazione.TransazioneImponibileEur = null;
                Transazione.TransazioneIvaEur = null;
                Transazione.TransazioneLordoEur = null;
            }

            StateHasChanged();
        }
    }

    // =========================================
    // Evento: Cambio Valuta
    // =========================================
    private async Task OnValutaChanged(int valutaId)
    {
        // Aggiorna l'ID della valuta sul modello (per il binding)
        Transazione.TransazioneValutaId = valutaId;

        // Recupera informazioni valuta per verificare se è EUR
        if (valutaId > 0)
        {
            var valuta = _initData.Valute.FirstOrDefault(v => v.ValutaId == valutaId);
            _valutaIsEur = valuta?.ValutaIsBase ?? false; // ValutaIsBase = true solo per EUR

            // Aggiorna anche il codice ISO sul modello (utile per altri componenti)
            Transazione.ValutaCodiceIso = valuta?.ValutaCodiceIso;
        }
        else
        {
            _valutaIsEur = true; // Default a EUR se nessuna valuta selezionata
            Transazione.ValutaCodiceIso = null;
        }

        // Se non EUR, azzera IVA
        if (!_valutaIsEur)
        {
            Transazione.TransazioneAliquotaIvaFk = null;
            Transazione.TransazioneImponibileEur = null;
            Transazione.TransazioneIvaEur = null;
            Transazione.TransazioneLordoEur = null;
            _aliquotaPercentuale = null;
            Transazione.AliquotaIvaPercentuale = null;
        }

        StateHasChanged();
    }

    // =========================================
    // Evento: Cambio Aliquota IVA
    // =========================================
    private async Task OnAliquotaIvaChanged(int? aliquotaId)
    {
        Transazione.TransazioneAliquotaIvaFk = aliquotaId;

        if (aliquotaId.HasValue)
        {
            // Recupera la percentuale IVA dai dati init
            var aliquota = _initData.AliquoteIva.FirstOrDefault(a => a.IvaId == aliquotaId.Value);
            if (aliquota != null)
            {
                Transazione.AliquotaIvaPercentuale = aliquota.IvaPercentuale;
                // _aliquotaPercentuale = aliquota.IvaPercentuale; // Old logic
                // CalcolaIvaReattivo(); // Old logic
            }
        }
        else
        {
            // _aliquotaPercentuale = null; // Old logic
            Transazione.AliquotaIvaPercentuale = null;
            Transazione.TransazioneImponibileEur = null;
            Transazione.TransazioneIvaEur = null;
            Transazione.TransazioneLordoEur = null;
        }

        StateHasChanged();
    }

    // =========================================
    // Gestione Righe di Dettaglio
    // =========================================

    private void AddRiga()
    {
        var nuovaRiga = new MovTransazioniRighe
        {
            RigaNumero = Transazione.Righe.Count + 1,
            RigaDescrizione = Transazione.TransazioneCausale ?? "Nuova riga",
            RigaTipo = "PRESTAZIONE"
        };
        Transazione.Righe.Add(nuovaRiga);
        StateHasChanged();
    }

    private void RemoveRiga(MovTransazioniRighe riga)
    {
        Transazione.Righe.Remove(riga);
        // Riassegna numeri riga
        for (int i = 0; i < Transazione.Righe.Count; i++)
        {
            Transazione.Righe[i].RigaNumero = i + 1;
        }
        StateHasChanged();
    }

    private void OnRigaAliquotaChanged(MovTransazioniRighe riga, int? id)
    {
        riga.RigaAliquotaIvaFk = id ?? 0;
        if (id.HasValue && id.Value > 0)
        {
            var al = _initData.AliquoteIva.FirstOrDefault(a => a.IvaId == id.Value);
            if (al != null)
            {
                riga.AliquotaIvaCodice = al.IvaCodice;
                riga.AliquotaIvaPercentuale = al.IvaPercentuale;
                riga.AliquotaIvaDescrizione = al.IvaDescrizione;
            }
        }
        else
        {
            riga.AliquotaIvaCodice = null;
            riga.AliquotaIvaPercentuale = 0;
        }
        
        CalcolaDatiRiga(riga);
        StateHasChanged();
    }

    private void OnRigaImponibileChanged(MovTransazioniRighe riga)
    {
        CalcolaDatiRiga(riga);
        StateHasChanged();
    }

    private void CalcolaDatiRiga(MovTransazioniRighe riga)
    {
        decimal percentuale = riga.AliquotaIvaPercentuale ?? 0;
        riga.RigaIvaValore = Math.Round(riga.RigaImponibile * (percentuale / 100m), 2);
        riga.RigaLordo = riga.RigaImponibile + riga.RigaIvaValore;
    }

    private async Task ApplicaCalcoloRegime()
    {
        try
        {
            if (Transazione == null) return;

            var result = await FiscalCalcService.ApplyRegimeCalculationAsync(
                AziendaId,
                Transazione.TransazioneImporto,
                Transazione.TransazioneCausale);

            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? "Errore nel calcolo regime.", Severity.Error);
                return;
            }

            Transazione.Righe.Clear();
            Transazione.Righe.AddRange(result.Righe);

            Snackbar.Add("Calcolo regime fiscale applicato correttamente.", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore critico durante il calcolo regime: {ex.Message}", Severity.Error);
            _logger.LogError(ex, "Errore in ApplicaCalcoloRegime");
        }
    }

