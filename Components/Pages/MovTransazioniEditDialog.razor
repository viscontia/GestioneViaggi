@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Components.Shared
@inject MovTransazioniService TransazioniService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext
@inject ISessionManager SessionManager
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudForm Model="@Transazione" @ref="_form" Validation="@(new Func<object, string, Task<IEnumerable<string>>>((obj, prop) => Task.FromResult<IEnumerable<string>>(Array.Empty<string>())))">
            <MudGrid>
                <!-- RIGA 1: Data e Tipo -->
                <MudItem xs="6">
                    <MudDatePicker @ref="_firstField"
                                   Label="Data Transazione"
                                   @bind-Date="_dataTransazione"
                                   Required="true"
                                   RequiredError="Data obbligatoria"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Tipo Movimento" @bind-Value="Transazione.TransazioneTipoMovimento" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("USCITA")">Uscita (Spesa)</MudSelectItem>
                        <MudSelectItem Value="@("ENTRATA")">Entrata (Incasso)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- RIGA 2: Fornitore e Causale -->
                <MudItem xs="12" sm="6">
                    <FornitoreSelect @bind-SelectedFornitoreId="Transazione.TransazioneFornitoreId"
                                     AziendaId="@AziendaId"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Causale"
                                  Value="@Transazione.TransazioneCausale"
                                  ValueChanged="@((string val) => HandleCausaleChanged(val))"
                                  Required="true"
                                  RequiredError="Causale obbligatoria"
                                  Variant="Variant.Outlined"
                                  Class="uppercase-input" />
                </MudItem>

                <!-- RIGA 3: Importo e Valuta -->
                <MudItem xs="6">
                    <MudNumericField @bind-Value="Transazione.TransazioneImporto" 
                                     Label="Importo" 
                                     Format="N2" 
                                     Variant="Variant.Outlined" 
                                     Required="true" 
                                     Adornment="Adornment.Start" 
                                     AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                </MudItem>
                <MudItem xs="6">
                    <ValutaSelect @bind-SelectedValutaId="Transazione.TransazioneValutaId" Required="true" />
                </MudItem>

                <!-- RIGA 4: Stato -->
                 <MudItem xs="6">
                    <MudSelect T="string" Label="Stato Pagamento" @bind-Value="Transazione.TransazioneStato" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("DA_PAGARE")">Da Pagare</MudSelectItem>
                        <MudSelectItem Value="@("PAGATO")">Pagato</MudSelectItem>
                        <MudSelectItem Value="@("PARZIALMENTE_PAGATO")">Parzialmente Pagato</MudSelectItem>
                        <MudSelectItem Value="@("ANNULLATO")">Annullato</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- RIGA 5: Numero Documento e Data Documento (vicini) -->
                <MudItem xs="6">
                    <MudTextField Label="N. Documento / Fattura"
                                  Value="@Transazione.TransazioneNumeroDocumento"
                                  ValueChanged="@((string val) => HandleNumeroDocumentoChanged(val))"
                                  Variant="Variant.Outlined"
                                  Class="uppercase-input"
                                  Error="@_numeroDocumentoError"
                                  ErrorText="@_numeroDocumentoErrorText" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="Data Documento"
                                   @bind-Date="_dataDocumento"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Clearable="true"
                                   Error="@_dataDocumentoError"
                                   ErrorText="@_dataDocumentoErrorText" />
                </MudItem>

                <!-- RIGA 7: Note -->
                <MudItem xs="12">
                    <MudTextField Label="Note"
                                  Value="@Transazione.TransazioneNote"
                                  ValueChanged="@((string val) => HandleNoteChanged(val))"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Class="uppercase-input" />
                </MudItem>

                <!-- RIGA 8: Date Scadenza e Pagamento -->
                <MudItem xs="6">
                    <MudDatePicker Label="Data Scadenza"
                                   @bind-Date="_dataScadenza"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Clearable="true"
                                   Error="@_dataScadenzaError"
                                   ErrorText="@_dataScadenzaErrorText" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="Data Pagamento"
                                   @bind-Date="_dataPagamento"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Clearable="true"
                                   Error="@_dataPagamentoError"
                                   ErrorText="@_dataPagamentoErrorText" />
                </MudItem>

                <!-- RIGA 9: Viaggio e Data Viaggio -->
                <MudItem xs="6">
                    <ViaggioSelect @bind-SelectedViaggioId="Transazione.TransazioneViaggioId"
                                   AziendaId="@AziendaId"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="6">
                    <DataViaggioSelect @bind-SelectedDataViaggioId="Transazione.TransazioneDataViaggioId"
                                       ViaggioId="@Transazione.TransazioneViaggioId"
                                       Clearable="true" />
                </MudItem>

            </MudGrid>

            @if(Transazione.TransazioneId > 0 && Transazione.TransazioneImportoEur.HasValue && Transazione.ValutaCodiceIso != "EUR")
            {
                 <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true">
                     Controvalore calcolato: <b>@Transazione.TransazioneImportoEur?.ToString("N2") EUR</b> (da @Transazione.TransazioneImporto.ToString("N2") @Transazione.ValutaCodiceIso)
                 </MudAlert>
            }

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public MovTransazioni Transazione { get; set; } = new();
    [Parameter] public int AziendaId { get; set; }

    private MudForm _form = default!;
    private MudDatePicker? _firstField;
    private DateTime? _dataTransazione;
    private DateTime? _dataDocumento;
    private DateTime? _dataScadenza;
    private DateTime? _dataPagamento;

    // Validation error flags
    private bool _numeroDocumentoError = false;
    private string _numeroDocumentoErrorText = string.Empty;
    private bool _dataDocumentoError = false;
    private string _dataDocumentoErrorText = string.Empty;
    private bool _dataScadenzaError = false;
    private string _dataScadenzaErrorText = string.Empty;
    private bool _dataPagamentoError = false;
    private string _dataPagamentoErrorText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Init dates from model
        if (Transazione.TransazioneId == 0)
        {
            _dataTransazione = DateTime.Today;
            Transazione.TransazioneStato = "DA_PAGARE";
            Transazione.TransazioneTipoMovimento = "USCITA";
            // Use AziendaId parameter (passed from parent page)
            Transazione.TransazioneAziendaId = AziendaId;

            // Imposta la valuta di default dell'utente corrente
            try
            {
                var session = await SessionManager.GetSessionAsync();
                if (session?.User?.ValutaDefaultId.HasValue == true)
                {
                    Transazione.TransazioneValutaId = session.User.ValutaDefaultId.Value;
                    System.Diagnostics.Debug.WriteLine($"[MovTransazioniEditDialog] Valuta default impostata: {session.User.ValutaDefaultId.Value}");
                }
                else
                {
                    System.Diagnostics.Debug.WriteLine($"[MovTransazioniEditDialog] Nessuna valuta default trovata per l'utente");
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[MovTransazioniEditDialog] Errore recupero valuta default: {ex.Message}");
            }
        }
        else
        {
            _dataTransazione = Transazione.TransazioneData;
            _dataDocumento = Transazione.TransazioneDataDocumento;
            _dataScadenza = Transazione.TransazioneDataScadenza;
            _dataPagamento = Transazione.TransazioneDataPagamento;
        }

        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup TAB navigation tra i campi della form
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation");
            }
            catch { }

            // Focus automatico sul primo campo
            if (_firstField != null)
            {
                await Task.Delay(300);
                await _firstField.FocusAsync();
            }
        }
    }

    public void Dispose()
    {
        // Cleanup dei listener JavaScript per la navigazione TAB
        try
        {
            ((IJSInProcessRuntime)JS).InvokeVoid("dialogFormHelper.cleanup");
        }
        catch { }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();

        // Reset error states
        _numeroDocumentoError = false;
        _numeroDocumentoErrorText = string.Empty;
        _dataDocumentoError = false;
        _dataDocumentoErrorText = string.Empty;
        _dataScadenzaError = false;
        _dataScadenzaErrorText = string.Empty;
        _dataPagamentoError = false;
        _dataPagamentoErrorText = string.Empty;

        bool hasValidationErrors = false;

        // Validazione custom: Viaggio e DataViaggio devono essere entrambi presenti o entrambi assenti
        bool viaggioPresente = Transazione.TransazioneViaggioId.HasValue && Transazione.TransazioneViaggioId.Value > 0;
        bool dataViaggioPresente = Transazione.TransazioneDataViaggioId.HasValue && Transazione.TransazioneDataViaggioId.Value > 0;

        if (viaggioPresente != dataViaggioPresente)
        {
            Snackbar.Add("Se si seleziona un Viaggio, è obbligatorio selezionare anche la Data Viaggio (e viceversa)", Severity.Warning);
            return;
        }

        // Validazione: Numero Documento e Data Documento devono essere entrambi presenti o entrambi assenti
        bool hasNumeroDocumento = !string.IsNullOrWhiteSpace(Transazione.TransazioneNumeroDocumento);
        bool hasDataDocumento = _dataDocumento.HasValue;

        if (hasNumeroDocumento && !hasDataDocumento)
        {
            _dataDocumentoError = true;
            _dataDocumentoErrorText = "Se si inserisce il numero documento, è obbligatorio inserire anche la data documento";
            hasValidationErrors = true;
        }
        else if (!hasNumeroDocumento && hasDataDocumento)
        {
            _numeroDocumentoError = true;
            _numeroDocumentoErrorText = "Se si inserisce la data documento, è obbligatorio inserire anche il numero documento";
            hasValidationErrors = true;
        }

        // Validazione: Data Scadenza >= Data Documento (se entrambi presenti)
        if (_dataDocumento.HasValue && _dataScadenza.HasValue && _dataScadenza.Value < _dataDocumento.Value)
        {
            _dataScadenzaError = true;
            _dataScadenzaErrorText = "La data scadenza deve essere maggiore o uguale alla data documento";
            hasValidationErrors = true;
        }

        // Validazione: Data Pagamento >= Data Documento (se entrambi presenti)
        if (_dataDocumento.HasValue && _dataPagamento.HasValue && _dataPagamento.Value < _dataDocumento.Value)
        {
            _dataPagamentoError = true;
            _dataPagamentoErrorText = "La data pagamento deve essere maggiore o uguale alla data documento";
            hasValidationErrors = true;
        }

        // Validazione: Data Pagamento >= Data Scadenza (se entrambi presenti)
        if (_dataScadenza.HasValue && _dataPagamento.HasValue && _dataPagamento.Value < _dataScadenza.Value)
        {
            _dataPagamentoError = true;
            _dataPagamentoErrorText = "La data pagamento deve essere maggiore o uguale alla data scadenza";
            hasValidationErrors = true;
        }

        if (hasValidationErrors)
        {
            StateHasChanged();
            return;
        }

        if (_form.IsValid)
        {
            // Sync UI dates back to model
            if (_dataTransazione.HasValue)
                Transazione.TransazioneData = _dataTransazione.Value;

            Transazione.TransazioneDataDocumento = _dataDocumento;
            Transazione.TransazioneDataScadenza = _dataScadenza;
            Transazione.TransazioneDataPagamento = _dataPagamento;

            try
            {
                string? warningMessage = null;

                if (Transazione.TransazioneId == 0)
                {
                    // Ensure created properties
                    Transazione.CreatedBy = "System"; // TODO: Get Real User
                    var (transazioneId, warning) = await TransazioniService.CreateAsync(Transazione);
                    warningMessage = warning;
                    Snackbar.Add("Transazione creata con successo", Severity.Success);
                }
                else
                {
                    // Ensure updated properties
                    Transazione.UpdatedBy = "System";
                    warningMessage = await TransazioniService.UpdateAsync(Transazione);
                    Snackbar.Add("Transazione aggiornata con successo", Severity.Success);
                }

                // Mostra warning se il tasso di cambio è stato recuperato con fallback
                if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    Snackbar.Add(warningMessage, Severity.Warning, config =>
                    {
                        config.VisibleStateDuration = 5000; // 5 secondi
                    });
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante il salvataggio: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== HANDLERS PER CONVERSIONE AUTOMATICA IN MAIUSCOLO ==========

    private void HandleCausaleChanged(string value)
    {
        Transazione.TransazioneCausale = value?.ToUpper() ?? string.Empty;
        StateHasChanged();
    }

    private void HandleNumeroDocumentoChanged(string value)
    {
        Transazione.TransazioneNumeroDocumento = value?.ToUpper();
        StateHasChanged();
    }

    private void HandleNoteChanged(string value)
    {
        Transazione.TransazioneNote = value?.ToUpper();
        StateHasChanged();
    }
}
