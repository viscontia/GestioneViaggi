@page "/anagrafiche/clienti"
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.UI
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Services.Export
@using GestioneViaggi.Services.Shared
@using GestioneViaggi.Components.Shared
@using MudBlazor
@inject IClienteService ClienteService
@inject IClienteExportService ClienteExportService
@inject IExcelExportService ExcelExportService
@inject IFileOpenerService FileOpenerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStatusBarService StatusBarService
@inject ITenantContext TenantContext
@inject NavigationManager Navigation
@attribute [Authorize]
@implements IDisposable

@if (QueryYear.HasValue)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="my-2" Icon="@Icons.Material.Filled.FilterList">
    <div class="d-flex align-center justify-space-between">
        <MudText>
            <b>Filtro Attivo:</b> Anno Creazione @QueryYear.Value
        </MudText>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="ResetFilters"
            StartIcon="@Icons.Material.Filled.Clear">
            Mostra Tutto
        </MudButton>
    </div>
</MudAlert>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
    <MudText Typo="Typo.h6">ERRORE:</MudText>
    <MudText>@_errorMessage</MudText>
</MudAlert>
}
else
{
    <EnterpriseDataGrid T="Cliente" Items="@_filteredItems" Title="Gestione Anagrafica Clienti" Loading="@_loading" OnSearch="@CercaAsync" OnRefresh="@LoadDataAsync"
    @bind-SelectedItem="_selectedItem">

    <ToolBarActions>
        @if (_isSuperAdmin)
            {
                <div style="min-width: 250px;" class="mr-4">
                    <AziendaSelect Value="_selectedAziendaId" Label="Seleziona Azienda" Clearable="false" Required="true"
                        ValueChanged="@OnAziendaFilterChanged" />
                </div>
            }
            <div style="min-width: 200px;" class="mr-4">
                <MudSelect T="int" Value="_selectedPresetFilter" Label="Filtri Rapidi" ValueChanged="OnPresetFilterChanged">
                    <MudSelectItem Value="0">Tutti</MudSelectItem>
                    <MudSelectItem Value="1">Con Viaggi Fatti</MudSelectItem>
                    <MudSelectItem Value="2">Con Viaggi Futuri</MudSelectItem>
                    <MudSelectItem Value="3">Viaggi Futuri + Intolleranze</MudSelectItem>
                </MudSelect>
            </div>
            <ExcelExportButton OnExport="@ExportToExcel" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="@OpenCreateDialog" Class="ml-2">
                Nuovo Cliente
            </MudButton>
        </ToolBarActions>

        <Columns>
            @if (_isSuperAdmin)
            {
                <PropertyColumn Property="x => x.AziendaRagioneSociale" Title="Azienda" />
            }

            <TemplateColumn SortBy="@(x => x.ViaggiFatti)" HeaderStyle="text-align:center" CellStyle="text-align:center"
                Class="col-xs">
                <HeaderTemplate>
                    <MudText Typo="Typo.caption"
                        Style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.2;">
                        VIAGGI<br />FATTI</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ViaggiFatti > 0)
                    {
                        <span class="count-badge-green">@context.Item.ViaggiFatti</span>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn SortBy="@(x => x.ViaggiDaFare)" HeaderStyle="text-align:center" CellStyle="text-align:center"
                Class="col-xs">
                <HeaderTemplate>
                    <MudText Typo="Typo.caption"
                        Style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.2;">
                        VIAGGI<br />DA FARE</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ViaggiDaFare > 0)
                    {
                        <span class="count-badge-yellow">@context.Item.ViaggiDaFare</span>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Cliente" HeaderStyle="font-weight:bold" SortBy="@(x => $"{x.Cognome} {x.Nome}")">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2"><strong>@context.Item.Cognome</strong> @context.Item.Nome</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Item.Intolleranza))
                        {
                            <MudTooltip Text="@context.Item.Intolleranza" Placement="Placement.Right" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Filled.NoFood" Color="Color.Error" Size="Size.Small"
                                    Style="margin-bottom: -2px;" />
                            </MudTooltip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.Sesso" Title="Sesso" HeaderStyle="text-align:center"
                CellStyle="text-align:center" Class="col-xs" />

            <TemplateColumn Title="Nato a" SortBy="@(x => x.ComuneNascita?.Nome)"
                HeaderStyle="min-width: 150px" CellStyle="min-width: 150px">
                <CellTemplate>
                    @if (context.Item.ComuneNascita != null)
                    {
                        var sigla = context.Item.ComuneNascita.ComuneEstero ? context.Item.ComuneNascita.ProvinciaSigla : "IT";
                        <text>@context.Item.ComuneNascita.Nome (@sigla)</text>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Nato il" SortBy="@(x => x.DataNascita)">
                <CellTemplate>
                    @context.Item.DataNascita?.ToString("dd/MM/yyyy")
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Età" HeaderStyle="text-align:center" CellStyle="text-align:center">
                <CellTemplate>
                    @(context.Item.DataNascita.HasValue ? (DateTime.Now.Year - context.Item.DataNascita.Value.Year -
                        (DateTime.Now.DayOfYear < context.Item.DataNascita.Value.DayOfYear ? 1 : 0)) : "")
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Residenza" SortBy="@(x => x.ComuneResidenza?.Nome)"
                HeaderStyle="min-width: 150px" CellStyle="min-width: 150px">
                <CellTemplate>
                    @if (context.Item.ComuneResidenza != null)
                    {
                        var sigla = context.Item.ComuneResidenza.ComuneEstero ? context.Item.ComuneResidenza.ProvinciaSigla : "IT";
                        <text>@context.Item.ComuneResidenza.Nome (@sigla)</text>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Prov." SortBy="@(x => x.ComuneResidenza?.ProvinciaSigla)"
                HeaderStyle="text-align:center; width: 60px" CellStyle="text-align:center">
                <CellTemplate>
                    @if (context.Item.ComuneResidenza != null && !context.Item.ComuneResidenza.ComuneEstero)
                    {
                        <text>@context.Item.ComuneResidenza.ProvinciaSigla</text>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Telefono" CellStyle="white-space: nowrap">
                <CellTemplate>
                    @($"{context.Item.PrefTelInt} {context.Item.Telefono}")
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <PropertyColumn Property="x => x.CodiceFiscale" Title="Codice Fiscale" />
            <PropertyColumn Property="x => x.Intolleranza" Title="Int. Alimentare" />

            <TemplateColumn T="Cliente" Tag="@("Actions")" Sortable="false" StickyLeft="true"
                HeaderClass="sticky-actions-column" CellClass="sticky-actions-column">
                <HeaderTemplate>
                    <MudText Typo="Typo.caption"
                        Style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Azioni</MudText>
                </HeaderTemplate>
                <CellTemplate Context="cellContext">
                    <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                        <MudTooltip Text="Modifica">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                Class="inline-action-btn edit-btn" OnClick="@(() => OpenEditDialog(cellContext.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Elimina">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default"
                                Class="inline-action-btn delete-btn" OnClick="@(() => DeleteItem(cellContext.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Statistiche Viaggi">
                            <MudIconButton Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Small"
                                Color="Color.Default" Class="inline-action-btn stats-btn"
                                OnClick="@(() => ShowTravelStats(cellContext.Item))" />
                        </MudTooltip>
                        @if (!string.IsNullOrWhiteSpace(cellContext.Item.Email))
                        {
                            <MudTooltip Text="Invia Email">
                                <MudIconButton Icon="@Icons.Material.Filled.Email" Size="Size.Small"
                                    Color="Color.Success" Class="inline-action-btn"
                                    OnClick="@(() => OpenEmailDialog(cellContext.Item))" />
                            </MudTooltip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>

    </EnterpriseDataGrid>
}

@code {
    private List<Cliente> _items = new();
    private List<Cliente> _filteredItems = new();
    private int _selectedPresetFilter = 0; // 0=All, 1=Made, 2=Future, 3=Future+Intolerance
    private Cliente? _selectedItem;
    private string _errorMessage = string.Empty;
    private bool _loading = true;
    private int? _currentAziendaId;
    private int _selectedAziendaId; // Filtro per SuperAdmin
    private bool _isSuperAdmin;

    [SupplyParameterFromQuery(Name = "year")]
    public int? QueryYear { get; set; }

    protected override async Task OnInitializedAsync()
    {
        StatusBarService.SetCurrentTable("ana_clienti");

        _isSuperAdmin = await TenantContext.IsSuperAdminAsync();

        if (_isSuperAdmin)
        {
            _currentAziendaId = null; // Accesso globale
        }
        else
        {
            // Get current azienda ID for normal users
            var aziendaId = await TenantContext.GetCurrentAziendaIdAsync();
            if (!aziendaId.HasValue)
            {
                _errorMessage = "Impossibile determinare l'azienda corrente";
                return;
            }
            _currentAziendaId = aziendaId.Value;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(_errorMessage))
        {
            await LoadDataAsync();
        }
    }

    public void Dispose()
    {
        StatusBarService.SetCurrentTable(null);
    }

    private async Task OnAziendaFilterChanged(int aziendaId)
    {
        _selectedAziendaId = aziendaId;
        await LoadDataAsync();
    }

    /// <summary>Il testo cercato. Vuoto = elenco completo.</summary>
    private string _ricerca = string.Empty;

    /// <summary>
    /// Ogni battuta interroga il database (con la pausa della casella, 350 ms).
    /// Su questa anagrafica non scrive piu' un solo software, quindi non esiste una
    /// lista in memoria che resti buona: cercare vuol dire chiedere.
    /// </summary>
    private async Task CercaAsync(string testo)
    {
        _ricerca = testo ?? string.Empty;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _errorMessage = string.Empty;
        int? filterId = _isSuperAdmin ? (_selectedAziendaId > 0 ? _selectedAziendaId : (int?)null) : _currentAziendaId;

        // SuperAdmin MUST select a company first
        if (_isSuperAdmin && !filterId.HasValue)
        {
            _items = new List<Cliente>();
            _filteredItems = new List<Cliente>();
            // Keep _loading = true to show loading indicator
            return;
        }

        _loading = true;
        try
        {
            // La ricerca interroga il database, non la lista gia' letta: cosi' trova anche
            // chi e' stato inserito da un'altra sessione o dal sito di iscrizione, che scrive
            // negli stessi clienti. Prima la casella filtrava la memoria e si comportava in
            // due modi diversi a seconda di quando il record fosse nato.
            // filterId qui non e' mai nullo (i due rami sopra escono prima), ma dirlo al
            // compilatore con un `.Value` secco significherebbe fidarsi di quella lettura
            // anche fra un anno, quando i rami sopra saranno cambiati.
            _items = string.IsNullOrWhiteSpace(_ricerca) || filterId is null
                ? await ClienteService.GetAllAsync(filterId, QueryYear)
                : await ClienteService.SearchAsync(_ricerca, filterId.Value);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Errore durante il caricamento: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnPresetFilterChanged(int value)
    {
        _selectedPresetFilter = value;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        switch (_selectedPresetFilter)
        {
            case 1: // Viaggi Fatti
                _filteredItems = _items.Where(x => x.ViaggiFatti > 0).ToList();
                break;
            case 2: // Viaggi Futuri
                _filteredItems = _items.Where(x => x.ViaggiDaFare > 0).ToList();
                break;
            case 3: // Viaggi Futuri + Intolleranze
                _filteredItems = _items.Where(x => x.ViaggiDaFare > 0 && !string.IsNullOrWhiteSpace(x.Intolleranza)).ToList();
                break;
            default: // Tutti
                _filteredItems = new List<Cliente>(_items);
                break;
        }
    }

    // Il filtro in memoria e' stato tolto: cerca fn_search_clienti, sugli stessi campi.

    private async Task OpenCreateDialog()
    {
        // Se è SuperAdmin e non ha selezionato un'azienda (filtro = 0), blocca e mostra errore
        if (_isSuperAdmin && _selectedAziendaId == 0)
        {
            Snackbar.Add("Selezionare una Azienda prima di Inserire un nuovo Cliente", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ClienteDialog>
{
{ x => x.Entity, new Cliente() },
{ x => x.IsEditMode, false },
// Se Azienda selezionata nel filtro (SuperAdmin) o AziendaCorrente (User)
{ x => x.AziendaFk, _selectedAziendaId > 0 ? _selectedAziendaId : (_currentAziendaId ?? 0) }
};

        var options = new DialogOptions
            {
                BackdropClick = false,
                CloseButton = true,
                MaxWidth = MaxWidth.Large,
                FullWidth = true
            };

        var dialog = await DialogService.ShowAsync<ClienteDialog>("Nuovo Cliente", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is Cliente newItem)
        {
            // Il salvataggio è già avvenuto nel dialog
            _items.Add(newItem);
            ApplyFilters(); // Refresh filtered list
            StateHasChanged();
        }
    }

    private async Task OpenEditDialog(Cliente item)
    {
        // Clone entity to avoid modifying the original during editing
        var cloned = item.Clone<Cliente>();

        var parameters = new DialogParameters<ClienteDialog>
{
{ x => x.Entity, cloned },
{ x => x.IsEditMode, true },
{ x => x.AziendaFk, _currentAziendaId ?? item.AziendaFk }
};

        var options = new DialogOptions
            {
                BackdropClick = false,
                CloseButton = true,
                MaxWidth = MaxWidth.Large,
                FullWidth = true
            };

        var dialog = await DialogService.ShowAsync<ClienteDialog>($"Modifica Cliente: {item.Cognome} {item.Nome}", parameters,
        options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is Cliente updatedItem)
        {
            // Il salvataggio è già avvenuto nel dialog
            var index = _items.FindIndex(c => c.ClienteId == updatedItem.ClienteId);
            if (index >= 0)
            {
                _items[index] = updatedItem;
            }

            ApplyFilters(); // Refresh filtered list
            StateHasChanged();
        }
    }

    private async Task DeleteItem(Cliente item)
    {
        var parameters = new DialogParameters
{
{ "Title", "Attenzione" },
{ "ContentText", $"Vuoi veramente cancellare il cliente {item.Cognome} {item.Nome}?" }
};

        var options = new DialogOptions { BackdropClick = false, CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await DialogService.ShowAsync<DeleteConfirmationDialog>("Conferma Eliminazione", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                var success = await ClienteService.DeleteAsync(item.ClienteId, _currentAziendaId ?? item.AziendaFk);
                if (success)
                {
                    _items.Remove(item);
                    ApplyFilters(); // Refresh filtered list
                    Snackbar.Add("Cliente eliminato con successo", Severity.Success);
                    StateHasChanged();
                }
                else
                {
                    Snackbar.Add("Impossibile eliminare il cliente", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
            }
        }
    }
    private async Task ShowTravelStats(Cliente item)
    {
        var parameters = new DialogParameters<TravelStatsDialog>
{
{ x => x.Cliente, item }
};

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                NoHeader = true
            };

        await DialogService.ShowAsync<TravelStatsDialog>("Statistiche Viaggi", parameters, options);
    }

    private async Task OpenEmailDialog(Cliente client)
    {
        if (string.IsNullOrWhiteSpace(client.Email))
        {
            Snackbar.Add("Questo cliente non ha un indirizzo email configurato.", Severity.Warning);
            return;
        }

        var aziendaId = _selectedAziendaId > 0 ? _selectedAziendaId : (_currentAziendaId ?? client.AziendaFk);

        var parameters = new DialogParameters
        {
            ["AziendaId"] = aziendaId,
            ["DefaultSubject"] = string.Empty,
            ["RecipientEmails"] = new List<string> { client.Email.Trim() },
            ["RecipientDisplayLabel"] = $"{client.Cognome} {client.Nome} ({client.Email})"
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<SendEmailDialog>("", parameters, options);
    }

    private async Task ExportToExcel()
    {
        try
        {
            int? filterId = _selectedAziendaId > 0 ? _selectedAziendaId : _currentAziendaId;
            var data = await ClienteExportService.GetClientiExportAsync(filterId);

            if (!data.Any())
            {
                Snackbar.Add("Nessun dato da esportare", Severity.Warning);
                return;
            }

            var columns = ClienteExportService.GetColumnDefinitions();
            var fileName = $"Anagrafica_Clienti_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            var outputPath = await ExcelExportService.ExportToExcelAsync(data, columns, fileName, "Clienti");

            Snackbar.Add($"Esportati {data.Count} clienti", Severity.Success);
            await FileOpenerService.OpenFileAsync(outputPath, "Export Completato");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante l'esportazione: {ex.Message}", Severity.Error);
        }
    }

    private void ResetFilters()
    {
        Navigation.NavigateTo("/anagrafiche/clienti");
    }
}
