    private async Task NuovaNewsletter(bool comeModello)
    {
        var titolo = comeModello ? "Nuovo modello" : "Nuova newsletter";
        var etichetta = comeModello ? "Nome del modello" : "Oggetto della newsletter";
        var oggetto = await ChiediTestoAsync(titolo, etichetta);
        if (string.IsNullOrWhiteSpace(oggetto)) return;

        _busy = true;
        try
        {
            var id = await InviiService.CreaBozzaAsync(_aziendaId, oggetto!.Trim(), comeModello);
            await ReloadAsync();
            _mostraModelli = comeModello;
            var voce = Elenco.FirstOrDefault(x => x.Id == id);
            if (voce != null) await ApriComposizione(voce);
            Snackbar.Add(comeModello ? "Modello creato." : "Bozza creata.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Errore creazione: {MessaggioErrore(ex)}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Duplica(WebNewsletterElencoVoce n)
    {
        var oggetto = await ChiediTestoAsync("Duplica", "Oggetto della copia", $"{n.Oggetto} (copia)");
        if (string.IsNullOrWhiteSpace(oggetto)) return;

        _busy = true;
        try
        {
            // La copia nasce sempre come bozza, anche da una gia' inviata o da un modello.
            await InviiService.ClonaAsync(n.Id, _aziendaId, oggetto!.Trim(), comeModello: false);
            _mostraModelli = false;
            await ReloadAsync();
            Snackbar.Add("Copia creata fra le bozze.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Errore duplicazione: {MessaggioErrore(ex)}", Severity.Error); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Elimina definitivamente una newsletter non inviata. I blocchi vanno via in CASCADE.
    /// Una gia' inviata non si tocca: e' la prova documentale di cosa e' stato spedito e a chi,
    /// e il suo log dei destinatari serve anche a rispondere a una contestazione.
    /// </summary>
    private async Task Elimina(WebNewsletterElencoVoce n)
    {
        if (!n.IsBozza)
        {
            Snackbar.Add("Una newsletter già inviata non può essere eliminata.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.Title, n.IsModello ? "Elimina modello" : "Elimina newsletter" },
            { x => x.ContentText, $"Eliminare definitivamente «{n.Oggetto}» con i suoi {n.NumeroBlocchi} blocchi? L'operazione non si può annullare." },
            { x => x.ButtonText, "Elimina" },
            { x => x.Color, Color.Error }
        };
        var dlg = await DialogService.ShowAsync<DeleteConfirmationDialog>("Elimina", parameters,
            new DialogOptions { BackdropClick = false });
        if ((await dlg.Result)!.Canceled) return;

        _busy = true;
        try
        {
            await InviiService.DeleteAsync(n.Id, _aziendaId);
            if (_invioCorrente?.Id == n.Id) ChiudiComposizione();
            await ReloadAsync();
            Snackbar.Add("Eliminata.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ApriComposizione(WebNewsletterElencoVoce n)
    {
        _invioCorrente = n;
