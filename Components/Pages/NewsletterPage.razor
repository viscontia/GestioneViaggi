    private async Task CaricaBlocchiAsync()
    {
        if (_invioCorrente is null) return;
        try { _blocchi = await BlocchiService.ListAsync(_invioCorrente.Id, _aziendaId); }
        catch (Exception ex) { Snackbar.Add($"Errore lettura blocchi: {MessaggioErrore(ex)}", Severity.Error); }
