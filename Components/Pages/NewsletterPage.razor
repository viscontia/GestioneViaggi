                await InviiService.UpdateAsync(invio);
                await ReloadAsync();
                _invioCorrente = Elenco.FirstOrDefault(x => x.Id == _invioCorrente.Id) ?? _invioCorrente;
                Snackbar.Add("Oggetto aggiornato.", Severity.Success);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Errore: {MessaggioErrore(ex)}", Severity.Error); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Aggiunge un blocco e ne apre SUBITO la form: una riga vuota in elenco non dice niente
    /// all'utente, che dovrebbe capire da solo di doverla aprire. Se annulla, il blocco appena
    /// creato viene rimosso — cosi' "annulla" su un elemento nuovo significa davvero non averlo
    /// creato, e non si accumulano blocchi vuoti.
    /// </summary>
    private async Task AggiungiBlocco(WebNewsletterTipoBlocco tipo)
    {
        if (_invioCorrente is null) return;

        long nuovoId;
        _busy = true;
        try
        {
            var b = new WebNewsletterBlocco
            {
                AziendaId = _aziendaId, InvioIdFk = _invioCorrente.Id, Tipo = tipo.Tipo
            };
            nuovoId = await BlocchiService.CreateAsync(b);
            await CaricaBlocchiAsync();
        }
        catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Warning); return; }
        finally { _busy = false; }

        var creato = _blocchi.FirstOrDefault(x => x.WebNewsletterBloccoId == nuovoId);
        if (creato is null) return;

        var salvato = await ModificaBlocco(creato);
        if (!salvato)
        {
            // Annullato: si torna allo stato precedente all'aggiunta.
            _busy = true;
            try
            {
                await BlocchiService.DeleteAsync(nuovoId, _aziendaId);
                await CaricaBlocchiAsync();
            }
            catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Warning); }
            finally { _busy = false; }
        }
    }

    private async Task<bool> ModificaBlocco(WebNewsletterBlocco b)
    {
        // Copia di lavoro: se l'utente annulla, la riga in elenco non deve risultare modificata.
        var copia = new WebNewsletterBlocco
        {
            WebNewsletterBloccoId = b.WebNewsletterBloccoId, InvioIdFk = b.InvioIdFk, Tipo = b.Tipo,
            Ordine = b.Ordine, Layout = b.Layout, Colonne = b.Colonne,
            Titolo = b.Titolo, Sottotitolo = b.Sottotitolo, CorpoHtml = b.CorpoHtml,
            ImmagineUrl = b.ImmagineUrl, ImmagineStoragePath = b.ImmagineStoragePath, ImmagineAlt = b.ImmagineAlt,
            LinkUrl = b.LinkUrl, LinkEtichetta = b.LinkEtichetta,
            DataViaggioIdFk = b.DataViaggioIdFk, AziendaId = b.AziendaId
        };

        var parameters = new DialogParameters<NewsletterBloccoDialog>
        {
            { x => x.Blocco, copia },
            { x => x.Etichetta, _catalogo.FirstOrDefault(c => c.Tipo == b.Tipo)?.Etichetta ?? b.Tipo },
            { x => x.IsSuperAdmin, _isSuperAdmin },
            { x => x.Galleria, _galleria }
        };
        var dlg = await DialogService.ShowAsync<NewsletterBloccoDialog>("Modifica blocco", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, BackdropClick = false });
        var res = await dlg.Result;
        if (res!.Canceled) return false;

        _busy = true;
        try
        {
            await BlocchiService.UpdateAsync(copia);
            await CaricaBlocchiAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore salvataggio blocco: {MessaggioErrore(ex)}", Severity.Error);
            return false;
        }
        finally { _busy = false; }
    }

