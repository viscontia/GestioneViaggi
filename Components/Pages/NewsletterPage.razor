@page "/newsletter"
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Models.Web
@using GestioneViaggi.Services.Web
@using GestioneViaggi.Services.Email
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Services.UI
@using GestioneViaggi.Components.Shared
@using Microsoft.Extensions.Logging
@using MudBlazor
@inject NewsletterSenderService Sender
@inject WebNewsletterInviiService InviiService
@inject WebNewsletterIscrittiService IscrittiService
@inject WebNewsletterSoppressioniService SoppressioniService
@inject ITenantContext TenantContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStatusBarService StatusBarService
@inject WebAziendeFunzioniService FunzioniService
@inject WebNewsletterBlocchiService BlocchiService
@inject NewsletterRenderService RenderService
@inject ILogger<NewsletterPage> Logger
@attribute [Authorize]
@implements IDisposable

@* Pagina Newsletter (Blocco 11), per-azienda. Compose+invio multilingua, storico, iscritti, soppressioni. *@

@* Overlay bloccante durante l'invio: stesso pattern di Galleria e generazione mappa.
   Uno spinner in linea non si nota e non impedisce di continuare a cliccare. *@
<MudOverlay Visible="@_busy" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="8" Style="min-width:320px;">
        <MudProgressCircular Indeterminate="@(_invioTotale == 0)" Value="@_invioPercentuale"
                             Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h6" Class="mt-4">
            @(_invioTotale > 0 ? $"Invio in corso: {_invioFatti} di {_invioTotale}" : "Preparazione dell'invio…")
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            @(_invioTotale > 0 ? "Non chiudere la finestra." : "Traduzione dei testi per le lingue dei destinatari.")
        </MudText>
        @if (_invioTotale > 0)
        {
            <MudProgressLinear Color="Color.Primary" Value="@_invioPercentuale" Class="mt-4" Style="width:100%;" />
        }
    </MudPaper>
</MudOverlay>

<MudText Typo="Typo.h5" Class="mb-3">Newsletter</MudText>

@* SuperAdmin: la pagina e' per-azienda, quindi senza una scelta esplicita non c'e' nulla da mostrare. *@
@if (_isSuperAdmin)
{
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <AziendaSelect Value="@_aziendaId" ValueChanged="OnAziendaChanged"
                       Label="Azienda" Class="mt-0" Style="max-width:420px;" />
    </MudPaper>
}

@if (_aziendaId == 0)
{
    <MudAlert Severity="Severity.Warning">Seleziona un'azienda per gestire la newsletter.</MudAlert>
}
else if (!_enabled)
{
    <MudAlert Severity="Severity.Info">La funzione Newsletter non è attiva per questa azienda. Attivala in <strong>Anagrafica Aziende → Funzioni Web</strong>.</MudAlert>
}
else
{
<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

    <!-- CAMPAGNA -->
    <!-- NEWSLETTER: elenco oppure composizione a blocchi -->
    <MudTabPanel Text="Newsletter" Icon="@Icons.Material.Filled.Campaign">

        @if (_invioCorrente is null)
        {
            @* ---------- ELENCO ---------- *@
            <div class="d-flex align-center gap-2 mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@_busy" OnClick="@(() => NuovaNewsletter(false))">Nuova newsletter</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Bookmarks"
                           Disabled="@_busy" OnClick="@(() => NuovaNewsletter(true))">Nuovo modello</MudButton>
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_mostraModelli" Color="Color.Primary"
                           Label="Mostra i modelli" LabelPlacement="Placement.Start" />
            </div>

            <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto;">
                <thead>
                    <tr>
                        <th>@(_mostraModelli ? "Modello" : "Oggetto")</th>
                        <th>Stato</th>
                        <th style="text-align:center;">Blocchi</th>
                        <th>Ultima modifica</th>
                        <th style="text-align:right;">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Elenco)
                    {
                        <tr>
                            <td>@n.Oggetto</td>
                            <td>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(n.Stato == "inviata" ? Color.Success : n.IsBozza ? Color.Warning : Color.Default)">@n.Stato</MudChip>
                            </td>
                            <td style="text-align:center;">@n.NumeroBlocchi</td>
                            <td>@((n.DataInvio ?? n.Created).ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                            <td style="text-align:right;white-space:nowrap;">
                                <MudTooltip Text="Anteprima">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                   Color="Color.Primary" Disabled="@_busy"
                                                   OnClick="@(() => Anteprima(n.Id))" />
                                </MudTooltip>
                                <MudTooltip Text="Duplica">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   Disabled="@_busy" OnClick="@(() => Duplica(n))" />
                                </MudTooltip>
                                @if (n.IsBozza)
                                {
                                    <MudTooltip Text="Componi">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       Color="Color.Primary" Disabled="@_busy"
                                                       OnClick="@(() => ApriComposizione(n))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Elimina definitivamente">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" Disabled="@_busy"
                                                       OnClick="@(() => Elimina(n))" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudTooltip Text="Una newsletter già inviata non si modifica: duplicala.">
                                        <span><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="true" /></span>
                                    </MudTooltip>
                                    <MudTooltip Text="Una newsletter già inviata non si elimina: è la prova di cosa è stato spedito.">
                                        <span><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="true" /></span>
                                    </MudTooltip>
                                }
                            </td>
                        </tr>
                    }
                    @if (Elenco.Count == 0)
                    {
                        <tr><td colspan="5">
                            <MudText Color="Color.Secondary">
                                @(_mostraModelli
                                    ? "Nessun modello. Creane uno per riusare una struttura ricorrente."
                                    : "Nessuna newsletter. Creane una nuova, oppure duplica un modello.")
                            </MudText>
                        </td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            @* ---------- COMPOSIZIONE A BLOCCHI ---------- *@
            <div class="d-flex align-center gap-2 mb-3">
                <MudTooltip Text="Torna all'elenco">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default"
                                   OnClick="ChiudiComposizione" />
                </MudTooltip>
                <MudTextField @bind-Value="_oggetto" Label="Oggetto" Variant="Variant.Outlined"
                              MaxLength="255" Margin="Margin.Dense" Style="max-width:420px;" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@_busy" OnClick="SalvaOggetto">Salva oggetto</MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility"
                           Disabled="@_busy" OnClick="@(() => Anteprima(_invioCorrente!.Id))">Anteprima</MudButton>
            </div>

            <div class="d-flex gap-2 mb-3 flex-wrap">
                @foreach (var t in _catalogo.Where(c => !c.Obbligatorio))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@_busy" OnClick="@(() => AggiungiBlocco(t))">@t.Etichetta</MudButton>
                }
            </div>

            <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto;">
                <thead>
                    <tr>
                        <th style="width:40px;"></th>
                        <th>Blocco</th>
                        <th>Contenuto</th>
                        <th style="text-align:right;">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _blocchi.Count; i++)
                    {
                        var b = _blocchi[i];
                        var idx = i;
                        var obbligatorio = _catalogo.FirstOrDefault(c => c.Tipo == b.Tipo)?.Obbligatorio == true;
                        <tr>
                            <td style="white-space:nowrap;">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                               Disabled="@(_busy || idx == 0 || obbligatorio)"
                                               OnClick="@(() => Sposta(idx, -1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                               Disabled="@(_busy || idx == _blocchi.Count - 1 || obbligatorio)"
                                               OnClick="@(() => Sposta(idx, 1))" />
                            </td>
                            <td>
                                <strong>@(_catalogo.FirstOrDefault(c => c.Tipo == b.Tipo)?.Etichetta ?? b.Tipo)</strong>
                                @if (obbligatorio)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="ml-2">obbligatorio</MudChip>
                                }
                                @if (b.Tipo == "tour" && b.Colonne == 2)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">affiancato</MudChip>
                                }
                            </td>
                            <td><MudText Typo="Typo.body2" Color="Color.Secondary">@Riassunto(b)</MudText></td>
                            <td style="text-align:right;white-space:nowrap;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                               Disabled="@_busy" OnClick="@(async () => await ModificaBlocco(b))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               Disabled="@(_busy || obbligatorio)" OnClick="@(() => EliminaBlocco(b))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <div class="d-flex align-center flex-wrap gap-3">
                    <MudTooltip Text="Vedi l'elenco dei destinatari">
                        <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.Group"
                                 OnClick="VediDestinatari" Disabled="@(_busy || _count == 0)">Destinatari: @_count</MudChip>
                    </MudTooltip>
                    <MudTextField @bind-Value="_testEmail" Label="Invia una prova a" Variant="Variant.Outlined"
                                  Style="max-width:280px;" Margin="Margin.Dense"
                                  HelperText="Indirizzo qualsiasi: riceve la newsletter vera, non una versione ridotta." />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send"
                               Disabled="@_busy" OnClick="InviaProva">Invia prova</MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Campaign"
                               Disabled="@(_busy || _count == 0 || _invioCorrente!.IsModello)" OnClick="InviaTutti">Invia a tutti (@_count)</MudButton>
                </div>
                @if (_invioCorrente!.IsModello)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Questo è un <strong>modello</strong>: si duplica, non si invia.
                    </MudAlert>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Senza chiave Claude sull'azienda, i destinatari non-IT ricevono la versione italiana.</MudText>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- STORICO -->
    <MudTabPanel Text="Storico" Icon="@Icons.Material.Filled.History">
        <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto;">
            <thead><tr><th>Oggetto</th><th>Stato</th><th>Data invio</th><th style="text-align:center;">Destinatari</th><th>Canale</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in _storico)
                {
                    <tr>
                        <td>@i.Oggetto</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@(i.Stato == "inviata" ? Color.Success : Color.Default)">@i.Stato</MudChip></td>
                        <td>@(i.DataInvio?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td style="text-align:center;">@(i.NumeroDestinatari?.ToString() ?? "—")</td>
                        <td>@(i.Canale ?? "—")</td>
                        <td style="text-align:right;">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ListAlt" OnClick="@(() => VediLog(i))">Log</MudButton>
                        </td>
                    </tr>
                }
                @if (_storico.Count == 0) { <tr><td colspan="6"><MudText Color="Color.Secondary">Nessun invio.</MudText></td></tr> }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    <!-- ISCRITTI -->
    <MudTabPanel Text="Iscritti" Icon="@Icons.Material.Filled.MarkEmailRead">
        <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto;">
            <thead><tr><th>Email</th><th>Nome</th><th>Lingua</th><th>Stato</th><th>Consenso</th></tr></thead>
            <tbody>
                @foreach (var s in _iscritti)
                {
                    <tr>
                        <td>@s.Email</td>
                        <td>@($"{s.Nome} {s.Cognome}".Trim())</td>
                        <td>@s.Lingua</td>
                        <td>@s.Stato</td>
                        <td>@(s.Consenso ? "sì" : "no")</td>
                    </tr>
                }
                @if (_iscritti.Count == 0) { <tr><td colspan="5"><MudText Color="Color.Secondary">Nessun iscritto (le iscrizioni arrivano dal sito).</MudText></td></tr> }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    <!-- SOPPRESSIONI -->
    <MudTabPanel Text="Soppressioni" Icon="@Icons.Material.Filled.Block">
        <div class="d-flex align-center gap-2 mb-3">
            <MudTextField @bind-Value="_sopEmail" Label="Email da sopprimere" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:280px;" />
            <MudTextField @bind-Value="_sopMotivo" Label="Motivo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:280px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="AggiungiSoppressione">Aggiungi</MudButton>
        </div>
        <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto;">
            <thead><tr><th>Email</th><th>Motivo</th><th>Data</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _soppressioni)
                {
                    <tr>
                        <td>@s.Email</td>
                        <td>@s.Motivo</td>
                        <td>@(s.Data?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                        <td style="text-align:right;"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RimuoviSoppressione(s))" /></td>
                    </tr>
                }
                @if (_soppressioni.Count == 0) { <tr><td colspan="4"><MudText Color="Color.Secondary">Nessuna soppressione.</MudText></td></tr> }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    <!-- IMPOSTAZIONI -->
    <MudTabPanel Text="Impostazioni" Icon="@Icons.Material.Filled.Settings">
        <MudText Typo="Typo.subtitle1" Class="mb-1">Composizione del footer</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Cosa compare in fondo a ogni newsletter di questa azienda. Vale per tutte: è
            l'intestazione legale del mittente, non un contenuto della singola campagna.
        </MudText>

        <div class="d-flex gap-4 flex-wrap">
            <MudPaper Outlined="true" Class="pa-3" Style="min-width:360px;flex:1 1 360px;">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Campi e ordine</MudText>
                <MudSimpleTable Dense="true" Bordered="false">
                    <tbody>
                        @for (int i = 0; i < _footerCampi.Count; i++)
                        {
                            var idx = i;
                            var campo = _footerCampi[idx];
                            <tr>
                                <td style="width:40px;">
                                    <MudCheckBox T="bool" Value="@campo.Attivo" Color="Color.Primary"
                                                 ValueChanged="@(v => CampoFooterAttivo(idx, v))" />
                                </td>
                                <td>@campo.Etichetta</td>
                                <td style="text-align:right;white-space:nowrap;">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                   Disabled="@(idx == 0)" OnClick="@(() => SpostaCampoFooter(idx, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                   Disabled="@(idx == _footerCampi.Count - 1)" OnClick="@(() => SpostaCampoFooter(idx, 1))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <div class="d-flex gap-3 mt-3">
                    <MudSelect T="int" @bind-Value="_footerColonne" Label="Colonne" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="int" Value="1">Una colonna</MudSelectItem>
                        <MudSelectItem T="int" Value="2">Due colonne</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_footerAllineamento" Label="Allineamento" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("centro")">Centrato</MudSelectItem>
                        <MudSelectItem T="string" Value="@("sinistra")">A sinistra</MudSelectItem>
                        <MudSelectItem T="string" Value="@("destra")">A destra</MudSelectItem>
                    </MudSelect>
                </div>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_busy"
                           OnClick="SalvaFooter">Salva composizione</MudButton>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3" Style="min-width:320px;flex:1 1 320px;">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Come apparirà</MudText>
                <div style="border:1px solid var(--mud-palette-lines-default);border-radius:4px;padding:16px;background:#fff;">
                    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#888;
                                text-align:@(_footerAllineamento == "sinistra" ? "left" : _footerAllineamento == "destra" ? "right" : "center");">
                        @foreach (var riga in AnteprimaFooter())
                        {
                            @riga<br />
                        }
                        <div style="margin-top:10px;">
                            Non desideri più ricevere la nostra newsletter? <u>Disiscriviti</u>
                        </div>
                    </div>
                </div>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Il link di <strong>disiscrizione</strong> è sempre presente e non si può togliere:
                    è obbligatorio per legge ed è l'unico modo che ha il destinatario per cancellarsi.
                </MudAlert>
            </MudPaper>
        </div>
    </MudTabPanel>
</MudTabs>
}

@code {
    private int _aziendaId;
    private bool _isSuperAdmin;
    private bool _enabled = true;
    private bool _busy;
    private int _count;

    // Avanzamento dell'invio (0/0 = ancora in traduzione, prima che il ciclo parta).
    private int _invioFatti;
    private int _invioTotale;
    private int _invioPercentuale => _invioTotale == 0 ? 0 : (int)(100.0 * _invioFatti / _invioTotale);
    private string? _oggetto;
    private string? _testEmail;
    private string? _sopEmail;
    private string? _sopMotivo;

    private List<WebNewsletterInvio> _storico = new();
    private List<WebNewsletterIscritto> _iscritti = new();
    private List<WebNewsletterSoppressione> _soppressioni = new();

    // --- Newsletter a blocchi ---------------------------------------------
    private List<WebNewsletterElencoVoce> _newsletter = new();
    private List<WebNewsletterElencoVoce> _modelli = new();
    private List<WebNewsletterTipoBlocco> _catalogo = new();
    private List<WebNewsletterBlocco> _blocchi = new();
    private List<ImmaginePicker.Voce> _galleria = new();

    // --- Impostazioni: composizione del footer ----------------------------
    private sealed class CampoFooter
    {
        public string Campo { get; init; } = "";
        public string Etichetta { get; init; } = "";
        public bool Attivo { get; set; }
    }

    private List<CampoFooter> _footerCampi = new();
    private int _footerColonne = 1;
    private string _footerAllineamento = "centro";
    private NewsletterRenderAzienda? _datiAzienda;
    private bool _mostraModelli;

    /// <summary>Newsletter aperta in composizione; null = si sta guardando l'elenco.</summary>
    private WebNewsletterElencoVoce? _invioCorrente;

    private List<WebNewsletterElencoVoce> Elenco => _mostraModelli ? _modelli : _newsletter;

    protected override async Task OnInitializedAsync()
    {
        StatusBarService.SetCurrentTable("web_newsletter_invii");
        try
        {
            _isSuperAdmin = await TenantContext.IsSuperAdminAsync();
            _aziendaId = await TenantContext.GetCurrentAziendaIdAsync() ?? 0;
            if (_aziendaId != 0)
            {
                _enabled = await FunzioniService.IsNewsletterEnabledAsync(_aziendaId);
                if (_enabled) await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore apertura Newsletter: {MessaggioErrore(ex)}", Severity.Error);
        }
    }

    /// <summary>SuperAdmin: cambio azienda dal selettore. Ricarica tutto, gating compreso.</summary>
    private async Task OnAziendaChanged(int aziendaId)
    {
        _aziendaId = aziendaId;
        _storico.Clear(); _iscritti.Clear(); _soppressioni.Clear();
        _count = 0;
        _enabled = true;

        if (_aziendaId != 0)
        {
            try
            {
                _enabled = await FunzioniService.IsNewsletterEnabledAsync(_aziendaId);
                if (_enabled) await ReloadAsync();
            }
            catch (Exception ex) { Snackbar.Add($"Errore cambio azienda: {MessaggioErrore(ex)}", Severity.Error); }
        }
        StateHasChanged();
    }

    public void Dispose() => StatusBarService.SetCurrentTable(null);

    private async Task ReloadAsync()
    {
        try
        {
            _count = await Sender.CountRecipientsAsync(_aziendaId);
            _storico = await InviiService.ListByAziendaAsync(_aziendaId);
            _iscritti = await IscrittiService.ListByAziendaAsync(_aziendaId);
            _soppressioni = await SoppressioniService.ListByAziendaAsync(_aziendaId);
            _newsletter = await InviiService.ElencoAsync(_aziendaId, modelli: false);
            _modelli = await InviiService.ElencoAsync(_aziendaId, modelli: true);
            if (_catalogo.Count == 0) _catalogo = await BlocchiService.GetCatalogoAsync();
            _galleria = await BlocchiService.GetGalleriaAziendaAsync(_aziendaId);
            await CaricaFooterConfigAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Errore caricamento: {MessaggioErrore(ex)}", Severity.Error); }
        StateHasChanged();
    }

    /// <summary>
    /// Controlli comuni a prova e invio: oggetto presente, almeno un blocco di contenuto, e
    /// nessun blocco incompleto. Restituisce false se si deve interrompere.
    /// </summary>
    private bool ComposizioneValida()
    {
        if (_invioCorrente is null) { Snackbar.Add("Apri una newsletter prima di inviare.", Severity.Warning); return false; }
        if (string.IsNullOrWhiteSpace(_oggetto)) { Snackbar.Add("Inserisci l'oggetto.", Severity.Warning); return false; }

        // Intestazione e footer ci sono sempre: da soli non fanno una newsletter.
        var conContenuto = _blocchi.Count(b => b.Tipo is not ("intestazione" or "footer"));
        if (conContenuto == 0)
        {
            Snackbar.Add("La newsletter non ha contenuti: aggiungi almeno un blocco.", Severity.Warning);
            return false;
        }

        var problemi = GestioneViaggi.Validation.Business.NewsletterBloccoValidator.ValidaTutti(_blocchi);
        if (problemi.Count > 0)
        {
            // Un messaggio per problema: dire "ci sono errori" senza dire dove costringerebbe
            // l'utente a cercarli a mano.
            foreach (var p in problemi.Take(4)) Snackbar.Add(p, Severity.Warning);
            if (problemi.Count > 4) Snackbar.Add($"…e altri {problemi.Count - 4} blocchi incompleti.", Severity.Warning);
            return false;
        }

        return true;
    }

