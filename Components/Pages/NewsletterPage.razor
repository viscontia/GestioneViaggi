    private async Task SalvaOggetto()
    {
        if (_invioCorrente is null || string.IsNullOrWhiteSpace(_oggetto)) return;
        _busy = true;
        try
        {
            var invio = await InviiService.GetByIdAsync(_invioCorrente.Id, _aziendaId);
            if (invio != null)
            {
