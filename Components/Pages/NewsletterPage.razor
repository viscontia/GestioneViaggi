    /// <summary>
    /// Controlli sul branding prima di spedire. Sito mancante = STOP (il link di disiscrizione
    /// sarebbe rotto); logo mancante = conferma esplicita, perche' impedire l'invio per un logo
    /// lascerebbe l'azienda muta verso i propri clienti.
    /// Restituisce false se si deve interrompere.
    /// </summary>
    private async Task<bool> PreflightOkAsync()
    {
        NewsletterPreflight pf;
        try { pf = await Sender.GetPreflightAsync(_aziendaId); }
        catch (Exception ex) { Snackbar.Add($"Errore controlli preliminari: {MessaggioErrore(ex)}", Severity.Error); return false; }

        if (pf.SitoMancante)
        {
            Snackbar.Add("Questa azienda non ha un sito web: il link di disiscrizione sarebbe rotto. " +
                         "Compila 'Sito web' in Anagrafica Aziende prima di inviare.", Severity.Error);
            return false;
        }

        if (pf.LogoMancante)
        {
            var parameters = new DialogParameters<DeleteConfirmationDialog>
            {
                { x => x.Title, "Logo mancante" },
                { x => x.ContentText, "Questa azienda non ha un logo: la mail partira' senza intestazione. Continuare?" },
                { x => x.ButtonText, "Invia comunque" },
                { x => x.Color, Color.Warning }
            };
            var dlg = await DialogService.ShowAsync<DeleteConfirmationDialog>("Logo mancante", parameters,
                new DialogOptions { BackdropClick = false });
            if ((await dlg.Result)!.Canceled) return false;
        }

        return true;
    }

    private async Task InviaProva()
    {
        if (!ComposizioneValida()) return;
        if (string.IsNullOrWhiteSpace(_testEmail)) { Snackbar.Add("Inserisci un'email di prova.", Severity.Warning); return; }

        // Stesso validatore della scheda cliente: senza, si poteva scrivere qualsiasi cosa e
        // l'errore arrivava solo dal server SMTP, con un messaggio incomprensibile.
        var formato = GestioneViaggi.Validation.Business.ClienteValidator.ValidateEmail(_testEmail!.Trim());
        if (!formato.IsValid) { Snackbar.Add(formato.Message, Severity.Warning); return; }

        if (!await PreflightOkAsync()) return;
        _busy = true;
        try
        {
            // Rendering REALE dei blocchi: nessun prefisso [TEST], nessuna versione ridotta.
            // Serve proprio a vedere cosa arrivera' ai destinatari.
            var ok = await Sender.SendProvaBlocchiAsync(
                _aziendaId, _invioCorrente!.Id, _oggetto!.Trim(), _testEmail!.Trim(), RenderService);
            Snackbar.Add(ok ? "Prova inviata: controlla la casella." : "Invio di prova fallito (verifica la configurazione email).",
                         ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task InviaTutti()
    {
        if (!ComposizioneValida()) return;
        if (!await PreflightOkAsync()) return;
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.Title, "Conferma invio" },
            { x => x.ContentText, $"Inviare la newsletter a {_count} destinatari?" },
            { x => x.ButtonText, "Invia" },
            { x => x.Color, Color.Primary }
        };
        var dlg = await DialogService.ShowAsync<DeleteConfirmationDialog>("Conferma invio", parameters, new DialogOptions { BackdropClick = false });
        if ((await dlg.Result)!.Canceled) return;

        _busy = true;
        _invioFatti = 0; _invioTotale = 0;
        try
        {
            var progress = new Progress<(int Fatti, int Totale)>(p =>
            {
                _invioFatti = p.Fatti; _invioTotale = p.Totale;
                InvokeAsync(StateHasChanged);
            });

            var res = await Sender.SendCampaignBlocchiAsync(
                _aziendaId, _invioCorrente!.Id, _oggetto!.Trim(), RenderService, progress);
            var msg = $"Inviate {res.Inviate}/{res.Totale}" + (res.Errori > 0 ? $", {res.Errori} errori" : "");
            Snackbar.Add(msg, res.Errori > 0 ? Severity.Warning : Severity.Success);
            ChiudiComposizione();
            await ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Error); }
        finally { _busy = false; _invioFatti = 0; _invioTotale = 0; }
    }

