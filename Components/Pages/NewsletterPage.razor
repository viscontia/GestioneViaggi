    private async Task CaricaFooterConfigAsync()
    {
        try
        {
            var cfg = await RenderService.GetFooterConfigAsync(_aziendaId);
            _footerColonne = cfg.Colonne;
            _footerAllineamento = cfg.Allineamento;

            // I campi attivi nell'ordine configurato, poi gli altri spenti in coda: cosi'
            // l'elenco mostra sempre tutto e l'ordine e' quello vero.
            var attivi = cfg.Campi.ToList();
            _footerCampi = attivi
                .Where(c => NewsletterRenderService.CampiFooter.Any(x => x.Campo == c))
                .Select(c => new CampoFooter
                {
                    Campo = c,
                    Etichetta = NewsletterRenderService.CampiFooter.First(x => x.Campo == c).Etichetta,
                    Attivo = true
                })
                .Concat(NewsletterRenderService.CampiFooter
                    .Where(x => !attivi.Contains(x.Campo))
                    .Select(x => new CampoFooter { Campo = x.Campo, Etichetta = x.Etichetta, Attivo = false }))
                .ToList();

            _datiAzienda = await RenderService.GetDatiAziendaAsync(_aziendaId);
        }
        catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Error); }
    }

    private void CampoFooterAttivo(int indice, bool attivo) => _footerCampi[indice].Attivo = attivo;

    private void SpostaCampoFooter(int indice, int delta)
    {
        var destinazione = indice + delta;
        if (destinazione < 0 || destinazione >= _footerCampi.Count) return;
        (_footerCampi[indice], _footerCampi[destinazione]) = (_footerCampi[destinazione], _footerCampi[indice]);
    }

    /// <summary>Righe del footer come appariranno, con i dati veri dell'azienda.</summary>
    private List<string> AnteprimaFooter()
    {
        var righe = new List<string>();
        if (_datiAzienda is null) return righe;

        foreach (var c in _footerCampi.Where(x => x.Attivo))
        {
            var v = c.Campo switch
            {
                "ragione_sociale" => _datiAzienda.RagioneSociale,
                "indirizzo"       => _datiAzienda.Indirizzo,
                "partita_iva"     => string.IsNullOrWhiteSpace(_datiAzienda.PartitaIva) ? null : $"P. IVA {_datiAzienda.PartitaIva}",
                "email"           => _datiAzienda.Email,
                "telefono"        => _datiAzienda.Telefono,
                "sito_web"        => _datiAzienda.SitoWeb,
                _                 => null
            };
            if (!string.IsNullOrWhiteSpace(v)) righe.Add(v!);
        }
        return righe;
    }

    private async Task SalvaFooter()
    {
        var scelti = _footerCampi.Where(x => x.Attivo).Select(x => x.Campo).ToList();
        if (scelti.Count == 0)
        {
            Snackbar.Add("Scegli almeno un campo: un footer completamente vuoto non è ammesso.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await RenderService.SalvaFooterConfigAsync(_aziendaId,
                new NewsletterFooterConfig(scelti, _footerColonne, _footerAllineamento));
            Snackbar.Add("Composizione del footer salvata.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(MessaggioErrore(ex), Severity.Error); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Traduce un'eccezione in un messaggio per l'utente, passando sempre dal dizionario centrale.
    /// </summary>
    /// <remarks>
    /// Le eccezioni gia' "parlanti" (le guardie di business che le function DB sollevano come
    /// P0001, e gli InvalidOperationException dei servizi) hanno un messaggio scritto per l'utente
    /// e si usano cosi'. Tutto il resto passa da <c>DatabaseExceptionHelper</c>, che conosce i
    /// codici Postgres e i nomi dei vincoli. L'ultima spiaggia non e' mai il messaggio tecnico:
    /// un "Object reference not set to an instance of an object" in faccia all'utente non e'
    /// un'informazione, e' un difetto che si vede.
    /// </remarks>
    private string MessaggioErrore(Exception ex)
    {
        switch (ex)
        {
            case InvalidOperationException or GestioneViaggi.Models.Exceptions.GestioneViaggiException:
                return ex.Message;

            case Npgsql.PostgresException pex:
                return Helpers.DatabaseExceptionHelper.WrapException(pex, "web_newsletter_invii").Message;

            default:
                Logger.LogError(ex, "Errore non gestito nella pagina Newsletter");
                return "Si è verificato un errore imprevisto. L'operazione non è stata completata; " +
                       "il dettaglio tecnico è nel log dell'applicazione.";
        }
    }

