    /// <summary>Riga di riepilogo del contenuto di un blocco, per l'elenco di composizione.</summary>
    private static string Riassunto(WebNewsletterBlocco b)
    {
        if (b.Tipo is "intestazione" or "footer") return "dati dell'azienda";
        if (b.Tipo == "separatore") return "linea";

        var parti = new List<string>();
        if (!string.IsNullOrWhiteSpace(b.Titolo)) parti.Add(b.Titolo!);
        if (!string.IsNullOrWhiteSpace(b.CorpoHtml))
        {
            var testo = System.Text.RegularExpressions.Regex.Replace(b.CorpoHtml!, "<.*?>", " ").Trim();
            if (testo.Length > 60) testo = testo[..60] + "…";
            if (testo.Length > 0) parti.Add(testo);
        }
        if (!string.IsNullOrWhiteSpace(b.ImmagineUrl)) parti.Add("[immagine]");
        if (!string.IsNullOrWhiteSpace(b.LinkUrl)) parti.Add($"[{b.LinkEtichetta ?? "collegamento"}]");

        return parti.Count == 0 ? "(vuoto)" : string.Join(" · ", parti);
    }

