    /// <summary>Sposta un blocco di una posizione. I blocchi obbligatori non si spostano.</summary>
    private async Task Sposta(int indice, int delta)
    {
        var destinazione = indice + delta;
        if (destinazione < 0 || destinazione >= _blocchi.Count || _invioCorrente is null) return;

        (_blocchi[indice], _blocchi[destinazione]) = (_blocchi[destinazione], _blocchi[indice]);

        _busy = true;
        try
        {
            // La function rimette comunque intestazione prima e footer ultimo: qui non serve
            // difendersi, basta mandare l'ordine visibile.
            await BlocchiService.ReorderAsync(_aziendaId, _invioCorrente.Id,
                _blocchi.Select(x => x.WebNewsletterBloccoId).ToList());
            await CaricaBlocchiAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Errore riordino: {MessaggioErrore(ex)}", Severity.Error); }
        finally { _busy = false; }
    }

