@page "/ana-viaggi"
@using GestioneViaggi.Models
@using AnaViaggiEntity = GestioneViaggi.Models.AnaViaggi
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Components.Shared
@using GestioneViaggi.Services.Authentication
@inject AnaViaggiService ViaggiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthenticationService AuthService

@attribute [System.Diagnostics.CodeAnalysis.SuppressMessage("MudBlazor", "MUD0002", Justification = "False positive on custom DataGrid")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" GutterBottom="true">Gestione Viaggi</MudText>

    @if (_isLoading)
    {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else
    {
            <MudGrid>
                <!-- LEFT PANEL: TREE VIEW FILTER (30%) -->
                <MudItem xs="12" md="4" lg="3">
                    <MudPaper Class="pa-4" Elevation="3" Height="calc(100vh - 150px)" Style="overflow-y: auto;">
                        <MudSelect T="int" Label="Ordina per" Dense="true" Value="_sortOption" ValueChanged="OnSortChanged" Class="mb-4" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="0">Nazione -> Tipo</MudSelectItem>
                            <MudSelectItem Value="1">Tipo -> Nazione</MudSelectItem>
                        </MudSelect>

                    @if (_treeItems.Count == 0)
                    {
                                <MudText Typo="Typo.body2" Color="Color.Default">Nessun viaggio trovato.</MudText>
                    }
                    else
                    {
                                <MudTreeView T="ViaggiTreeItem" Hover="true" Dense="true" ExpandOnClick="true"
                                    SelectedValueChanged="OnTreeSelectionChanged" SelectedValue="_selectedTreeItem">
                            @foreach (var level1 in _treeItems)
                            {
                                            <MudTreeViewItem Value="@level1" Text="@level1.Title" Icon="@level1.Icon" IconColor="@level1.IconColor" @bind-Expanded="@level1.IsExpanded">
                                                <ChildContent>
                                        @foreach (var level2 in level1.Children)
                                        {
                                                            <MudTreeViewItem Value="@level2" Text="@level2.Title" Icon="@level2.Icon" IconColor="@level2.IconColor" @bind-Expanded="@level2.IsExpanded">
                                                                <ChildContent>
                                                    @foreach (var tripNode in level2.Children)
                                                {
                                                                    <MudTreeViewItem Value="@tripNode" Text="@tripNode.Title" Icon="@tripNode.Icon" IconColor="@tripNode.IconColor"
                                                                                     Expanded="@tripNode.IsExpanded"
                                                                                     ExpandedChanged="@((e) => { tripNode.IsExpanded = e; _ = OnItemExpanded(tripNode); })">
                                                                        <ChildContent>
                                                                            @foreach (var dateNode in tripNode.Children)
                                                                            {
                                                                                <MudTreeViewItem Value="@dateNode" Text="@dateNode.Title" Icon="@dateNode.Icon" IconColor="@dateNode.IconColor" />
                                                                            }
                                                                        </ChildContent>
                                                                    </MudTreeViewItem>
                                                }
                                                        </ChildContent>
                                                    </MudTreeViewItem>
                                        }
                                                </ChildContent>
                                            </MudTreeViewItem>
                            }
                                </MudTreeView>
                    }
                    </MudPaper>
                </MudItem>

                <!-- RIGHT PANEL: DATA GRID (70%) -->
                <MudItem xs="12" md="8" lg="9">
                    <MudPaper Elevation="3" Class="pa-4">
                        <EnterpriseDataGrid T="AnaViaggiEntity" Items="@_filteredItems" Filterable="true" Class="mt-4" Title="Elenco Viaggi"
                                            SearchFunction="@Search">

                            <ToolBarActions>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                    OnClick="OpenCreateDialog" Class="mr-2">
                                    Nuovo Viaggio
                                </MudButton>
                                @if (_selectedTreeItem?.Type == "Trip")
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Event"
                                        OnClick="OpenNewDateDialogFromTree">
                                        Nuova Data
                                    </MudButton>
                                }
                            </ToolBarActions>

                            <Columns>
                                <!-- AZIONI (Auto-positioned to left by EnterpriseDataGrid logic) -->
                                <EnterpriseActionsColumn T="AnaViaggiEntity" OnEdit="@((e) => OpenEditDialog(e))" OnDelete="@DeleteAsync">
                                    <CustomActions>
                                        <MudTooltip Text="Aggiungi Data">
                                            <MudIconButton Icon="@Icons.Material.Filled.EventAvailable"
                                                           Size="Size.Small"
                                                           Color="Color.Success"
                                                           Class="inline-action-btn"
                                                           OnClick="@(() => OpenEditDialog(context, true, true))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Gestione Date">
                                            <MudIconButton Icon="@Icons.Material.Filled.DateRange"
                                                           Size="Size.Small"
                                                           Color="Color.Info"
                                                           Class="inline-action-btn"
                                                           OnClick="@(() => OpenEditDialog(context, true))" />
                                        </MudTooltip>
                                    </CustomActions>
                                </EnterpriseActionsColumn>

                                <!-- DATI -->
                                <PropertyColumn Property="x => x.NazioneNome" Title="Nazione" />
                                <PropertyColumn Property="x => x.DescrizioneBreve" Title="Descrizione Breve" />
                                <PropertyColumn Property="x => x.TipoViaggioDescrizione" Title="Tipo Viaggio" />

                                <PropertyColumn Property="x => x.NumeroGiorni" Title="Giorni" CellStyle="width: 70px; min-width: 70px; max-width: 70px; text-align: center;" HeaderStyle="width: 70px; min-width: 70px; max-width: 70px; text-align: center;" />
                                <PropertyColumn Property="x => x.NumeroNotti" Title="Notti" CellStyle="width: 70px; min-width: 70px; max-width: 70px; text-align: center;" HeaderStyle="width: 70px; min-width: 70px; max-width: 70px; text-align: center;" />
                                <PropertyColumn Property="x => x.Km" Title="Km" CellStyle="width: 80px; min-width: 80px; max-width: 80px; text-align: right;" HeaderStyle="width: 80px; min-width: 80px; max-width: 80px; text-align: right;" />

                                <TemplateColumn Title="Pasti Sacco" CellStyle="width: 90px; min-width: 90px; max-width: 90px; text-align: center;" HeaderStyle="width: 90px; min-width: 90px; max-width: 90px; text-align: center;">
                                    <CellTemplate>
                                    @(context.Item.PastiAlSacco == "Y" ? "Sì" : "No")
                                    </CellTemplate>
                                </TemplateColumn>

                                <PropertyColumn Property="x => x.TipoTrattamentoDescrizione" Title="Trattamento" />
                                <PropertyColumn Property="x => x.TipoPernottamentoDescrizione" Title="Pernottamento" />
                                <PropertyColumn Property="x => x.TipoAvvicinamentoDescrizione" Title="Avvicinamento" />

                            @if (_isSuperAdmin)
                            {
                                        <PropertyColumn Property="x => x.AziendaRagioneSociale" Title="Azienda" />
                            }
                            </Columns>

                        </EnterpriseDataGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>
    }
    </MudContainer>

@code {
    private bool _isLoading = true;
    private List<AnaViaggiEntity> _allItems = new();
    private List<AnaViaggiEntity> _filteredItems = new();

    // TreeView Data Structure
    private HashSet<ViaggiTreeItem> _treeItems = new();

    private int _sortOption = 0; // 0: Nazione -> Tipo, 1: Tipo -> Nazione

    private UserInfo? _session;
    private bool _isSuperAdmin = false;

    // Helper class for Tree structure
    public class ViaggiTreeItem
    {
        public string Title { get; set; } = string.Empty;
        public string Icon { get; set; } = Icons.Material.Filled.Folder;
        public Color IconColor { get; set; } = Color.Default;
        public string Type { get; set; } = string.Empty; // "Country", "Type", "Trip", "Date", "Dummy"
        public int? RelatedId { get; set; } // ID of whatever entity this node represents
        public int? ParentId { get; set; } // ID of the parent entity (e.g. Trip ID for a Date)
        public bool IsExpanded { get; set; }
        public bool AreDatesLoaded { get; set; }

        // Use HashSet for automatic deduplication in sets, but TreeView wants HashSet<T> or List<T>
        public HashSet<ViaggiTreeItem> Children { get; set; } = new();

        public override bool Equals(object? obj)
        {
            if (obj is ViaggiTreeItem other)
            {
                // Unique based on Type + Title (Title should be unique within parent usually, but Type adds safety)
                return Title == other.Title && Type == other.Type;
            }
            return false;
        }

        public override int GetHashCode() => HashCode.Combine(Title, Type);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _session = await AuthService.GetCurrentUserAsync();
            _isSuperAdmin = _session?.IsSuperAdmin ?? false;
        }
        catch (Exception)
        {
            // Suppress auth error during init if any, default to non-admin
        }

        await LoadDataAsync();
    }

    private ViaggiTreeItem? _selectedTreeItem;

    // ...

    // Recursive helper to get expanded keys
    private HashSet<string> GetExpandedState()
    {
        var expanded = new HashSet<string>();
        foreach (var item in _treeItems)
        {
             CollectExpanded(item, expanded);
        }
        return expanded;
    }

    private void CollectExpanded(ViaggiTreeItem item, HashSet<string> expanded)
    {
        if (item.IsExpanded)
        {
            expanded.Add(GetNodeKey(item));
        }
        foreach (var child in item.Children)
        {
            CollectExpanded(child, expanded);
        }
    }

    private string GetNodeKey(ViaggiTreeItem item) => $"{item.Type}_{item.Title}_{item.RelatedId}";

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        
        // Capture state before reload
        var expandedState = GetExpandedState();
        string? selectedKey = _selectedTreeItem != null ? GetNodeKey(_selectedTreeItem) : null;

        try
        {
            // Determine filter: SuperAdmin passes null (all), others pass their AziendaId
            int? filterAziendaId = _isSuperAdmin ? null : _session?.AziendaId;

            _allItems = await ViaggiService.GetAllAsync(filterAziendaId);
            
            // Filter is now handled by SQL.
            // _allItems contains only visible records.

            // Await the async build to ensure children are loaded
            await BuildTreeAsync(expandedState);
            
            // Restore Selection
            if (selectedKey != null)
            {
                 var node = FindNodeByKey(selectedKey);
                 if (node != null)
                 {
                     _selectedTreeItem = node;
                 }
            }

            _filteredItems = new List<AnaViaggiEntity>(_allItems);
            StateHasChanged(); // FORCE UI UPDATE
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore caricamento dati: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private ViaggiTreeItem? FindNodeByKey(string key)
    {
        foreach (var item in _treeItems)
        {
            var found = FindNodeRecursive(item, key);
            if (found != null) return found;
        }
        return null;
    }

    private ViaggiTreeItem? FindNodeRecursive(ViaggiTreeItem current, string key)
    {
        if (GetNodeKey(current) == key) return current;
        foreach (var child in current.Children)
        {
            var found = FindNodeRecursive(child, key);
            if (found != null) return found;
        }
        return null;
    }

    private async Task OnSortChanged(int value)
    {
        _sortOption = value;
        await BuildTreeAsync(null); 
        StateHasChanged();
    }

    private async Task BuildTreeAsync(HashSet<string>? expandedState = null)
    {
        _treeItems.Clear();

        if (_sortOption == 0)
        {
             // Hierarchy: Nazione -> Tipo Viaggio -> Viaggio
            var countries = _allItems
                .GroupBy(x => x.NazioneNome ?? "Sconosciuta")
                .OrderBy(g => g.Key);

            foreach (var countryGroup in countries)
            {
                var countryNode = CreateNode(countryGroup.Key, "Country", Icons.Material.Filled.Public, null, expandedState);

                var types = countryGroup
                    .GroupBy(x => x.TipoViaggioDescrizione ?? "Altro")
                    .OrderBy(g => g.Key);

                foreach (var typeGroup in types)
                {
                    var typeNode = CreateNode(typeGroup.Key, "Type", Icons.Material.Filled.Category, null, expandedState);

                    foreach (var trip in typeGroup.OrderBy(t => t.DescrizioneBreve))
                    {
                        var tripNode = CreateNode(trip.DescrizioneBreve, "Trip", Icons.Material.Filled.FlightTakeoff, trip.Id, expandedState);
                        
                        // Add dummy to enable expansion
                        tripNode.Children.Add(new ViaggiTreeItem { Title = "Caricamento...", Type = "Dummy" });
                        
                        typeNode.Children.Add(tripNode);
                        
                        if (tripNode.IsExpanded)
                        {
                            // Await loading of children to ensure Date nodes exist if we need to select them
                            await OnItemExpanded(tripNode);
                        }
                    }
                    countryNode.Children.Add(typeNode);
                }
                _treeItems.Add(countryNode);
            }
        }
        else
        {
            // Hierarchy: Tipo Viaggio -> Nazione -> Viaggio
            // Same logic, just swapped levels
            var types = _allItems
                .GroupBy(x => x.TipoViaggioDescrizione ?? "Altro")
                .OrderBy(g => g.Key);

            foreach (var typeGroup in types)
            {
                 var typeNode = CreateNode(typeGroup.Key, "Type", Icons.Material.Filled.Category, null, expandedState);

                var countries = typeGroup
                    .GroupBy(x => x.NazioneNome ?? "Sconosciuta")
                    .OrderBy(g => g.Key);

                foreach (var countryGroup in countries)
                {
                    var countryNode = CreateNode(countryGroup.Key, "Country", Icons.Material.Filled.Public, null, expandedState);

                    foreach (var trip in countryGroup.OrderBy(t => t.DescrizioneBreve))
                    {
                        var tripNode = CreateNode(trip.DescrizioneBreve, "Trip", Icons.Material.Filled.FlightTakeoff, trip.Id, expandedState);
                        
                        tripNode.Children.Add(new ViaggiTreeItem { Title = "Caricamento...", Type = "Dummy" });
                        
                        countryNode.Children.Add(tripNode);
                        
                        if (tripNode.IsExpanded)
                        {
                            await OnItemExpanded(tripNode);
                        }
                    }
                    typeNode.Children.Add(countryNode);
                }
                _treeItems.Add(typeNode);
            }
        }
    }

    private ViaggiTreeItem CreateNode(string title, string type, string icon, int? relatedId, HashSet<string>? expandedState)
    {
        var node = new ViaggiTreeItem
        {
            Title = title,
            Type = type,
            Icon = icon,
            RelatedId = relatedId
        };
        
        if (expandedState != null && expandedState.Contains(GetNodeKey(node)))
        {
            node.IsExpanded = true;
        }
        return node;
    }


    private bool Search(AnaViaggiEntity item, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (item.DescrizioneBreve?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.NazioneNome?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.TipoViaggioDescrizione?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (item.TipoTrattamentoDescrizione?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task OnTreeSelectionChanged(ViaggiTreeItem item)
    {
        if (item == null) return;
        _selectedTreeItem = item;

        switch (item.Type)
        {
            case "Country":
                _filteredItems = _allItems.Where(x => (x.NazioneNome ?? "Sconosciuta") == item.Title).ToList();
                break;
            case "Type":
                _filteredItems = _allItems.Where(x => (x.TipoViaggioDescrizione ?? "Altro") == item.Title).ToList();
                break;
            case "Trip":
                _filteredItems = _allItems.Where(x => x.Id == item.RelatedId).ToList();
                break;
            case "Date":
                // Logic to open Dialog focused on this Date
                if (item.RelatedId.HasValue)
                {
                    // Find Trip ID parent (we need to traverse or find in list).
                    // Since specific date belongs to a Trip, and we likely have the Trip ID in related parent or we can fetch.
                    // For now simplest way: Iterate _allItems to find which trip owns this date? No, date has ViaggioIdFk but we don't have the object here.
                    // Actually, TreeItem could store parent ID.
                    // But wait, the standard logic requested is: Click on Date -> Open Dialog Tab 2.
                    // We need the Trip Entity to open the main dialog.
                    // Let's implement a Helper to find Trip by Date ID or we can just pass the Trip ID to the TreeItem when building.
                    // Let's modify BuildTree / OnItemExpanded to store TripID in the Date Node context.
                    // FOR NOW: just ensure we select the trip in the grid.
                     var trip = _allItems.FirstOrDefault(t => t.Id == item.ParentId); // We will add ParentId to TreeItem
                     if (trip != null) 
                     {
                         _filteredItems = new List<AnaViaggiEntity> { trip };
                         // Open Dialog
                         await OpenEditDialog(trip, true); // true = focus on dates tab
                     }
                }
                break;
        }
        StateHasChanged(); // FORCE UI UPDATE
    }

    private async Task OnItemExpanded(ViaggiTreeItem item)
    {
        if (item.Type == "Trip" && !item.AreDatesLoaded && item.RelatedId.HasValue)
        {
            try
            {
                var dates = await ViaggiService.GetDatesByTripIdAsync(item.RelatedId.Value);
                item.Children.Clear(); // Remove dummy

                foreach (var d in dates)
                {
                    var color = GetStatusColor(d);
                    var title = $"Dal {d.DataInizio:dd/MM/yyyy} al {d.DataFine:dd/MM/yyyy} - Costo P: {d.CostoPilota:C0} - Costo Pass: {d.CostoPasseggero:C0} - N.Mezzi: {d.TotMezzi} - N.Cli.: {d.TotClienti}";

                    item.Children.Add(new ViaggiTreeItem
                        {
                            Title = title,
                            Type = "Date",
                            RelatedId = d.Id,
                            ParentId = item.RelatedId,
                            Icon = Icons.Material.Filled.Event,
                            IconColor = color
                        });
                }

                if (dates.Count == 0)
                {
                    item.Children.Add(new ViaggiTreeItem { Title = "Nessuna data", Type = "Info", Icon = Icons.Material.Filled.Info, IconColor = Color.Default });
                }

                item.AreDatesLoaded = true;
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore caricamento date: {ex.Message}", Severity.Error);
                item.Children.Clear();
                item.Children.Add(new ViaggiTreeItem { Title = "Errore", Type = "Error", Icon = Icons.Material.Filled.Error, IconColor = Color.Error });
            }
            StateHasChanged();
        }
    }

    private Color GetStatusColor(AnaDataViaggio date)
    {
        var today = DateTime.Today;
        // Logic:
        // Green: Effettuato Y AND EndDate < Today (Past)
        // Yellow: Effettuato N AND Today <= EndDate (Future/Present)
        // Red: Effettuato N AND EndDate < Today (Past)

        bool isPast = date.DataFine.HasValue && date.DataFine.Value < today;
        bool isFutureOrPresent = !isPast; // date.DataFine >= today
        bool isDone = date.EffettuatoSino == "Y";

        if (isDone && isPast) return Color.Success;
        if (!isDone && isFutureOrPresent) return Color.Warning;
        if (!isDone && isPast) return Color.Error;

        return Color.Default;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
            {
                ["IsEditMode"] = false,
                ["AziendaFk"] = _session?.AziendaId ?? 0
            };
        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                BackdropClick =
                false
            };
        var dialog = await DialogService.ShowAsync<AnaViaggiDialog>("Nuovo Viaggio", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data != null)
        {
            try
            {
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore ricaricamento dati: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(AnaViaggiEntity item, bool openDatesTab = false, bool autoAddDate = false)
    {
        // Need to fetch FULL entity (with description etc) if grid item is partial? Always safer.
        // Assuming GetByIdAsync returns full object.
        var entity = await ViaggiService.GetByIdAsync(item.Id);
        if (entity == null) return;

        var parameters = new DialogParameters
            {
                ["Entity"] = entity,
                ["IsEditMode"] = true,
                ["AziendaFk"] = _session?.AziendaId ?? 0,
                ["StartOnDatesTab"] = openDatesTab,
                ["AutoOpenAddDate"] = autoAddDate
            };
        // Ideally we add [Parameter] public bool StartOnDatesTab { get; set; } to AnaViaggiDialog.
        // Ideally we add [Parameter] public bool StartOnDatesTab { get; set; } to AnaViaggiDialog.
        
        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                BackdropClick =
                false
            };
        var dialog = await DialogService.ShowAsync<AnaViaggiDialog>("Modifica Viaggio", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data != null)
        {
            try
            {
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore ricaricamento dati: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenNewDateDialogFromTree()
    {
        if (_selectedTreeItem?.Type == "Trip" && _selectedTreeItem.RelatedId.HasValue)
        {
            var tripId = _selectedTreeItem.RelatedId.Value;
            var trip = _allItems.FirstOrDefault(x => x.Id == tripId);
            if (trip != null)
            {
                await OpenEditDialog(trip, true);
            }
        }
    }

    private async Task DeleteAsync(AnaViaggiEntity item)
    {
        bool? result = await DialogService.ShowMessageBox(
        "Conferma Eliminazione",
        $"Sei sicuro di voler eliminare il viaggio '{item.DescrizioneBreve}'?",
        yesText: "Elimina", cancelText: "Annulla");

        if (result == true)
        {
            try
            {
                await ViaggiService.DeleteAsync(item.Id);
                Snackbar.Add("Viaggio eliminato", Severity.Success);
                await LoadDataAsync();
            }
            catch (InvalidOperationException ex)
            {
                // Business logic error (e.g., dependencies found) - Show as Warning/Info, clean message
                Snackbar.Add(ex.Message, Severity.Warning); 
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error);
            }
        }
    }
}
