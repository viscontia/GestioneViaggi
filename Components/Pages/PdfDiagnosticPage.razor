@page "/pdf-diagnostic"
@using GestioneViaggi.Services.Printing
@using GestioneViaggi.Services.Database
@inject ISnackbar Snackbar
@inject IDatabaseConnectionManager ConnectionManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" />
            Test Diagnostico Stampe PDF
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-4">
            Questi test identificano esattamente dove fallisce la generazione delle stampe su Mac Catalyst.
        </MudText>

        <MudStack Spacing="3">
            <MudButton
                Color="Color.Primary"
                Variant="Variant.Filled"
                OnClick="RunQuestPdfDiagnostic"
                Disabled="_isRunning"
                StartIcon="@Icons.Material.Filled.PictureAsPdf">
                @if (_isRunningQuestPdf)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Test QuestPDF...</MudText>
                }
                else
                {
                    <MudText>Test 1: QuestPDF (Font + Generazione PDF)</MudText>
                }
            </MudButton>

            <MudButton
                Color="Color.Secondary"
                Variant="Variant.Filled"
                OnClick="RunDataRetrievalDiagnostic"
                Disabled="_isRunning"
                StartIcon="@Icons.Material.Filled.Storage">
                @if (_isRunningDataRetrieval)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Test Recupero Dati...</MudText>
                }
                else
                {
                    <MudText>Test 2: Recupero Dati (Dapper + JSON + LINQ)</MudText>
                }
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrEmpty(_diagnosticResult))
        {
            <MudPaper Class="mt-6 pa-4" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.h6" Class="mb-3">Risultati:</MudText>
                <MudText Typo="Typo.body2" Style="font-family: monospace; white-space: pre-wrap;">@_diagnosticResult</MudText>
            </MudPaper>
        }

        @if (!string.IsNullOrEmpty(_errorDetails))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Errore Catturato:</MudText>
                <MudText Typo="Typo.body2" Style="font-family: monospace; white-space: pre-wrap;">@_errorDetails</MudText>
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isRunning => _isRunningQuestPdf || _isRunningDataRetrieval;
    private bool _isRunningQuestPdf = false;
    private bool _isRunningDataRetrieval = false;
    private string? _diagnosticResult;
    private string? _errorDetails;

    private async Task RunQuestPdfDiagnostic()
    {
        if (_isRunning) return;

        _isRunningQuestPdf = true;
        _diagnosticResult = null;
        _errorDetails = null;
        StateHasChanged();

        try
        {
            _diagnosticResult = await PdfUtils.RunDiagnosticTestAsync();
            Snackbar.Add("Test QuestPDF completato", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorDetails = $"{ex.GetType().Name}: {ex.Message}\n\nStack Trace:\n{ex.StackTrace}";

            if (ex.InnerException != null)
            {
                _errorDetails += $"\n\nInner Exception:\n{ex.InnerException.GetType().Name}: {ex.InnerException.Message}";
            }

            Snackbar.Add("Test QuestPDF fallito - vedi dettagli", Severity.Error);
        }
        finally
        {
            _isRunningQuestPdf = false;
            StateHasChanged();
        }
    }

    private async Task RunDataRetrievalDiagnostic()
    {
        if (_isRunning) return;

        _isRunningDataRetrieval = true;
        _diagnosticResult = null;
        _errorDetails = null;
        StateHasChanged();

        try
        {
            _diagnosticResult = await PdfUtils.RunDataRetrievalTestAsync(ConnectionManager);
            Snackbar.Add("Test Recupero Dati completato", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorDetails = $"{ex.GetType().Name}: {ex.Message}\n\nStack Trace:\n{ex.StackTrace}";

            if (ex.InnerException != null)
            {
                _errorDetails += $"\n\nInner Exception:\n{ex.InnerException.GetType().Name}: {ex.InnerException.Message}";
            }

            Snackbar.Add("Test Recupero Dati fallito - vedi dettagli", Severity.Error);
        }
        finally
        {
            _isRunningDataRetrieval = false;
            StateHasChanged();
        }
    }
}
