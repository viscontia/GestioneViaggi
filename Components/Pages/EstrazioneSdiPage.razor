@page "/estrazione/sdi"
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Services.Printing
@using GestioneViaggi.Services.Export
@using GestioneViaggi.Components.Shared
@inject FatturaAttivaPrintService PrintService
@inject AziendaBancaService AziendaBancaService
@inject IFatturaElettronicaXmlService FatturaElettronicaXmlService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext
@inject ISessionManager SessionManager
@inject IJSRuntime JS
@implements IDisposable

<AppBreadcrumbs />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div style="width: 100%; overflow-x: auto;">

        <!-- Filters Area -->
        <MudPaper Elevation="0" Class="mb-4 pa-4 d-flex gap-4 align-center flex-wrap estrazione-sdi-filters">
            @if (_isSuperAdmin)
            {
                <div style="min-width: 200px;">
                    <AziendaSelect Value="_selectedAziendaIdInt" Label="Azienda" Clearable="false" ShowAllOption="false"
                        ValueChanged="@OnAziendaFilterChanged" />
                </div>
            }

            <div style="min-width: 120px;">
                <MudSelect T="int" Label="Anno" Value="_filterAnno" ValueChanged="@OnAnnoChanged" Variant="Variant.Outlined" Dense="true"
                           Disabled="@(_anniDisponibili.Count == 0)"
                          >
                    @foreach (var anno in _anniDisponibili)
                    {
                        <MudSelectItem Value="@anno">@anno</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div style="min-width: 160px;">
                <MudDatePicker Label="Data Doc. Da" @bind-Date="_filterDataDa" Editable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Converter="@ConvertitoreDataFlessibile.Standard" DateFormat="dd/MM/yyyy"
                               Placeholder="gg/mm/aaaa" />
            </div>

            <div style="min-width: 160px;">
                <MudDatePicker Label="Data Doc. A" @bind-Date="_filterDataA" Editable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Converter="@ConvertitoreDataFlessibile.Standard" DateFormat="dd/MM/yyyy"
                               Placeholder="gg/mm/aaaa" />
            </div>

            <div style="min-width: 220px;">
                <ControparteSelect SelectedControparteId="_filterControparteId"
                                   SelectedControparteIdChanged="@OnControparteFilterChanged"
                                   AziendaId="@_aziendaIdEffettivo"
                                   CausaleCiclo="ATTIVO"
                                   Label="Cliente"
                                   Clearable="true" />
            </div>

            <div style="min-width: 120px;">
                <MudNumericField T="decimal?" Label="Importo Da" @bind-Value="_filterImportoDa"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
            </div>

            <div style="min-width: 120px;">
                <MudNumericField T="decimal?" Label="Importo A" @bind-Value="_filterImportoA"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" />
            </div>

            <div style="min-width: 150px;">
                <MudSelect T="string" Label="Stato" @bind-Value="_filterStato" Variant="Variant.Outlined" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@("DA_PAGARE")">Da Pagare</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PAGATO")">Pagato</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PARZIALMENTE_PAGATO")">Parz. Pagato</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ANNULLATO")">Annullato</MudSelectItem>
                </MudSelect>
            </div>

            <div style="min-width: 130px;">
                <MudTextField T="string" Label="N. Documento" @bind-Value="_filterNumeroDocumento"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Class="uppercase-input" Immediate="true" Converter="@_uppercaseConverter" />
            </div>

            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ResetFilters"
                       StartIcon="@Icons.Material.Filled.Clear" Size="Size.Small">
                Reset
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CercaAsync"
                       StartIcon="@Icons.Material.Filled.Search" Size="Size.Small">
                Cerca
            </MudButton>
        </MudPaper>

        <!-- DataGrid risultati -->
        <EnterpriseDataGrid T="FatturaAttivaListItem" Items="_items" Title="Fatture Attive per Export SDI">
            <ToolBarActions>
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="EsportaTuttiXml"
                           Disabled="@(!_items.Any() || _isExporting)"
                           Size="Size.Small">
                    @if (_isExporting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1 mr-2" />
                        <span>Esportazione...</span>
                    }
                    else
                    {
                        <span>Esporta Tutti XML SDI (@_items.Count)</span>
                    }
                </MudButton>
            </ToolBarActions>
            <Columns>
                <PropertyColumn Property="x => x.DataDocumentoFormatted" Title="Data Doc."
                                CellStyle="white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 100px;" />

                <PropertyColumn Property="x => x.NumeroDocumento" Title="N. Doc."
                                CellStyle="white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 100px;" />

                <PropertyColumn Property="x => x.NumeroProtocolloIva" Title="Prot. IVA"
                                CellStyle="white-space: nowrap; padding: 8px 6px; text-align: center;"
                                HeaderStyle="padding: 8px 6px; width: 80px; text-align: center;" />

                <PropertyColumn Property="x => x.ControparteRagioneSociale" Title="Cliente"
                                CellStyle="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; min-width: 150px;" />

                <PropertyColumn Property="x => x.ImponibileFormatted" Title="Imponibile"
                                CellStyle="text-align: right; padding: 8px 6px;"
                                HeaderStyle="text-align: right; padding: 8px 6px; width: 100px;" />

                <PropertyColumn Property="x => x.IvaFormatted" Title="IVA"
                                CellStyle="text-align: right; padding: 8px 6px;"
                                HeaderStyle="text-align: right; padding: 8px 6px; width: 80px;" />

                <PropertyColumn Property="x => x.LordoFormatted" Title="Lordo"
                                CellStyle="text-align: right; font-weight: 600; padding: 8px 6px;"
                                HeaderStyle="text-align: right; padding: 8px 6px; width: 100px;" />

                <PropertyColumn Property="x => x.Stato" Title="Stato"
                                CellStyle="text-align: center; padding: 8px 6px;"
                                HeaderStyle="text-align: center; padding: 8px 6px; width: 100px;">
                    <CellTemplate>
                        <div style="width: 100%; pointer-events: none;">
                            <MudChip Color="@GetStatoColor(context.Item.Stato)" Size="Size.Small" Variant="Variant.Filled">
                                @context.Item.StatoDisplay
                            </MudChip>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.DataScadenzaFormatted" Title="Scadenza"
                                CellStyle="white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 100px;" />
            </Columns>
        </EnterpriseDataGrid>
    </div>
</MudContainer>

@code {
    private List<FatturaAttivaListItem> _items = new();
    private bool _isSuperAdmin;
    private int? _currentAziendaId;
    private bool _isExporting;

    // Filtri
    private int _selectedAziendaIdInt;
    private int? _selectedAziendaId => _selectedAziendaIdInt > 0 ? _selectedAziendaIdInt : null;
    private int _aziendaIdEffettivo => _isSuperAdmin ? (_selectedAziendaId ?? 0) : (_currentAziendaId ?? 0);
    private List<int> _anniDisponibili = new();
    private int _filterAnno;
    private DateTime? _filterDataDa;
    private DateTime? _filterDataA;
    private int _filterControparteId;
    private decimal? _filterImportoDa;
    private decimal? _filterImportoA;
    private string? _filterStato;
    private string? _filterNumeroDocumento;

    private Converter<string> _uppercaseConverter = new Converter<string>
    {
        SetFunc = value => value?.ToUpperInvariant(),
        GetFunc = text => text?.ToUpperInvariant()
    };

    protected override async Task OnInitializedAsync()
    {
        _isSuperAdmin = await TenantContext.IsSuperAdminAsync();
        if (!_isSuperAdmin)
        {
            _currentAziendaId = await TenantContext.GetCurrentAziendaIdAsync();
            await CaricaAnniDisponibiliAsync();
        }
    }

    private async Task OnAziendaFilterChanged(int id)
    {
        if (_selectedAziendaIdInt == id) return;
        _selectedAziendaIdInt = id;
        _filterControparteId = 0;
        _items.Clear();
        await CaricaAnniDisponibiliAsync();
        StateHasChanged();
    }

    private void OnControparteFilterChanged(int id)
    {
        _filterControparteId = id;
    }

    private void ResetFilters()
    {
        _filterAnno = _anniDisponibili.FirstOrDefault();
        ImpostaDateDaAnno(_filterAnno);
        _filterControparteId = 0;
        _filterImportoDa = null;
        _filterImportoA = null;
        _filterStato = null;
        _filterNumeroDocumento = null;
        _items.Clear();
        StateHasChanged();
    }

    private async Task CaricaAnniDisponibiliAsync()
    {
        if (_aziendaIdEffettivo <= 0)
        {
            _anniDisponibili.Clear();
            _filterAnno = 0;
            _filterDataDa = null;
            _filterDataA = null;
            return;
        }

        _anniDisponibili = await PrintService.GetAnniDisponibiliAsync(_aziendaIdEffettivo);
        _filterAnno = _anniDisponibili.FirstOrDefault();
        ImpostaDateDaAnno(_filterAnno);
    }

    private void OnAnnoChanged(int anno)
    {
        _filterAnno = anno;
        ImpostaDateDaAnno(anno);
    }

    private void ImpostaDateDaAnno(int anno)
    {
        if (anno > 0)
        {
            _filterDataDa = new DateTime(anno, 1, 1);
            _filterDataA = new DateTime(anno, 12, 31);
        }
        else
        {
            _filterDataDa = null;
            _filterDataA = null;
        }
    }

    private async Task CercaAsync()
    {
        if (_aziendaIdEffettivo <= 0)
        {
            Snackbar.Add("Seleziona un'azienda prima di cercare.", Severity.Warning);
            return;
        }

        if (_filterDataDa.HasValue != _filterDataA.HasValue)
        {
            Snackbar.Add("Inserire entrambe le date (Da e A) oppure nessuna.", Severity.Warning);
            return;
        }

        if (_filterDataDa.HasValue && _filterDataA.HasValue && _filterDataA < _filterDataDa)
        {
            Snackbar.Add("La data 'A' non puo' essere anteriore alla data 'Da'.", Severity.Warning);
            return;
        }

        if (_filterImportoDa.HasValue && _filterImportoA.HasValue && _filterImportoDa > _filterImportoA)
        {
            Snackbar.Add("L'importo 'Da' non puo' essere superiore all'importo 'A'.", Severity.Warning);
            return;
        }

        try
        {
            _items = await PrintService.GetElencoFattureAttiveAsync(
                _aziendaIdEffettivo,
                _filterControparteId > 0 ? _filterControparteId : null,
                _filterDataDa,
                _filterDataA,
                _filterImportoDa,
                _filterImportoA,
                _filterStato,
                !string.IsNullOrWhiteSpace(_filterNumeroDocumento) ? _filterNumeroDocumento.ToUpperInvariant() : null);

            if (_items.Count == 0)
            {
                Snackbar.Add("Nessuna fattura attiva trovata con i filtri selezionati.", Severity.Info);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nella ricerca: {ex.Message}", Severity.Error);
            _items.Clear();
            StateHasChanged();
        }
    }

    private async Task EsportaTuttiXml()
    {
        if (!_items.Any()) return;

        _isExporting = true;
        StateHasChanged();

        try
        {
            // 1. Selezione banca (una volta per tutte le fatture)
            InvoiceBankInfo? bankInfo = null;
            var banche = await AziendaBancaService.GetByAziendaIdAsync(_aziendaIdEffettivo);

            if (banche.Count == 1)
            {
                bankInfo = MapBancaToInvoice(banche[0]);
            }
            else if (banche.Count > 1)
            {
                var parameters = new DialogParameters { ["AziendaId"] = _aziendaIdEffettivo };
                var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
                var dialog = await DialogService.ShowAsync<SelezioneBancaDialog>("Seleziona Conto Bancario per XML", parameters, options);
                var result = await dialog.Result;

                if (result == null || result.Canceled)
                {
                    _isExporting = false;
                    StateHasChanged();
                    return;
                }

                if (result.Data is AziendaBanca selectedBanca)
                    bankInfo = MapBancaToInvoice(selectedBanca);
            }

            // 2. Export massivo
            var totale = _items.Count;
            var esportate = 0;
            var errori = new List<string>();

            foreach (var item in _items)
            {
                try
                {
                    await FatturaElettronicaXmlService.GeneraXmlFatturaAsync(item.TransazioneId, bankInfo);
                    esportate++;
                }
                catch (InvalidOperationException ex)
                {
                    errori.Add($"N. {item.NumeroDocumento ?? item.TransazioneId.ToString()} - {ex.Message}");
                }
                catch (Exception ex)
                {
                    errori.Add($"N. {item.NumeroDocumento ?? item.TransazioneId.ToString()} - Errore: {ex.Message}");
                }
            }

            // 3. Report finale
            var messaggio = $"Fatture esportate: {esportate} su {totale}";
            if (errori.Any())
            {
                messaggio += $"\n\nErrori ({errori.Count}):\n" + string.Join("\n", errori.Select(e => $"- {e}"));
            }

            await DialogService.ShowMessageBox(
                "Esportazione XML Completata",
                messaggio,
                yesText: "OK");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante l'esportazione: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private static InvoiceBankInfo MapBancaToInvoice(AziendaBanca banca)
    {
        return new InvoiceBankInfo
        {
            NomeBanca = banca.NomeBanca,
            Filiale = banca.Filiale,
            Iban = banca.Iban,
            SwiftBic = banca.SwiftBic
        };
    }

    private Color GetStatoColor(string stato) => stato switch
    {
        "PAGATO" => Color.Success,
        "DA_PAGARE" => Color.Warning,
        "PARZIALMENTE_PAGATO" => Color.Info,
        "ANNULLATO" => Color.Error,
        _ => Color.Default
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dialogFormHelper.setupTabNavigation", ".estrazione-sdi-filters");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up tab navigation: {ex.Message}");
            }
        }
    }

    public void Dispose()
    {
        try
        {
            JS.InvokeVoidAsync("dialogFormHelper.cleanup", ".estrazione-sdi-filters");
        }
        catch { }
    }
}
