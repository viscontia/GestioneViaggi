@page "/movimenti"
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Components.Shared
@using GestioneViaggi.Models.DTOs
@inject MovTransazioniService TransazioniService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext
@inject ISessionManager SessionManager
@using GestioneViaggi.Services.Printing
@inject FatturaAttivaPrintService FatturaAttivaPrintService
@inject AziendaBancaService AziendaBancaService
@inject IPdfOpenerService PdfOpenerService

<AppBreadcrumbs />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div style="width: 100%; overflow-x: auto;">
        
        <!-- Filters Area -->
        <MudPaper Elevation="0" Class="mb-4 pa-4 d-flex gap-4 align-center flex-wrap">
            @if (_isSuperAdmin)
            {
                <div style="min-width: 200px;">
                    <AziendaSelect Value="_selectedAziendaId" Label="Filtra per Azienda" Clearable="false" ShowAllOption="false"
                        ValueChanged="@OnAziendaFilterChanged" />
                </div>
            }

            <div style="min-width: 200px;">
                 <ViaggioSelect SelectedViaggioId="_filterViaggioId" 
                               SelectedViaggioIdChanged="@OnViaggioFilterChanged"
                               Label="Filtra Viaggio" 
                               Clearable="true" 
                               CustomItems="@_distinctViaggi"
                               Disabled="@(!_distinctViaggi.Any())" />
            </div>

            <div style="min-width: 200px;">
                <DataViaggioSelect SelectedDataViaggioId="_filterDataViaggioId" 
                                  SelectedDataViaggioIdChanged="@OnDataViaggioFilterChanged"
                                  ViaggioId="_filterViaggioId" 
                                  Label="Filtra Data Viaggio" 
                                  Clearable="true" 
                                  CustomItems="@_distinctDateViaggi"
                                  Disabled="@(!_filterViaggioId.HasValue)" />
            </div>

            <div style="min-width: 180px;">
                <CausaleSelect SelectedCausaleId="_filterCausaleTipoIdInt"
                               SelectedCausaleIdChanged="@OnCausaleFilterChanged"
                               AziendaId="@(_isSuperAdmin ? _selectedAziendaId : (_currentAziendaId ?? 0))"
                               Label="Filtra Causale"
                               Clearable="true" />
            </div>

             <div style="min-width: 150px;">
                <MudDatePicker Label="Data Movimento" 
                               Date="_filterDataTransazione"
                               DateChanged="@(EventCallback.Factory.Create<DateTime?>(this, OnDataTransazioneFilterChanged))"
                               Clearable="true"
                               Variant="Variant.Outlined" 
                               Editable="true"
                               Mask="@(new DateMask("dd/MM/yyyy"))"
                               Adornment="Adornment.End" 
                               AdornmentIcon="@Icons.Material.Filled.Event" />
            </div>

            <div style="min-width: 150px;">
               <MudCheckBox Value="_filterSoloDaPagare" 
                            ValueChanged="@(EventCallback.Factory.Create<bool>(this, OnSoloDaPagareFilterChanged))"
                            Label="Solo da Pagare" 
                            Color="Color.Primary" 
                            Dense="true" />
            </div>
            
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterListOff" OnClick="@ClearFilters" Class="ml-auto">
                Reset
            </MudButton>
        </MudPaper>


        <EnterpriseDataGrid T="MovTransazioni"
                            Title="Gestione Movimenti"
                            Items="@_items"
                            SearchFunction="@Search"
                            ColumnResizeMode="ResizeMode.Column"
                            Breakpoint="Breakpoint.None"
                            FixedHeader="false"
                            @bind-SelectedItem="_selectedItem">
            
            <ToolBarActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenCreateDialog">
                    Nuova Transazione
                </MudButton>
            </ToolBarActions>

            <Columns>
                @if (_isSuperAdmin)
                {
                    <PropertyColumn Property="x => x.AziendaCodice" Sortable="true" Title="Az."
                                    CellStyle="white-space: nowrap; text-align: center; padding: 8px 6px;"
                                    HeaderStyle="text-align: center; padding: 8px 6px; width: 80px; min-width: 60px;">
                    </PropertyColumn>
                }

                <PropertyColumn Property="x => x.TransazioneData" Title="Data" Format="dd/MM/yyyy" Sortable="true"
                                CellStyle="white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 100px; min-width: 80px;" />

                <PropertyColumn Property="x => x.ControparteRagioneSociale" Title="Controparte"
                                CellStyle="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 180px; min-width: 120px;" />

                <PropertyColumn Property="x => x.CausaleDescrizione" Title="Causale Contabile"
                                CellStyle="padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 140px; min-width: 100px;">
                    <CellTemplate>
                        <div style="width: 100%; pointer-events: none;">
                            @if (context.Item.CausaleSegno > 0)
                            {
                                <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Text">@context.Item.CausaleDescrizione</MudChip>
                            }
                            else
                            {
                                <MudChip Color="Color.Error" Size="Size.Small" Variant="Variant.Text">@context.Item.CausaleDescrizione</MudChip>
                            }
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TransazioneCausale" Title="Descrizione" 
                                CellStyle="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 220px; min-width: 150px;" />

                <PropertyColumn Property="x => x.ImportoFormattato" Title="Importo"
                                CellStyle="font-weight: bold; text-align: right; white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="text-align: right; padding: 8px 6px; width: 110px; min-width: 90px;" />

                <PropertyColumn Property="x => x.TransazioneStato" Title="Stato"
                                CellStyle="text-align: center; padding: 8px 6px;"
                                HeaderStyle="text-align: center; padding: 8px 6px; width: 100px; min-width: 80px;">
                    <CellTemplate>
                        <div style="width: 100%; pointer-events: none;">
                            <MudChip Color="@GetStatoColor(context.Item.TransazioneStato)" Size="Size.Small" Variant="Variant.Filled">
                                @context.Item.TransazioneStato.Replace("_", " ")
                            </MudChip>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TransazioneNumeroDocumento" Title="Doc. Num."
                                CellStyle="white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 100px; min-width: 80px;" />

                <PropertyColumn Property="x => x.ViaggioDescrizione" Title="Viaggio"
                                CellStyle="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 140px; min-width: 100px;" />

                <TemplateColumn T="MovTransazioni" Tag="@("Actions")" Sortable="false" StickyLeft="true"
                                HeaderClass="sticky-actions-column" CellClass="sticky-actions-column">
                    <HeaderTemplate>
                        <MudText Typo="Typo.caption"
                            Style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Azioni</MudText>
                    </HeaderTemplate>
                    <CellTemplate Context="cellContext">
                        <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                            <MudTooltip Text="Modifica">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                    Class="inline-action-btn edit-btn" OnClick="@(() => OpenEditDialog(cellContext.Item))" />
                            </MudTooltip>
                            @if (cellContext.Item.TransazioneStato is "DA_PAGARE" or "PARZIALMENTE_PAGATO")
                            {
                                <MudTooltip Text="Paga Ora">
                                    <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                                   Size="Size.Small"
                                                   Color="Color.Success"
                                                   Class="inline-action-btn payment-btn"
                                                   OnClick="@(() => PagaOraAsync(cellContext.Item))" />
                                </MudTooltip>
                            }
                            @if (cellContext.Item.IsFatturaAttiva)
                            {
                                <MudTooltip Text="Stampa Fattura">
                                    <MudIconButton Icon="@Icons.Material.Filled.Print"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   Class="inline-action-btn print-btn"
                                                   OnClick="@(() => StampaFatturaAttiva(cellContext.Item))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Elimina">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default"
                                    Class="inline-action-btn delete-btn" OnClick="@(() => DeleteTransazione(cellContext.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </EnterpriseDataGrid>
    </div>
</MudContainer>

@code {
    private List<MovTransazioni> _items = new();
    private MovTransazioni? _selectedItem;
    private bool _isSuperAdmin;
    private int _selectedAziendaId = 0; // 0 = Tutte
    private int? _currentAziendaId;
    
    // UI Filters
    private int? _filterViaggioId;
    private int? _filterDataViaggioId;
    private DateTime? _filterDataTransazione;
    private bool _filterSoloDaPagare;
    private int _filterCausaleTipoIdInt;
    private int? _filterCausaleTipoId => _filterCausaleTipoIdInt > 0 ? _filterCausaleTipoIdInt : null;

    // Cache per select
    private List<GestioneViaggi.Models.AnaViaggi> _distinctViaggi = new();
    private List<DataViaggioDTO> _distinctDateViaggi = new();

    protected override async Task OnInitializedAsync()
    {
        _isSuperAdmin = await TenantContext.IsSuperAdminAsync();
        if (!_isSuperAdmin)
        {
            _currentAziendaId = await TenantContext.GetCurrentAziendaIdAsync();
        }

        // Carica dati iniziali
        await LoadDistinctFiltersAsync();
        await LoadDataAsync();
    }

    private async Task LoadDistinctFiltersAsync()
    {
        try
        {
            int? aziendaId = _isSuperAdmin 
                ? (_selectedAziendaId > 0 ? _selectedAziendaId : null) 
                : _currentAziendaId;

            _distinctViaggi = (await TransazioniService.GetDistinctViaggiAsync(aziendaId)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento filtri: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatoColor(string stato) => stato switch
    {
        "PAGATO" => Color.Success,
        "DA_PAGARE" => Color.Warning,
        "PARZIALMENTE_PAGATO" => Color.Info,
        "ANNULLATO" => Color.Error,
        _ => Color.Default
    };

    private async Task OnAziendaFilterChanged(int id)
    {
        if (_selectedAziendaId == id) return;
        _selectedAziendaId = id;
        
        // Reset dipendenze
        _filterViaggioId = null;
        _filterDataViaggioId = null;
        _filterCausaleTipoIdInt = 0;
        
        await LoadDistinctFiltersAsync();
        await LoadDataAsync();
    }

    private async Task OnViaggioFilterChanged(int? id)
    {
        if (_filterViaggioId == id) return;
        _filterViaggioId = id;
        _filterDataViaggioId = null;
        
        try
        {
            if (id.HasValue)
            {
                _distinctDateViaggi = (await TransazioniService.GetDistinctDateViaggiAsync(id.Value)).ToList();
            }
            else
            {
                _distinctDateViaggi.Clear();
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento date: {ex.Message}", Severity.Error);
            _distinctDateViaggi = new List<DataViaggioDTO>();
            StateHasChanged();
        }
    }
    
    private async Task OnDataViaggioFilterChanged(int? id)
    {
        if (_filterDataViaggioId == id) return;
        _filterDataViaggioId = id;
        await LoadDataAsync();
    }

    private async Task OnCausaleFilterChanged(int id)
    {
        if (_filterCausaleTipoIdInt == id) return;
        _filterCausaleTipoIdInt = id;
        await LoadDataAsync();
    }

    private async Task OnDataTransazioneFilterChanged(DateTime? date)
    {
        _filterDataTransazione = date;
        await LoadDataAsync();
    }

    private async Task OnSoloDaPagareFilterChanged(bool val)
    {
        _filterSoloDaPagare = val;
        await LoadDataAsync();
    }

    private async Task ClearFilters()
    {
        _filterViaggioId = null;
        _filterDataViaggioId = null;
        _filterDataTransazione = null;
        _filterSoloDaPagare = false;
        _filterCausaleTipoIdInt = 0;
        _distinctDateViaggi.Clear();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            if (_isSuperAdmin)
            {
                if (_selectedAziendaId > 0)
                {
                    _items = (await TransazioniService.GetByAziendaAsync(_selectedAziendaId,
                        _filterViaggioId, _filterDataViaggioId, _filterDataTransazione, _filterSoloDaPagare, _filterCausaleTipoId)).ToList();
                }
                else
                {
                    _items = new List<MovTransazioni>();
                    // Non mostriamo errori qui, aspettiamo che l'utente selezioni l'azienda
                }
            }
            else
            {
                if (_currentAziendaId.HasValue && _currentAziendaId.Value > 0)
                {
                    _items = (await TransazioniService.GetByAziendaAsync(_currentAziendaId.Value,
                        _filterViaggioId, _filterDataViaggioId, _filterDataTransazione, _filterSoloDaPagare, _filterCausaleTipoId)).ToList();
                }
                else
                {
                    _items = new List<MovTransazioni>();
                    Snackbar.Add("Errore: nessuna azienda assegnata all'utente corrente", Severity.Error);
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento delle transazioni: {ex.Message}", Severity.Error);
            _items = new List<MovTransazioni>();
            StateHasChanged();
        }
    }

    private async Task OpenCreateDialog()
    {
        if (_isSuperAdmin && _selectedAziendaId == 0)
        {
            Snackbar.Add("Selezionare un'Azienda prima di inserire una nuova Transazione", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Transazione"] = new MovTransazioni(),
            ["AziendaId"] = _selectedAziendaId > 0 ? _selectedAziendaId : (_currentAziendaId ?? 0)
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MovTransazioniEditDialog>("Nuova Transazione", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(MovTransazioni item)
    {
        // Carica la transazione completa con le righe di dettaglio (master-detail)
        var fullItem = await TransazioniService.GetByIdAsync(item.TransazioneId);
        if (fullItem == null)
        {
            Snackbar.Add("Errore: transazione non trovata", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Transazione"] = fullItem,
            ["AziendaId"] = fullItem.TransazioneAziendaId
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MovTransazioniEditDialog>("Modifica Transazione", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task PagaOraAsync(MovTransazioni item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var dialog = await DialogService.ShowAsync<PagaOraDialog>("Registra Pagamento", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PagaOraDialogResult paymentResult)
        {
            try
            {
                var session = await SessionManager.GetSessionAsync();
                int pgId = await TransazioniService.PagaOraAsync(
                    item.TransazioneId,
                    paymentResult.ImportoPagamento,
                    paymentResult.DataPagamento,
                    paymentResult.Note,
                    session?.User?.Username ?? "System");

                Snackbar.Add($"Pagamento registrato con successo (ID: {pgId})", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante il pagamento: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteTransazione(MovTransazioni item)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Elimina Transazione", 
            $"Sei sicuro di voler eliminare la transazione del {item.TransazioneData:d} per {item.ImportoFormattato}?", 
            yesText: "Elimina", cancelText: "Annulla");

        if (result == true)
        {
            try
            {
                await TransazioniService.DeleteAsync(item.TransazioneId);
                Snackbar.Add("Transazione eliminata", Severity.Success);
                await LoadDataAsync();
            }
            catch (InvalidOperationException ex)
            {
                // Blocco business rule (es. protocollo IVA assegnato) - mostra come avviso
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore durante l'eliminazione: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task StampaFatturaAttiva(MovTransazioni item)
    {
        try
        {
            Snackbar.Add("Caricamento dati fattura...", Severity.Info);

            // 1. Carica dati fattura
            var printData = await FatturaAttivaPrintService.GetFatturaAttivaDataAsync(item.TransazioneId);
            if (printData == null)
            {
                Snackbar.Add("Impossibile caricare i dati della fattura", Severity.Error);
                return;
            }

            // 2. Gestione selezione banca
            var aziendaId = item.TransazioneAziendaId;
            var banche = await AziendaBancaService.GetByAziendaIdAsync(aziendaId);

            if (banche.Count == 1)
            {
                // Una sola banca: usa direttamente
                printData.Bank = MapBancaToInvoice(banche[0]);
            }
            else if (banche.Count > 1)
            {
                // Più banche: mostra dialog di selezione
                var parameters = new DialogParameters { ["AziendaId"] = aziendaId };
                var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
                var dialog = await DialogService.ShowAsync<SelezioneBancaDialog>("Seleziona Conto Bancario", parameters, options);
                var result = await dialog.Result;

                if (result == null || result.Canceled)
                    return;

                if (result.Data is AziendaBanca selectedBanca)
                {
                    printData.Bank = MapBancaToInvoice(selectedBanca);
                }
            }
            // Se 0 banche: stampa senza dati bancari

            // 3. Genera PDF
            Snackbar.Add("Generazione PDF in corso...", Severity.Info);

            var session = await SessionManager.GetSessionAsync();
            printData.UtenteStampa = session?.User?.FullName ?? "System";

            var targetFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            var fileName = PdfFileNameHelper.GetFatturaAttivaFileName(
                printData.NumeroDocumento, printData.Client.RagioneSociale, printData.DataDocumento);
            var outputPath = Path.Combine(targetFolder, fileName);

            if (File.Exists(outputPath))
                File.Delete(outputPath);

            await FatturaAttivaPrinter.GeneratePdfAsync(printData, outputPath);
            await PdfOpenerService.OpenPdfAsync(outputPath, "Fattura Generata");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore durante la stampa della fattura: {ex.Message}", Severity.Error);
        }
    }

    private static Services.Printing.InvoiceBankInfo MapBancaToInvoice(AziendaBanca banca)
    {
        return new Services.Printing.InvoiceBankInfo
        {
            NomeBanca = banca.NomeBanca,
            Filiale = banca.Filiale,
            Iban = banca.Iban,
            SwiftBic = banca.SwiftBic
        };
    }

    private Func<MovTransazioni, string, bool> Search => (t, searchString) =>
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;

        // Cerca in Fornitore, Descrizione (Causale libera), Tipo (Causale contabile), Viaggio
        if (t.ControparteRagioneSociale?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneCausale?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.CausaleDescrizione?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneNumeroDocumento?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.ViaggioDescrizione?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    };
}
