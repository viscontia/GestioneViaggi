@page "/movimenti"
@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Components.Shared
@using GestioneViaggi.Models.DTOs
@inject MovTransazioniService TransazioniService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext

<AppBreadcrumbs />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div style="width: 100%; overflow-x: auto;">
        
        <!-- DEBUG PANEL AT TOP -->


        <!-- Filters Area -->
        <MudPaper Elevation="0" Class="mb-4 pa-4 d-flex gap-4 align-center flex-wrap">
             @if (_isSuperAdmin)
            {
                <div style="min-width: 200px;">
                    <AziendaSelect Value="_selectedAziendaId" Label="Filtra per Azienda" Clearable="false" ShowAllOption="true"
                        ValueChanged="@OnAziendaFilterChanged" />
                </div>
            }

            <div style="min-width: 200px;">
                 <ViaggioSelect SelectedViaggioId="_filterViaggioId" 
                               SelectedViaggioIdChanged="@OnViaggioFilterChanged"
                               Label="Filtra Viaggio" 
                               Clearable="true" 
                               CustomItems="@_distinctViaggi"
                               Disabled="@(!_distinctViaggi.Any())" />
            </div>

            <div style="min-width: 200px;">
                <DataViaggioSelect SelectedDataViaggioId="_filterDataViaggioId" 
                                  SelectedDataViaggioIdChanged="@OnDataViaggioFilterChanged"
                                  ViaggioId="_filterViaggioId" 
                                  Label="Filtra Data Viaggio" 
                                  Clearable="true" 
                                  CustomItems="@_distinctDateViaggi"
                                  Disabled="@(!_filterViaggioId.HasValue)" />
            </div>

             <div style="min-width: 150px;">
                <MudDatePicker Label="Data Movimento" 
                               Date="_filterDataTransazione"
                               DateChanged="@(EventCallback.Factory.Create<DateTime?>(this, OnDataTransazioneFilterChanged))"
                               Clearable="true"
                               Variant="Variant.Outlined" 
                               Adornment="Adornment.End" 
                               AdornmentIcon="@Icons.Material.Filled.Event" />
            </div>

            <div style="min-width: 150px;">
               <MudCheckBox Value="_filterSoloDaPagare" 
                            ValueChanged="@(EventCallback.Factory.Create<bool>(this, OnSoloDaPagareFilterChanged))"
                            Label="Solo da Pagare" 
                            Color="Color.Primary" 
                            Dense="true" />
            </div>
            
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterListOff" OnClick="@ClearFilters" Class="ml-auto">
                Reset
            </MudButton>
        </MudPaper>


        <EnterpriseDataGrid T="MovTransazioni"
                            Title="Gestione Movimenti"
                            Items="@_items"
                            SearchFunction="@Search"
                            ColumnResizeMode="ResizeMode.Column"
                            Breakpoint="Breakpoint.None"
                            FixedHeader="false"
                            @bind-SelectedItem="_selectedItem">
            
            <ToolBarActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenCreateDialog">
                    Nuova Transazione
                </MudButton>
            </ToolBarActions>

            <Columns>
                @if (_isSuperAdmin)
                {
                    <PropertyColumn Property="x => x.AziendaCodice" Sortable="true"
                                    CellStyle="white-space: nowrap; text-align: center; padding: 8px 6px;"
                                    HeaderStyle="text-align: center; padding: 8px 6px; width: 80px; min-width: 60px;">
                        <HeaderTemplate>
                            <div style="line-height: 1.1;">Cod.<br/>Az.</div>
                        </HeaderTemplate>
                    </PropertyColumn>
                }

                <PropertyColumn Property="x => x.TransazioneData" Title="Data" Format="dd/MM/yyyy" Sortable="true"
                                CellStyle="padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 120px; min-width: 100px;" />

                <PropertyColumn Property="x => x.TransazioneTipoMovimento" Title="Tipo"
                                CellStyle="padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 100px; min-width: 80px;">
                    <CellTemplate>
                        <div style="width: 100%; pointer-events: none;">
                            @if (context.Item.TransazioneTipoMovimento == "ENTRATA")
                            {
                                <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Entrata</MudChip>
                            }
                            else
                            {
                                <MudChip Color="Color.Error" Size="Size.Small" Variant="Variant.Text">Uscita</MudChip>
                            }
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ViaggioDescrizione" Title="Viaggio" Sortable="true"
                                CellStyle="padding: 8px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                HeaderStyle="padding: 8px 6px; width: 200px; min-width: 150px;">
                    <CellTemplate>
                        <div title="@context.Item.ViaggioDescrizione" style="overflow: hidden; text-overflow: ellipsis; pointer-events: none;">
                            @(context.Item.ViaggioDescrizione ?? "-")
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.DataViaggioInizio" Title="Data Viaggio" Format="dd/MM/yyyy" Sortable="true"
                                CellStyle="padding: 8px 6px;"
                                HeaderStyle="padding: 8px 6px; width: 120px; min-width: 100px;">
                    <CellTemplate>
                        <div style="pointer-events: none;">
                            @(context.Item.DataViaggioInizio.HasValue ? context.Item.DataViaggioInizio.Value.ToString("dd/MM/yyyy") : "-")
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.FornitoreRagioneSociale" Title="Fornitore"
                                CellStyle="padding: 8px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                HeaderStyle="padding: 8px 6px; width: 200px; min-width: 150px;">
                    <CellTemplate>
                        <div title="@context.Item.FornitoreRagioneSociale" style="overflow: hidden; text-overflow: ellipsis; pointer-events: none;">
                            @context.Item.FornitoreRagioneSociale
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TransazioneCausale" Title="Causale"
                                CellStyle="padding: 8px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                HeaderStyle="padding: 8px 6px; width: 200px; min-width: 150px;">
                    <CellTemplate>
                        <div title="@context.Item.TransazioneCausale" style="overflow: hidden; text-overflow: ellipsis; pointer-events: none;">
                            @context.Item.TransazioneCausale
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TransazioneImporto" Title="Importo Orig."
                                CellStyle="font-weight:bold; padding: 8px 6px; text-align: right;"
                                HeaderStyle="padding: 8px 6px; text-align: right; width: 120px; min-width: 100px;">
                    <CellTemplate>
                        <div style="pointer-events: none;">
                            @context.Item.ImportoFormattato
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TransazioneImportoEur" Title="Importo (EUR)" Format="N2"
                                CellStyle="padding: 8px 6px; text-align: right;"
                                HeaderStyle="padding: 8px 6px; text-align: right; width: 120px; min-width: 100px;" />

                 <PropertyColumn Property="x => x.TransazioneStato" Title="Stato"
                                  CellStyle="padding: 8px 6px;"
                                  HeaderStyle="padding: 8px 6px; width: 100px; min-width: 80px;">
                    <CellTemplate>
                        <div style="pointer-events: none;">
                            <StatusBadge Status="@context.Item.TransazioneStato" />
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <EnterpriseActionsColumn T="MovTransazioni" OnEdit="@OpenEditDialog" OnDelete="@DeleteTransazione" />
            </Columns>
        </EnterpriseDataGrid>
    </div>
</MudContainer>

@code {
    private List<MovTransazioni> _items = new();
    private MovTransazioni? _selectedItem;

    // Filter properties

    // Filter properties
    private List<GestioneViaggi.Models.AnaViaggi> _distinctViaggi = new();
    private List<DataViaggioDTO> _distinctDateViaggi = new();
    private int? _filterViaggioId;
    private int? _filterDataViaggioId;
    private DateTime? _filterDataTransazione;
    private bool _filterSoloDaPagare; // Replaces previous logic if any

    // SuperAdmin Logic
    private int? _currentAziendaId;
    private int _selectedAziendaId; // 0 = All
    private bool _isSuperAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isSuperAdmin = await TenantContext.IsSuperAdminAsync();

        if (_isSuperAdmin)
        {
            _currentAziendaId = null;
        }
        else
        {
            _currentAziendaId = await TenantContext.GetCurrentAziendaIdAsync();
        }

        await LoadFiltersDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task OnAziendaFilterChanged(int aziendaId)
    {
        _selectedAziendaId = aziendaId;

        // Reset filters when company changes
        _filterViaggioId = null;
        _filterDataViaggioId = null;
        _filterDataTransazione = null;
        _filterSoloDaPagare = false;

        await LoadFiltersDataAsync();
        await LoadDataAsync();
    }
    
    // --- Filtering Logic ---



    private async Task LoadFiltersDataAsync()
    {
        int? aziendaIdTarget = _isSuperAdmin ? (_selectedAziendaId > 0 ? _selectedAziendaId : null) : _currentAziendaId;

        try
        {
            _distinctViaggi = (await TransazioniService.GetDistinctViaggiAsync(aziendaIdTarget)).ToList();
            _distinctDateViaggi.Clear();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento filtri: {ex.Message}", Severity.Error);
            _distinctViaggi = new List<GestioneViaggi.Models.AnaViaggi>();
            _distinctDateViaggi = new List<DataViaggioDTO>();
        }
    }



    private async Task ClearFilters()
    {
        _filterViaggioId = null;
        _filterDataViaggioId = null;
        _filterDataTransazione = null;
        _filterSoloDaPagare = false;
        _distinctDateViaggi.Clear();
        StateHasChanged();
        await LoadDataAsync();
    }
    
    // Handlers for UI changes (to be wired up properly)
    // Actually, I need to update the Razor part to use ValueChanged or Property setter logic correctly.
    // I will update the razor markup in a simpler way: using @bind:after or manually handling ValueChanged.
    // MudBlazor supports generic binding.
    // BUT my `ViaggioSelect` uses `SelectedViaggioIdChanged`. 
    // I will modify the bindings in the Razor markup to call `ApplyFilters` (or `OnFilterViaggioChanged`).

    private async Task OnViaggioFilterChanged(int? id)
    {
        // Prevent redundant calls if the value hasn't actually changed
        if (_filterViaggioId == id)
            return;

        _filterViaggioId = id;
        _filterDataViaggioId = null; // Reset data viaggio filter when viaggio changes

        try
        {
            if (id.HasValue)
            {
                _distinctDateViaggi = (await TransazioniService.GetDistinctDateViaggiAsync(id.Value)).ToList();
            }
            else
            {
                _distinctDateViaggi.Clear();
            }

            // StateHasChanged will be called by LoadDataAsync, no need to call it twice
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento date: {ex.Message}", Severity.Error);
            _distinctDateViaggi = new List<DataViaggioDTO>();
            StateHasChanged();
        }
    }
    
    private async Task OnDataViaggioFilterChanged(int? id)
    {
        // Prevent redundant calls if the value hasn't actually changed
        if (_filterDataViaggioId == id)
            return;

        _filterDataViaggioId = id;
        await LoadDataAsync();
    }

    private async Task OnDataTransazioneFilterChanged(DateTime? date)
    {
        _filterDataTransazione = date;
        await LoadDataAsync();
    }

    private async Task OnSoloDaPagareFilterChanged(bool val)
    {
        _filterSoloDaPagare = val;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            if (_isSuperAdmin)
            {
                if (_selectedAziendaId == 0)
                {
                    _items = (await TransazioniService.GetAllAsync(
                        _filterViaggioId, _filterDataViaggioId, _filterDataTransazione, _filterSoloDaPagare)).ToList();
                }
                else
                {
                    _items = (await TransazioniService.GetByAziendaAsync(_selectedAziendaId,
                        _filterViaggioId, _filterDataViaggioId, _filterDataTransazione, _filterSoloDaPagare)).ToList();
                }
            }
            else
            {
                if (_currentAziendaId.HasValue && _currentAziendaId.Value > 0)
                {
                    _items = (await TransazioniService.GetByAziendaAsync(_currentAziendaId.Value,
                        _filterViaggioId, _filterDataViaggioId, _filterDataTransazione, _filterSoloDaPagare)).ToList();
                }
                else
                {
                    _items = new List<MovTransazioni>();
                    Snackbar.Add("Errore: nessuna azienda assegnata all'utente corrente", Severity.Error);
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore nel caricamento delle transazioni: {ex.Message}", Severity.Error);
            _items = new List<MovTransazioni>();
            StateHasChanged();
        }
    }

    private async Task OpenCreateDialog()
    {
        // Enforce company selection for SuperAdmin
        if (_isSuperAdmin && _selectedAziendaId == 0)
        {
            Snackbar.Add("Selezionare un'Azienda prima di inserire una nuova Transazione", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Transazione"] = new MovTransazioni(),
            ["AziendaId"] = _selectedAziendaId > 0 ? _selectedAziendaId : (_currentAziendaId ?? 0)
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MovTransazioniEditDialog>("Nuova Transazione", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(MovTransazioni item)
    {
        var parameters = new DialogParameters
        {
            ["Transazione"] = item,
            ["AziendaId"] = item.TransazioneAziendaId
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MovTransazioniEditDialog>("Modifica Transazione", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task DeleteTransazione(MovTransazioni item)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Elimina Transazione", 
            $"Sei sicuro di voler eliminare la transazione del {item.TransazioneData:d} per {item.ImportoFormattato}?", 
            yesText: "Elimina", cancelText: "Annulla");

        if (result == true)
        {
            try
            {
                await TransazioniService.DeleteAsync(item.TransazioneId);
                Snackbar.Add("Transazione eliminata", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error);
            }
        }
    }

    private Func<MovTransazioni, string, bool> Search => (t, searchString) =>
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;

        // Cerca in Fornitore, Causale, Tipo, Viaggio
        if (t.FornitoreRagioneSociale?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneCausale?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneTipoMovimento?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneNumeroDocumento?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.ViaggioDescrizione?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    };
}
