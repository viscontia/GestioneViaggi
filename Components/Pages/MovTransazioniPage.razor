@using GestioneViaggi.Models
@using GestioneViaggi.Services.CRUD
@using GestioneViaggi.Services.Authentication
@using GestioneViaggi.Services.Session
@using GestioneViaggi.Components.Shared
@inject MovTransazioniService TransazioniService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext

<AppBreadcrumbs />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <EnterpriseDataGrid T="MovTransazioni"
                        Title="Gestione Movimenti"
                        Items="@_items"
                        SearchFunction="@Search"
                        @bind-SelectedItem="_selectedItem"
                        Loading="@_loading">
        
        <ToolBarActions>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add" 
                       OnClick="@OpenCreateDialog">
                Nuova Transazione
            </MudButton>
        </ToolBarActions>

        <Columns>
            <PropertyColumn Property="x => x.TransazioneData" Title="Data" Format="dd/MM/yyyy" Sortable="true" />
            
            <PropertyColumn Property="x => x.TransazioneTipoMovimento" Title="Tipo">
                <CellTemplate>
                    @if (context.Item.TransazioneTipoMovimento == "ENTRATA")
                    {
                        <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Entrata</MudChip>
                    }
                    else
                    {
                        <MudChip Color="Color.Error" Size="Size.Small" Variant="Variant.Text">Uscita</MudChip>
                    }
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.FornitoreRagioneSociale" Title="Fornitore" />
            <PropertyColumn Property="x => x.TransazioneCausale" Title="Causale" />

            <PropertyColumn Property="x => x.TransazioneImporto" Title="Importo Orig." CellStyle="font-weight:bold;">
                <CellTemplate>
                    @context.Item.ImportoFormattato
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.TransazioneImportoEur" Title="Importo (EUR)" Format="N2" />

             <PropertyColumn Property="x => x.TransazioneStato" Title="Stato">
                <CellTemplate>
                    <StatusBadge Status="@context.Item.TransazioneStato" />
                </CellTemplate>
            </PropertyColumn>

            <EnterpriseActionsColumn T="MovTransazioni" OnEdit="@OpenEditDialog" OnDelete="@DeleteTransazione" />
        </Columns>
    </EnterpriseDataGrid>
</MudContainer>

@code {
    private IEnumerable<MovTransazioni> _items = new List<MovTransazioni>();
    private MovTransazioni? _selectedItem;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try 
        {
            var aziendaId = await TenantContext.GetCurrentAziendaIdAsync();
            if (aziendaId.HasValue && aziendaId.Value > 0)
            {
                _items = await TransazioniService.GetByAziendaAsync(aziendaId.Value);
            }
        }
        finally 
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MovTransazioniEditDialog>("Nuova Transazione", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(MovTransazioni item)
    {
        var parameters = new DialogParameters { ["Transazione"] = item };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MovTransazioniEditDialog>("Modifica Transazione", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task DeleteTransazione(MovTransazioni item)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Elimina Transazione", 
            $"Sei sicuro di voler eliminare la transazione del {item.TransazioneData:d} per {item.ImportoFormattato}?", 
            yesText: "Elimina", cancelText: "Annulla");

        if (result == true)
        {
            try
            {
                await TransazioniService.DeleteAsync(item.TransazioneId);
                Snackbar.Add("Transazione eliminata", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore eliminazione: {ex.Message}", Severity.Error);
            }
        }
    }

    private Func<MovTransazioni, string, bool> Search => (t, searchString) =>
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        
        // Cerca in Fornitore, Causale, Tipo
        if (t.FornitoreRagioneSociale?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneCausale?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneTipoMovimento?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (t.TransazioneNumeroDocumento?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        
        return false;
    };
}
