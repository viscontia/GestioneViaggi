    @code {
    private bool _isLoading = true; // FASE 2: Loading state for fade-in animation
    private Models.UserInfo? _currentUser;
    private ComparisonMode _comparisonMode = ComparisonMode.FullYear;
    private StatisticResult? _statsClienti;
    private StatisticResult? _statsViaggi;
    private StatisticResult? _statsRevenue;
    private StatisticResult? _statsViaggiFatti;
    private StatisticResult? _statsViaggiDaFare;

    private int _selectedYear = DateTime.Now.Year;
    private int _currentYear = DateTime.Now.Year;
    private List<int> _pastYears = new();

    private List<int> _futureYears = new();

    private List<GestioneViaggi.Models.DTOs.ActivityLogItem>? _activities;

    private bool _isIscrizioneWebDisabled = true;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
        int? aziendaId = _currentUser?.AziendaId;

        _currentYear = DateTime.Now.Year;
        // Fetch oldest year from DB
        int oldestYear = await StatYear.GetMaxOldYearCompanyAsync(aziendaId);

        // Forced Logic: Always show at least 5 years back
        int startYear = Math.Min(oldestYear, _currentYear - 5);

        // Anni passati (dal più recente al più vecchio)
        _pastYears.Clear();
        for (int i = _currentYear - 1; i >= startYear; i--)
        {
            _pastYears.Add(i);
        }

        // Anni futuri (dal più vicino al più lontano)
        _futureYears.Clear();
        for (int i = _currentYear + 1; i <= _currentYear + 5; i++)
        {
            _futureYears.Add(i);
        }

        // Ensure selected year is valid
        if (_selectedYear < startYear || _selectedYear > _currentYear + 5)
        {
            _selectedYear = _currentYear;
        }

        await LoadStatsAsync();
        await LoadActivitiesAsync();

        // Calculate Iscrizione WEB button state
        if (_currentUser?.AziendaId != null)
        {
            try
            {
                var azienda = await AziendaService.GetByIdAsync(_currentUser.AziendaId.Value);
                _isIscrizioneWebDisabled = string.IsNullOrWhiteSpace(azienda?.SitoWebIscrizione);
            }
            catch
            {
                // If error loading azienda, keep button disabled
                _isIscrizioneWebDisabled = true;
            }
        }

        _isLoading = false; // FASE 2: Trigger fade-in animation
    }

    private string GetYearLabel()
    {
        string suffix = _selectedYear == _currentYear ? " (corrente)" : "";
        return $"Anno: {_selectedYear}{suffix}";
    }

    private async Task OnYearSelected(int year)
    {
        if (_selectedYear != year)
        {
            _selectedYear = year;
            await LoadStatsAsync();
        }
    }

    private async Task OnYearChanged(int year)
    {
        _selectedYear = year;
        // Reset comparison mode when changing year (PoP only relevant for current year)
        if (_selectedYear != _currentYear) _comparisonMode = ComparisonMode.FullYear;
        await LoadStatsAsync();
    }

    private async Task OnComparisonModeChanged(ComparisonMode mode)
    {
        _comparisonMode = mode;
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        int? aziendaId = _currentUser?.AziendaId;
        int? valutaDefaultId = _currentUser?.ValutaDefaultId;

        // SECURITY FIX: Pass aziendaId to all statistics for multi-tenant filtering
        // SEQUENTIAL LOADING: To prevent "Too Many Sessions" on Supabase/Postgres
        _statsClienti = await StatClienti.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode);
        StateHasChanged(); // Update UI for first card

        _statsViaggi = await StatViaggi.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode);
        StateHasChanged();

        _statsRevenue = await StatRevenue.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode, valutaDefaultId);
        StateHasChanged();

        _statsViaggiFatti = await StatViaggiFatti.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode);
        StateHasChanged();

        _statsViaggiDaFare = await StatViaggiDaFare.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode);
        StateHasChanged();
    }

    private DateTime GetEffectiveEndDate()
    {
        DateTime endOfYear = new DateTime(_selectedYear, 12, 31);
        return DateTime.Today < endOfYear ? DateTime.Today : endOfYear;
    }

    private Color GetTrendColor(double value) => value switch
    {
        > 0 => Color.Success,
        < 0 => Color.Error,
        _ => Color.Default
    };

    private string GetTrendIcon(double value) => value switch
    {
        > 0 => Icons.Material.Filled.TrendingUp,
        < 0 => Icons.Material.Filled.TrendingDown,
        _ => Icons.Material.Filled.TrendingFlat
    };

    private RenderFragment GetTooltipContent(StatisticResult? stats, string entityName, bool isStockMetric)
    {
        if (stats == null) return builder => { };

        return builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "pa-3");

            // Header: Total Value - "684 Clienti Totali al 12/01/2026"
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "style", "font-size: 1.2em; font-weight: bold; margin-bottom: 8px;");

            string dateContext = _selectedYear == _currentYear ? $"al {DateTime.Today:dd/MM/yyyy}" : $"nel {_selectedYear}";
            builder.AddContent(4, $"{stats.MainValue:N0} {entityName} {(isStockMetric ? "Totali" : "")} {dateContext}");
            builder.CloseElement(); // div header

            builder.OpenElement(5, "div");
            builder.AddAttribute(6, "style", "font-size: 1.1em;");

            // Define labels and values based on ComparisonMode and Entity
            string labelCurr = "";
            string labelPrev = "";
            long valueCurr = stats.CurrentYearValue;
            long valuePrev = stats.PreviousYearValue;

            if (_comparisonMode == ComparisonMode.PeriodOverPeriod && _selectedYear == _currentYear)
            {
                // PoP Mode
                // "Questo Periodo (dal 01/01/2026 al 12/01/2026): +3"
                // "Periodo prec. (dal 01/01/2025 al 12/01/2025): +681"
                string currDates = $"(dal 01/01/{_selectedYear} al {DateTime.Today:dd/MM/yyyy})";
                string prevDates = $"(dal 01/01/{_selectedYear - 1} al {DateTime.Today.AddYears(-1):dd/MM/yyyy})";

                labelCurr = $"• Questo Periodo {currDates}:";
                labelPrev = $"• Periodo prec. {prevDates}:";

                if (isStockMetric)
                {
                    // For stock metrics in PoP (Hybrid), using ReferenceFlowValue for previous year "flow"
                    valuePrev = stats.ReferenceFlowValue ?? 0;
                }
                // Else (Flow metrics): valuePrev is already stats.PreviousYearValue which is correct flow.
            }
            else
            {
                // YoY Mode (Full Year)
                if (entityName == "Clienti")
                {
                    labelCurr = $"• Acquisiti nel {_selectedYear}:";
                }
                else if (entityName == "Viaggi")
                {
                    labelCurr = $"• Creati nel {_selectedYear}:";
                }
                else if (entityName == "Viaggi Fatti" || stats == _statsViaggiFatti)
                {
                    labelCurr = $"• Realizzati nel {_selectedYear}:";
                }
                else if (entityName == "Fatturato") 
                {
                    labelCurr = $"• Generato nel {_selectedYear}:";
                }
                else // Viaggi Da Fare
                {
                    labelCurr = $"• Preparati nel {_selectedYear}:";
                }

                labelPrev = $"• Periodo prec. (fino al {_selectedYear - 1}):";
            }

            // Render Row 1
            builder.OpenElement(7, "div");
            builder.AddAttribute(8, "class", "d-flex justify-space-between");
            builder.AddContent(9, labelCurr);
            builder.OpenElement(10, "span");
            builder.AddAttribute(11, "style", "font-weight: bold; margin-left: 8px;");
            builder.AddContent(12, $"{valueCurr:+0;-0;0}");
            builder.CloseElement();
            builder.CloseElement();

            // Render Row 2
            builder.OpenElement(13, "div");
            builder.AddAttribute(14, "class", "d-flex justify-space-between");
            builder.AddContent(15, labelPrev);
            builder.OpenElement(16, "span");
            builder.AddAttribute(17, "style", "font-weight: bold; margin-left: 8px;");
            builder.AddContent(18, $"{valuePrev:+0;-0;0}");
            builder.CloseElement();
            builder.CloseElement();

            builder.CloseElement(); // div body
            builder.CloseElement(); // div main
        };
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private void OnPartenzeDaFareClick()
    {
        string route = $"/ana-viaggi?year={_selectedYear}";
        if (_selectedYear == _currentYear)
        {
            route += "&filter=future";
        }
        else if (_selectedYear < _currentYear)
        {
            route += "&filter=not_done";
        }
        Navigation.NavigateTo(route);
    }

