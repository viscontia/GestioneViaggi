@page "/dashboard-admin"
@using GestioneViaggi.Services.Authentication
@using Microsoft.AspNetCore.Authorization
@using GestioneViaggi.Statistics
@using GestioneViaggi.Services.CRUD
@layout DashboardLayout
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject StatisticCountClienti StatClienti
@inject StatisticCountViaggi StatViaggi
@inject StatisticCountViaggiFatti StatViaggiFatti
@inject StatisticCountViaggiDaFare StatViaggiDaFare
@inject StatisticRevenue StatRevenue
@inject StatisticYearService StatYear
@inject ISnackbar Snackbar

<MudStack Spacing="4">

    <!-- Header -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-2" />
                    Dashboard Aziendale
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Benvenuto, @_currentUser?.FullName
                    @if (_currentUser?.AziendaId != null)
                    {
                        <span> - Azienda ID: @_currentUser.AziendaId</span>
                    }
                </MudText>
            </div>
            @if (_selectedYear == _currentYear)
            {
                <div class="ml-4" style="width: 200px; flex: none;">
                    <MudTooltip>
                        <TooltipContent>
                            <MudText Typo="Typo.body2" Align="Align.Left">
                                <b>Anno Intero (YoY):</b> Confronto con l'intero anno precedente.<br />
                                <b>Su Periodo (PoP):</b> Confronto con lo stesso periodo (date esatte) dell'anno precedente.
                            </MudText>
                        </TooltipContent>
                        <ChildContent>
                            <MudSelect T="ComparisonMode" Value="_comparisonMode" ValueChanged="OnComparisonModeChanged"
                                Label="Modalità Confronto" Variant="Variant.Outlined" Margin="Margin.Dense"
                                AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="ComparisonMode.FullYear">Anno Intero (YoY)</MudSelectItem>
                                <MudSelectItem Value="ComparisonMode.PeriodOverPeriod">Su Periodo (PoP)</MudSelectItem>
                            </MudSelect>
                        </ChildContent>
                    </MudTooltip>
                </div>
            }
            <div class="d-flex" style="width: 250px; flex: none;">
                <MudMenu Label="@GetYearLabel()" Variant="Variant.Outlined"
                    EndIcon="@Icons.Material.Filled.KeyboardArrowDown" FullWidth="true"
                    AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                    <MudList T="int" @bind-SelectedValue="_selectedYear" Dense="true"
                        Style="max-height: 350px; overflow-y: auto;">
                        @* Anno Corrente *@
                        <MudListItem Value="@_currentYear" OnClick="() => OnYearSelected(_currentYear)">
                            <MudText Typo="Typo.body1"><b>@_currentYear (corrente)</b></MudText>
                        </MudListItem>

                        <MudDivider />

                        @* Anni Passati *@
                        <MudListItem Text="Anni Passati">
                            <NestedList>
                                @foreach (var year in _pastYears)
                                {
                                    <MudListItem Value="@year" OnClick="() => OnYearSelected(year)">@year</MudListItem>
                                }
                            </NestedList>
                        </MudListItem>

                        @* Anni Futuri *@
                        <MudListItem Text="Anni Futuri">
                            <NestedList>
                                @foreach (var year in _futureYears)
                                {
                                    <MudListItem Value="@year" OnClick="() => OnYearSelected(year)">@year</MudListItem>
                                }
                            </NestedList>
                        </MudListItem>
                    </MudList>
                </MudMenu>
            </div>
        </MudStack>
    </MudPaper>



    <!-- Stats Cards -->
    <style>
        @@media(min-width:1280px) {
            .col-lg-5-custom {
                flex: 0 0 20%;
                max-width: 20%;
            }
        }
    </style>
    <MudGrid>

        <MudItem xs="12" sm="6" md="4" Class="col-lg-5-custom">
            <MudPaper Elevation="2" Class="pa-4 cursor-pointer" Style="height: 100%"
            @onclick="@(() => NavigateTo($"/anagrafiche/clienti?year={_selectedYear}"))">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Success" />
                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudChip T="string" Size="Size.Large"
                                Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))" Variant="Variant.Text"
                                Icon="@(GetTrendIcon(_statsClienti?.PercentageChange ?? 0))">
                                @(_statsClienti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                            </MudChip>
                            <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))"
                                Style="font-weight: bold" Class="mr-2">
                                @(_statsClienti?.Increment.ToString("+0;-0;0"))
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.h4">@(_statsClienti?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Clienti Totali</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(% @_selectedYear su @(_selectedYear - 1))
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" Class="col-lg-5-custom">
            <MudPaper Elevation="2" Class="pa-4 cursor-pointer" Style="height: 100%"
            @onclick="@(() => NavigateTo($"/ana-viaggi?year={_selectedYear}"))">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Size="Size.Large" Color="Color.Info" />
                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudChip T="string" Size="Size.Large"
                                Color="@(GetTrendColor(_statsViaggi?.PercentageChange ?? 0))" Variant="Variant.Text"
                                Icon="@(GetTrendIcon(_statsViaggi?.PercentageChange ?? 0))">
                                @(_statsViaggi?.PercentageChange.ToString("+0.#;-0.#;0"))%
                            </MudChip>
                            <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsViaggi?.PercentageChange ?? 0))"
                                Style="font-weight: bold" Class="mr-2">
                                @(_statsViaggi?.Increment.ToString("+0;-0;0"))
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.h4">@(_statsViaggi?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Viaggi Totali</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(% @_selectedYear su @(_selectedYear - 1))
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" Class="col-lg-5-custom">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.EuroSymbol" Size="Size.Large" Color="Color.Tertiary" />
                    <MudText Typo="Typo.h4">@(_statsRevenue?.MainValue ?? 0)</MudText>
                        <MudText Typo="Typo.body2">Fatturato</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="col-lg-5-custom">
                <MudPaper Elevation="2" Class="pa-4 cursor-pointer" Style="height: 100%"
                @onclick="@(() => NavigateTo($"/ana-viaggi?year={_selectedYear}&filter=completed"))">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Secondary" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large"
                                    Color="@(GetTrendColor(_statsViaggiFatti?.PercentageChange ?? 0))"
                                    Variant="Variant.Text" Icon="@(GetTrendIcon(_statsViaggiFatti?.PercentageChange ?? 0))">
                                    @(_statsViaggiFatti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                            </MudChip>
                            <MudText Typo="Typo.body1"
                                Color="@(GetTrendColor(_statsViaggiFatti?.PercentageChange ?? 0))"
                                Style="font-weight: bold" Class="mr-2">
                                @(_statsViaggiFatti?.Increment.ToString("+0;-0;0"))
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.h4">@(_statsViaggiFatti?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Viaggi fatti @_selectedYear</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">fino al
                                @GetEffectiveEndDate().ToString("dd/MM/yyyy")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="col-lg-5-custom">
                <MudPaper Elevation="2" Class="pa-4 cursor-pointer" Style="height: 100%" @onclick="OnPartenzeDaFareClick">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Warning" />
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudChip T="string" Size="Size.Large"
                                    Color="@(GetTrendColor(_statsViaggiDaFare?.PercentageChange ?? 0))"
                                    Variant="Variant.Text"
                                    Icon="@(GetTrendIcon(_statsViaggiDaFare?.PercentageChange ?? 0))">
                                    @(_statsViaggiDaFare?.PercentageChange.ToString("+0.#;-0.#;0"))%
                            </MudChip>
                            <MudText Typo="Typo.body1"
                                Color="@(GetTrendColor(_statsViaggiDaFare?.PercentageChange ?? 0))"
                                Style="font-weight: bold" Class="mr-2">
                                @(_statsViaggiDaFare?.Increment.ToString("+0;-0;0"))
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.h4">@(_statsViaggiDaFare?.MainValue ?? 0)</MudText>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Viaggi da fare @_selectedYear</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">fino al 31/12/@_selectedYear</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Quick Actions -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Azioni Rapide</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                    OnClick="@(() => NavigateTo("/ana-viaggi?action=new"))">
                    Nuovo Viaggio
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Event"
                    OnClick="OnNuovaPartenzaClick">
                    Nuova Partenza
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.People"
                    OnClick="@(() => NavigateTo($"/ana-viaggi?year={_currentYear}&filter=future"))">
                    Gestisci Partecipanti
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.FlashOn"
                    OnClick="OpenQuickAddDialog">
                    Iscrizione Veloce
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Stampe per i Viaggi -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Stampe per i Viaggi</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Description"
                           OnClick="@(() => Snackbar.Add("Funzionalità in sviluppo", Severity.Info))">
                    Stampa Scheda Data Viaggio
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ListAlt"
                           OnClick="@(() => Snackbar.Add("Funzionalità in sviluppo", Severity.Info))">
                    Stampa Dettaglio Data Viaggio
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Hotel"
                           OnClick="@(() => Snackbar.Add("Funzionalità in sviluppo", Severity.Info))">
                    Stampa Rooming List
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Recent Activity -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Attività Recente</MudText>
            <MudList T="string">
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                    <MudText>Viaggio "Safari Kenya" completato - 2 ore fa</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Edit" IconColor="Color.Info">
                    <MudText>Modificato itinerario "Islanda 2025" - 5 ore fa</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.PersonAdd" IconColor="Color.Primary">
                    <MudText>Nuovo partecipante aggiunto a "Dolomiti Adventure" - 1 giorno fa</MudText>
                </MudListItem>
            </MudList>
        </MudPaper>

    </MudStack>

    @code {
    private Models.UserInfo? _currentUser;
    private ComparisonMode _comparisonMode = ComparisonMode.FullYear;
    private StatisticResult? _statsClienti;
    private StatisticResult? _statsViaggi;
    private StatisticResult? _statsRevenue;
    private StatisticResult? _statsViaggiFatti;
    private StatisticResult? _statsViaggiDaFare;

    private int _selectedYear = DateTime.Now.Year;
    private int _currentYear = DateTime.Now.Year;
    private List<int> _pastYears = new();
    private List<int> _futureYears = new();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
        int? aziendaId = _currentUser?.AziendaId;

        _currentYear = DateTime.Now.Year;
        // Fetch oldest year from DB
        int oldestYear = await StatYear.GetMaxOldYearCompanyAsync(aziendaId);

        // Forced Logic: Always show at least 5 years back
        int startYear = Math.Min(oldestYear, _currentYear - 5);

        // Anni passati (dal più recente al più vecchio)
        _pastYears.Clear();
        for (int i = _currentYear - 1; i >= startYear; i--)
        {
            _pastYears.Add(i);
        }

        // Anni futuri (dal più vicino al più lontano)
        _futureYears.Clear();
        for (int i = _currentYear + 1; i <= _currentYear + 5; i++)
        {
            _futureYears.Add(i);
        }

        // Ensure selected year is valid
        if (_selectedYear < startYear || _selectedYear > _currentYear + 5)
        {
            _selectedYear = _currentYear;
        }

        await LoadStatsAsync();
    }

    private string GetYearLabel()
    {
        string suffix = _selectedYear == _currentYear ? " (corrente)" : "";
        return $"Anno: {_selectedYear}{suffix}";
    }

    private async Task OnYearSelected(int year)
    {
        if (_selectedYear != year)
        {
            _selectedYear = year;
            await LoadStatsAsync();
        }
    }

    private async Task OnYearChanged(int year)
    {
        _selectedYear = year;
        // Reset comparison mode when changing year (PoP only relevant for current year)
        if (_selectedYear != _currentYear) _comparisonMode = ComparisonMode.FullYear;
        await LoadStatsAsync();
    }

    private async Task OnComparisonModeChanged(ComparisonMode mode)
    {
        _comparisonMode = mode;
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        int? aziendaId = _currentUser?.AziendaId;

        // SECURITY FIX: Pass aziendaId to all statistics for multi-tenant filtering
        var tasks = new Task[]
        {
Task.Run(async () => _statsClienti = await StatClienti.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode)),
Task.Run(async () => _statsViaggi = await StatViaggi.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode)),
Task.Run(async () => _statsRevenue = await StatRevenue.GetStatsAsync(_selectedYear, aziendaId, _comparisonMode)),
Task.Run(async () => _statsViaggiFatti = await StatViaggiFatti.GetStatsAsync(_selectedYear, aziendaId,
_comparisonMode)),
Task.Run(async () => _statsViaggiDaFare = await StatViaggiDaFare.GetStatsAsync(_selectedYear, aziendaId,
_comparisonMode))
        };

        await Task.WhenAll(tasks);
    }

    private DateTime GetEffectiveEndDate()
    {
        DateTime endOfYear = new DateTime(_selectedYear, 12, 31);
        return DateTime.Today < endOfYear ? DateTime.Today : endOfYear;
    }

    private Color GetTrendColor(double value) => value switch
    {
        > 0 => Color.Success,
        < 0 => Color.Error,
        _ => Color.Default
    };

    private string GetTrendIcon(double value) => value switch
    {
        > 0 => Icons.Material.Filled.TrendingUp,
        < 0 => Icons.Material.Filled.TrendingDown,
        _ => Icons.Material.Filled.TrendingFlat
    };

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private void OnPartenzeDaFareClick()
    {
        string route = $"/ana-viaggi?year={_selectedYear}";
        if (_selectedYear == _currentYear)
        {
            route += "&filter=future";
        }
        else if (_selectedYear < _currentYear)
        {
            route += "&filter=not_done";
        }
        Navigation.NavigateTo(route);
    }

    [Inject] public IDialogService DialogService { get; set; } = default!;
    [Inject] public AnaViaggiService ViaggiService { get; set; } = default!;

    private async Task OnNuovaPartenzaClick()
    {
        var parameters = new DialogParameters
            {
                ["AziendaId"] = _currentUser?.AziendaId ?? 0
            };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<GestioneViaggi.Components.Shared.NuovaPartenzaDialog>("Nuova Partenza",
        parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is int viaggioId)
        {
            // Trip selected, now fetch entity and open AnaViaggiDialog in Add Date mode
            try
            {
                var trip = await ViaggiService.GetByIdAsync(viaggioId);
                if (trip != null)
                {
                    var editParams = new DialogParameters
                        {
                            ["Entity"] = trip,
                            ["IsEditMode"] = true,
                            ["AziendaFk"] = _currentUser?.AziendaId ?? 0,
                            ["StartOnDatesTab"] = true, // Go to dates
                            ["AutoOpenAddDate"] = true // Open add dialog immediately
                        };

                    var editOptions = new DialogOptions
                        {
                            CloseButton = true,
                            MaxWidth = MaxWidth.Medium,
                            FullWidth = true,
                            BackdropClick = false
                        };

                    var editDialog = await DialogService.ShowAsync<AnaViaggiDialog>("Nuova Partenza - INSERIMENTO", editParams,
                    editOptions);
                    var editResult = await editDialog.Result;

                    if (editResult != null && !editResult.Canceled)
                    {
                        Snackbar.Add("Partenza inserita con successo!", Severity.Success);
                        // Refresh stats
                        await LoadStatsAsync();
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Errore apertura viaggio: {ex.Message}", Severity.Error);
            }
            }
        }


    private async Task OpenQuickAddDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<GestioneViaggi.Components.Shared.QuickAddParticipantDialog>("Iscrizione Veloce", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadStatsAsync();
        }
    }
}
