                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudChip T="string" Size="Size.Large"
                                Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))" Variant="Variant.Text"
                                Icon="@(GetTrendIcon(_statsClienti?.PercentageChange ?? 0))">
                                @(_statsClienti?.PercentageChange.ToString("+0.#;-0.#;0"))%
                            </MudChip>
                            <MudText Typo="Typo.body1" Color="@(GetTrendColor(_statsClienti?.PercentageChange ?? 0))"
                                Style="font-weight: bold" Class="mr-2">
                                @(_statsClienti?.Increment.ToString("+0;-0;0"))
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Style="height: 60px; width: 100%;">
                        <MudText Typo="Typo.h3" Style="font-weight: 700; line-height: 1.2;">@(_statsClienti?.MainValue ?? 0)</MudText>
                        <MudPaper Height="60px" Elevation="0" Class="d-flex align-end ml-4" Style="flex: 1; min-width: 60px; max-width: 140px; background: transparent;">
                        @if (_statsClienti?.TrendData?.Count == 12)
                        {
                                <svg width="100%" height="100%" viewBox="0 0 140 60" preserveAspectRatio="none" aria-hidden="true">
                                    @{
                                        var data = _statsClienti.TrendData;
                                        // Ensure we have 12 points
                                        var points = new List<double>();
                                        for(int i=0; i<12; i++) points.Add((i < data.Count) ? data[i] : 0);

                                        var max = points.Any() ? points.Max() : 1;
                                        if (max == 0) max = 1;

                                        // Bar Layout Constants
                                        double slotWidth = 11.67; // 140 / 12
                                        double gap = 2.0;
                                        double barWidth = slotWidth - gap; // ~9.67

                                        // Build line points based on BAR CENTERS
                                        var sb = new System.Text.StringBuilder();
                                        for (int i = 0; i < 12; i++)
                                        {
                                            var val = points[i];
                                            // Center of the bar: (i * 11.67) + (9.67 / 2)
                                            var x = (i * slotWidth) + (barWidth / 2.0);
                                            // Y scaling:
                                            // Top Margin = 8 (safer for radius)
                                            // Bottom Margin = 5
                                            // Height = 60. Available = 60 - 8 - 5 = 47.
                                            // y = 55 - (val/max * 47)
                                            var y = 55.0 - ((val / max) * 47.0);

                                            sb.Append($"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)} ");
                                        }
                                        var polylinePoints = sb.ToString();
                                    }
                                    <!-- 1. Background Ghost Bars -->
                                    @for(int i=0; i<12; i++)
                                    {
                                         var x = (i * slotWidth);
                                         var monthName = System.Globalization.CultureInfo.GetCultureInfo("it-IT").DateTimeFormat.GetAbbreviatedMonthName(i + 1);
                                         var toolTip = $"{monthName}: {points[i]}";
                                         <rect x="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="0" width="@barWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)" height="60" fill="#e0e0e0" rx="2">
                                             <title>@toolTip</title>
                                         </rect>
                                    }

                                    <!-- 2. Data Bars -->
                                    @for(int i=0; i<12; i++)
                                    {
                                         var x = (i * slotWidth);
                                         var val = points[i];
                                         if (val > 0.01)
                                         {
                                             var barHeight = (val / max) * 47.0;
                                             var y = 55.0 - barHeight;
                                             <rect x="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" width="@barWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)" height="@barHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)" fill="@Colors.Green.Default" opacity="0.7" rx="2" />
                                         }
                                    }

                                    <!-- 3. Trend Line -->
                                    <polyline points="@polylinePoints" fill="none" stroke="@Colors.Green.Default" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

                                    <!-- 4. Dots -->
                                    @for (int i = 0; i < 12; i++)
                                    {
                                        var val = points[i];
                                        var monthName = System.Globalization.CultureInfo.GetCultureInfo("it-IT").DateTimeFormat.GetAbbreviatedMonthName(i + 1);
                                        var toolTip = $"{monthName}: {val}";

                                        if (val > 0.01) // Strict check
                                        {
                                            var x = (i * slotWidth) + (barWidth / 2.0);
                                            var y = 55.0 - ((val / max) * 47.0);
                                            <circle cx="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)" cy="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="3" fill="@Colors.Green.Default">
                                                <title>@toolTip</title>
                                            </circle>
                                        }
                                    }
                                </svg>
                        }
                        else
                        {
                            <div class="chart-skeleton" style="width: 140px; height: 60px;"></div>
                        }
                        </MudPaper>
                    </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 4px;">
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Clienti Totali</MudText>
                            <MudText Typo="Typo.body2" Style="font-size: 12px; color: var(--mud-palette-text-secondary);">(% @_selectedYear su @(_selectedYear - 1))
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
                </ChildContent>
            </MudTooltip>
