@page "/demogrid"
@using MudBlazor
@using System.Text.Json

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
        <MudText Typo="Typo.h6">ERRORE RILEVATO:</MudText>
        <MudText>@ErrorMessage</MudText>
        <MudText Typo="Typo.caption" Class="mt-2">Stack Trace:</MudText>
        <pre>@ErrorStack</pre>
    </MudAlert>
}
else
{
    <EnterpriseDataGrid T="Country" 
                        Items="@Elements" 
                        Title="Gestione Nazioni"
                        SearchFunction="@SearchCountry">
        
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.Name" Title="Nazione" />
            <PropertyColumn Property="x => x.Code" Title="Codice ISO" />
            <PropertyColumn Property="x => x.Region" Title="Regione" />
            <PropertyColumn Property="x => x.Population" Title="Popolazione" />
            
            <EnterpriseActionsColumn T="Country" OnEdit="@EditCountry" OnDelete="@DeleteCountry" />
        </Columns>
        
    </EnterpriseDataGrid>
}

@code {
    private List<Country> Elements = new List<Country>();
    private string ErrorMessage = "";
    private string ErrorStack = "";

    protected override void OnInitialized()
    {
        try 
        {
            Elements.Add(new Country { Id = "1", Name = "ITALIA", Code = "IT", Region = "Europa", Population = 60000000 });
            Elements.Add(new Country { Id = "2", Name = "FRANCIA", Code = "FR", Region = "Europa", Population = 67000000 });
            Elements.Add(new Country { Id = "3", Name = "GERMANIA", Code = "DE", Region = "Europa", Population = 83000000 });
            Elements.Add(new Country { Id = "4", Name = "SPAGNA", Code = "ES", Region = "Europa", Population = 47000000 });
            Elements.Add(new Country { Id = "5", Name = "GIAPPONE", Code = "JP", Region = "Asia", Population = 125000000 });
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            ErrorStack = ex.StackTrace;
        }
    }

    // Funzione di Ricerca Case-Insensitive su tutti i campi
    private bool SearchCountry(Country country, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (country.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Code?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Region?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Id?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private void EditCountry(Country item)
    {
        // Logica di edit (es. apertura dialog)
        Console.WriteLine($"Edit richiesto per: {item.Name}");
    }

    private void DeleteCountry(Country item)
    {
        // Logica di delete (es. conferma e rimozione)
        Elements.Remove(item);
    }

    public class Country
    {
        public string? Id { get; set; }
        public string? Name { get; set; }
        public string? Code { get; set; }
        public string? Region { get; set; }
        public long Population { get; set; } 
    }
}
