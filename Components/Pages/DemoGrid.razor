@page "/demogrid"
@using MudBlazor
@using System.Text.Json

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
        <MudText Typo="Typo.h6">ERRORE RILEVATO:</MudText>
        <MudText>@ErrorMessage</MudText>
        <MudText Typo="Typo.caption" Class="mt-2">Stack Trace:</MudText>
        <pre>@ErrorStack</pre>
    </MudAlert>
}
else
{
    <MudDataGrid T="Country" 
                 Items="@Elements" 
                 Filterable="true"
                 SortMode="SortMode.Multiple"
                 Groupable="false"
                 QuickFilter="@(x => SearchCountry(x, _searchString))"
                 @bind-SelectedItem="_selectedItem">
        
        <ToolBarContent>
            <MudText Typo="Typo.h6">Gestione Nazioni</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Cerca..." Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>

        <Columns>
            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                        <MudTooltip Text="Modifica">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(() => EditCountry(context.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Elimina">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(() => DeleteCountry(context.Item))" />
                        </MudTooltip>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.Name" Title="Nazione" />
            <PropertyColumn Property="x => x.Code" Title="Codice ISO" />
            <PropertyColumn Property="x => x.Region" Title="Regione">
                <CellTemplate>
                    <MudChip Size="Size.Small" 
                             Class="@($"difficulty-badge difficulty-{context.Item.Region?.ToLower().Replace(" ", "-")}")">
                        @context.Item.Region
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Population" Title="Popolazione" />
            <PropertyColumn Property="x => x.Status" Title="Stato">
                <CellTemplate>
                    <StatusBadge Status="@context.Item.Status" />
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        
    </MudDataGrid>
}

@code {
    private List<Country> Elements = new List<Country>();
    private Country? _selectedItem;
    private string ErrorMessage = "";
    private string ErrorStack = "";
    private string _searchString = string.Empty;

    protected override void OnInitialized()
    {
        try 
        {
            Elements.Add(new Country { Id = "1", Name = "ITALIA", Code = "IT", Region = "Europa", Population = 60000000, Status = "Active" });
            Elements.Add(new Country { Id = "2", Name = "FRANCIA", Code = "FR", Region = "Europa", Population = 67000000, Status = "Planned" });
            Elements.Add(new Country { Id = "3", Name = "GERMANIA", Code = "DE", Region = "Europa", Population = 83000000, Status = "Completed" });
            Elements.Add(new Country { Id = "4", Name = "SPAGNA", Code = "ES", Region = "Europa", Population = 47000000, Status = "Active" });
            Elements.Add(new Country { Id = "5", Name = "GIAPPONE", Code = "JP", Region = "Asia", Population = 125000000, Status = "Planned" });
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            ErrorStack = ex.StackTrace;
        }
    }

    // Funzione di Ricerca Case-Insensitive su tutti i campi
    private bool SearchCountry(Country country, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (country.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Code?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Region?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Id?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (country.Status?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private void EditCountry(Country item)
    {
        // Logica di edit (es. apertura dialog)
        Console.WriteLine($"Edit richiesto per: {item.Name}");
    }

    private void DeleteCountry(Country item)
    {
        // Logica di delete (es. conferma e rimozione)
        Elements.Remove(item);
    }

    public class Country
    {
        public string? Id { get; set; }
        public string? Name { get; set; }
        public string? Code { get; set; }
        public string? Region { get; set; }
        public long Population { get; set; } 
        public string? Status { get; set; } = "Planned"; // New Status property
    }
}
