@page "/"
@using GestioneViaggi.Services.Authentication
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation

@code {
    protected override async Task OnInitializedAsync()
    {
        // Controlla se l'utente è autenticato
        var currentUser = await AuthService.GetCurrentUserAsync();

        if (currentUser == null)
        {
            // Non autenticato → vai al login
            Navigation.NavigateTo("/login", true);
        }
        else
        {
            // Autenticato → vai alla dashboard corretta
            if (currentUser.IsSuperAdmin)
            {
                Navigation.NavigateTo("/dashboard-superadmin", true);
            }
            else
            {
                Navigation.NavigateTo("/dashboard-admin", true);
            }
        }
    }
}
