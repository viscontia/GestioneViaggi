<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Framework impostati su .NET 9 -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net9.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net9.0-maccatalyst</TargetFrameworks>

        <!-- QUESTA È LA RIGA MAGICA CHE RISOLVE L'ERRORE DI XCODE -->
        <_SuppressSdkVersionCheck>true</_SuppressSdkVersionCheck>

        <OutputType>Exe</OutputType>
        <RootNamespace>GestioneViaggi</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Mantieni file originali static web assets (non solo compressi) -->
        <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
        <GenerateStaticWebAssetsManifest>true</GenerateStaticWebAssetsManifest>

        <!-- Display name -->
        <ApplicationTitle>GestioneViaggi</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.adrianovisconti.gestioneviaggi</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.35</ApplicationDisplayVersion>
        <ApplicationVersion>35</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>

        <!-- Versioni Minime OS -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Entitlements per MacCatalyst Debug (senza sandbox) -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' AND '$(Configuration)' == 'Debug'">
        <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.Debug.plist</CodesignEntitlements>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' AND '$(Configuration)' == 'Release'">
        <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
        <NoWarn>$(NoWarn);IL2037</NoWarn>
    </PropertyGroup>

    <!-- Preserva assembly dal trimming IL Linker per compatibilità Npgsql -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <TrimmerRootAssembly Include="Npgsql" />
        <TrimmerRootAssembly Include="GestioneViaggi" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="appsettings.json" />
        <Content Remove="appsettings.Development.json" />
        <EmbeddedResource Include="appsettings.json" />
        <EmbeddedResource Include="appsettings.Development.json" />
        <EmbeddedResource Include="Resources\Version\Versione.txt" />
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splashscreen.png" Color="#172331" BaseSize="800,339" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />
<!-- MauiAsset Include="Resources\Fonts\*" LogicalName="%(Filename)%(Extension)" / -->

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pacchetti Nuget -->
        <PackageReference Include="ClosedXML" Version="0.105.0" />
        <PackageReference Include="ExcelDataReader" Version="3.8.0" />
        <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
        <PackageReference Include="HarfBuzzSharp" Version="7.3.0.2" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.MacCatalyst" Version="7.3.0.2" Condition="$(TargetFramework.Contains('-maccatalyst'))" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="7.3.0.2" Condition="$(TargetFramework.Contains('-windows'))" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
        <PackageReference Include="SkiaSharp" Version="2.88.8" />
        <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.8" />
        <PackageReference Include="SkiaSharp.NativeAssets.MacCatalyst" Version="2.88.8" Condition="$(TargetFramework.Contains('-maccatalyst'))" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" Condition="$(TargetFramework.Contains('-windows'))" />
        <PackageReference Include="libphonenumber-csharp" Version="9.0.21" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
        <PackageReference Include="MudBlazor" Version="8.15.0" />

        <!-- Database PostgreSQL -->
        <PackageReference Include="Npgsql" Version="8.0.6" />

        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.0" />
        <PackageReference Include="QuestPDF" Version="2023.12.6" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

        <!-- Email SMTP (MailKit) -->
        <PackageReference Include="MailKit" Version="4.9.0" />

        <!-- Rich Text Editor (Quill.js wrapper) -->
        <PackageReference Include="Blazored.TextEditor" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Fix build error with omnisharp.json -->
        <Content Remove="omnisharp.json" />
        <None Remove="omnisharp.json" />

        <!-- Escludi Unit_Tests dal bundling MAUI -->
        <Compile Remove="Unit_Tests\**" />
        <Content Remove="Unit_Tests\**" />
        <None Remove="Unit_Tests\**" />

        <!-- Escludi script di test standalone dalla root (evitano conflitti DI/entry-point) -->
        <Compile Remove="Test*.cs" />
        <Compile Remove="test_*.cs" />
        <MauiAsset Remove="Unit_Tests\**" />

        <!-- Escludi output del tooling graphify dal bundling MAUI (non è codice/asset dell'app) -->
        <Compile Remove="graphify-out\**" />
        <Content Remove="graphify-out\**" />
        <None Remove="graphify-out\**" />
        <MauiAsset Remove="graphify-out\**" />
        <EmbeddedResource Remove="graphify-out\**" />
    </ItemGroup>

    <!-- Manually include QuestPDF Lato fonts as MAUI assets for cross-platform support -->
    <!-- QuestPDF fonts inclusion removed due to version mismatch and build errors -->

    <!-- Fix static web assets in Release builds - copy uncompressed files -->
    <Target Name="CopyUncompressedWwwroot" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net9.0-maccatalyst'">
        <PropertyGroup>
            <WwwrootDestination>$(OutputPath)maccatalyst-arm64\$(AssemblyName).app\Contents\Resources\wwwroot\</WwwrootDestination>
            <NuGetPackagesPath Condition="'$(NuGetPackagesPath)' == ''">$(HOME)/.nuget/packages</NuGetPackagesPath>
        </PropertyGroup>
        <ItemGroup>
            <!-- Project wwwroot files -->
            <WwwrootFiles Include="$(ProjectDir)wwwroot\**\*.*" Exclude="$(ProjectDir)wwwroot\**\*.br;$(ProjectDir)wwwroot\**\*.gz;$(ProjectDir)wwwroot\**\.DS_Store" />
            <!-- MudBlazor static assets from NuGet -->
            <MudBlazorFiles Include="$(NuGetPackagesPath)/mudblazor/8.15.0/staticwebassets/*.*" />
            <!-- Blazored.TextEditor static assets from NuGet -->
            <BlazoredTextEditorFiles Include="$(NuGetPackagesPath)/blazored.texteditor/1.1.0/staticwebassets/**/*.*" />
        </ItemGroup>
        <Message Importance="high" Text="Copying uncompressed wwwroot files to: $(WwwrootDestination)" />
        <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(WwwrootDestination)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(MudBlazorFiles)" DestinationFolder="$(WwwrootDestination)_content/MudBlazor/" SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(BlazoredTextEditorFiles)" DestinationFiles="@(BlazoredTextEditorFiles->'$(WwwrootDestination)_content/Blazored.TextEditor/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    </Target>

</Project>