<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Framework impostati su .NET 9 -->
        <TargetFrameworks>net9.0-maccatalyst</TargetFrameworks>

        <!-- QUESTA È LA RIGA MAGICA CHE RISOLVE L'ERRORE DI XCODE -->
        <_SuppressSdkVersionCheck>true</_SuppressSdkVersionCheck>

        <OutputType>Exe</OutputType>
        <RootNamespace>GestioneViaggi</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>GestioneViaggi</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.adrianovisconti.gestioneviaggi</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>

        <!-- Versioni Minime OS -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Entitlements per MacCatalyst Debug (senza sandbox) -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' AND '$(Configuration)' == 'Debug'">
        <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.Debug.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- Entitlements per MacCatalyst Release (con sandbox per App Store) -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' AND '$(Configuration)' == 'Release'">
        <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splashscreen.png" Color="#172331" BaseSize="800,339" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />
<!-- MauiAsset Include="Resources\Fonts\*" LogicalName="%(Filename)%(Extension)" / -->

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pacchetti Nuget -->
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="ExcelDataReader" Version="3.8.0" />
        <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
        <PackageReference Include="HarfBuzzSharp" Version="7.3.0.2" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.MacCatalyst" Version="7.3.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
        <PackageReference Include="SkiaSharp" Version="2.88.8" />
        <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.8" />
        <PackageReference Include="SkiaSharp.NativeAssets.MacCatalyst" Version="2.88.8" />
        <PackageReference Include="libphonenumber-csharp" Version="9.0.21" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
        <PackageReference Include="MudBlazor" Version="8.15.0" />

        <!-- Database PostgreSQL -->
        <PackageReference Include="Npgsql" Version="8.0.5" />

        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.0" />
        <PackageReference Include="QuestPDF" Version="2023.12.6" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

        <!-- Email SMTP (MailKit) -->
        <PackageReference Include="MailKit" Version="4.9.0" />

        <!-- Rich Text Editor (Quill.js wrapper) -->
        <PackageReference Include="Blazored.TextEditor" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Fix build error with omnisharp.json -->
        <Content Remove="omnisharp.json" />
        <None Remove="omnisharp.json" />

        <!-- Escludi Unit_Tests dal bundling MAUI -->
        <Compile Remove="Unit_Tests\**" />
        <Content Remove="Unit_Tests\**" />
        <None Remove="Unit_Tests\**" />
        <MauiAsset Remove="Unit_Tests\**" />
    </ItemGroup>

    <!-- Manually include QuestPDF Lato fonts as MAUI assets for cross-platform support -->
    <!-- QuestPDF fonts inclusion removed due to version mismatch and build errors -->

</Project>